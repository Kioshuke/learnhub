# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.

# Supabase
SUPABASE_URL=https://hyuzukvxulwouaexatqv.supabase.co
# Secret key (tạo từ Project Settings -> API Keys). Chỉ dùng server-side, tuyệt đối không đưa vào web.
SUPABASE_SECRET_KEY=sb_secret_...

# Firebase: đường dẫn tới service account JSON (tạo từ Firebase Console -> Project settings -> Service accounts -> Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./learnhub-firebase-service-account.json
