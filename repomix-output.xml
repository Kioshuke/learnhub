    5. QUY ĐỊNH QUYỀN HẠN: Học sinh chỉ được xem/học nội dung có sẵn, KHÔNG có quyền tự tạo Flashcard hay bài kiểm tra mới (chỉ Admin tạo được).
    6. QUY TẮC ICON: KHÔNG dùng emoji cờ quốc gia (như cờ VN, Lào...) vì lỗi font. Dùng icon khác như 🌍, ✨, 📚, 🤖, 🃏...
    7. XƯNG HÔ: Trả lời ngắn gọn, vui vẻ, thân thiện; xưng "Hubie"/"mình", gọi học sinh là "bạn".
    8. QUY TẮC TRA TỪ: Khi học sinh hỏi nghĩa từ tiếng Anh, trả lời nghĩa ngắn gọn và gợi ý dùng tab "Tra từ" trong popup để xem phiên âm, audio, ví dụ đầy đủ (nhanh và không tốn lượt AI).
    9. GIỚI HẠN AN TOÀN: Từ chối nhẹ nhàng các yêu cầu nội dung nhạy cảm, không phù hợp học đường; hướng dẫn liên hệ Admin qua nút "Góp ý ý kiến" ở cuối trang nếu cần trợ giúp kỹ thuật.
    `;

    const MODEL_QUEUE = [
        { id: "gemma-4-31b-it", name: "Gemma 4 31B" },
        { id: "gemma-4-26b-a4b-it", name: "Gemma 4 26B" },
        { id: "minimax-m3", name: "MiniMax M3" },
        { id: "glm-5.2", name: "GLM 5.2" },
        { id: "nemotron-3-ultra", name: "Nemotron 3 Ultra" },
        { id: "nemotron-3-super", name: "Nemotron 3 Super" },
        { id: "nemotron-3-nano", name: "Nemotron 3 Nano" },
        { id: "openrouter-free", name: "Auto Router" }
    ];

    // ==================== CHỌN CHẾ ĐỘ ====================
    let currentMode = "chat";

    function getModeFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const m = params.get("mode");
        return m === "tut" ? "tut" : "chat";
    }

    function setMode(mode) {
        currentMode = mode;
        document.getElementById("panel-chat").style.display = mode === "chat" ? "flex" : "none";
        document.getElementById("panel-tut").style.display = mode === "tut" ? "flex" : "none";
        document.querySelectorAll(".mode-tab").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.mode === mode);
        });
        if (mode === "tut") {
            setTimeout(() => {
                const inp = document.getElementById("wordInput");
                if (inp) inp.focus();
            }, 60);
        }
    }

    // ==================== CHAT ====================
    function getCurrentTimeFormatted() {
        const now = new Date();
        let hours = now.getHours();
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12; 
        return `${hours}:${minutes} ${ampm}`;
    }

    document.getElementById('welcome-time').innerText = getCurrentTimeFormatted();

    // ℹ️ HÀM ĐIỀU KHIỂN POPUP THÔNG TIN (MODAL)
    function openInfoModal() {
        document.getElementById('infoModal').style.display = 'flex';
    }

    function closeInfoModal() {
        document.getElementById('infoModal').style.display = 'none';
    }

    function closeInfoModalOutside(event) {
        if (event.target.id === 'infoModal') {
            closeInfoModal();
        }
    }

    // 📋 HÀM SAO CHÉP NỘI DUNG (COPY)
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            const statusEl = document.getElementById('status');
            const originalStatus = statusEl.innerText;
            statusEl.innerText = "✓ Đã copy nội dung tin nhắn!";
            setTimeout(() => { statusEl.innerText = originalStatus; }, 2000);
        }).catch(err => {
            lhToast('Lỗi! Không thể copy văn bản.', 'error');
        });
    }

    function escapeHtmlText(str) {
        return String(str ?? "").replace(/[&<>"']/g, (c) => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        }[c]));
    }

    function formatMarkdown(text) {
        let html = escapeHtmlText(text);
        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
        return html.split('\n').map(line => line.trim() ? `<p>${line}</p>` : '<br>').join('');
    }

    function autoResizeTextarea(textarea) {
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
    }

    // 📸 XỬ LÝ CHỌN FILE QUA NÚT GHIM GIẤY
    function handleFileSelect(event) {
        const file = event.target.files[0];
        processFile(file);
    }

    // 📋 XỬ LÝ PASTE ẢNH TRỰC TIẾP (CTRL + V) VÀO Ô TEXTAREA
    document.getElementById('userInput').addEventListener('paste', function(e) {
        const items = (e.clipboardData || e.originalEvent.clipboardData).items;
        for (let i = 0; i < items.length; i++) {
            if (items[i].type.indexOf('image') !== -1) {
                const file = items[i].getAsFile();
                processFile(file);
                e.preventDefault(); 
                break;
            }
        }
    });

    // HÀM CHUNG ĐỂ XỬ LÝ ĐỌC FILE ẢNH
    function processFile(file) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
            lhToast('Hubie hiện tại chỉ hỗ trợ nhận diện các định dạng hình ảnh thôi nè!', 'warning');
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            const base64Data = e.target.result.split(',')[1];
            selectedFileData = {
                mimeType: file.type,
                data: base64Data,
                dataUrl: e.target.result
            };
            
            document.getElementById('previewImg').src = e.target.result;
            document.getElementById('previewContainer').style.display = 'flex';
        };
        reader.readAsDataURL(file);
    }

    function clearSelectedFile() {
        selectedFileData = null;
        document.getElementById('fileInput').value = '';
        document.getElementById('previewContainer').style.display = 'none';
        document.getElementById('previewImg').src = '';
    }

    function renderSavedChat() {
        const savedHTML = localStorage.getItem("hubie_chat_html");
        if (savedHTML) {
            document.getElementById('chatBox').innerHTML = savedHTML;
            scrollToBottom();
        }
    }

    function saveChatToLocal() {
        // [FIX BUG #15] Trim chatHistory nếu quá lớn để tránh localStorage quota
        if (chatHistory.length > 40) {
            chatHistory = chatHistory.slice(chatHistory.length - 40);
        }
        try {
            localStorage.setItem("hubie_chat_history", JSON.stringify(chatHistory));
        } catch (e) {}
        try {
            localStorage.setItem("hubie_chat_html", document.getElementById('chatBox').innerHTML);
        } catch (e) {}
    }

    window.addEventListener("beforeunload", () => {
        localStorage.removeItem("hubie_chat_history");
        localStorage.removeItem("hubie_chat_html");
    });

    async function fetchWithBackup(requestBody, modelIndex = 0, errorLog = []) {
        if (modelIndex >= MODEL_QUEUE.length) {
            const detail = errorLog
                .map((e, i) => `${MODEL_QUEUE[i] ? MODEL_QUEUE[i].name : '?'} [${e.code || 'ERR'}]: ${e.message}`)
                .join(' | ');
            throw new Error(`Tất cả các model dự phòng đều đã hết lượt dùng trong ngày! (${detail})`);
        }
        const currentModel = MODEL_QUEUE[modelIndex];
        const statusEl = document.getElementById('status');
        statusEl.innerText = `Hubie đang kết nối với ${currentModel.name}...`;

        try {
            const response = await fetch(WORKER_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    model: currentModel.id,
                    requestBody: requestBody
                })
            });
            const data = await response.json();
            // Tự đổi model dự phòng khi gặp các lỗi: hết lượt (429), model không tồn tại (404),
            // bị chặn (403), hoặc lỗi máy chủ (5xx)
            const retriableCodes = [429, 404, 403, 500, 502, 503];
            if (data.error && retriableCodes.includes(data.error.code)) {
                errorLog.push({ code: data.error.code, message: data.error.message });
                return await fetchWithBackup(requestBody, modelIndex + 1, errorLog);
            }
            if (data.error) {
                if (typeof data.error === 'string') throw new Error(`[${currentModel.id}] HTTP ${response.status}: ${data.error}`);
                throw new Error(`[${currentModel.id}] ${data.error.status || data.error.code || response.status}: ${data.error.message}`);
            }
            return { data: data, activeModelName: currentModel.name };
        } catch (err) {
            if (err.message && err.message.startsWith('[')) throw err;
            errorLog.push({ code: 'NET', message: err.message || 'Lỗi mạng' });
            return await fetchWithBackup(requestBody, modelIndex + 1, errorLog);
        }
    }

    async function sendMessage() {
        const inputEl = document.getElementById('userInput');
        const text = inputEl.value.trim();

        if (!text && !selectedFileData) return;

        let currentMessageParts = [];
        let displayImgUrl = null;

        if (selectedFileData) {
            currentMessageParts.push({
                inlineData: {
                    mimeType: selectedFileData.mimeType,
                    data: selectedFileData.data
                }
            });
            displayImgUrl = selectedFileData.dataUrl;
        }

        if (text) {
            currentMessageParts.push({ text: text });
        } else if (selectedFileData) {
            currentMessageParts.push({ text: "Hãy phân tích hình ảnh này giúp mình nhé!" });
        }

        appendUserMessage(text, displayImgUrl);
        
        inputEl.value = '';
        inputEl.style.height = 'auto';
        clearSelectedFile();

        chatHistory.push({ role: "user", parts: currentMessageParts });
        saveChatToLocal();

        await requestAiResponse();
    }

    // 🔄 TÁCH BIỆT HÀM GỌI API ĐỂ SỬ DỤNG CHO CẢ SEND VÀ REGENERATE
    async function requestAiResponse(opts) {
        // [FIX BUG #8] Chỉ rollback tin nhắn người dùng khi đây là lượt GỬI MỚI.
        // Với regenerate, tin người dùng đã nằm sẵn trong lịch sử nên không được xoá.
        const rollbackUserOnError = !(opts && opts.rollbackUserOnError === false);
        const statusEl = document.getElementById('status');
        const requestBody = {
            contents: chatHistory,
            systemInstruction: { parts: [{ text: systemInstructionText }] },
            generationConfig: { temperature: 0.7, maxOutputTokens: 3000 }
        };

        const typingIndicator = showTypingIndicator();
        scrollToBottom();

        try {
            const result = await fetchWithBackup(requestBody, 0);
            const data = result.data;
            const activeModelName = result.activeModelName;
            
            removeTypingIndicator(typingIndicator);

            if (data.candidates && data.candidates[0].content && data.candidates[0].content.parts) {
                const responseText = data.candidates[0].content.parts[0].text;
                chatHistory.push({ role: "model", parts: [{ text: responseText }] });

                appendAiMessage(responseText);
                statusEl.innerText = `Hubie đã trả lời - ${activeModelName}`;
                saveChatToLocal();
                scrollToBottom();
                return true;
            } else {
                throw new Error("Phản hồi trống hoặc sai cấu trúc.");
            }
        } catch (error) {
            removeTypingIndicator(typingIndicator);
            console.error(`[Hubie] API Error:`, error);
            const errMsg = String(error.message || "");
            const codeMatch = errMsg.match(/\b(HTTP )?(\d{3})\b/) || errMsg.match(/\[(\d{3})\]/);
            const errCode = codeMatch ? codeMatch[2] || codeMatch[1] : "AI_FAIL";
            if (window.logAppError) {
                window.logAppError({
                    source: "chat",
                    category: "ai",
                    level: "error",
                    code: errCode,
                    message: errMsg.slice(0, 500),
                    detail: { models: MODEL_QUEUE.map(m => m.name), activeTab: currentMode }
                });
            }
            appendErrorMessage(`⚠️ Hubie bảo trì: ${errMsg}`);
            statusEl.innerText = "Gặp sự cố lỗi hệ thống";
            // [FIX BUG #8] Chỉ xoá tin người dùng khi là lượt gửi mới (không phải regenerate)
            if (rollbackUserOnError) {
                if (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === "user") {
                    chatHistory.pop();
                }
                const chatBox = document.getElementById('chatBox');
                const userWrappers = chatBox.getElementsByClassName('user-wrapper');
                if (userWrappers.length > 0) {
                    chatBox.removeChild(userWrappers[userWrappers.length - 1]);
                }
                saveChatToLocal();
            }
            scrollToBottom();
            return false;
        }
    }

    // 🔄 HÀM TẠO LẠI CÂU TRẢ LỜI CỦA AI (REGENERATE)
    // [FIX BUG #8] Nếu tạo lại thất bại, khôi phục câu trả lời cũ để không mất dữ liệu.
    async function regenerateAiResponse() {
        if (chatHistory.length > 0 && chatHistory[chatHistory.length - 1].role === "model") {
            const removedModel = chatHistory.pop();
            const chatBox = document.getElementById('chatBox');
            const aiWrappers = chatBox.getElementsByClassName('ai-wrapper');
            let removedWrapper = null;
            if (aiWrappers.length > 0) {
                removedWrapper = aiWrappers[aiWrappers.length - 1];
                chatBox.removeChild(removedWrapper);
            }
            saveChatToLocal();
            const ok = await requestAiResponse({ rollbackUserOnError: false });
            if (ok === false && removedModel) {
                // Khôi phục lại câu trả lời cũ (dữ liệu + DOM)
                chatHistory.push(removedModel);
                if (removedWrapper) {
                    try { chatBox.appendChild(removedWrapper); } catch (e) {}
                }
                saveChatToLocal();
                scrollToBottom();
            }
        }
    }

    function handleKeyDown(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    }

    function scrollToBottom() {
        const chatBox = document.getElementById('chatBox');
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function appendUserMessage(text, imageUrl) {
        const chatBox = document.getElementById('chatBox');
        const wrapper = document.createElement('div');
        wrapper.className = 'message-wrapper user-wrapper';
        
        const msgDiv = document.createElement('div');
        msgDiv.className = 'message user-msg';
        
        if (imageUrl) {
            const imgEl = document.createElement('img');
            imgEl.src = imageUrl;
            imgEl.className = 'chat-img';
            msgDiv.appendChild(imgEl);
        }
        
        if (text) {
            const textEl = document.createElement('span');
            textEl.innerText = text;
            msgDiv.appendChild(textEl);
        } else if (imageUrl) {
            const textEl = document.createElement('span');
            textEl.style.fontSize = '12px';
            textEl.style.opacity = '0.8';
            textEl.innerHTML = '<i class="fa-solid fa-image" style="font-size:13px"></i> Đã gửi một hình ảnh';
            msgDiv.appendChild(textEl);
        }
        
        const timeDiv = document.createElement('div');
        timeDiv.className = 'msg-time';
        timeDiv.innerText = getCurrentTimeFormatted();
        
        wrapper.appendChild(msgDiv);
        wrapper.appendChild(timeDiv);
        chatBox.appendChild(wrapper);
    }

    function appendAiMessage(text) {
        const chatBox = document.getElementById('chatBox');
        const wrapper = document.createElement('div');
        wrapper.className = 'message-wrapper ai-wrapper';
        
        const contentGroup = document.createElement('div');
        contentGroup.className = 'ai-content-group';
        
        const avatar = document.createElement('img');
        avatar.className = 'msg-avatar';
        avatar.src = '../../assets/images/chatboiavt.png';
        avatar.onerror = function() { this.src = 'https://via.placeholder.com/26'; };
        
        const msgDiv = document.createElement('div');
        msgDiv.className = 'message ai-msg';
        msgDiv.innerHTML = formatMarkdown(text);
        
        contentGroup.appendChild(avatar);
        contentGroup.appendChild(msgDiv);
        
        const timeDiv = document.createElement('div');
        timeDiv.className = 'msg-time';
        timeDiv.style.paddingLeft = '34px'; 
        timeDiv.innerText = getCurrentTimeFormatted();
        
        // 🛠️ TỰ ĐỘNG KHỞI TẠO CỤM PHÍM TẮT DƯỚI GÓC PHẢI TIN NHẮN
        const toolsDiv = document.createElement('div');
        toolsDiv.className = 'ai-tools';
        
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'tool-btn';
        copyBtn.title = 'Sao chép câu trả lời';
        copyBtn.innerHTML = '<i class="fa-solid fa-copy"></i>';
        copyBtn.addEventListener('click', () => copyToClipboard(text));
        
        const regenBtn = document.createElement('button');
        regenBtn.type = 'button';
        regenBtn.className = 'tool-btn';
        regenBtn.title = 'Yêu cầu Hubie trả lời lại câu này';
        regenBtn.innerHTML = '<i class="fa-solid fa-rotate"></i>';
        regenBtn.addEventListener('click', () => regenerateAiResponse());
        
        toolsDiv.appendChild(copyBtn);
        toolsDiv.appendChild(regenBtn);
        
        wrapper.appendChild(contentGroup);
        wrapper.appendChild(timeDiv);
        wrapper.appendChild(toolsDiv);
        chatBox.appendChild(wrapper);
    }

    function showTypingIndicator() {
        const chatBox = document.getElementById('chatBox');
        const wrapper = document.createElement('div');
        wrapper.className = 'message-wrapper ai-wrapper';
        
        const contentGroup = document.createElement('div');
        contentGroup.className = 'ai-content-group';
        
        const avatar = document.createElement('img');
        avatar.className = 'msg-avatar';
        avatar.src = '../../assets/images/chatboiavt.png';
        
        const bubble = document.createElement('div');
        bubble.className = 'typing-bubble';
        bubble.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
        
        contentGroup.appendChild(avatar);
        contentGroup.appendChild(bubble);
        wrapper.appendChild(contentGroup);
        chatBox.appendChild(wrapper);
        return wrapper;
    }

    function removeTypingIndicator(el) {
        if (el && el.parentNode) el.parentNode.removeChild(el);
    }

    function appendErrorMessage(text) {
        const chatBox = document.getElementById('chatBox');
        const msgDiv = document.createElement('div');
        msgDiv.className = 'message error-msg';
        msgDiv.innerText = text;
        chatBox.appendChild(msgDiv);
    }

    // ==================== TRA TỪ ====================
    let currentAudioUrl = "";

    async function lookupWord() {
        const raw = document.getElementById("wordInput").value.trim();
        if (!raw) return;

        const btn = document.getElementById("searchBtn");
        const stateMsg = document.getElementById("stateMsg");
        const resultBox = document.getElementById("resultBox");

        btn.disabled = true;
        resultBox.style.display = "none";
        stateMsg.style.display = "block";
        stateMsg.className = "state-msg";
        stateMsg.innerText = "Đang tra \"" + raw + "\"...";

        try {
            const word = raw.toLowerCase();

            // 1) Tra tiếng Anh
            const dictRes = await fetch("https://api.dictionaryapi.dev/api/v2/entries/en/" + encodeURIComponent(word));
            if (!dictRes.ok) {
                throw new Error("NOT_FOUND");
            }
            const dictData = await dictRes.json();
            const entry = dictData[0];

            // Lấy phiên âm + audio đầu tiên có sẵn
            let phonetic = entry.phonetic || "";
            let audioUrl = "";
            (entry.phonetics || []).forEach(p => {
                if (!phonetic && p.text) phonetic = p.text;
                if (!audioUrl && p.audio) audioUrl = p.audio;
            });
            if (audioUrl && audioUrl.startsWith("//")) audioUrl = "https:" + audioUrl;
            currentAudioUrl = audioUrl;

            // Lấy tất cả từ loại (part of speech) mà từ này có, mỗi cái 1 definition đầu tiên
            const meanings = entry.meanings || [];

            // 2) Dịch từ đơn (nghĩa nhanh của cả từ) + dịch song song từng definition sang tiếng Việt
            const wordViPromise = translateToVi(word).catch(() => "");

            const meaningsData = await Promise.all(meanings.map(async (m) => {
                const def = (m.definitions && m.definitions[0]) ? m.definitions[0] : null;
                const enText = def ? def.definition : "";
                const example = def ? def.example : "";
                let viText = "";
                if (enText) {
                    try {
                        viText = await translateToVi(enText);
                    } catch (e) {
                        viText = "(Không dịch được lúc này)";
                    }
                }
                return { pos: m.partOfSpeech, en: enText, vi: viText, example };
            }));

            const wordVi = await wordViPromise;

            renderResult(entry.word, phonetic, wordVi, meaningsData);
            stateMsg.style.display = "none";
            resultBox.style.display = "block";

        } catch (err) {
            console.error("Lỗi tra từ:", err);
            stateMsg.className = "state-msg error";
            if (err.message === "NOT_FOUND") {
                stateMsg.innerText = "Không tìm thấy từ \"" + raw + "\" trong từ điển.";
            } else {
                stateMsg.innerText = "Có lỗi xảy ra, thử lại sau.";
            }
            resultBox.style.display = "none";
        } finally {
            btn.disabled = false;
        }
    }

    async function translateToVi(text) {
        const res = await fetch(DEEPL_PROXY_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ text: text, target_lang: "VI", source_lang: "EN" })
        });
        if (!res.ok) throw new Error("Lỗi dịch");
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        return data.translatedText || "";
    }

    function shortGloss(viFull) {
        if (!viFull) return "";
        let seg = viFull.split(/[;,.]/)[0].trim();
        seg = seg.replace(/^(Để|Đã|Là|Một|Sẽ|Đang)\s+/i, "").trim();
        return seg;
    }

    function posAbbrev(pos) {
        const map = {
            "noun": "n",
            "verb": "v",
            "adjective": "adj",
            "adverb": "adv",
            "pronoun": "pron",
            "preposition": "prep",
            "conjunction": "conj",
            "interjection": "interj",
            "exclamation": "interj",
            "determiner": "det",
            "article": "art",
            "number": "num"
        };
        const key = (pos || "").toLowerCase().trim();
        return map[key] || key;
    }

    function renderResult(word, phonetic, wordVi, meaningsData) {
        // innerText không parse HTML nên KHÔNG cần escape ở đây
        document.getElementById("rWord").innerText = word;
        // [FIX BUG #34] Helper escape chỉ dùng cho các chỗ gán innerHTML bên dưới (từ điển)
        const esc = (s)=> (s||"").replace(/[<>&"']/g,c=>({"<":"&lt;","&gt":"&gt;","&":"&amp;","\"":"&quot;","'":"&#039;"})[c]);
        document.getElementById("rPhonetic").innerText = phonetic ? "/" + phonetic.replace(/\//g, "") + "/" : "";
        document.getElementById("rAudioBtn").disabled = !currentAudioUrl;
        const firstAbbrev = (meaningsData && meaningsData.length > 0) ? posAbbrev(meaningsData[0].pos) : "";
        document.getElementById("rWordVi").innerText = wordVi ? "→ " + (firstAbbrev ? "(" + firstAbbrev + ") " : "") + wordVi : "";

        const list = document.getElementById("rMeaningsList");
        list.innerHTML = "";

        meaningsData.forEach(m => {
            if (!m.en) return;
            const posTag = document.createElement("div");
            // [FIX BUG #34] Escape dữ liệu từ API từ điển để tránh chèn HTML
            posTag.innerHTML = '<span class="pos-tag">' + esc(m.pos) + '</span> <span class="pos-gloss">— ' + esc(shortGloss(m.vi) || "?") + '</span>';
            list.appendChild(posTag);

            const block = document.createElement("div");
            block.className = "meaning-block";

            const enLabel = document.createElement("div");
            enLabel.className = "meaning-label";
            enLabel.innerText = "Tiếng Anh";
            const enText = document.createElement("div");
            enText.className = "meaning-text en";
            enText.innerText = m.en;

            const viLabel = document.createElement("div");
            viLabel.className = "meaning-label";
            viLabel.style.marginTop = "8px";
            viLabel.innerText = "Tiếng Việt";
            const viText = document.createElement("div");
            viText.className = "meaning-text vi";
            const abbrev = posAbbrev(m.pos);
            viText.innerText = (abbrev ? "(" + abbrev + ") " : "") + (m.vi || "(chưa có bản dịch)");

            block.appendChild(enLabel);
            block.appendChild(enText);
            block.appendChild(viLabel);
            block.appendChild(viText);

            if (m.example) {
                const ex = document.createElement("div");
                ex.className = "example";
                // innerText an toàn (không parse HTML)
                ex.innerText = "VD: " + m.example;
                block.appendChild(ex);
            }

            list.appendChild(block);
        });
    }

    function playAudio() {
        if (!currentAudioUrl) return;
        // [FIX BUG #36] Bắt lỗi promise khi phát audio (trước đây lỗi bị nuốt âm thầm)
        try {
            const p = new Audio(currentAudioUrl).play();
            if (p && typeof p.catch === "function") p.catch(function (e) { console.warn("Không phát được audio:", e && e.message); });
        } catch (e) {
            console.warn("Không phát được audio:", e && e.message);
        }
    }

    setMode(getModeFromUrl());
    renderSavedChat();
</script>

<script type="module">
import { logAppError } from "../../scripts/core/supabase-config.js";
window.logAppError = logAppError;
</script>

</body>
</html>
