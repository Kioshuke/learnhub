<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LearnHub Flashcard</title>
  <link rel="icon" href="../../assets/images/favicon.png" sizes="any">

  <link rel="stylesheet" href="../../styles/global.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

  <style>
    :root {
      --primary: #2563eb;
      --glass: rgba(255, 255, 255, 0.82);
      --line: rgba(148, 163, 184, 0.35);
      --text-main: #0f172a;
      --text-sub: #475569;
      --chip: rgba(37, 99, 235, 0.12);
    }

    * {
      box-sizing: border-box;
    }

    body {
      --hub-hover-x: 50%;
      --hub-hover-y: 24%;
      --hub-hover-glow: rgba(37, 99, 235, 0);
      --hub-hover-opacity: 0;
      margin: 0;
      font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      color: var(--text-main);
      min-height: 100vh;
      background:
        radial-gradient(circle at 12% 8%, rgba(236, 72, 153, 0.12), transparent 28%),
        radial-gradient(circle at 88% 16%, rgba(37, 99, 235, 0.14), transparent 30%),
        radial-gradient(circle at 72% 86%, rgba(245, 158, 11, 0.1), transparent 32%),
        linear-gradient(135deg, #f8fbff 0%, #fff7fb 44%, #f8fffb 100%);
      background-attachment: fixed;
      position: relative;
      overflow-x: hidden;
      isolation: isolate;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
      background-size: 34px 34px;
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), transparent 78%);
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: var(--hub-hover-opacity);
      background:
        radial-gradient(circle at var(--hub-hover-x) var(--hub-hover-y), var(--hub-hover-glow), transparent 34%),
        linear-gradient(135deg, var(--hub-hover-glow), transparent 56%);
      transition: opacity 0.25s ease, background 0.25s ease;
    }

    .wrap {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 18px 40px;
    }

    .hero {
      text-align: center;
      margin-bottom: 22px;
    }

    .hero h1 {
      margin: 0 0 10px;
      font-size: clamp(28px, 4vw, 46px);
      letter-spacing: 0.3px;
      color: var(--primary);
    }

    .hero p {
      margin: 0 auto;
      max-width: 760px;
      color: var(--text-sub);
      line-height: 1.6;
    }

    .toolbar {
      display: flex;
      justify-content: center;
      margin-top: 18px;
      margin-bottom: 8px;
      position: relative;
    }

    .filter {
      width: min(360px, 100%);
      position: relative;
    }

    .filter-btn {
      width: 100%;
      border: 1px solid #cbd5e1;
      background: rgba(255, 255, 255, 0.98);
      color: #0f172a;
      border-radius: 14px;
      padding: 11px 14px;
      font-size: 15px;
      font-weight: 700;
