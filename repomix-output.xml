<script>
  // FAQ Accordion functionality
  document.querySelectorAll('.faq-question').forEach(question => {
    question.addEventListener('click', () => {
      const faqItem = question.parentElement;
      const isActive = faqItem.classList.contains('active');

      // Close all other FAQ items
      document.querySelectorAll('.faq-item').forEach(item => {
        item.classList.remove('active');
      });

      // Toggle current item
      if (!isActive) {
        faqItem.classList.add('active');
      }
    });
  });

  // FAQ Search
  function filterFAQ() {
    const query = document.getElementById('faqSearchInput').value.trim().toLowerCase();
    const clearBtn = document.getElementById('faqSearchClear');
    const noResults = document.getElementById('faqNoResults');
    const quickHelp = document.getElementById('quickHelp');
    const categories = document.querySelectorAll('.faq-category');

    clearBtn.classList.toggle('show', query.length > 0);

    if (!query) {
      categories.forEach(c => { c.style.display = ''; c.querySelectorAll('.faq-item').forEach(i => i.style.display = ''); });
      noResults.style.display = 'none';
      quickHelp.style.display = '';
      return;
    }

    quickHelp.style.display = 'none';
    let totalVisible = 0;

    categories.forEach(cat => {
      const items = cat.querySelectorAll('.faq-item');
      let catVisible = 0;
      items.forEach(item => {
        const q = item.querySelector('.faq-question')?.textContent.toLowerCase() || '';
        const a = item.querySelector('.faq-answer')?.textContent.toLowerCase() || '';
        const match = q.includes(query) || a.includes(query);
        item.style.display = match ? '' : 'none';
        if (match) catVisible++;
      });
      cat.style.display = catVisible > 0 ? '' : 'none';
      totalVisible += catVisible;
    });

    noResults.style.display = totalVisible === 0 ? '' : 'none';
  }

  // Feedback Modal Functions
  function openFeedbackModal() {
    const overlay = document.getElementById('lh-feedback-overlay');
    if (overlay) {
      overlay.classList.add('active');
      // Lưu vị trí cuộn trước khi khóa (.no-scroll dùng position:fixed
      // nên nếu không lưu thì trang sẽ bị nhảy về đầu trang)
      const lockY = window.scrollY || document.documentElement.scrollTop || 0;
      document.body.dataset.scrollLockY = String(lockY);
      document.body.style.top = (-lockY) + 'px';
      document.body.classList.add('no-scroll');
    }
  }

  function closeFeedbackModal() {
    const overlay = document.getElementById('lh-feedback-overlay');
    if (overlay) {
      overlay.classList.remove('active');
      // Khôi phục đúng vị trí cuộn trước khi khóa
      const lockY = parseInt(document.body.dataset.scrollLockY || '0', 10);
      document.body.classList.remove('no-scroll');
      document.body.style.top = '';
      delete document.body.dataset.scrollLockY;
      window.scrollTo(0, lockY);
    }
  }

  function closeFeedbackModalByOverlay(event) {
    if (event.target.id === 'lh-feedback-overlay') {
      closeFeedbackModal();
    }
  }

  // Close modal on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeFeedbackModal();
    }
  });
</script>

<!-- Scroll Spy -->
<script>
(function(){
  const links = document.querySelectorAll('.toc-link');
  const sections = document.querySelectorAll('.faq-category');
  function activateMenu(){
    let current = '';
    sections.forEach(s => {
      const rect = s.getBoundingClientRect();
      if (rect.top <= 160) current = s.getAttribute('id');
    });
    if (window.scrollY < 100) current = sections[0].getAttribute('id');
    links.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === '#' + current) link.classList.add('active');
    });
  }
  window.addEventListener('scroll', activateMenu, {passive: true});
  activateMenu();
})();
</script>

<!-- Hamburger Toggle (Mobile) -->
<script>
(function(){
  const hamburger = document.getElementById('tocHamburger');
  const sidebar = document.querySelector('.toc-sidebar');
  const overlay = document.getElementById('tocOverlay');
  if(!hamburger||!sidebar||!overlay) return;
  function openMenu(){ sidebar.classList.add('open'); overlay.classList.add('show'); hamburger.style.display='none'; }
  function closeMenu(){ sidebar.classList.remove('open'); overlay.classList.remove('show'); hamburger.style.display=''; }
  hamburger.addEventListener('click', function(){ sidebar.classList.contains('open') ? closeMenu() : openMenu(); });
  overlay.addEventListener('click', closeMenu);
  sidebar.querySelectorAll('.toc-link').forEach(function(link){ link.addEventListener('click', function(){ closeMenu(); }); });
})();
</script>


<script>
(function(){
  var bar=document.getElementById('readProgress');
  if(!bar)return;
  var tick=false;
  function upd(){
    tick=false;
    var h=document.documentElement;
    var max=h.scrollHeight-h.clientHeight;
    var y=h.scrollTop||document.body.scrollTop||0;
    bar.style.width=(max>0?(y/max)*100:0)+'%';
  }
  function onScroll(){if(!tick){tick=true;requestAnimationFrame(upd);}}
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll,{passive:true});
  upd();
})();
</script>
