<!-- loginBox đã được tách sang login.html -->


<div id="lh-header-placeholder" data-active="home"></div>
<script>
fetch('components/header.html').then(r=>r.text()).then(html=>{
  document.getElementById('lh-header-placeholder').innerHTML = html;
  // Nếu trang đang ở guest mode (chưa đăng nhập) -> áp lại UI "Chưa đăng nhập"
  if(window.__lhGuest && typeof window.enterGuestMode === 'function') window.enterGuestMode();
  const active = document.getElementById('lh-header-placeholder').dataset.active;
  const map = {'home':'/index.html','flash':'pages/flashcard/hub.html','forum':'pages/blog/forum.html','blog':'pages/blog/blog.html','tai-lieu':'pages/features/hubfile.html','phong-hoc':'pages/features/phong-hoc.html'};
  const reverseMap = {'/index.html':'home','pages/flashcard/hub.html':'flash','pages/blog/forum.html':'forum','pages/blog/blog.html':'blog','pages/features/hubfile.html':'tai-lieu','pages/features/phong-hoc.html':'phong-hoc'};
  document.querySelectorAll('.nav-link').forEach(a => {
    if(a.getAttribute('href') === map[active]) a.classList.add('active');
    a.addEventListener('click', function(e){
      var href = this.getAttribute('href');
      var tab = reverseMap[href];
      if(tab){
        e.preventDefault();
        if(typeof show === 'function') show(tab);
      }
    });
  });

  // ==================== NOTIFICATION BELL ====================
  (async function(){
    const bell = document.getElementById('notifBell');
    const badge = document.getElementById('notifBadge');
    const dropdown = document.getElementById('notifDropdown');
    const list = document.getElementById('notifList');
    if (!bell || !badge || !dropdown) return;

    const bellTypeColors = { info:"#2563eb", warning:"#d97706", error:"#ef4444", success:"#16a34a" };
    const bellTypeIcons = { info:"fa-solid fa-circle-info", warning:"fa-solid fa-triangle-exclamation", error:"fa-solid fa-circle-xmark", success:"fa-solid fa-circle-check" };

    function updateBadge(show, count) {
      if (!badge) return;
      if (show) {
        badge.style.display = "flex";
        badge.textContent = count || "";
        badge.style.animation = "none";
        void badge.offsetWidth;
        badge.style.animation = "";
        bell.classList.add("has-unread");
      } else {
        badge.style.display = "none";
        badge.textContent = "";
        bell.classList.remove("has-unread");
      }
    }

    function openNotifDetail(nd) {
      var overlay = document.getElementById("notifDetailOverlay");
      if (!overlay) {
        if (window.logAppError) window.logAppError({ source: "mailbox", category: "ui", level: "error", code: "OVERLAY_MISSING", message: "notifDetailOverlay element not found — popup khong mo duoc." });
        if (window.lhToast) window.lhToast("Không mở được thư. Vui lòng tải lại trang.", { type: "error", title: "Lỗi hộp thư" });
        return;
      }
      try {
        document.getElementById("notifDetailTitle").textContent = nd.title || "Hộp Thư";
        document.getElementById("notifDetailMsg").innerHTML = nd.message || "";
        document.getElementById("notifDetailIcon").src = "assets/images/newlogo.png";
        var dateStr = "";
        var dateVal = nd.created_at || nd.updated_at;
        if (dateVal) {
          var d = new Date(dateVal);
          dateStr = d.toLocaleDateString("vi-VN",{day:"2-digit",month:"2-digit",year:"numeric"}) + " " + d.toLocaleTimeString("vi-VN",{hour:"2-digit",minute:"2-digit"});
        }
        document.getElementById("notifDetailDate").textContent = dateStr;
        overlay.classList.remove("closing");
        overlay.classList.add("opening");
        dropdown.classList.remove("open");
      } catch(e) {
        if (window.logAppError) window.logAppError({ source: "mailbox", category: "ui", level: "error", code: "OPEN_FAIL", message: "Loi khi mo popup thu: " + (e.message || e), detail: { title: nd.title } });
        if (window.lhToast) window.lhToast("Lỗi hiển thị nội dung thư.", { type: "error", title: "Lỗi hộp thư" });
      }
    }

    window.closeNotifDetail = function() {
      var overlay = document.getElementById("notifDetailOverlay");
      if (!overlay) return;
      if (overlay.classList.contains("closing")) return;
      overlay.classList.remove("opening");
      overlay.classList.add("closing");
      overlay.addEventListener("animationend", function handler() {
        overlay.removeEventListener("animationend", handler);
        overlay.classList.remove("closing");
      });
    };

    window.openNotifDetail = openNotifDetail;

    var detailOverlay = document.getElementById("notifDetailOverlay");
    if (detailOverlay) {
      detailOverlay.addEventListener("click", function(e) {
        if (e.target === detailOverlay) window.closeNotifDetail();
      });
    }

    function timeAgo(date) {
      var diff = Math.floor((Date.now() - date.getTime()) / 1000);
      if (diff < 60) return "Vừa xong";
      if (diff < 3600) return Math.floor(diff / 60) + " phút trước";
      if (diff < 86400) return Math.floor(diff / 3600) + " giờ trước";
      return Math.floor(diff / 86400) + " ngày trước";
    }

    let unreadCount = 0;
    var firstMailboxLoad = true;
    var _mailboxUserEmail = "";

    function stripHtml(html) {
      var tmp = document.createElement("div");
      tmp.innerHTML = html || "";
      return tmp.textContent || tmp.innerText || "";
    }

    function getReadIds() {
      if (!_mailboxUserEmail) return [];
      try { return JSON.parse(localStorage.getItem("mailbox_read_" + _mailboxUserEmail) || "[]"); }
      catch(e) { return []; }
    }
    function markReadLocal(id) {
      if (!_mailboxUserEmail || !id) return;
      var ids = getReadIds();
      if (ids.indexOf(id) === -1) { ids.push(id); localStorage.setItem("mailbox_read_" + _mailboxUserEmail, JSON.stringify(ids)); }
    }

    function createWelcomeEl(createdAt) {
      var WELCOME_ID = "__welcome__";
      var readIds = getReadIds();
      var isRead = readIds.indexOf(WELCOME_ID) !== -1;
      var el = document.createElement("div");
      el.className = "notif-dd-item" + (isRead ? "" : " unread");
      el.setAttribute("data-id", WELCOME_ID);
      var welcomeDate = createdAt ? new Date(createdAt) : new Date();
      el.onclick = function() {
        var self = this;
        window.openNotifDetail({
          title: "Chào mừng bạn đến với LearnHub Platform!",
          message: "Chào bạn,<br><br>Chào mừng bạn đến với LearnHub Platform - Hệ sinh thái học tập trực tuyến dành cho học sinh và sinh viên.<br>Đây là hộp thư nơi bạn nhận được các thông báo quan trọng từ Ban Quản Trị như cập nhật tính năng mới, lịch thi, thông báo hệ thống và nhiều tin tức khác.<br><br>Hãy nhấn vào biểu tượng chuông ở header bất cứ lúc nào để kiểm tra hộp thư nhé!<br><br><p style=\"margin-top:24px\">Trân trọng,<br><strong>Đội ngũ phát triển!</strong></p>",
          created_at: welcomeDate.toISOString()
        });
        if (self.classList.contains("unread")) {
          self.classList.remove("unread");
          var icon = self.querySelector(".notif-dd-item-icon");
          if (icon) { icon.style.background = "#eff6ff"; icon.innerHTML = '<i class="fa-solid fa-envelope-open"></i>'; }
          markReadLocal(WELCOME_ID);
          unreadCount = Math.max(0, unreadCount - 1);
          updateBadge(unreadCount > 0, unreadCount);
        }
      };
      var dateStr = welcomeDate.toLocaleDateString("vi-VN",{day:"2-digit",month:"2-digit",year:"numeric"}) + " " + welcomeDate.toLocaleTimeString("vi-VN",{hour:"2-digit",minute:"2-digit"});
      var iconBg = isRead ? "#eff6ff" : "linear-gradient(135deg,#dbeafe,#bfdbfe)";
      var iconHtml = isRead ? "fa-envelope-open" : "fa-envelope";
      el.innerHTML = '<div class="notif-dd-item-icon" style="background:' + iconBg + ';color:#2563eb"><i class="fa-solid ' + iconHtml + '"></i></div>'
        + '<div class="notif-dd-item-body">'
        + '<div class="notif-dd-item-title">Thư Chào Mừng</div>'
        + '<div class="notif-dd-item-msg">Chào mừng bạn đến với LearnHub!</div>'
        + '<div class="notif-dd-item-time">' + dateStr + '</div>'
        + '</div>';
      return el;
    }

    async function loadMailbox() {
      try {
        if(window.__lhGuest) return; // khách chưa đăng nhập: không tải hộp thư
        var userCreatedAt = null;
        try {
          var sessResult = await window.supabaseClient.auth.getSession();
          if (sessResult.data && sessResult.data.session && sessResult.data.session.user) {
            userCreatedAt = sessResult.data.session.user.created_at;
            _mailboxUserEmail = sessResult.data.session.user.email || "";
          }
        } catch(e){}
        var readIds = getReadIds();
        const { data: messages, error } = await window.supabaseClient
          .from("mailbox_messages")
          .select("*")
          .order("created_at", { ascending: false })
          .limit(20);
        if (error) throw error;
        unreadCount = 0;
        list.innerHTML = "";
        if (messages && messages.length > 0) {
          messages.forEach(function(msg) {
            var isUnread = !msg.is_read && readIds.indexOf(msg.id) === -1;
            if (isUnread) unreadCount++;
            var item = document.createElement("div");
            item.className = "notif-dd-item" + (isUnread ? " unread" : "");
            item.setAttribute("data-id", msg.id);
            item.innerHTML = '<div class="notif-dd-item-icon" style="background:' + (isUnread ? 'linear-gradient(135deg,#dbeafe,#bfdbfe)' : '#eff6ff') + ';color:#2563eb"><i class="fa-solid fa-envelope' + (isUnread ? '' : '-open') + '"></i></div>'
              + '<div class="notif-dd-item-body">'
              + '<div class="notif-dd-item-title">' + window.escapeHtml(msg.title || "Thông báo") + '</div>'
              + '<div class="notif-dd-item-msg">' + stripHtml((msg.message || "").substring(0, 80)) + '</div>'
              + (msg.created_at ? '<div class="notif-dd-item-time">' + timeAgo(new Date(msg.created_at)) + '</div>' : '')
              + '</div>';
            item._nd = { title: msg.title, message: msg.message, created_at: msg.created_at, _id: msg.id };
            item.addEventListener("click", function() {
              var self = this;
              openNotifDetail(self._nd);
              if (self.classList.contains("unread")) {
                self.classList.remove("unread");
                var icon = self.querySelector(".notif-dd-item-icon");
                if (icon) { icon.style.background = "#eff6ff"; icon.innerHTML = '<i class="fa-solid fa-envelope-open"></i>'; }
                markReadLocal(self._nd._id);
                if (self._nd._id) {
                  window.supabaseClient.from("mailbox_messages").update({ is_read: true }).eq("id", self._nd._id).then(function() {
                    unreadCount = Math.max(0, unreadCount - 1);
                    updateBadge(unreadCount > 0, unreadCount);
                  });
                }
              }
            });
            list.appendChild(item);
          });
        }
        list.appendChild(createWelcomeEl(userCreatedAt));
        var welcomeEl = list.querySelector(".notif-dd-item[data-id='__welcome__']");
        if (welcomeEl && welcomeEl.classList.contains("unread")) unreadCount++;
        updateBadge(unreadCount > 0, unreadCount);
        firstMailboxLoad = false;
      } catch(e) {
        if (!firstMailboxLoad) {
          console.warn("Mailbox load error:", e);
          if (window.logAppError) window.logAppError({ source: "mailbox", category: "load", level: "warning", code: "LOAD_FAIL", message: "Khong tai duoc mailbox: " + (e.message || e) });
          if (window.lhToast) window.lhToast("Không tải được hộp thư. Đang hiển thị mặc định.", { type: "warning", title: "Hộp thư" });
        }
        if (list.children.length === 0) list.appendChild(createWelcomeEl());
        firstMailboxLoad = false;
      }
    }
    window.loadMailbox = loadMailbox;
    loadMailbox();

    bell.addEventListener("click", function(e) {
      e.stopPropagation();
      dropdown.classList.toggle("open");
    });

    document.addEventListener("click", function(e) {
      var bw = document.getElementById("notifBellWrap");
      var dd = document.getElementById("notifDropdown");
      if (!dd) return;
      if (bw && bw.contains(e.target)) return;
      dd.classList.remove("open");
    });

    window.clearNotifBadge = function() {
      var b = document.getElementById('notifBadge');
      if (b) { b.style.display = 'none'; b.textContent = ''; }
      var dd = document.getElementById('notifDropdown');
      if (dd) dd.classList.remove('open');
      unreadCount = 0;
      list.querySelectorAll(".notif-dd-item[data-id]").forEach(function(el) {
        var id = el.getAttribute("data-id");
        markReadLocal(id);
        if (el.classList.contains("unread")) {
          el.classList.remove("unread");
          var icon = el.querySelector(".notif-dd-item-icon");
          if (icon) { icon.style.background = "#eff6ff"; icon.innerHTML = '<i class="fa-solid fa-envelope-open"></i>'; }
        }
      });
      try {
        window.supabaseClient.from("mailbox_messages").update({ is_read: true }).eq("is_read", false).then(function(res) {
          setTimeout(function() {
            if (res.error) {
              if (window.logAppError) window.logAppError({ source: "mailbox", category: "action", level: "warning", code: "CLEAR_FAIL", message: "Danh dau da doc that bai: " + (res.error.message || res.error) });
              if (window.lhToast) window.lhToast("Không đánh dấu được đã đọc.", { type: "error", title: "Lỗi" });
            } else {
              if (window.lhToast) window.lhToast("Đã đánh dấu tất cả thư là đã đọc.", { type: "success", title: "Hộp thư" });
            }
          }, 100);
        });
      } catch(e) {
        if (window.logAppError) window.logAppError({ source: "mailbox", category: "action", level: "warning", code: "CLEAR_EXCEPTION", message: "Loi khi danh dau da doc: " + (e.message || e) });
        if (window.lhToast) window.lhToast("Không đánh dấu được đã đọc.", { type: "error", title: "Lỗi" });
      }
    };
  })();

});
</script>
