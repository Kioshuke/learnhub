      }
      if (type === "drive") {
        var isFolder = /folders\//.test(url);
        var gvIcon = isFolder ? "fa-folder" : (gvKind(c) === "document" ? "fa-file-lines" : "fa-file-video");
        return '<li class="grammar-sidebar-item" data-gv="drive" data-gv-url="' + escHtml(url) + '" onclick="switchSidebarGv(this)"><i class="fas ' + gvIcon + '"></i> ' + escHtml(title) + '</li>';
      }
      return '<li class="grammar-sidebar-item math-pending"><i class="fas fa-circle-question"></i> ' + escHtml(title) + '<span class="math-pending-tag">Không hỗ trợ</span></li>';
    }).join("");
    return (
      '<div class="gv-group">' +
        '<div class="gv-group-head">' +
          '<i class="fa-solid fa-chevron-right gv-group-caret"></i>' +
          '<i class="fa-solid fa-folder gv-group-folder"></i>' +
          '<span class="gv-group-title">' + escHtml(g) + '</span>' +
          '<span class="gv-group-count">' + gvCountText(items) + '</span>' +
        '</div>' +
        '<ul class="gv-group-body" style="display:none">' + itemsHtml + '</ul>' +
      '</div>'
    );
  }).join("");

  var listId = "gvSidebarList";
  document.getElementById("quiz").innerHTML =
    '<div class="video-box">' +
      '<div class="video-topbar">' +
        '<a id="gvDriveFolderOpenBtn" class="quiz-btn open-drive-btn" target="_blank" rel="noopener" style="display:none">' +
          '<i class="fas fa-folder-open"></i> Mở thư mục Drive' +
        '</a>' +
        '<button class="quiz-btn close-btn" onclick="closeQuiz();">Đóng video</button>' +
      '</div>' +
      '<div class="grammar-player-content">' +
        '<div class="video-frame">' + gvPlaceholderHtml() + '</div>' +
