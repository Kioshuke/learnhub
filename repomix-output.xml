    var mq = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mq && mq.addEventListener) mq.addEventListener("change", function (e) { applyReduced(e.matches); });
    window.addEventListener("message", function (e) {
        if (e.data && e.data.type === "REDUCED_MOTION") applyReduced(e.data.value === true);
    });
    applyReduced(mq ? mq.matches : false);
})();
