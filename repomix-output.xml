    var ai = -1, bi = -1, si = 0, i = 0;
    while (i < h.length && (ai < 0 || bi < 0)) {
      if (h[i] === "<") { var e = h.indexOf(">", i); i = e < 0 ? h.length : e + 1; continue; }
      if (si === a) ai = i;
      if (si === b) bi = i;
      si++; i++;
