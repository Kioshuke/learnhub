import { supabase, logAppError } from "../../scripts/core/supabase-config.js";
window.logAppError = logAppError;

/* ===== Thông báo môn học từ database (subject_notices) =====
   Nạp notice do giáo viên đặt rồi render lên từng môn.
   KHÔNG có dữ liệu DB / tải lỗi → môn không hiện thông báo (để trống). */
function applySubjectNotices(map) {
  window.__subjectNoticeMap = map || {};
  var subjects = window.PHONGHOC_SUBJECTS || [];
  subjects.forEach(function (s) {
    var n = (map && map[s.id]) || null;
    if (!n || typeof n !== "object" || n.enabled === false || !n.html) {
      s.notice = null;
      return;
    }
    s.notice = { icon: n.icon || "fa-bell", html: n.html };
  });
  if (typeof refreshNoticeBoxes === "function") refreshNoticeBoxes();
}

(async function loadSubjectNotices() {
  try {
    const { data, error } = await supabase.rpc("load_subject_notices");
    if (error) throw error;
    applySubjectNotices((data && data[0] && data[0].notices) || null);
  } catch (err) {
    /* Không tải được database → để trống, không hiện thông báo nào. */
    console.error("[phong-hoc] tải thông báo môn lỗi:", err);
    applySubjectNotices(null);
  }
})();

/* Cập nhật realtime: giáo viên sửa thông báo → phòng học đổi ngay nếu đang mở. */
// [FIX BUG #25] Giữ tham chiếu kênh và gỡ khi rời trang để tránh rò kênh realtime
// (trước đây mỗi lần vào lại tạo thêm kênh mới nhưng không bao giờ removeChannel).
var subjectNoticesChannel = null;
if (typeof supabase.channel === "function") {
  subjectNoticesChannel = supabase
    .channel("phong-hoc-notices")
    .on("postgres_changes", { event: "*", schema: "public", table: "subject_notices" }, function () {
      supabase.rpc("load_subject_notices").then(function ({ data, error }) {
        if (!error) applySubjectNotices((data && data[0] && data[0].notices) || null);
      });
    })
    .subscribe();
  var _removeSubjectNoticesChannel = function () {
    if (subjectNoticesChannel) {
      try { supabase.removeChannel(subjectNoticesChannel); } catch (e) {}
      subjectNoticesChannel = null;
    }
  };
  window.addEventListener("pagehide", _removeSubjectNoticesChannel);
  window.addEventListener("beforeunload", _removeSubjectNoticesChannel);
}

(async function initVideoGv() {
  try {
    const { data: subjects, error } = await supabase.rpc("list_video_subjects");
    if (error) throw error;
    const names = (subjects || []).map(function(r) { return r.subject; }).filter(Boolean);
    const map = {};
    async function loadOne(name) {
      const { data: cards, error: e2 } = await supabase.rpc("list_video_cards_by_subject", { p_subject: name });
      if (e2) throw e2;
      map[name] = (cards || []).filter(function(c) { return c && c.video_url; });
    }
    await Promise.all(names.map(loadOne));
    window.__gvData = map;
    if (typeof window.seedGvVideoTab === "function") window.seedGvVideoTab(map, names);
  } catch (err) {
    console.error("[phong-hoc] tải video giáo viên lỗi:", err);
    if (typeof logAppError === "function") {
      logAppError({ source: "phong-hoc-gv", category: "feature", level: "error", code: "GV_LOAD_FAIL", message: String((err && (err.message || err.error_description)) || err), url: location.href });
    }
    if (typeof window.seedGvVideoTab === "function") window.seedGvVideoTab(null, []);
  }
})();

(async function initTestCards() {
