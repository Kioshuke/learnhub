  <script src="shell.js"></script>
  <script src="../../scripts/core/toast.js"></script>

  <script type="module">
    import { supabase, getUserRow, escapeHtml, logAppError } from "../../scripts/core/supabase-config.js";

    // Liên kết menu shell: các trang con của khu vực Giáo viên.
    window.onTeacherNav = function(key) {
      if (key === "home") window.location.href = "./index.html";
      else if (key === "manage") window.location.href = "./index.html?view=manage";
      else if (key === "fc") window.location.href = "./newflashcard.html";
      else if (key === "video") window.location.href = "./cardphonghoc.html";
      else if (key === "docs") window.location.href = "./taileu.html";
      else if (key === "notice") window.location.href = "./index.html?view=notice";
      else if (key === "quiz") window.location.href = "./index.html?view=quiz";
      else if (key === "report") window.location.href = "./index.html?view=report";
    };

    if (window.TeacherShell && window.TeacherShell.setActive) TeacherShell.setActive("fc");

    const tcApp = document.getElementById("tcApp");
    const fcDenied = document.getElementById("fcDenied");
    const fcLoading = document.getElementById("fcLoading");

    function show(which) {
      if (tcApp) tcApp.style.display = which === "app" ? "" : "none";
      fcDenied.style.display = which === "denied" ? "" : "none";
      fcLoading.style.display = which === "loading" ? "" : "none";
    }

    function toast(msg, type) {
      if (window.lhToast) lhToast(msg, { type: type || "info" });
    }

    function normRole(role) {
      return String(role || "").trim().toLowerCase();
    }
    function isTeacherRole(role) {
      const r = normRole(role);
      return r === "giáo viên" || r === "giao vien";
    }
    function isAdminRole(role) {
      return normRole(role) === "admin";
    }

    async function guard() {
      show("loading");
      let session = null, row = null;
      try {
        const r = await supabase.auth.getSession();
        session = r.data?.session || null;
        if (session && session.user) row = await getUserRow(session.user.id);
      } catch (e) {
        console.error("guard lỗi:", e);
        show("denied"); return;
      }
      if (!session || !session.user) { show("denied"); return; }
      const role = row?.role || "";
      const isAdmin = isAdminRole(role);
      const isTeacher = isTeacherRole(role) || isAdmin;
      if (!isTeacher) { show("denied"); return; }

      const displayName = (row && (row.name || row.email)) || "Giáo viên";
      const badge = document.getElementById("tcUserBadge");
      const avatar = row && (row.photo || row.avatar_url || row.picture);
      const initials = displayName.split(" ").map(w => w[0]).join("").substring(0, 2).toUpperCase();
      let avatarHtml;
      if (avatar && !/^https?:\/\//i.test(avatar) && !/^data:image/i.test(avatar)) {
        avatarHtml = `<div class="tc-topbar-avatar">${initials}</div>`;
      } else if (avatar) {
        avatarHtml = `<img class="tc-topbar-avatar-img" src="${escapeHtml(avatar)}" alt="${escapeHtml(displayName)}">`;
      } else {
        avatarHtml = `<div class="tc-topbar-avatar">${initials}</div>`;
      }

      const label = isAdmin
        ? `<span class="tc-badge"><i class="fa-solid fa-shield-halved"></i> ${escapeHtml(row.email || "")} · Admin</span>`
        : `<span class="tc-topbar-name">${escapeHtml(row.name || row.email || "")}</span>`;

      if (badge) badge.innerHTML = `<div class="tc-topbar-user">${label}${avatarHtml}</div>`;
      show("app");
      await boot();
    }

    // ================= SOẠN FLASHCARD (lưu DB) =================
    let tcFcEditId = null;
    let tcFcListCache = null;   // null = chưa load, else mảng bộ từ
    let tcFcOpenByCat = new Map();   // nhóm (category) -> đang mở? giữ vị trí khi render lại
    let tcFcGroupsCache = {};   // name -> is_complete của nhóm

    function tcFcShowEditor(show) {
      const ed = document.getElementById("tcFcEditor");
      const listCard = document.getElementById("tcFcListCard");
      if (ed) ed.style.display = show ? "" : "none";
      if (listCard) listCard.style.display = show ? "none" : "";
      if (show) document.getElementById("tcFcText").focus();
    }

    function tcFcParseText(text) {
      return String(text || "")
        .split("\n")
        .map(line => line.trim())
        .filter(line => line && line.includes(" - "))
        .map(line => {
          const parts = line.split(" - ", 3);
          const front = (parts[0] || "").trim();
          const back = (parts[1] || "").trim();
          const example = (parts[2] || "").trim();
          if (!front || !back) return null;
          const card = { front, back };
          if (example) card.example = example;
          return card;
        })
        .filter(Boolean);
    }

    function tcFcUpdatePreview() {
      const cards = tcFcWithMeta(tcFcParseText(document.getElementById("tcFcText").value));
      const el = document.getElementById("tcFcPreview");
      if (el) el.innerHTML = `<i class="fa-solid fa-layer-group"></i> ${cards.length} thẻ`;
      const live = document.getElementById("tcFcLive");
      if (!live) return;
      if (!cards.length) {
        live.innerHTML = '<div class="fc-live-empty"><i class="fa-solid fa-wand-magic-sparkles"></i>Nhập thẻ vào khung bên trên, xem trước xuất hiện tại đây.</div>';
        return;
      }
      let shown = cards.slice(0, 4).map(c => `
        <div class="fc-live-card">
          <div class="fc-live-front">${escapeHtml(c.front)}</div>
          <div class="fc-live-arrow"><i class="fa-solid fa-arrow-right"></i></div>
          <div class="fc-live-back">${escapeHtml(c.back)}${c.example ? `<span class="fc-live-ex"><i class="fa-solid fa-quote-left"></i> ${escapeHtml(c.example)}</span>` : ""}${c.level ? `<span class="fc-preview-lvl">${escapeHtml(c.level)}</span>` : ""}</div>
        </div>
      `).join("");
      if (cards.length > 4) shown += `<div class="fc-live-more">+${cards.length - 4} thẻ nữa</div>`;
      live.innerHTML = shown;
      live.querySelectorAll(".fc-live-card").forEach((el, i) => {
        el.addEventListener("click", () => tcFcCardsOpen(i));
      });
    }

    // ================= SỬA TỪNG THẺ (popup) =================
    let fcCards = [];
    let fcCardEditIndex = -1;

    const FC_LEVELS = ["Dễ", "Trung bình", "Khó", "Nâng cao"];
    const fcMeta = new Map();

    function fcCardSig(c) {
      return String(c.front || "").trim() + "\u0001" + String(c.back || "").trim() + "\u0001" + String(c.example || "").trim();
    }

    function fcLevelClass(level) {
      return { "Dễ": "de", "Trung bình": "tb", "Khó": "kho", "Nâng cao": "cao" }[level] || "none";
    }

    function tcFcWithMeta(parsed) {
      return parsed.map(c => {
        const meta = fcMeta.get(fcCardSig(c));
        if (meta) {
          if (meta.description) c.description = meta.description;
          if (meta.level) c.level = meta.level;
        }
        return c;
      });
    }

    function fcRememberMeta(cards) {
      (cards || []).forEach(c => {
        fcMeta.set(fcCardSig(c), { description: c.description || "", level: c.level || "" });
      });
    }

    function tcFcSerializeCards(cards) {
      return cards.map(c =>
        String(c.front || "").trim() + " - " + String(c.back || "").trim() + (c.example ? " - " + String(c.example).trim() : "")
      ).join("\n");
    }

    function tcFcSyncFromCards() {
      document.getElementById("tcFcText").value = tcFcSerializeCards(fcCards);
      tcFcUpdatePreview();
    }

    window.tcFcCardsOpen = function(index) {
      fcCards = tcFcWithMeta(tcFcParseText(document.getElementById("tcFcText").value));
      fcCardEditIndex = index === null || index === undefined ? -1 : index;
      tcFcCardsRender();
      document.getElementById("fcCardEditor").classList.add("open");
      if (fcCardEditIndex >= 0) tcFcCardsEdit(fcCardEditIndex);
      document.getElementById("tcFcText").style.minHeight = "60px";
    };

    window.tcFcCardsClose = function() {
      document.getElementById("fcCardEditor").classList.remove("open");
      tcFcCardsCancel();
    };

    function tcFcCardsRender() {
      const listEl = document.getElementById("fcCardList");
      document.getElementById("fcCardCount").textContent = fcCards.length ? fcCards.length + " thẻ" : "chưa có thẻ";
      listEl.innerHTML = fcCards.length
        ? fcCards.map((c, i) => `
          <div class="fc-card-item">
            <i class="fa-solid fa-grip-vertical fc-drag-handle" draggable="true" data-i="${i}" title="Giữ và kéo để đổi thứ tự"></i>
            <span class="fc-card-item-front">${escapeHtml(c.front)}</span>
            <i class="fa-solid fa-arrow-right" style="color:#a78bfa;font-size:11px;flex:none"></i>
            <span class="fc-card-item-back">${escapeHtml(c.back)}</span>
            ${c.example ? `<span class="fc-card-item-ex"><i class="fa-solid fa-quote-left"></i> ${escapeHtml(c.example)}</span>` : ""}
            ${c.level ? `<span class="fc-lv-chip lv-${fcLevelClass(c.level)}">${escapeHtml(c.level)}</span>` : ""}
            ${c.description ? `<span class="fc-card-item-desc"><i class="fa-solid fa-pen-ruler"></i> ${escapeHtml(c.description)}</span>` : ""}
            <span class="fc-card-item-acts">
              <button type="button" class="fc-ed" data-i="${i}" title="Sửa thẻ"><i class="fa-solid fa-pen"></i></button>
              <button type="button" class="fc-del" data-i="${i}" title="Xoá thẻ"><i class="fa-solid fa-trash-can"></i></button>
            </span>
          </div>`).join("")
        : '<div class="fc-live-empty"><i class="fa-solid fa-file-circle-plus"></i>Chưa có thẻ nào. Bấm "Thêm thẻ mới" bên dưới.</div>';
      listEl.querySelectorAll(".fc-ed").forEach(b => b.addEventListener("click", () => tcFcCardsEdit(Number(b.dataset.i))));
      listEl.querySelectorAll(".fc-del").forEach(b => b.addEventListener("click", async () => {
        const i = Number(b.dataset.i);
        const ok = window.lhConfirm ? await lhConfirm("Xoá thẻ này?") : confirm("Xoá thẻ này?");
        if (!ok) return;
        fcCards.splice(i, 1);
        tcFcSyncFromCards();
        tcFcCardsRender();
      }));
      // Kéo thả đổi thứ tự thẻ: giữ nút grip rồi thả lên thẻ muốn đặt sau.
      let fcDragIdx = -1;
      listEl.querySelectorAll(".fc-drag-handle").forEach(g => {
        g.addEventListener("dragstart", (e) => {
          fcDragIdx = Number(g.dataset.i);
          g.closest(".fc-card-item").classList.add("dragging");
          try { e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", String(fcDragIdx)); } catch (err) {}
        });
        g.addEventListener("dragend", () => {
          listEl.querySelectorAll(".fc-card-item").forEach(x => x.classList.remove("dragging", "d-over"));
          fcDragIdx = -1;
        });
      });
      listEl.querySelectorAll(".fc-card-item").forEach(item => {
        item.addEventListener("dragover", (e) => { e.preventDefault(); if (!item.classList.contains("dragging")) item.classList.add("d-over"); });
        item.addEventListener("dragleave", () => item.classList.remove("d-over"));
        item.addEventListener("drop", (e) => {
          e.preventDefault();
          item.classList.remove("d-over");
          const to = Number(item.querySelector(".fc-drag-handle").dataset.i);
          if (fcDragIdx < 0 || fcDragIdx === to || !fcCards[fcDragIdx]) return;
          const [moved] = fcCards.splice(fcDragIdx, 1);
          const ins = fcDragIdx < to ? to : to + 1;
          fcCards.splice(ins, 0, moved);
          tcFcCardsCancel();
          tcFcSyncFromCards();
          tcFcCardsRender();
        });
      });
    }

    window.tcFcCardsEdit = function(index) {
      fcCardEditIndex = index;
      const editing = index >= 0 && fcCards[index];
      const f = document.getElementById("fcCardForm");
      const num = document.getElementById("fcMNum");
      num.textContent = editing ? "#" + (index + 1) : "#" + (fcCards.length + 1);
      f.style.display = "";
      if (editing) {
        document.getElementById("fcMFront").value = fcCards[index].front || "";
        document.getElementById("fcMBack").value = fcCards[index].back || "";
        document.getElementById("fcMEx").value = fcCards[index].example || "";
        document.getElementById("fcMDesc").value = fcCards[index].description || "";
        document.getElementById("fcMLevel").value = fcCards[index].level || "";
      } else {
        document.getElementById("fcMFront").value = "";
        document.getElementById("fcMBack").value = "";
        document.getElementById("fcMEx").value = "";
        document.getElementById("fcMDesc").value = "";
        document.getElementById("fcMLevel").value = "";
      }
      setTimeout(() => {
        try { f.scrollIntoView({ behavior: "smooth", block: "center" }); } catch (e) {}
        const fr = document.getElementById("fcMFront");
        if (fr) fr.focus();
      }, 60);
    };

    window.tcFcCardsSave = function() {
      const front = document.getElementById("fcMFront").value.trim();
      const back = document.getElementById("fcMBack").value.trim();
      if (!front || !back) return toast("Mặt trước và mặt sau không được bỏ trống", "error");
      const example = document.getElementById("fcMEx").value.trim();
      const description = document.getElementById("fcMDesc").value.trim();
      const level = document.getElementById("fcMLevel").value.trim();
      const card = { front, back };
      if (example) card.example = example;
      if (description) card.description = description;
      if (level) card.level = level;
      if (fcCardEditIndex >= 0 && fcCards[fcCardEditIndex]) {
        fcMeta.delete(fcCardSig(fcCards[fcCardEditIndex]));
        fcCards[fcCardEditIndex] = card;
        toast("Đã cập nhật thẻ #" + (fcCardEditIndex + 1), "success");
      } else {
        fcCards.push(card);
        toast("Đã thêm thẻ mới", "success");
      }
      fcRememberMeta([card]);
      tcFcSyncFromCards();
      tcFcCardsRender();
      tcFcCardsCancel();
    };

    window.tcFcCardsCancel = function() {
      document.getElementById("fcCardForm").style.display = "none";
      fcCardEditIndex = -1;
    };

    window.tcFcMaybeMinimize = function() {
      const ta = document.getElementById("tcFcText");
      if (ta.style.minHeight) {
        ta.style.minHeight = "";
        ta.style.height = "";
      } else {
        ta.style.minHeight = "60px";
        ta.style.height = "60px";
        toast("Bạn vẫn có thể sửa từng thẻ trong danh sách bên dưới", "info");
      }
    };

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.getElementById("fcCardEditor").classList.remove("open");
        document.getElementById("fcGroupRename").classList.remove("open");
      }
    });
    document.getElementById("fcCardEditor").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) tcFcCardsClose();
    });
    const fcGRModal = document.getElementById("fcGroupRename");
    if (fcGRModal) {
      fcGRModal.addEventListener("click", (e) => {
        if (e.target === e.currentTarget) fcGroupRenameClose();
      });
      const inp = document.getElementById("fcGroupRenameInput");
      if (inp) inp.addEventListener("keydown", (e) => { if (e.key === "Enter") fcGroupRenameDoSave(); });
      const sv = document.getElementById("fcGroupRenameSave");
      if (sv) sv.addEventListener("click", fcGroupRenameDoSave);
    }

    (() => {
      const bind = (id, fn) => { const el = document.getElementById(id); if (el) el.addEventListener("click", fn); };
      bind("fcBtnCardsOpen", () => { window.tcFcCardsOpen(); if (window.lhToast) lhToast("Đang mở popup sửa từng thẻ...", "info"); });
      bind("fcCardEditorClose", () => window.tcFcCardsClose());
      bind("fcCardAddBtn", () => window.tcFcCardsEdit(-1));
      bind("fcCardCancelBtn", () => window.tcFcCardsCancel());
      // [FIX BUG #9] Bind 1 lần duy nhất; đã bỏ onclick inline trên nút để tránh double-bind.
      bind("fcCardSaveBtn", () => window.tcFcCardsSave());
      bind("fcGroupRenameCloseBtn", () => window.fcGroupRenameClose());
      bind("fcGroupRenameCancelBtn", () => window.fcGroupRenameClose());
    })();

    window.tcFcNew = function() {
      tcFcEditId = null;
      fcMeta.clear();
      document.getElementById("tcFcName").value = "";
      document.getElementById("tcFcCategory").value = "";
      document.getElementById("tcFcNewCategory").value = "";
      document.getElementById("tcFcLevel").value = "";
      document.getElementById("tcFcDesc").value = "";
      document.getElementById("tcFcText").value = "";
      document.getElementById("tcFcComplete").checked = false;
      document.getElementById("tcFcEditorTitle").textContent = "Bộ từ mới";
      document.getElementById("tcFcEditorMode").textContent = "";
      document.getElementById("tcFcBtnSave").innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu bộ từ';
      tcFcSetNewCatMode(false);
      fcDDRefresh("fcFcCatDD");
      fcDDRefresh("fcFcLvDD");
      tcFcUpdatePreview();
      tcFcShowEditor(true);
    };

    window.tcFcCancel = function() {
      tcFcShowEditor(false);
      tcFcEditId = null;
    };

    async function tcFcLoadList() {
      if (tcFcListCache === null) {
        const listEl = document.getElementById("tcFcList");
        listEl.innerHTML = `<div class="empty"><div class="big"><i class="fa-solid fa-spinner fa-spin" style="color:#2563eb"></i></div><div class="empty-title">Đang tải bộ từ...</div></div>`;
        try {
          const [setsRes, groupsRes] = await Promise.all([
            supabase.rpc("teacher_flashcard_sets"),
            supabase.rpc("list_flashcard_groups")
          ]);
          if (setsRes.error) throw setsRes.error;
          tcFcListCache = setsRes.data || [];
          tcFcGroupsCache = {};
          (groupsRes.data || []).forEach(g => { tcFcGroupsCache[g.name] = g.is_complete === true; });
        } catch (e) {
          console.error("teacher_flashcard_sets lỗi:", e);
          const status = (e && e.status) ? ` [HTTP ${e.status}]` : "";
          const code = (e && e.code) ? ` (${e.code})` : "";
          const msg = (e && (e.message || e.error_description)) || String(e);
          listEl.innerHTML = `<div class="empty"><div class="big">⚠️</div><div class="empty-title">Không tải được danh sách bộ từ</div><p class="empty-sub">Kiểm tra lại SQL đã chạy chưa.<br><code style="font-size:12px;color:#b45309">learnhub-fcfix2 · ${escapeHtml(new Date().toISOString())}${status}${code} — ${escapeHtml(msg)}</code></p></div>`;
          if (typeof logAppError === "function") logAppError({ source: "teacher-flashcard", category: "feature", level: "error", code: "FCLIST_FAIL", message: "teacher_flashcard_sets thất bại: " + (status + code + " " + msg), url: location.href });
          return;
        }
      }
      tcFcRenderList(tcFcListCache);
    }

    function tcFcRenderList(rows) {
      const listEl = document.getElementById("tcFcList");
      const list = rows || [];
      document.getElementById("fcMemberCount").textContent = list.length;
      const countEl = document.getElementById("fcCount");
      if (countEl) countEl.textContent = list.length ? `(${list.length} bộ từ)` : "";
      tcFcRenderCategoryOptions(list);

      if (!list.length) {
        listEl.innerHTML = `<div class="empty">
          <div class="big">🃏</div>
          <div class="empty-title">Bạn chưa có bộ từ nào</div>
          <p class="empty-sub">Tạo bộ từ đầu tiên để học sinh có thể vào luyện tập ngay.</p>
          <button class="empty-cta" type="button" onclick="tcFcNew()"><i class="fa-solid fa-plus"></i> Tạo bộ từ mới</button>
        </div>`;
        return;
      }

      // Nhóm các bộ từ theo category, giữ thứ tự: nhóm tĩnh trên trước rồi tới các nhóm khác.
      const groups = [];
      const byCat = {};
      (list || []).forEach(s => {
        const cat = String(s.category || "").trim() || "Chưa phân nhóm";
        if (!byCat[cat]) { byCat[cat] = []; groups.push({ cat, sets: byCat[cat] }); }
        byCat[cat].push(s);
      });
      groups.sort((a, b) => {
        const ia = TC_STATIC_GROUPS.indexOf(a.cat);
        const ib = TC_STATIC_GROUPS.indexOf(b.cat);
        if (ia === -1 && ib === -1) return a.cat.localeCompare(b.cat, "vi");
        if (ia === -1) return 1;
        if (ib === -1) return -1;
        return ia - ib;
      });

      listEl.innerHTML = groups.map((g, gi) => {
        const grpOpen = tcFcOpenByCat.has(g.cat) ? tcFcOpenByCat.get(g.cat) : gi === 0;
        return `
        <div class="fc-group">
          <div class="fc-group-head${grpOpen ? " open" : ""}" data-fc-toggle="${gi}" data-fc-cat="${escapeHtml(g.cat)}">
            <i class="fa-solid fa-chevron-right fc-group-caret"></i>
            <span class="fc-group-title">${escapeHtml(g.cat)}</span>
            <span class="fc-group-count">${g.sets.length} bộ</span>
            <label class="fc-toggle-row fc-group-toggle" title="Trạng thái nhóm" onclick="event.stopPropagation()">
              <input type="checkbox" data-fc-group-complete="${escapeHtml(g.cat)}" ${tcFcGroupsCache[g.cat] ? "checked" : ""}>
              <span class="fc-toggle-track"></span>
              <span class="fc-toggle-text">${tcFcGroupsCache[g.cat] ? "Hoàn thành" : "Đang cập nhật"}</span>
            </label>
            <button type="button" class="fc-group-rename" data-fc-group-rename="${escapeHtml(g.cat)}" title="Sửa tên nhóm" onclick="event.stopPropagation()"><i class="fa-solid fa-pen"></i></button>
          </div>
          <div class="tc-class-grid" data-fc-body="${gi}" style="${grpOpen ? "" : "display:none"}">${g.sets.map(s => `
            <div class="tc-class" data-fc-set-id="${escapeHtml(s.set_id)}">
              <div class="tc-class-head">
                <span class="tc-drag-handle" draggable="true" data-fc-drag="${escapeHtml(s.set_id)}" title="Giữ và kéo để sắp xếp thứ tự"><i class="fa-solid fa-grip-vertical"></i></span>
                <div class="tc-class-ico"><i class="fa-solid fa-layer-group"></i></div>
                <div class="name">${escapeHtml(s.name)}</div>
              </div>
              <div class="meta" style="margin-bottom:10px">
                ${s.level ? `<span class="fc-chip green">${escapeHtml(s.level)}</span>` : ""}
                <span class="fc-chip pending"><i class="fa-solid fa-address-card"></i> ${s.card_count} thẻ</span>
                ${s.is_complete ? `<span class="fc-chip complete-chip"><i class="fa-solid fa-circle-check"></i> Hoàn thành</span>` : `<span class="fc-chip wip-chip"><i class="fa-solid fa-pen-ruler"></i> Đang soạn</span>`}
              </div>
              <div class="meta" style="justify-content:flex-end">
                <button class="btn-sm" style="background:#e0f2fe;color:#0369a1" data-fc-edit="${escapeHtml(s.set_id)}" data-fc-edit-cat="${escapeHtml(s.category || "")}"><i class="fa-solid fa-pen"></i> Sửa</button>
                <button class="btn-sm btn-remove" data-fc-del="${escapeHtml(s.set_id)}"><i class="fa-solid fa-trash-can"></i> Xoá</button>
              </div>
            </div>
          `).join("")}</div>
        </div>
      `;
      }).join("");
      listEl.querySelectorAll("[data-fc-edit]").forEach(btn => {
        btn.addEventListener("click", () => tcFcEdit(btn.dataset.fcEdit, btn.dataset.fcEditCat || ""));
      });
      listEl.querySelectorAll("[data-fc-del]").forEach(btn => {
        btn.addEventListener("click", () => tcFcDelete(btn.dataset.fcDel));
      });
      listEl.querySelectorAll("[data-fc-toggle]").forEach(hd => {
        hd.addEventListener("click", () => {
          const body = listEl.querySelector(`[data-fc-body="${hd.dataset.fcToggle}"]`);
          if (!body) return;
          const open = body.style.display !== "none";
          body.style.display = open ? "none" : "";
          hd.classList.toggle("open", !open);
          if (hd.dataset.fcCat) tcFcOpenByCat.set(hd.dataset.fcCat, !open);
        });
      });
      listEl.querySelectorAll("[data-fc-group-complete]").forEach(cb => {
        cb.addEventListener("change", () => tcFcGroupSetComplete(cb.dataset.fcGroupComplete, cb.checked, cb));
      });
      listEl.querySelectorAll("[data-fc-group-rename]").forEach(btn => {
        btn.addEventListener("click", () => tcFcGroupRename(btn.dataset.fcGroupRename, btn));
      });

      if (!listEl.dataset.fcDragWired) {
        listEl.dataset.fcDragWired = "1";
        let dragId = null;
        listEl.addEventListener("dragstart", (e) => {
          const grip = e.target.closest("[data-fc-drag]");
          if (!grip) return;
          dragId = grip.dataset.fcDrag;
          const card = grip.closest(".tc-class");
          if (card) card.classList.add("dragging");
          try { e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", dragId); } catch (err) {}
        });
        listEl.addEventListener("dragend", () => {
          dragId = null;
          listEl.querySelectorAll(".tc-class.dragging, .tc-class.d-over").forEach(x => x.classList.remove("dragging", "d-over"));
        });
        listEl.addEventListener("dragover", (e) => {
          const card = e.target.closest(".tc-class");
          if (!card || !dragId || card.dataset.fcSetId === dragId) return;
          e.preventDefault();
          card.classList.add("d-over");
        });
        listEl.addEventListener("dragleave", (e) => {
          const card = e.target.closest(".tc-class");
          if (card) card.classList.remove("d-over");
        });
        listEl.addEventListener("drop", async (e) => {
          const card = e.target.closest(".tc-class");
          if (!card || !dragId) return;
          e.preventDefault();
          card.classList.remove("d-over");
          if (card.dataset.fcSetId === dragId) return;
          const grid = card.closest(".tc-class-grid");
          const draggedEl = grid && grid.querySelector(`[data-fc-set-id="${dragId}"]`);
          if (!grid || !draggedEl) { dragId = null; return; }
          if (draggedEl !== card.nextElementSibling) card.insertAdjacentElement("afterend", draggedEl);
          const ranked = [...grid.querySelectorAll(".tc-class")]
            .map((el, i) => ({ set_id: el.dataset.fcSetId, position: i }))
            .filter(x => x.set_id);
          try {
            const { data, error } = await supabase.rpc("reorder_flashcard_sets", { p_ranked: ranked });
            if (error) throw error;
            if (data && data.ok === true) toast("Đã lưu thứ tự mới", "success");
            else toast("Không lưu được thứ tự", "error");
            const cat = grid.closest(".fc-group")?.querySelector(".fc-group-head")?.dataset.fcCat || "";
            const normC = (c) => String(c || "").trim() || "Chưa phân nhóm";
            if (cat) {
              const order = [...grid.querySelectorAll(".tc-class")].map(el => el.dataset.fcSetId).filter(Boolean);
              const others = (tcFcListCache || []).filter(s => normC(s.category) !== cat);
              const inCat = (tcFcListCache || []).filter(s => normC(s.category) === cat);
              inCat.sort((a, b) => order.indexOf(a.set_id) - order.indexOf(b.set_id));
              tcFcListCache = [...others, ...inCat];
            }
          } catch (err) {
            console.error("reorder_flashcard_sets lỗi:", err);
            toast("Không lưu được thứ tự: " + ((err && (err.message || err.error_description)) || err), "error");
          }
          dragId = null;
        });
      }
    }

    // Điền vào dropdown nhóm: các nhóm tĩnh có sẵn trong hub + nhóm từng dùng trong DB.
    const TC_STATIC_GROUPS = [
      "800 Từ Vựng Nền Tảng",
      "300 Từ Vựng Tủ Chuyên Sâu Nâng Cao 9+",
      "Từ Vựng Theo Chủ Đề",
      "Từ Vựng Nhập Môn"
    ];
    let tcFcNewCatMode = false;

    function tcFcSetNewCatMode(on) {
      tcFcNewCatMode = on;
      const row = document.getElementById("tcFcNewCatRow");
      if (row) row.style.display = on ? "flex" : "none";
      if (on) document.getElementById("tcFcNewCategory").focus();
    }

    window.tcFcAddCategory = function() {
      document.getElementById("tcFcCategory").value = "";
      tcFcSetNewCatMode(true);
    };

    window.tcFcCancelNewCategory = function() {
      document.getElementById("tcFcNewCategory").value = "";
      tcFcSetNewCatMode(false);
    };

    function tcFcGetCategory() {
      if (tcFcNewCatMode) {
        const v = document.getElementById("tcFcNewCategory").value.trim();
        if (v) return v;
      }
      return document.getElementById("tcFcCategory").value.trim();
    }

    function tcFcRenderCategoryOptions(list) {
      const sel = document.getElementById("tcFcCategory");
      if (!sel) return;
      const cats = [];
      TC_STATIC_GROUPS.forEach(c => { if (!cats.includes(c)) cats.push(c); });
      (list || []).forEach(s => {
        const c = String(s.category || "").trim();
        if (c && !cats.includes(c)) cats.push(c);
      });
      cats.sort((a, b) => a.localeCompare(b, "vi"));
      sel.innerHTML = `<option value="">— Chọn nhóm —</option>` +
        cats.map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join("");
      fcDDRefresh("fcFcCatDD");
    }

    // ---- Dropdown custom (menu không phải native của trình duyệt) ----
    function fcDDLabelEl(wrapId) {
      const w = document.getElementById(wrapId);
      return w ? w.querySelector(".fc-dd-trigger span") : null;
    }
    function fcDDRefresh(wrapId) {
      const w = document.getElementById(wrapId);
      if (!w) return;
      const sel = w.querySelector("select");
      const menu = w.querySelector(".fc-dd-menu");
      if (!sel || !menu) return;
      const ph = sel.options[0] ? sel.options[0].text : "— Chọn —";
      const label = fcDDLabelEl(wrapId);
      if (label) {
        const o = [...sel.options].find(e => e.value === sel.value);
        label.textContent = o ? (o.value === "" ? ph : o.text) : ph;
        label.classList.toggle("ph", !o || o.value === "");
      }
      const items = [...sel.options].map((o, i) =>
        `<li role="option" aria-selected="${o.value === sel.value}" data-i="${i}" data-v="${escapeHtml(o.value)}" class="fc-dd-opt${o.value === sel.value ? " sel" : ""}">${escapeHtml(o.text)}</li>`
      ).join("");
      menu.innerHTML = items;
    }
    function fcDDSetup(wrapId) {
      const w = document.getElementById(wrapId);
      if (!w || w.dataset.dd) return;
      w.dataset.dd = "1";
      const trig = w.querySelector(".fc-dd-trigger");
      const menu = w.querySelector(".fc-dd-menu");
      const sel = w.querySelector("select");
      trig.addEventListener("click", (e) => {
        e.stopPropagation();
        const wasOpen = w.classList.contains("open");
        document.querySelectorAll(".fc-dd.open").forEach(x => x.classList.remove("open"));
        if (!wasOpen) w.classList.add("open");
      });
      menu.addEventListener("click", (e) => {
        const li = e.target.closest(".fc-dd-opt");
        if (!li) return;
        sel.value = li.dataset.v;
        sel.dispatchEvent(new Event("change"));
        w.classList.remove("open");
        fcDDRefresh(wrapId);
      });
      fcDDRefresh(wrapId);
    }
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".fc-dd")) document.querySelectorAll(".fc-dd.open").forEach(x => x.classList.remove("open"));
    });
    // Thông báo cho JS cũ khi select ẩn đổi giá trị.
    function fcDDChanged(wrapId) {
      fcDDRefresh(wrapId);
    }

    async function tcFcEdit(setId, catOverride) {
      const { data, error } = await supabase.rpc("get_flashcard_set", { p_set_id: setId });
      if (error || !data || !data.length) {
        console.error("get_flashcard_set lỗi:", error);
        return toast("Không đọc được bộ từ", "error");
      }
      const s = data[0];
      const cards = Array.isArray(s.cards) ? s.cards : [];
      fcMeta.clear();
      fcRememberMeta(cards);
      tcFcEditId = setId;
      document.getElementById("tcFcName").value = s.name || "";
      document.getElementById("tcFcLevel").value = s.level || "";
      document.getElementById("tcFcDesc").value = s.description || "";
      document.getElementById("tcFcComplete").checked = s.is_complete === true;

      // Nhóm: luôn chọn đúng nhóm đang hiển thị. get_flashcard_set không trả category nên lấy từ param của dòng đang sửa.
      const cat = String(catOverride || s.category || "").trim();
      const sel = document.getElementById("tcFcCategory");
      const inp = document.getElementById("tcFcNewCategory");
      if (cat && ![...sel.options].some(o => o.value === cat)) {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        sel.appendChild(opt);
      }
      sel.value = cat;
      inp.value = "";
      tcFcSetNewCatMode(false);
      document.getElementById("tcFcText").value = cards
        .map(c => [c.front, c.back, c.example].filter(Boolean).join(" - "))
        .join("\n");
      fcDDRefresh("fcFcCatDD");
      fcDDRefresh("fcFcLvDD");
      document.getElementById("tcFcEditorTitle").textContent = "Sửa bộ từ";
      document.getElementById("tcFcEditorMode").textContent = "(Sửa sẽ lưu đè nội dung hiện tại)";
      document.getElementById("tcFcBtnSave").innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi';
      tcFcUpdatePreview();
      tcFcShowEditor(true);
    }

    window.tcFcSave = async function() {
      const name = document.getElementById("tcFcName").value.trim();
      const category = tcFcGetCategory();
      const level = document.getElementById("tcFcLevel").value.trim();
      const desc = document.getElementById("tcFcDesc").value.trim();
      const cards = tcFcWithMeta(tcFcParseText(document.getElementById("tcFcText").value));
      if (!name) return toast("Vui lòng nhập tên bộ từ", "error");
      if (!category) return toast("Vui lòng chọn hoặc nhập nhóm hiển thị (vd: Từ vựng thường ngày)", "error");
      if (!cards.length) return toast("Chưa có thẻ nào. Mỗi dòng theo dạng: từ - nghĩa", "error");

      const btn = document.getElementById("tcFcBtnSave");
      btn.disabled = true;
      try {
        const args = { p_name: name, p_category: category, p_level: level, p_description: desc, p_cards: cards, p_is_complete: document.getElementById("tcFcComplete").checked };
        const result = tcFcEditId
          ? await supabase.rpc("update_flashcard_set", { p_set_id: tcFcEditId, ...args })
          : await supabase.rpc("create_flashcard_set", args);
        if (result.error) throw result.error;
        if (result.data && result.data.ok !== true) {
          const msgs = { forbidden: "Bạn không có quyền làm việc này", empty_name: "Tên bộ từ trống", empty_cards: "Bộ từ chưa có thẻ" };
          return toast(msgs[result.data.error] || "Không lưu được", "error");
        }
        toast(tcFcEditId ? "Đã lưu thay đổi bộ từ" : "Đã tạo bộ từ mới", "success");
        // Tải lại từ server: thứ tự giờ được DB giữ (sort_order) nên chắc chắn đúng theo thứ tự đã kéo thả.
        tcFcShowEditor(false);
        tcFcEditId = null;
        if (category) tcFcOpenByCat.set(category, true);
        tcFcListCache = null;
        await tcFcLoadList();
      } catch (e) {
        console.error("Lưu flashcard lỗi:", e);
        toast("Lỗi lưu bộ từ: " + (e.message || e), "error");
      } finally {
        btn.disabled = false;
      }
    };

    window.tcFcDelete = async function(setId) {
      const ok = window.lhConfirm
        ? await lhConfirm("Chắc chắn xoá bộ từ này? Học sinh sẽ không vào học được nữa!")
        : confirm("Chắc chắn xoá bộ từ này? Học sinh sẽ không vào học được nữa!");
      if (!ok) return;
      const { data, error } = await supabase.rpc("delete_flashcard_set", { p_set_id: setId });
      if (error) { console.error("delete_flashcard_set lỗi:", error); return toast("Lỗi xoá bộ từ", "error"); }
      if (data && data.ok !== true) return toast("Không xoá được bộ từ", "error");
      toast("Đã xoá bộ từ", "success");
      tcFcListCache = (tcFcListCache || []).filter(s => s.set_id !== setId);
      tcFcRenderList(tcFcListCache);
    };

    // Bật/tắt "nhóm đã hoàn thành" (trạng thái riêng của nhóm).
    async function tcFcGroupSetComplete(name, checked, cb) {
      const { data, error } = await supabase.rpc("set_flashcard_group_complete", { p_name: name, p_is_complete: checked });
      if (error || (data && data.ok !== true)) {
        console.error("set_flashcard_group_complete lỗi:", error);
        toast("Không đổi được trạng thái nhóm", "error");
        cb.checked = !checked;
        return;
      }
      tcFcGroupsCache[name] = checked;
      toast(checked ? "Nhóm đã đánh dấu hoàn thành" : "Nhóm chuyển sang đang cập nhật", "success");
      tcFcRenderList(tcFcListCache);
    }

    // Sửa tên nhóm (đổi luôn category của các bộ trong nhóm).
    let fcGroupRenameOld = "";
    let fcGroupRenameBtn = null;

    function fcGroupRenameOpen(name, btn) {
      fcGroupRenameOld = String(name || "").trim();
      fcGroupRenameBtn = btn || null;
      document.getElementById("fcGroupRenameInput").value = fcGroupRenameOld;
      document.getElementById("fcGroupRename").classList.add("open");
      setTimeout(() => {
        const inp = document.getElementById("fcGroupRenameInput");
        if (inp) { inp.focus(); inp.select(); }
      }, 60);
    }

    window.fcGroupRenameClose = function() {
      document.getElementById("fcGroupRename").classList.remove("open");
      fcGroupRenameBtn = null;
    };

    async function tcFcGroupRename(oldName, btn) {
      fcGroupRenameOpen(oldName, btn);
    }

    async function fcGroupRenameDoSave() {
      const btn = fcGroupRenameBtn;
      const newName = document.getElementById("fcGroupRenameInput").value.trim();
      document.getElementById("fcGroupRenameSave").disabled = true;
      try {
        if (!newName) return toast("Tên nhóm trống", "error");
        if (newName === fcGroupRenameOld) { fcGroupRenameClose(); return; }
        const { data, error } = await supabase.rpc("rename_flashcard_group", { p_old_name: fcGroupRenameOld, p_new_name: newName });
        if (error || (data && data.ok !== true)) {
          const msgs = { empty_name: "Tên nhóm trống", duplicate: "Đã có nhóm trùng tên", forbidden: "Bạn không có quyền này" };
          return toast(msgs[data && data.error] || "Không đổi được tên nhóm", "error");
        }
        (tcFcListCache || []).forEach(s => { if (String(s.category).trim() === fcGroupRenameOld) s.category = newName; });
        const oldG = tcFcGroupsCache[fcGroupRenameOld];
        delete tcFcGroupsCache[fcGroupRenameOld];
        tcFcGroupsCache[newName] = oldG === true;
        toast("Đã đổi tên nhóm", "success");
        fcGroupRenameClose();
        tcFcRenderList(tcFcListCache);
        if (btn) btn.disabled = false;
      } finally {
        document.getElementById("fcGroupRenameSave").disabled = false;
      }
    }

    // Khởi động: load danh sách; nếu mở theo ?set=<id> thì vào chế độ sửa.
    async function boot() {
      fcDDSetup("fcFcCatDD");
      fcDDSetup("fcFcLvDD");
      document.getElementById("tcFcText").addEventListener("input", tcFcUpdatePreview);
      document.getElementById("tcFcCategory").addEventListener("change", () => {
        if (document.getElementById("tcFcCategory").value !== "") tcFcSetNewCatMode(false);
        fcDDRefresh("fcFcCatDD");
      });
      await tcFcLoadList();
      const params = new URLSearchParams(window.location.search);
      const setId = params.get("set");
      if (setId) {
        const rec = (tcFcListCache || []).find(x => x.set_id === setId);
        await tcFcEdit(setId, rec ? rec.category : "");
      }
    }

    guard();
  </script>
</body>
</html>
</file>

