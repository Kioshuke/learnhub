            } else if (item.type === 'short_answer') {
                questionTitle = item.title || "Tự luận";
            } else if (item.type === 'multiple' && item.title) {
                questionTitle = item.title;
            }

            quizHtml += `
                <div class="question-card" id="card-${globalIdx}" style="margin-bottom: 20px; padding: 15px;">
                    <div class="q-header" style="margin-bottom: 12px; font-size: 0.95rem;">
                        <span class="q-badge" style="background: var(--primary); color: white; padding: 2px 8px; border-radius: 15px; font-size: 0.75rem; font-weight: bold; margin-right: 5px;">Câu ${globalIdx + 1}</span> 
                        <span>${esc(questionTitle)}</span>
