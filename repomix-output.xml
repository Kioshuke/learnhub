            let answersContent = '';
            if (item.type === 'multiple') {
                window.totalMaxScore += 1;
                // Nếu câu có title riêng thì đề bài (item.question) hiển thị ở thân card
                const promptBody = (item.title && promptText && promptText !== item.title) ? `
