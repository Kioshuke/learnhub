  frame.classList.add("vimeo-mode");
  frame.classList.remove("pdf-mode", "drive-mode", "drive-folder-mode", "drive-preview-mode", "tiktok-mode", "yt-zoom");
  frame.innerHTML =
    '<iframe src="' + escHtml(getVimeoEmbedUrl(vimeoUrl)) +
    '" title="Vimeo" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen="true"></iframe>';
}

function getTikTokEmbedUrl(url) {
  var s = String(url || "").trim();
  var m = s.match(/\/video\/(\d+)/);
  var id = m && m[1];
  if (!id) return s;
  return "https://www.tiktok.com/player/v1/" + id + "?autoplay=0&music_info=0&description_show=0&rel=0";
}

/* TikTok: nhúng player chính thức bằng iframe. Video TikTok dọc nên khung giữ
   tỉ lệ 16:9 như YouTube nhưng player tự đặt video giữa khung (không track "đã xem"). */
