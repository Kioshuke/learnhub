<script>
(function(){
  const links = document.querySelectorAll('.toc-link');
  const sections = document.querySelectorAll('.doc-section');
  const tocList = document.getElementById('tocScroll');

  function activateMenu(){
    let current = '';
    
    sections.forEach(s => {
      const rect = s.getBoundingClientRect();
      // Nhận diện phần đang đọc chính xác dựa trên tọa độ màn hình
      if (rect.top <= 160) {
        current = s.getAttribute('id');
      }
    });

    // Nếu cuộn lên đầu trang, đặt mục active là mục 1
    if (window.scrollY < 100) {
      current = sections[0].getAttribute('id');
    }

    links.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === '#' + current) {
        link.classList.add('active');
        
        // Trên mobile: tự động cuộn ngang thanh mục lục
        if (window.innerWidth <= 1024 && tocList) {
          const l = link.offsetLeft - tocList.offsetWidth / 2 + link.offsetWidth / 2;
          tocList.scrollTo({left: l, behavior: 'smooth'});
        }
      }
    });
  }

  window.addEventListener('scroll', activateMenu, {passive: true});
  window.addEventListener('resize', activateMenu, {passive: true});
  activateMenu();
})();
</script>

