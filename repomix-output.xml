/* Điều hướng item "Video GV": YouTube giữ nguyên cơ chế track "đã xem",
   còn Vimeo/TikTok/Drive mở trực tiếp (không track — giống Drive/PDF hiện tại). */
function switchSidebarGv(item) {
  var type = item.getAttribute("data-gv");
  if (type === "youtube") {
    switchSidebarVideo(item);
    return;
  }
  var url = item.getAttribute("data-gv-url");
