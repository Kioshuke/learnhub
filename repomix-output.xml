  <script src="../../scripts/core/toast.js"></script>
  <script type="module">
    import { supabase, getUserRow, escapeHtml } from "../../scripts/core/supabase-config.js";

    const tcApp = document.getElementById("tcApp");
    const tcDenied = document.getElementById("tcDenied");
    const tcLoading = document.getElementById("tcLoading");
    const tcUserBadge = document.getElementById("tcUserBadge");
    let accessChecked = false;
    let tcCurrentClassId = null;
    let tcClassesCache = null;
    let tcMembersCache = {};
    let tcEmail = "";

    function show(which) {
      tcApp.style.display = which === "app" ? "" : "none";
      tcDenied.style.display = which === "denied" ? "" : "none";
      tcLoading.style.display = which === "loading" ? "" : "none";
    }

    function setMainView(view) {
      const home = document.getElementById("tcHomeView");
      const manage = document.getElementById("tcManageView");
      const detail = document.getElementById("tcDetailView");
      const sched = document.getElementById("tcScheduleView");
      const notice = document.getElementById("tcNoticeView");
      const quiz = document.getElementById("tcQuizView");
      if (home) home.style.display = (view === "home" || view === "" || !view) ? "" : "none";
      if (manage) manage.style.display = view === "manage" ? "" : "none";
      if (detail) detail.style.display = view === "detail" ? "" : "none";
      if (sched) sched.style.display = view === "schedule" ? "" : "none";
      if (notice) notice.style.display = view === "notice" ? "" : "none";
      if (quiz) quiz.style.display = view === "quiz" ? "" : "none";
    }

    window.onTeacherNav = function(key) {
      if (key === "home") { setMainView("home"); tcLoadClasses(); }
      else if (key === "manage") { setMainView("manage"); tcLoadClasses(); }
      else if (key === "fc") window.location.href = "./newflashcard.html";
      else if (key === "video") window.location.href = "./cardphonghoc.html";
      else if (key === "docs") window.location.href = "./taileu.html";
      else if (key === "notice") tcOpenNotices();
      else if (key === "quiz") tcOpenQuizzes();
    };

    window.tcOpenManage = function() {
      setMainView("manage");
      tcLoadClasses();
    };

    window.tcOpenRoomVideos = function() {
      window.location.href = "./cardphonghoc.html";
    };

    window.tcOpenSchedule = function() {
      setMainView("schedule");
      if (window.TeacherShell && window.TeacherShell.setActive) window.TeacherShell.setActive("schedule");
      if (typeof tcLoadSchedule === "function") tcLoadSchedule();
    };

    window.tcBackHome = function() {
      setMainView("home");
      if (window.TeacherShell && window.TeacherShell.setActive) window.TeacherShell.setActive("home");
      tcLoadClasses();
    };

    function toast(msg, type) {
      if (window.lhToast) lhToast(msg, { type: type || "info" });
    }

    function normRole(role) {
      return String(role || "").trim().toLowerCase();
    }
    function isTeacherRole(role) {
      const r = normRole(role);
      return r === "giáo viên" || r === "giao vien";
    }
    function isAdminRole(role) {
      return normRole(role) === "admin";
    }

    async function guard() {
      if (accessChecked) return;
      show("loading");
      let session = null, row = null;
      try {
        const r = await supabase.auth.getSession();
        session = r.data?.session || null;
        if (session && session.user) row = await getUserRow(session.user.id);
      } catch (e) {
        console.error("guard lỗi:", e);
        show("denied"); accessChecked = true; return;
      }
      if (!session || !session.user) { show("denied"); accessChecked = true; return; }
      const role = row?.role || "";
      const isAdmin = isAdminRole(role);
      const isTeacher = isTeacherRole(role) || isAdmin;
      if (!isTeacher) { show("denied"); accessChecked = true; return; }
      tcEmail = (row && (row.email || session.user.email)) || "";

      const displayName = (row && (row.name || row.email)) || "Giáo viên";
      document.getElementById("tcWelcomeName").textContent = "Xin chào, " + displayName + "!";
      document.getElementById("tcWelcomeSub").textContent =
        "Chào mừng bạn quay lại. Hãy quản lý lớp học, duyệt yêu cầu và theo dõi học sinh của mình.";

      const avatar = row && (row.photo || row.avatar_url || row.picture);
      const initials = displayName.split(" ").map(w => w[0]).join("").substring(0, 2).toUpperCase();
      let avatarHtml;
      if (avatar && !/^https?:\/\//i.test(avatar) && !/^data:image/i.test(avatar)) {
        avatarHtml = `<div class="tc-topbar-avatar">${initials}</div>`;
      } else if (avatar) {
        avatarHtml = `<img class="tc-topbar-avatar-img" src="${escapeHtml(avatar)}" alt="${escapeHtml(displayName)}">`;
      } else {
        avatarHtml = `<div class="tc-topbar-avatar">${initials}</div>`;
      }

      const label = isAdmin
        ? `<span class="tc-badge"><i class="fa-solid fa-shield-halved"></i> ${escapeHtml(row.email || "")} · Admin</span>`
        : `<span class="tc-topbar-name">${escapeHtml(row.name || row.email || "")}</span>`;

      tcUserBadge.innerHTML = `<div class="tc-topbar-user">${label}${avatarHtml}</div>`;
      show("app");
      accessChecked = true;
      const view = new URLSearchParams(window.location.search).get("view");
      if (view === "manage") {
        if (window.TeacherShell && window.TeacherShell.setActive) TeacherShell.setActive("manage");
        setMainView("manage");
      } else if (view === "schedule") {
        tcOpenSchedule();
      } else if (view === "notice") {
        tcOpenNotices();
      } else if (view === "quiz") {
        tcOpenQuizzes();
      }
      tcLoadClasses();
    }

    function tcRenderClasses(rows) {
      const listEl = document.getElementById("tcClassList");
      const countEl = document.getElementById("tcClassCount");
      const list = rows || [];
      countEl.textContent = list.length ? `(${list.length} lớp)` : "";

      let totalMembers = 0, totalPending = 0;
      list.forEach(c => {
        totalMembers += Number(c.member_count || 0);
        totalPending += Number(c.pending_count || 0);
      });
      document.getElementById("tcStatClasses").textContent = list.length;
      document.getElementById("tcStatMembers").textContent = totalMembers;
      document.getElementById("tcStatPending").textContent = totalPending;

      if (!list.length) {
        listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-chalkboard-user"></i></div>Bạn chưa có lớp nào.<br><span style="font-size:12.5px">Tạo lớp đầu tiên ở phía trên để bắt đầu.</span></div>';
        return;
      }
      listEl.innerHTML = list.map(c => `
        <div class="tc-class" data-id="${escapeHtml(c.class_id)}">
          <div class="tc-class-head">
            <div class="tc-class-ico"><i class="fa-solid fa-chalkboard"></i></div>
            <div class="name">${escapeHtml(c.name)}</div>
          </div>
          <div class="meta" style="margin-bottom:10px">
            <span style="color:#6b7280;font-size:12.5px;font-weight:500">Khối ${escapeHtml(c.block) || "—"}</span>
            <span class="code">${escapeHtml(c.invite_code)}</span>
          </div>
          <div class="meta">
            <span class="tc-chip members"><i class="fa-solid fa-users"></i> ${c.member_count}</span>
            ${c.pending_count > 0 ? `<span class="tc-chip pending"><i class="fa-solid fa-clock"></i> ${c.pending_count} chờ duyệt</span>` : `<span class="tc-chip green"><i class="fa-solid fa-circle-check"></i> Đã duyệt hết</span>`}
          </div>
        </div>
      `).join("");
      listEl.querySelectorAll(".tc-class").forEach(el => {
        el.addEventListener("click", () => tcOpenDetail(el.dataset.id));
      });
    }

    async function tcLoadClasses(force) {
      if (tcClassesCache === null || force) {
        const listEl = document.getElementById("tcClassList");
        listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-chalkboard-user"></i></div>Đang tải danh sách lớp...</div>';
        try {
          const { data, error } = await supabase.rpc("teacher_classes");
          if (error) throw error;
          tcClassesCache = data || [];
        } catch (e) {
          console.error("teacher_classes lỗi:", e);
          listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-chalkboard-user"></i></div>Không tải được danh sách lớp. Kiểm tra lại SQL đã chạy chưa.</div>';
          return;
        }
      }
      tcRenderClasses(tcClassesCache);
    }

    window.tcCreateClass = async function() {
      const nameEl = document.getElementById("tcInputName");
      const blockEl = document.getElementById("tcInputBlock");
      const btn = document.getElementById("tcBtnCreate");
      const name = nameEl.value.trim();
      const block = blockEl.value.trim();
      if (!name) return toast("Vui lòng nhập tên lớp", "error");
      btn.disabled = true;
      try {
        const { data, error } = await supabase.rpc("create_class", { p_name: name, p_block: block });
        if (error) throw error;
        if (!data || data.ok !== true) {
          const msgs = { forbidden: "Bạn không có quyền tạo lớp", empty_name: "Tên lớp trống" };
          return toast(msgs[data?.error] || "Không tạo được lớp", "error");
        }
        nameEl.value = ""; blockEl.value = "";
        toast(`Đã tạo lớp. Mã mời: ${data.invite_code}`, "success");
        if (!tcClassesCache) tcClassesCache = [];
        tcClassesCache.unshift({
          class_id: data.id, name, block, invite_code: data.invite_code,
          member_count: 0, pending_count: 0
        });
        tcRenderClasses(tcClassesCache);
        setMainView("manage");
      } catch (e) {
        console.error("create_class lỗi:", e);
        toast("Lỗi tạo lớp: " + (e.message || e), "error");
      } finally {
        btn.disabled = false;
      }
    };

    function tcRenderDetailHead(classId) {
      const cls = (tcClassesCache || []).find(c => c.class_id === classId);
      if (!cls) return;
      document.getElementById("tcDetailName").textContent = cls.name;
      document.getElementById("tcDetailBlock").textContent = "Khối " + (cls.block || "—");
      document.getElementById("tcDetailCode").innerHTML =
        `<span class="hint">Mã mời: <span style="font-family:ui-monospace,monospace;background:#eff6ff;color:#1e40af;border-radius:8px;padding:3px 10px;font-weight:700;letter-spacing:0.5px;font-size:12.5px">${escapeHtml(cls.invite_code)}</span></span>`;
    }

    function tcRenderMembers(classId) {
      const listEl = document.getElementById("tcMemberList");
      const members = tcMembersCache[classId] || [];
      if (!members.length) {
        listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-chalkboard-user"></i></div>Chưa có thành viên hoặc yêu cầu.</div>';
        return;
      }
      const byStatus = (s) => members.filter(m => (m.status || "") === s);
      let html = "";
      const pending = byStatus("pending");
      const approved = byStatus("approved");

      const studentRow = (m, actionsHtml) => `
        <div class="tc-mem">
          <div class="ava">${escapeHtml((m.name || "?").charAt(0).toUpperCase())}</div>
          <div class="info"><div class="nm" data-user="${escapeHtml(m.user_id || "")}" title="Xem hồ sơ học sinh">${escapeHtml(m.name || "Chưa có tên")}</div><div class="em">${escapeHtml(m.email || "")}</div></div>
          <div class="acts">${actionsHtml}</div>
        </div>`;

      if (pending.length) {
        html += `<div class="hint" style="margin:8px 0 12px;font-weight:700;color:#b45309">YÊU CẦU CHỜ DUYỆT (${pending.length})</div>`;
        pending.forEach(m => {
          html += studentRow(m, `
            <button class="btn-sm btn-approve" data-id="${escapeHtml(m.member_id)}" data-act="approve"><i class="fa-solid fa-check"></i> Duyệt</button>
            <button class="btn-sm btn-remove" data-id="${escapeHtml(m.member_id)}" data-act="remove"><i class="fa-solid fa-xmark"></i> Từ chối</button>`);
        });
      }

      if (approved.length) {
        html += `<div class="hint" style="margin:18px 0 12px;font-weight:700;color:#0369a1">THÀNH VIÊN (${approved.length})</div>`;
        approved.forEach(m => {
          html += studentRow(m, `
            <button class="btn-sm btn-remove" data-id="${escapeHtml(m.member_id)}" data-act="remove"><i class="fa-solid fa-user-minus"></i> Gỡ</button>`);
        });
      }

      listEl.innerHTML = html;
      listEl.querySelectorAll("[data-act]").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          window.tcSetMember(btn.dataset.id, btn.dataset.act, classId);
        });
      });
      listEl.querySelectorAll(".nm[data-user]").forEach(el => {
        el.addEventListener("click", (e) => {
          e.stopPropagation();
          if (el.dataset.user) tcShowStudentProfile(el.dataset.user);
        });
      });
    }

    function tcCloseStudentModal() {
      const overlay = document.getElementById("tcStudentModal");
      if (overlay) {
        overlay.classList.remove("show");
        overlay.setAttribute("aria-hidden", "true");
      }
      document.removeEventListener("keydown", tcModalEscHandler);
    }
    window.tcCloseStudentModal = tcCloseStudentModal;

    function tcModalEscHandler(e) {
      if (e.key === "Escape") tcCloseStudentModal();
    }

    function tcModalOverlayHandler(e) {
      if (e.target === document.getElementById("tcStudentModal")) tcCloseStudentModal();
    }

    function fmtDate(v) {
      if (!v) return "";
      try {
        return new Date(v).toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" });
      } catch (e) { return String(v); }
    }

    window.tcShowStudentProfile = async function(userId) {
      const overlay = document.getElementById("tcStudentModal");
      if (!overlay || !userId) return;
      overlay.classList.add("show");
      overlay.setAttribute("aria-hidden", "false");
      document.addEventListener("keydown", tcModalEscHandler);

      document.getElementById("tcModalAva").textContent = "?";
      document.getElementById("tcModalName").textContent = "Học sinh";
      document.getElementById("tcModalEmail").textContent = "";
      document.getElementById("tcModalClasses").innerHTML =
        '<div class="tc-modal-empty"><i class="fa-solid fa-circle-notch fa-spin"></i> Đang tải...</div>';

      if (tcCurrentClassId) {
        const mem = (tcMembersCache[tcCurrentClassId] || []).find(x => x.user_id === userId);
        if (mem) {
          document.getElementById("tcModalAva").textContent = (mem.name || "?").charAt(0).toUpperCase();
          document.getElementById("tcModalName").textContent = mem.name || "Học sinh";
          document.getElementById("tcModalEmail").textContent = mem.email || "";
        }
      }

      try {
