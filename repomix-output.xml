      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .count {
      color: var(--section-accent-dark);
      font-size: 13px;
      opacity: 0.9;
    }

    .open-btn {
      border: none;
      border-radius: 12px;
      padding: 10px 14px;
      cursor: pointer;
      color: white;
      background: linear-gradient(135deg, var(--section-accent), var(--section-accent-dark));
      font-weight: 700;
      box-shadow: 0 8px 16px var(--section-border);
      transition: transform 0.15s ease;
    }

    .open-btn:hover {
      transform: translateY(-2px);
    }

    .loading-overlay {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(20px) saturate(1.15);
      -webkit-backdrop-filter: blur(20px) saturate(1.15);
    }

    .loading-overlay.show {
      display: flex;
      animation: overlayFade 0.25s ease;
    }

    .loading-box {
      position: relative;
      overflow: hidden;
      width: min(340px, 100%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.92));
      padding: 36px 24px 28px;
      text-align: center;
      animation: popupIn 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.25);
    }

    .loading-box::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
      background: linear-gradient(90deg, #ec4899, #8b5cf6, #3b82f6, #f59e0b);
      background-size: 300% 100%;
      animation: loadingBarShimmer 1.8s ease-in-out infinite;
    }

    @keyframes loadingBarShimmer {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .loading-emoji {
      font-size: 48px;
      display: block;
      margin: 0 auto 14px;
      animation: loadingBounce 0.8s ease-in-out infinite alternate;
    }

    @keyframes loadingBounce {
      from { transform: translateY(0) scale(1); }
      to { transform: translateY(-10px) scale(1.08); }
    }

    .loading-title {
      margin: 0 0 6px;
      color: #f1f5f9;
      font-size: 19px;
      font-weight: 700;
    }

    .loading-text {
      margin: 0 0 14px;
      color: #94a3b8;
      line-height: 1.5;
      font-weight: 500;
      font-size: 14px;
    }

    .loading-dots {
      display: flex;
      gap: 6px;
      justify-content: center;
    }

    .loading-dots span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #3b82f6;
      animation: dotPulse 1.2s ease-in-out infinite;
    }

    .loading-dots span:nth-child(2) { animation-delay: 0.15s; background: #8b5cf6; }
    .loading-dots span:nth-child(3) { animation-delay: 0.3s; background: #ec4899; }

    @keyframes dotPulse {
      0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
      40% { transform: scale(1); opacity: 1; }
    }

    @keyframes dropdownIn {
      from { opacity: 0; transform: translateY(-6px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes sectionFadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes cardFloatIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes overlayFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes popupIn {
      from { opacity: 0; transform: translateY(10px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* ===== SKELETON LOADING (cho lưới thẻ chủ đề, tránh giật khi dựng DOM nặng) ===== */
    .skel-bar {
      background: linear-gradient(90deg, #e2e9f5 25%, #f2f6fc 37%, #e2e9f5 63%);
      background-size: 400% 100%;
      animation: skeletonShimmer 1.4s ease infinite;
      border-radius: 8px;
    }

    @keyframes skeletonShimmer {
      0% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .skel-section {
      margin-top: 28px;
    }

    .skel-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .skel-title {
      width: 200px;
      height: 26px;
    }

    .skel-note {
      width: 60px;
      height: 20px;
    }

    .skel-card {
      border-radius: 22px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.6);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 210px;
    }

    .skel-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .skel-chip {
      width: 64px;
      height: 20px;
      border-radius: 999px;
    }

    .skel-card-title {
      width: 70%;
      height: 20px;
    }

    .skel-card-desc {
      width: 100%;
      height: 14px;
    }

    .skel-card-desc.short {
      width: 60%;
    }

    .skel-card-meta {
      margin-top: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .skel-count {
      width: 50px;
      height: 14px;
    }

    .skel-btn {
      width: 80px;
      height: 34px;
      border-radius: 12px;
    }

    /* ===== EMPTY STATE ===== */
    .hub-empty {
      text-align: center;
      padding: 60px 20px 50px;
      animation: sectionFadeIn 0.45s ease both;
    }
    .hub-empty-icon {
      width: 80px; height: 80px; margin: 0 auto 18px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(37,99,235,0.1), rgba(124,58,237,0.1));
      display: flex; align-items: center; justify-content: center;
      font-size: 36px;
      animation: maintenancePulse 2.5s ease-in-out infinite;
    }
    .hub-empty h3 { margin: 0 0 8px; font-size: 18px; color: var(--text-main); font-weight: 700; }
    .hub-empty p { margin: 0 auto; max-width: 380px; font-size: 14px; color: var(--text-sub); line-height: 1.6; }
    .hub-empty .hub-empty-contact {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 16px; padding: 10px 20px; border-radius: 12px;
      background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.2);
      color: #2563eb; font-size: 13px; font-weight: 600;
      text-decoration: none; transition: all 0.2s ease;
    }
    .hub-empty .hub-empty-contact:hover { background: rgba(37,99,235,0.14); transform: translateY(-1px); }
    @media (max-width: 860px) {
      .topic-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .topic-slider {
        --slide-step: calc((100% + 16px) / 2);
      }

      .topic-slider .topic-card {
        flex-basis: calc((100% - 16px) / 2);
      }
    }

    @media (max-width: 620px) {
      .section-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .section-actions {
        align-self: flex-end;
        justify-content: flex-end;
      }

      .topic-grid {
        grid-template-columns: 1fr;
      }

      .topic-slider {
        --slide-step: calc(100% + 16px);
      }

      .topic-slider .topic-card {
        flex-basis: 100%;
      }
    }
