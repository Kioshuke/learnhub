                                        <input type="radio" name="tf-${globalIdx}-${subIdx}" value="0" onclick="checkTFDone(${globalIdx})"> <b>S</b>
                                    </label>
                                </div>
                            </div>
                        `).join('')}
                    </div>`;
            } 
            else if (item.type === 'short_answer') {
                window.totalMaxScore += 1;
                // Hiển thị đề bài (prompt) phía trên + ô nhập tự luận
                const promptHtml = (promptText && promptText.trim() !== "") ? `
                    <div style="margin-bottom: 12px; font-size: 0.95rem; line-height: 1.6; font-weight: 600; color: var(--text);">
                        ${esc(promptText)}
