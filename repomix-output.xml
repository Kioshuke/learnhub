            <button id="tcFcBtnNew" class="btn-sm" type="button" style="background:#d1fae5;color:#047857;margin-left:auto" onclick="tcFcNew()"><i class="fa-solid fa-plus"></i> Tạo bộ từ mới</button>
          </div>
          <div id="tcFcList" class="tc-class-grid">
