</div>

<!-- DICTIONARY POPUP -->
<div id="dictPopup" class="popup" onclick="closeDictPopup(event)">
  <div class="popup-box dict-popup-box" onclick="event.stopPropagation()">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
      <h2 style="margin:0;font-size:22px;">
        <span id="dictWordDisplay" style="color:#1d4ed8;"></span>
      </h2>
