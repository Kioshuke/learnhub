                        return `<div class="flex items-center gap-2 px-3 py-2 rounded-lg" style="background:var(--tint-blue);border:1px solid rgba(37,99,235,0.15)">
                            <i class="fa-solid fa-chalkboard-user text-[11px]" style="color:var(--blue-accent)"></i>
