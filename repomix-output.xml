        width: fit-content;
        height: 34px;
        align-self: flex-start;
        gap: 4px;
        padding: 0 10px;
        font-size: 12px;
        border-radius: 17px;
        z-index: 1000;
    }
}
#menu button {
    padding: 6px 10px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #1e293b;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease-out;
    white-space: nowrap;
}

/* Hiệu ứng khi lướt chuột qua (LearnHub style chỉ đổi nền nhẹ) */
#menu button:hover:not(.active-nav) {
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
    transform: translateY(-2px);
}

#menu button.active-nav {
    background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%) !important;
    color: white !important;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
    transform: scale(1.02) translateY(-2px);
}


/* NÚT HOÀN TOÀN KHÔNG CÓ CÁI DẤU CHẤM DƯỚI GẦM (CHÁN) */
#menu button.active-nav::after {
    content: none !important; /* Xóa bỏ indicator chấm tròn cũ */
}

#menu button:active {
    transform: scale(0.97); /* Bấm xuống nhẹ */
}
/* Hiệu ứng nhịp tim nhẹ cho nút đang chọn */
@keyframes pulse-active {
  0% { box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4); }
  50% { box-shadow: 0 10px 35px rgba(79, 70, 229, 0.6); }
  100% { box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4); }
}

/* ===== MODE - Giữ nguyên cấu trúc ẩn/hiện ===== */
.mode {
  display: none;
  padding: 4px 10px;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 0;
}

.active {
  display: flex !important;
}

@keyframes flashFadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== PROGRESS ===== */
#progressContainer {
  width: 90%;
  max-width: 500px;
  margin: 6px auto;
  background: var(--panel-strong);
  padding: 6px 14px;
  border-radius: 14px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.2);
  border: 1px solid var(--line);
  z-index: 1;
}

#progressText {
  font-weight: 800;
  margin-bottom: 6px;
  color: #1d4ed8;
  letter-spacing: 1px;
  font-size: 13px;
}
#progressOuter {
  width: 100%;
  height: 8px;
  background: #f1f5f9;
  border-radius: 8px;
  overflow: hidden;
}
#progressInner {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #2563eb, #1d4ed8);
  border-radius: 10px;
  transition: width 0.5s ease;
}

#topicBanner {
  width: 90%;
  max-width: 520px;
  margin: 2px auto 6px;
  padding: 12px 18px;
  border-radius: 14px;
  border: 1px solid rgba(37, 99, 235, 0.22);
  background: rgba(255, 255, 255, 0.88);
  color: #1e3a8a;
  font-weight: 700;
  font-size: 15px;
  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.16);
  z-index: 1;
}

#topicBanner span {
  color: #0f172a;
  font-weight: 800;
}

/* ===== FLASHCARD (FIX CHUẨN 3D & SHADOW) ===== */
.flashcard {
  width: 400px !important;
  height: 240px !important;
  perspective: 1000px;
  margin: 0 !important;
  display: block;
  align-items: center;
  justify-content: center;
}

.flash-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.flash-inner.flipped {
  transform: rotateY(180deg);
}

.flash-front, .flash-back {
  position: absolute;
  width: 100% !important;
  height: 100% !important;
  inset: 0;
  border-radius: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25px;
  text-align: center;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 18px 35px rgba(15, 23, 42, 0.22);
  border: 1px solid rgba(255,255,255,0.85);
  font-size: 35px; /* Tăng size chữ cho xứng tầm card bự */
  font-weight: 800;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  box-sizing: border-box;
}

.flash-back {
  transform: rotateY(180deg);
  background: linear-gradient(140deg, rgba(243, 232, 255, 0.96), rgba(224, 242, 254, 0.96));
  color: #4338ca;
}

/* ===== BUTTON ĐIỀU HƯỚNG ===== */
button {
  margin: 10px;
  padding: 12px 24px;
  border-radius: 14px;
  border: none;
  background: linear-gradient(135deg, var(--brand-1), #6366f1);
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 10px 18px rgba(79, 70, 229, 0.3);
}

button:hover {
  transform: translateY(-2px) scale(1.05);
  box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3);
}

/* ===== MATCH (GIỮ NGUYÊN GRID 5 CỘT) ===== */
#matchGrid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 15px;
  width: 100%;
  max-width: none;
  margin: 0;
}

.game-shell {
  width: 100%;
  max-width: none;
  margin: 10px 0 0;
  padding: 20px;
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.74);
  border: 1px solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.22);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.char-slot {
  width: 28px;
  height: 36px;
  text-align: center;
  border: none;
  border-bottom: 2px solid #64748b;
  background: transparent;
  font-size: 22px;
  font-weight: 700;
  font-family: 'Segoe UI', Roboto, Arial, system-ui, sans-serif;
  outline: none;
  color: #1e293b;
  transition: border-color 0.2s, border-bottom-width 0.2s;
  padding: 0;
  margin: 0 1px;
  box-sizing: border-box;
  border-radius: 0;
}
.char-slot:focus {
  border-bottom-color: #4f46e5;
  border-bottom-width: 3px;
}
.slot-space {
  display: inline-block;
  width: 16px;
}

.game-start-screen {
  width: min(980px, 100%);
  min-height: 330px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12px auto 0;
  padding: 6px 10px;
}

.game-start-card {
  width: min(520px, 92%);
  padding: 28px 26px;
  text-align: center;
  margin: 0 auto;
  border-radius: 24px;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.95), rgba(241, 245, 249, 0.93));
  border: 1px solid rgba(226, 232, 240, 0.85);
  box-shadow: 0 18px 35px rgba(15, 23, 42, 0.2);
}

#match-start-screen,
#blast-start-screen,
#defender-start-screen {
  width: 100% !important;
  max-width: 100% !important;
  margin: 12px auto 0 !important;
  display: flex;
  justify-content: center !important;
  align-items: center !important;
}

.game-start-card h2 {
  margin: 0 0 10px;
  color: #312e81;
  font-size: 30px;
}

.game-start-card p {
  margin: 0 0 18px;
  color: #475569;
  line-height: 1.55;
  font-weight: 500;
}

.match-card {
  height: 95px;
  padding: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.92);
  font-size: 18px;
  font-weight: 600;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.match-card:hover {
  transform: translateY(-5px) scale(1.02); /* Nhấc thẻ lên cao hơn và phóng to nhẹ */
  border-color: #4f46e5; /* Đổi viền sang màu tím đậm */
  background: #ffffff;
  box-shadow: 0 12px 20px rgba(79, 70, 229, 0.15); /* Thêm đổ bóng màu tím nhạt cho ảo diệu */
  color: #4f46e5; /* Đổi màu chữ sang tím luôn cho đồng bộ */
}

.match-card.selected {
  border-color: #6366f1;
  background: #eef2ff;
}

.match-card.correct {
  background: #22c55e !important;
  color: white !important;
  border-color: #22c55e !important;
}

.match-card.wrong {
  background: #ef4444 !important;
  color: white !important;
  border-color: #ef4444 !important;
  animation: shake 0.3s;
}

.hidden {
  opacity: 0;
  transform: scale(0.8);
  pointer-events: none;
  transition: 0.3s;
}

/* ===== BLAST (QUIZ) - FIX HIỆU ỨNG ===== */
.blast-box {
  width: 100%;
  max-width: none;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 18px;
  box-shadow: 0 14px 32px rgba(15, 23, 42, 0.2);
}

.question {
  font-size: 35px;
  margin-bottom: 25px;
  font-weight: 800;
  color: #111827;
}

.options button {
  width: 100%;
  margin: 10px 0;
  padding: 16px;
  border-radius: 16px;
  background: white;
  color: #475569;
  box-shadow: 0 4px 6px rgba(0,0,0,0.02);
  border: 1px solid #e2e8f0;
  transition: 0.2s;
  font-size: 18px;
}

.options button:hover {
  background: #f8fafc;
  border-color: #4f46e5;
  color: #4f46e5;
}

/* Ép màu khi đúng/sai ở Blast */
.options button.correct {
  background: #22c55e !important;
  color: white !important;
}

.options button.wrong {
  background: #ef4444 !important;
  color: white !important;
  animation: shake 0.3s;
}

/* ===== POPUP - LUÔN Ở GIỮA ===== */
.popup {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(15, 23, 42, 0.7);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  perspective: 1000px;
  transition: opacity 0.3s ease;
}

.popup.show {
  display: flex;
}

.popup-box {
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(248, 250, 252, 0.95));
  border: none;
  padding: 60px 50px;
  border-radius: 32px;
  text-align: center;
  max-width: 450px;
  width: 90%;
  box-shadow: 0 18px 32px rgba(15, 23, 42, 0.28), 0 10px 30px rgba(147, 51, 234, 0.2), inset 0 2px 0 rgba(255, 255, 255, 0.5);
  position: relative;
  animation: popupPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popupPop {
  0% { transform: scale(0.8) translateY(20px) rotateX(-10deg); opacity: 0; }
  100% { transform: scale(1) translateY(0) rotateX(0deg); opacity: 1; }
}
.celebrate-icon {
 font-size: 80px;
 margin-bottom: 30px;
 display: inline-block;
 animation: partyShake 1s ease-in-out infinite alternate;
}

@keyframes partyShake {
 0% { transform: rotate(-5deg) scale(1.1); }
 100% { transform: rotate(5deg) scale(1); }
}

.popup-box h2 {
    font-size: 36px;
    font-weight: 800;
    margin-bottom: 15px;
    color: #4f46e5; 
    text-align: center;
}

.dict-popup-box {
  max-width: 600px !important;
  padding: 20px !important;
}

@media (max-width: 768px) {
  .dict-popup-box {
    max-width: 94% !important;
    padding: 14px !important;
  }
  #dictContent {
    max-height: 40vh !important;
    font-size: 14px !important;
  }
}

.popup-box p {
  font-size: 18px;
 color: #475569;
 margin-bottom: 40px;
 line-height: 1.6;
}

/* Nút Học lại xịn hơn */
.popup-box button {
 background: linear-gradient(135deg, #6366f1, #a855f7);
 color: white;
 padding: 18px 40px;
 font-size: 20px;
 font-weight: 700;
 border-radius: 20px;
 box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
 border: none;
 cursor: pointer;
}

.popup-box button:hover {
 transform: translateY(-4px);
 box-shadow: 0 15px 25px rgba(99, 102, 241, 0.4);
}


/* ===== PHÁO GIẤY CONFETTI (DÙNG CHUNG) ===== */
.confetti-container {
 position: fixed;
 top: 0; left: 0;
 width: 100%; height: 100%;
 pointer-events: none;
 z-index: 10001; /* Nổi lên trên popup-box */
 overflow: hidden;
}

.confetti {
 position: absolute;
 top: -20px;
 border-radius: 5px;
 animation: confettiFall ease-out infinite;
}

@keyframes confettiFall {
 0% { transform: translateY(-20px) rotate(0deg) translateX(0); opacity: 1; }
 100% { transform: translateY(110vh) rotate(720deg) translateX(calc(100vw * 0.2)); opacity: 0; }
}
/* ===== ANIMATIONS ===== */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-6px); }
  75% { transform: translateX(6px); }
}

/* Trạng thái khi thẻ bay ra ngoài */
.slide-out-left { 
  transform: translateX(-150px) rotate(-15deg) scale(0.8) !important; 
  opacity: 0; 
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Trạng thái chuẩn bị của thẻ mới (ở bên phải) */
.slide-in-right { 
  transform: translateX(150px) rotate(15deg) scale(0.8) !important; 
  opacity: 0; 
}

.slide-out-right {
  transform: translateX(150px) rotate(15deg) scale(0.8) !important;
  opacity: 0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.slide-in-left {
  transform: translateX(-150px) rotate(-15deg) scale(0.8) !important;
  opacity: 0;
}

/* Trạng thái khi thẻ mới bay vào vị trí chính giữa */
.slide-active {
  transform: translateX(0) rotate(0deg) scale(1) !important;
  opacity: 1;
  transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  box-shadow: 0 20px 40px rgba(79, 70, 229, 0.15) !important;
}
/* Khung bao quanh card và 2 nút mũi tên */
.flash-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30px;
  width: 100%;
  max-width: 800px;
}

/* Style cho nút mũi tên 2 bên */
.nav-arrow {
  background: white;
  color: #4f46e5;
  width: auto;
  min-width: 56px;
  height: 56px;
  padding: 0 18px;
  border-radius: 50px;
  border: none;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0;
  white-space: nowrap;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: 0.3s;
  flex: none;
}

.nav-badge {
  display: inline-block;
  min-width: 22px;
  height: 22px;
  line-height: 22px;
  margin-left: 4px;
  padding: 0 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);
  color: inherit;
  font-size: 12px;
  font-weight: 800;
  text-align: center;
}

.nav-arrow-left .nav-badge { color: #dc2626; }
.nav-arrow-right .nav-badge { color: #16a34a; }

.nav-arrow-left {
  background: linear-gradient(135deg, #f43f5e, #dc2626);
  color: white;
  box-shadow: 0 10px 18px rgba(239, 68, 68, 0.35);
}

.nav-arrow-left:hover {
  background: linear-gradient(135deg, #ef4444, #b91c1c);
  transform: scale(1.05) translateY(-3px);
  box-shadow: 0 12px 24px rgba(239, 68, 68, 0.45);
}

.nav-arrow-right {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: white;
  box-shadow: 0 10px 18px rgba(34, 197, 94, 0.35);
}

.nav-arrow-right:hover {
  background: linear-gradient(135deg, #34d399, #15803d);
  transform: scale(1.05) translateY(-3px);
  box-shadow: 0 12px 24px rgba(34, 197, 94, 0.45);
}

.nav-arrow:hover {
  background: #4f46e5;
  color: white;
  transform: scale(1.05) translateY(-3px); /* Nhấc nhẹ lên */
  box-shadow: 0 10px 20px rgba(79, 70, 229, 0.3);
}

/* Đảm bảo Card không có margin lung tung gây lệch */
.speaker-icon {
  position: absolute;
  top: 20px;
  right: 20px;
  font-size: 24px;
  background: #eef2ff;
  color: #4f46e5;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: 0.3s;
  z-index: 100;
  cursor: pointer;
}

.speaker-icon:hover {
  background: #4f46e5;
  color: white;
}

.dict-icon {
  position: absolute;
  top: 20px;
  left: 20px;
  font-size: 24px;
  background: #eef2ff;
  color: #4f46e5;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: 0.3s;
  z-index: 100;
  cursor: pointer;
}

.dict-icon:hover {
  background: #4f46e5;
  color: white;
}

@media (max-width: 768px) {
    /* 1. HIỆU ỨNG CHUYỂN TAB TỐI ƯU (GIẢM LAG) */
    .mode {
        transform: translate3d(0, 10px, 0);
        filter: none !important;
        transition: opacity 0.25s ease, transform 0.25s ease;
        will-change: transform, opacity;
    }

    .mode.active {
        transform: translate3d(0, 0, 0);
    }

    /* 2. KHUNG BAO FLASHCARD */
    .flashcard {
        width: 90vw !important;
        max-width: 350px;
        height: 50vh !important;
        margin: 20px auto !important;
        will-change: transform, opacity;
        transition: transform 0.3s ease-out !important;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1) !important;
    }

    /* Hiệu ứng trượt ngang mượt mà cho Flashcard */
    .slide-out-left {
        transform: translate3d(-100%, 0, 0) !important;
        opacity: 0;
    }

    .slide-in-right {
        transform: translate3d(100%, 0, 0) !important;
        opacity: 0;
    }

    .slide-out-right {
        transform: translate3d(100%, 0, 0) !important;
        opacity: 0;
    }

    .slide-in-left {
        transform: translate3d(-100%, 0, 0) !important;
        opacity: 0;
    }

    .slide-active {
        transform: translate3d(0, 0, 0) !important;
        opacity: 1;
    }

    .flash-inner {
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* 3. MENU ĐIỀU HƯỚNG - legacy overrides (xem block cuối file) */
    #menu {
        flex-wrap: nowrap;
        overflow-x: scroll;
        overflow-y: hidden;
        justify-content: flex-start;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    #menu::-webkit-scrollbar {
        display: none;
    }

    /* 4. GHÉP THẺ (MATCH GAME) */
    #matchGrid {
        grid-template-columns: repeat(2, 1fr) !important;
        padding: 10px;
        gap: 10px;
        width: 100% !important;
    }

    .match-card {
        width: 100%;
        height: 90px;
        font-size: 14px;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

/* 5. CÁC THÀNH PHẦN KHÁC */
    .nav-arrow {
        min-width: 48px;
        height: 42px;
        font-size: 12px;
        padding: 0 14px;
        margin: 4px;
    }

    .flash-wrapper {
        gap: 6px;
        max-width: 100%;
    }

    @media (max-width: 480px) {
        .nav-arrow {
            min-width: 44px;
            height: 38px;
            font-size: 11px;
            padding: 0 10px;
            margin: 2px;
        }
    }

    #progressContainer {
        width: 95%;
        margin: 4px auto;
        padding: 4px 10px;
    }

    #topicBanner {
        margin: 2px auto 4px;
        padding: 4px 10px;
        font-size: 12px;
    }

    /* Tối ưu hiệu ứng Stagger nội dung con */
    .mode.active > *:nth-child(n) {
        animation-duration: 0.4s !important;
        animation-delay: 0.05s !important;
        filter: none !important;
    }

    body {
        padding: 4px 4px 12px;
    }

    #topicBanner,
    #progressContainer {
        width: 100%;
        max-width: none;
    }

    .mode {
        padding: 4px 0 10px;
    }

.flash-wrapper {
        flex-wrap: wrap;
        gap: 8px;
        max-width: 100%;
    }

    .flash-wrapper .flashcard {
        order: -1;
        flex-basis: 100%;
        margin: 8px auto !important;
    }

    .flashcard {
        width: 92vw !important;
        max-width: none;
        height: 200px !important;
        margin: 4px auto !important;
    }

    .flash-front,
    .flash-back {
        border-radius: 22px;
        padding: 16px;
        font-size: clamp(22px, 7vw, 30px);
    }

    .speaker-icon {
