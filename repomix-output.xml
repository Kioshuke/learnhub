          <div class="panel-desc" style="margin-bottom:0">Soạn và đăng bài viết kiểu bài báo cho trang Blog — ai cũng đọc được, kể cả khách chưa đăng nhập.</div>
        </div>
      </div>
      <div id="blogManageRoot"></div>
    </section>

    <!-- ERROR LOGS -->
    <section class="panel tab-panel hidden" id="errorLogsTabPanel">
      <div class="panel-head">
        <div>
          <div class="panel-title">Lỗi hệ thống</div>
          <div class="panel-desc" style="margin-bottom:0">Lỗi từ user và tính năng (whitelist, khóa user, AI, tải bài test). Log quá 7 ngày tự xóa.</div>
        </div>
      </div>
      <div id="errorLogsStats" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px"></div>
      <div class="toolbar">
        <input id="errorLogsSearchInput" class="input" type="search" placeholder="Tìm theo email, nguồn, mã lỗi, nội dung...">
        <select id="errorLogsLevelSelect" class="select">
          <option value="all">Mọi mức độ</option>
          <option value="warning">Cảnh báo</option>
          <option value="error">Nghiêm trọng</option>
          <option value="info">Bình thường</option>
        </select>
        <select id="errorLogsStatusSelect" class="select">
          <option value="all">Mọi trạng thái</option>
          <option value="open">Còn lỗi</option>
          <option value="fixed">Đã fix</option>
        </select>
        <select id="errorLogsCategorySelect" class="select">
          <option value="all">Mọi loại</option>
          <option value="ai">Lỗi AI</option>
          <option value="whitelist">Whitelist</option>
          <option value="disabled">Khóa user</option>
          <option value="feature">Tính năng</option>
          <option value="auth">Xác thực</option>
          <option value="test">Tải bài test</option>
        </select>
<button class="btn btn-soft" id="errorLogsRefreshBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Làm mới
        </button>
        <button class="btn btn-success" id="errorLogsMarkAllBtn" title="Đánh dấu tất cả log còn lỗi là đã fix">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><path d="M7 12l4 4 7-8"/><path d="M7 18h10M4 7V8M8 4h2"/></svg>
          Đọc tất cả
        </button>
        <div class="pagination" id="errorLogsPagination"></div>
      </div>
      <div class="sheet-wrap">
        <div class="sheet-scroll">
          <table class="sheet-table">
            <thead><tr><th>Thời gian</th><th>Mức độ</th><th>Loại</th><th>User</th><th>Mã lỗi</th><th>Nội dung</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody id="errorLogsTableBody"></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- MODAL -->
<div id="confirmModal" class="confirm-modal">
  <div class="confirm-card">
    <div class="confirm-icon" id="confirmModalIcon"><i class="fa-solid fa-triangle-exclamation"></i></div>
    <h3 class="confirm-title" id="confirmModalTitle">Xác nhận</h3>
    <p class="confirm-message" id="confirmModalMessage">Bạn có chắc chắn muốn thực hiện hành động này?</p>
    <div class="confirm-actions">
      <button class="confirm-btn confirm-btn-cancel" id="confirmModalCancel">Hủy</button>
      <button class="confirm-btn confirm-btn-confirm" id="confirmModalConfirm">Xác nhận</button>
    </div>
  </div>
</div>

<!-- LOG DETAIL MODAL -->
<div id="logDetailModal" class="confirm-modal">
  <div class="confirm-card" style="max-width:680px;text-align:left">
    <div class="log-detail-head" id="logDetailHead">
      <div class="log-detail-head-left">
        <span class="log-detail-chip" id="logDetailLevelChip">Cảnh báo</span>
        <h3 class="confirm-title" id="logDetailTitle">Chi tiết log</h3>
      </div>
      <button class="btn btn-soft" onclick="closeLogDetail()" style="padding:6px 14px;font-size:12px">✕ Đóng</button>
    </div>
    <div id="logDetailBody" style="font-size:13px;line-height:1.6;color:var(--text-2);max-height:60vh;overflow:auto"></div>
  </div>
</div>

<script type="module" src="../../scripts/admin/administrator.js"></script>
</body>
</html>
