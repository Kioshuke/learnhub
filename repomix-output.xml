      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .filter-caret {
      font-size: 14px;
      color: #2563eb;
      transition: transform 0.2s ease;
    }

    .filter.open .filter-caret {
      transform: rotate(180deg);
    }

    .filter-menu {
      list-style: none;
      margin: 8px 0 0;
