  if(!hamburger||!sidebar||!overlay) return;

  function openMenu(){ sidebar.classList.add('open'); overlay.classList.add('show'); hamburger.style.display='none'; }
  function closeMenu(){ sidebar.classList.remove('open'); overlay.classList.remove('show'); hamburger.style.display=''; }

  hamburger.addEventListener('click', function(){
    sidebar.classList.contains('open') ? closeMenu() : openMenu();
  });
  overlay.addEventListener('click', closeMenu);

  sidebar.querySelectorAll('.toc-link').forEach(function(link){
    link.addEventListener('click', function(){ closeMenu(); });
  });
})();
