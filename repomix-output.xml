      const BLOCK_MSGS = {
        whitelist: ["Quyền truy cập của bạn đã bị thu hồi (bị gỡ khỏi danh sách thành viên). Vui lòng liên hệ Admin để được hỗ trợ.", "Không có quyền truy cập", "fa-user-xmark"],
