    rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.1);
  text-align: center;
  line-height: 1.22;
  letter-spacing: 0;
  font-weight: 800;
}

.options {
  width: min(700px, 100%);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.options button {
  min-height: 62px;
  margin: 0;
  padding: 13px 16px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.9);
  font-weight: 700;
  line-height: 1.38;
  letter-spacing: 0;
  text-wrap: balance;
}

#menu button,
#topicBanner,
#topicName,
#progressText,
#question,
.question,
#options button,
.options button,
#score,
.streak-badge {
  font-family: 'Segoe UI', Roboto, Arial, system-ui, -apple-system, sans-serif !important;
  font-synthesis: none;
  letter-spacing: 0 !important;
}

#options button,
.options button {
  font-weight: 700 !important;
  line-height: 1.42 !important;
}

.options button:hover {
  transform: translateY(-2px);
  background: #ffffff;
  border-color: rgba(37, 99, 235, 0.45);
}

#score {
  margin-top: 0;
  padding: 9px 15px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  letter-spacing: 0;
}

.streak-badge {
  min-width: 46px;
  padding: 5px 13px;
  text-align: center;
  font-size: 22px;
}

#score.streak-pop {
  animation: scorePop 0.28s ease-out;
}

#score.streak-pop .streak-badge {
  animation: streakBurst 0.28s ease-out;
}

#score.streak-reset {
  animation: scoreReset 0.28s ease;
}

@keyframes scorePop {
  0% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-3px) scale(1.035); }
  100% { transform: translateY(0) scale(1); }
}

@keyframes streakBurst {
  0% { transform: scale(0.96); }
  50% { transform: scale(1.16); }
  100% { transform: scale(1); }
}

@keyframes scoreReset {
  0%, 100% { transform: translateX(0); }
  35% { transform: translateX(-6px); }
  70% { transform: translateX(6px); }
}

@media (max-width: 768px) {
  .flash-front,
  .flash-back {
    border-radius: 26px;
