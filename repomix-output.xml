    <script type="module">
import { supabase, onAuthChange, escapeHtml, escapeUrl, beginOnlineSession, finalizeOnlineSession, logAppError } from "../../scripts/core/supabase-config.js";
        window.logAppError = logAppError;
        import { getWeekKey, getWeekStartMs, formatTimer } from "../../scripts/features/week-math.js";
        import { loadTestAttempts, loadTestAttempt } from "../../scripts/features/learnhub-stats.js";

        const settingsModal = document.getElementById('settings-modal');
        let settingsEditing = false;
        let currentUserId = null;
        let activeInterval = null;
        let usersChannel = null;
        let viewUserChannel = null; // Channel cho profile người khác
        let ownProfileChannel = null; // Channel cho profile của mình
        let statsChannel = null; // Channel cho stats
        let currentViewUserId = null; // Track user đang xem
        let allUsersData = []; // Toàn bộ users cho modal "Xem thêm"

        // ===== UPDATE ONLINE STATUS =====
        async function updateOnlineStatus(isOnline) {
            if (!currentUserId) return;
            if (isOnline) {
                return beginOnlineSession(currentUserId);
            } else {
                return finalizeOnlineSession(currentUserId);
            }
        }

        // Theo dõi visibility change để cập nhật online status
        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "hidden") {
                if(activeInterval){ clearInterval(activeInterval); activeInterval = null; }
                updateOnlineStatus(false);
            } else {
                updateOnlineStatus(true);
                if(!activeInterval){
                    activeInterval = setInterval(() => {
                        if (currentUserId) {
                            supabase.rpc("users_heartbeat", { p_uid: currentUserId });
                        }
                    }, 5000);
                }
            }
        });

        // pagehide: finalize kể cả khi đóng tab / rời trang (RPC idempotent nên an toàn khi gọi trùng)
        window.addEventListener("pagehide", () => {
            if(activeInterval){ clearInterval(activeInterval); activeInterval = null; }
            updateOnlineStatus(false);
        });

        // beforeunload: dùng sendBeacon + keepalive fetch đảm bảo RPC hoàn thành trước khi trang đóng
        window.addEventListener("beforeunload", () => {
            if (!currentUserId) return;
            try {
                const rpcUrl = "https://hyuzukvxulwouaexatqv.supabase.co/rest/v1/rpc/users_finalize_online";
                const body = JSON.stringify({ p_uid: currentUserId });
                navigator.sendBeacon(rpcUrl, new Blob([body], { type: "application/json" }));
            } catch(e) {}
            try {
                const rpcUrl = "https://hyuzukvxulwouaexatqv.supabase.co/rest/v1/rpc/users_finalize_online";
                fetch(rpcUrl, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "apikey": "sb_publishable_cFWEQ0SQuM8SSrOgbkQ8Kg_tJb3Qw9J",
                        "Authorization": "Bearer sb_publishable_cFWEQ0SQuM8SSrOgbkQ8Kg_tJb3Qw9J"
                    },
                    body: JSON.stringify({ p_uid: currentUserId }),
                    keepalive: true
                }).catch(()=>{});
            } catch(e) {}
            updateOnlineStatus(false);
        });

        // Interval để cập nhật online status mỗi 15 giây (heartbeat qua RPC)
        function startOnlineInterval() {
            if (!activeInterval) {
                activeInterval = setInterval(() => {
                    if (currentUserId) {
                        supabase.rpc("users_heartbeat", { p_uid: currentUserId });
                    }
                }, 5000);
            }
        }

        // Render lưới users: tối đa 17 người + ô "Xem thêm" (18 ô = 3 hàng x 6)
        function renderUserGrid(container, users) {
            const now = Date.now();
            const ACTIVE_THRESHOLD = 10000; // presence theo heartbeat: quá 10s không có tín hiệu = offline

            const displayUsers = users.slice(0, 17);
            const hasMore = users.length > 17;

            let html = '';
            displayUsers.forEach(u => {
                const isOnline = u.online && u.last_active && (now - u.last_active) < ACTIVE_THRESHOLD;
                const statusColor = isOnline ? 'bg-green-500' : 'bg-red-500';
                const statusPulse = isOnline ? 'animate-pulse' : '';

                html += `
                    <div class="flex flex-col items-center text-center p-0.5 rounded-lg hover:bg-white hover:shadow-sm transition-all cursor-pointer group" data-uid="${escapeHtml(u.id)}">
                        <div class="relative">
                            <img src="${escapeUrl(u.photo) || 'https://lh3.googleusercontent.com/a/default-user=s40'}" class="w-10 h-10 rounded-full border border-white shadow-sm group-hover:scale-105 transition-transform">
                            <span class="absolute bottom-0 right-0 w-2 h-2 ${statusColor} border border-white rounded-full ${statusPulse}"></span>
                        </div>
                        <span class="text-xs font-medium mt-1 text-gray-700 truncate w-full px-0.5">${escapeHtml(u.name) || 'User'}</span>
                    </div>
                `;
            });

            // Ô "Xem thêm" chiếm vị trí thứ 18
            if (hasMore) {
                html += `
                    <div class="flex flex-col items-center justify-center p-0.5 rounded-lg hover:bg-white hover:shadow-sm transition-all cursor-pointer border border-dashed border-blue-200 bg-blue-50/30 h-[60px]" onclick="viewAllUsers()">
                        <i class="fas fa-ellipsis-h text-xs text-lh-primary"></i>
                        <span class="text-xs font-bold text-lh-primary mt-1">Xem thêm</span>
                    </div>
                `;
            }

            container.innerHTML = html;
        }

        // ===== LISTEN TO USERS TABLE =====
        async function renderUsers() {
            const usersContainer = document.getElementById('users-grid');
            if (!usersContainer) return;

            const { data } = await supabase.from("users")
                .select("id, name, photo, online, last_active");

            const users = data || [];

            // Sắp xếp: online trước (theo bảng chữ cái), offline sau (theo bảng chữ cái)
            const now = Date.now();
            const ACTIVE_THRESHOLD = 10000; // presence theo heartbeat: quá 30s không có tín hiệu = offline

            users.sort((a, b) => {
                const aOnline = a.online && a.last_active && (now - a.last_active) < ACTIVE_THRESHOLD;
                const bOnline = b.online && b.last_active && (now - b.last_active) < ACTIVE_THRESHOLD;

                // Online trước, offline sau
                if (aOnline && !bOnline) return -1;
                if (!aOnline && bOnline) return 1;

                // Cùng trạng thái, sắp xếp theo bảng chữ cái
                const nameA = (a.name || '').toLowerCase();
                const nameB = (b.name || '').toLowerCase();
                return nameA.localeCompare(nameB, 'vi');
            });

            allUsersData = users;
            renderUserGrid(usersContainer, users);
        }

        // Click 1 lần ủy quyền cho toàn bộ grid (thay onclick inline → chống attribute injection).
        (function () {
            const gridEl = document.getElementById('users-grid');
            if (!gridEl) return;
            gridEl.addEventListener('click', (e) => {
                const item = e.target.closest('[data-uid]');
                if (!item) return;
                if (typeof window.viewUserProfile === 'function') {
                    window.viewUserProfile(item.dataset.uid);
                }
            });
        })();

        function startUsersListener() {
            if (usersChannel) supabase.removeChannel(usersChannel);
            renderUsers();
            usersChannel = supabase.channel("profile-users")
                .on("postgres_changes", { event: "*", schema: "public", table: "users" }, () => renderUsers())
                .subscribe();
        }

        // Xem profile người khác
        window.viewUserProfile = function(userId) {
            const currentUrl = new URL(window.location.href);
            const currentViewUser = currentUrl.searchParams.get('user');

            // Nếu click vào cùng người, không làm gì
            if (currentViewUser === userId) {
                return;
            }

            // Cập nhật URL mà không reload trang
            const newUrl = `profile.html?user=${userId}`;
            window.history.pushState({ userId: userId }, '', newUrl);

            // Load profile người khác
            loadViewUserProfile(userId);
        };

        // Xem tất cả users (mở modal danh sách đầy đủ)
        window.viewAllUsers = function() {
            const modal = document.getElementById('all-users-modal');
            const listEl = document.getElementById('all-users-list');
            if (!modal || !listEl) return;

            const now = Date.now();
            const ACTIVE_THRESHOLD = 10000;

            let html = '';
            allUsersData.forEach(u => {
                const isOnline = u.online && u.last_active && (now - u.last_active) < ACTIVE_THRESHOLD;
                const statusColor = isOnline ? 'bg-green-500' : 'bg-red-500';
                const statusPulse = isOnline ? 'animate-pulse' : '';
                html += `
                    <button type="button" data-uid="${escapeHtml(u.id)}" class="w-full flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-white hover:shadow-sm transition-all text-left" style="border:none;background:transparent">
                        <div class="relative flex-shrink-0">
                            <img src="${escapeUrl(u.photo) || 'https://lh3.googleusercontent.com/a/default-user=s40'}" class="w-10 h-10 rounded-full border border-white shadow-sm object-cover">
                            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 ${statusColor} border-2 border-white rounded-full ${statusPulse}"></span>
                        </div>
                        <span class="text-sm font-semibold truncate" style="color:var(--text-main)">${escapeHtml(u.name) || 'User'}</span>
                        <span class="ml-auto text-[11px] font-bold flex-shrink-0 ${isOnline ? 'text-emerald-500' : 'text-gray-400'}">${isOnline ? '● Online' : '● Offline'}</span>
                    </button>
                `;
            });

            if (!allUsersData.length) {
                html = '<p class="text-sm font-medium text-center py-8" style="color:var(--text-sub)">Chưa có người dùng nào.</p>';
            }
            listEl.innerHTML = html;

            const countEl = document.getElementById('all-users-count');
            if (countEl) countEl.textContent = allUsersData.length + ' người';

            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
            modal.querySelector('div').classList.remove('scale-95');
            modal.querySelector('div').classList.add('scale-100');
        };

        window.closeAllUsersModal = function() {
            const modal = document.getElementById('all-users-modal');
            if (!modal) return;
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
            modal.querySelector('div').classList.add('scale-95');
            modal.querySelector('div').classList.remove('scale-100');
        };

        (function () {
            const modal = document.getElementById('all-users-modal');
            if (!modal) return;
            modal.addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closeAllUsersModal();
            });
            const listEl = document.getElementById('all-users-list');
            if (listEl) {
                listEl.addEventListener('click', (e) => {
                    const item = e.target.closest('[data-uid]');
                    if (!item) return;
                    closeAllUsersModal();
                    if (typeof window.viewUserProfile === 'function') {
                        window.viewUserProfile(item.dataset.uid);
                    }
                });
            }
        })();

        // Cleanup khi logout
        function cleanup() {
            if (activeInterval) {
                clearInterval(activeInterval);
                activeInterval = null;
            }
            if (usersChannel) {
                supabase.removeChannel(usersChannel);
                usersChannel = null;
            }
            if (viewUserChannel) {
                supabase.removeChannel(viewUserChannel);
                viewUserChannel = null;
            }
            if (ownProfileChannel) {
                supabase.removeChannel(ownProfileChannel);
                ownProfileChannel = null;
            }
            if (statsChannel) {
                supabase.removeChannel(statsChannel);
                statsChannel = null;
            }
        }

        // Đếm số chạy mượt từ 0 lên giá trị đích (count-up), tôn trọng reduced-motion
        function animateCountUp(el, target, opts) {
            if (!el) return;
            opts = opts || {};
            const decimals = opts.decimals || 0;
            const duration = opts.duration || 900;
            const formatter = opts.formatter || function (v) { return v.toFixed(decimals); };
            const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (reduceMotion || duration <= 0 || !isFinite(target)) { el.innerText = formatter(target); return; }
            if (el._cuRaf) cancelAnimationFrame(el._cuRaf);
            const start = performance.now();
            function frame(now) {
                const p = Math.min(1, (now - start) / duration);
                const eased = 1 - Math.pow(1 - p, 3);
                el.innerText = formatter(target * eased);
                if (p < 1) {
                    el._cuRaf = requestAnimationFrame(frame);
                } else {
                    el.innerText = formatter(target);
                    el._cuRaf = null;
                }
            }
            el._cuRaf = requestAnimationFrame(frame);
        }

        // Chỉ animate giờ online khi mới mở/đổi profile xem, các lần cập nhật realtime sau đó set thẳng
        let onlineAnimKey = null;
        function setOnlineDisplay(seconds, key) {
            const el = document.getElementById('profile-online-display');
            if (!el) return;
            if (onlineAnimKey !== key) {
                onlineAnimKey = key;
                animateCountUp(el, seconds, { formatter: formatTimer, duration: 1200 });
            } else {
                el.innerText = formatTimer(seconds);
            }
        }

        // Load stats theo UID
        async function fetchStats(uid) {
            const { data } = await supabase.from("test_stats")
                .select("total_tests, total_score, best_score")
                .eq("user_id", uid)
                .maybeSingle();

            if (data) {
                animateCountUp(document.getElementById('stat-total-tests'), data.total_tests || 0);
                animateCountUp(document.getElementById('stat-total-score'), parseFloat(data.total_score || 0), { decimals: 2 });
                animateCountUp(document.getElementById('stat-best-score'), parseFloat(data.best_score || 0), { decimals: 2 });

                const avg = data.total_tests ? (data.total_score / data.total_tests) : 0;
                animateCountUp(document.getElementById('stat-avg-score'), avg, { decimals: 2 });
            } else {
                document.getElementById('stat-total-tests').innerText = 0;
                document.getElementById('stat-total-score').innerText = "0.00";
                document.getElementById('stat-best-score').innerText = "0.00";
                document.getElementById('stat-avg-score').innerText = "0.00";
            }
        }

        function loadStatsForUser(uid) {
            if (statsChannel) {
                supabase.removeChannel(statsChannel);
                statsChannel = null;
            }
            fetchStats(uid);
            statsChannel = supabase.channel("profile-stats-" + uid)
                .on("postgres_changes", { event: "*", schema: "public", table: "test_stats", filter: "user_id=eq." + uid }, () => fetchStats(uid))
                .subscribe();
        }

        // ================= LỊCH SỬ LÀM BÀI =================
        let attemptsLoading = false;
        let attemptsHasLoaded = false;
        let attemptGroups = [];
        let attemptsPage = 0;
        let attemptsModalTrigger = null;
        const ATTEMPTS_PAGE_SIZE = 4;

        function formatDateTime(iso) {
            if (!iso) return "—";
            try {
                const d = new Date(iso);
                if (isNaN(d.getTime())) return "—";
                return d.toLocaleString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });
            } catch (e) { return "—"; }
        }

        function formatDurationMs(ms) {
            const n = Number(ms);
            if (!Number.isFinite(n) || n <= 0) return "";
            const total = Math.round(n / 1000);
            const h = Math.floor(total / 3600);
            const m = Math.floor((total % 3600) / 60);
            const s = total % 60;
            if (h > 0) return `${h}g ${m}p`;
            if (m > 0) return `${m}p ${s}s`;
            return `${s}s`;
        }

        function attemptScoreStyle(score) {
            const s = Number(score);
            if (s >= 8) return { bg: "rgba(16,185,129,.14)", fg: "#059669" };
            if (s >= 5) return { bg: "rgba(245,158,11,.16)", fg: "#d97706" };
            return { bg: "rgba(239,68,68,.12)", fg: "#dc2626" };
        }

        function answerTextOf(ans) {
            if (ans === null || ans === undefined) return "";
            if (typeof ans === "string") return ans;
            if (typeof ans === "object") return String(ans.text ?? ans.content ?? ans.value ?? "");
            return String(ans);
        }

        function imgUrlOf(v) {
            if (!v) return "";
            if (typeof v === "string") return escapeUrl(v) || "";
            if (typeof v === "object") return escapeUrl(v.url || v.src || "") || "";
            return "";
        }

        function audioListHtml(audio) {
            if (!audio) return "";
            const tracks = Array.isArray(audio) ? audio : [audio];
            return tracks.map((tr) => {
                const url = escapeUrl(typeof tr === "string" ? tr : (tr && tr.url) || "");
                if (!url) return "";
                const label = typeof tr === "string" ? "" : (tr.title || "");
                return `<div style="margin:6px 0;">${label ? `<div style="font-size:0.78rem;font-weight:600;color:var(--text-sub);margin-bottom:4px;">${escapeHtml(label)}</div>` : ""}<audio controls preload="none" style="width:100%;height:42px"><source src="${url}" type="audio/mpeg"></audio></div>`;
            }).join("");
        }

        function miniStat(label, value, color, bg) {
            return `<div class="lh-stat p-2.5" style="background:${bg};border-color:transparent">
                <div class="text-[10px] font-bold uppercase tracking-wider" style="color:${color}">${escapeHtml(label)}</div>
                <div class="text-sm font-extrabold mt-0.5" style="color:${color}">${escapeHtml(value)}</div>
            </div>`;
        }

        function attemptItemHtml(a) {
            const sc = Number(a.score) || 0;
            const scoreHidden = String(a.show_score || "always").toLowerCase() === "none";
            const st = scoreHidden ? { bg: "rgba(148,163,184,.14)", fg: "#64748b" } : attemptScoreStyle(sc);
            const dur = formatDurationMs(a.duration_ms);
            const metaBits = [];
            if (!scoreHidden && a.total_questions != null) metaBits.push(`Đúng ${a.correct_count ?? 0}/${a.total_questions}`);
            if (dur) metaBits.push(dur);
            metaBits.push(formatDateTime(a.created_at));
            return `<div class="attempt-item" data-attempt-id="${escapeHtml(a.id)}" role="button" tabindex="0" aria-label="Xem kết quả lần làm lúc ${escapeHtml(formatDateTime(a.created_at))}">
                <div class="attempt-score" style="background:${st.bg};color:${st.fg}">${scoreHidden ? "Ẩn" : sc}</div>
                <div style="flex:1;min-width:0">
                    <div class="text-[10.5px] font-medium truncate mt-0.5" style="color:var(--text-sub)">${metaBits.join(" · ")}</div>
                    ${a.auto_submitted ? `<span class="attempt-tag mt-1"><i class="fas fa-clock"></i> Tự động nộp</span>` : ""}
                </div>
                <span class="text-[10px] font-bold flex-shrink-0" style="color:var(--blue-accent)">Xem kết quả</span>
            </div>`;
        }

        function groupTestAttempts(rows) {
            const groups = new Map();
            (rows || []).forEach((attempt) => {
                const groupKey = String(attempt.test_id || attempt.test_name || attempt.id || "unknown");
                if (!groups.has(groupKey)) {
                    groups.set(groupKey, {
                        key: groupKey,
                        name: attempt.test_name || "",
                        description: attempt.test_description || "",
                        subject: attempt.subject || "",
                        attempts: []
                    });
                }
                const group = groups.get(groupKey);
                if (!group.description && attempt.test_description) group.description = attempt.test_description;
                if (!group.name && attempt.test_name) group.name = attempt.test_name;
                group.attempts.push(attempt);
            });
            return Array.from(groups.values()).sort((a, b) =>
                new Date(b.attempts[0]?.created_at || 0) - new Date(a.attempts[0]?.created_at || 0)
            );
        }

        function openAttemptsModal(groupIndex, trigger) {
            const group = attemptGroups[groupIndex];
            const modal = document.getElementById("attempts-modal");
            const title = document.getElementById("attempts-modal-title");
            const description = document.getElementById("attempts-modal-description");
            const list = document.getElementById("attempts-modal-list");
            if (!group || !modal || !title || !description || !list) return;
            title.textContent = group.name || "Bài kiểm tra";
            description.textContent = group.description || "Chưa có mô tả cho lần làm này.";
            list.innerHTML = group.attempts.map(attemptItemHtml).join("");
            attemptsModalTrigger = trigger || null;
            modal.hidden = false;
            document.getElementById("attempts-modal-close")?.focus();
        }

        function closeAttemptsModal(restoreFocus = true) {
            const modal = document.getElementById("attempts-modal");
            if (!modal || modal.hidden) return;
            modal.hidden = true;
            if (restoreFocus) attemptsModalTrigger?.focus();
            attemptsModalTrigger = null;
        }

        function renderAttemptGroups() {
            const listEl = document.getElementById("attempts-list");
            const pagination = document.getElementById("attempts-pagination");
            const prevBtn = document.getElementById("attempts-prev");
            const nextBtn = document.getElementById("attempts-next");
            const pageLabel = document.getElementById("attempts-page-label");
            if (!listEl) return;

            const pageCount = Math.ceil(attemptGroups.length / ATTEMPTS_PAGE_SIZE);
            if (!attemptGroups.length) {
                listEl.innerHTML = `<p class="text-xs font-medium text-center py-4" style="color:var(--text-sub)">Bạn chưa có lịch sử làm bài nào.</p>`;
                if (pagination) pagination.classList.add("hidden");
                return;
            }

            attemptsPage = Math.min(attemptsPage, pageCount - 1);
            const start = attemptsPage * ATTEMPTS_PAGE_SIZE;
            const visibleGroups = attemptGroups.slice(start, start + ATTEMPTS_PAGE_SIZE);
            listEl.innerHTML = visibleGroups.map((group, visibleIndex) => {
                const groupIndex = start + visibleIndex;
                const last = group.attempts[0];
                const scoreHidden = String(last.show_score || "always").toLowerCase() === "none";
                const score = scoreHidden ? "Ẩn" : String(Number(last.score) || 0);
                const lastTime = formatDateTime(last.created_at);
                const description = group.description
                    ? escapeHtml(group.description)
                    : "Chưa có mô tả cho lần làm này.";
                return `<article class="attempt-group">
                    <button type="button" class="attempt-group-head" data-attempt-group="${groupIndex}" aria-label="Mở danh sách lần làm: ${escapeHtml(group.name || "Bài kiểm tra")}">
                        <div class="attempt-group-copy">
                            <div class="text-[13px] font-bold truncate" style="color:var(--text-main)">${escapeHtml(group.name || "Bài kiểm tra")}</div>
                            <div class="text-[11px] mt-1 line-clamp-2" style="color:var(--text-sub)">${description}</div>
                            ${group.subject ? `<div class="text-[10px] font-semibold mt-1 truncate" style="color:var(--blue-accent)">${escapeHtml(group.subject)}</div>` : ""}
                        </div>
                        <div class="attempt-group-stats">
                            <div class="attempt-group-stat"><div class="attempt-group-stat-label">Tổng lần làm</div><div class="attempt-group-stat-value">${group.attempts.length}</div></div>
                            <div class="attempt-group-stat"><div class="attempt-group-stat-label">Lần cuối</div><div class="attempt-group-stat-value" title="${escapeHtml(lastTime)}">${escapeHtml(lastTime)}</div></div>
                            <div class="attempt-group-stat"><div class="attempt-group-stat-label">Điểm gần nhất</div><div class="attempt-group-stat-value">${score}</div></div>
                        </div>
                    </button>
                </article>`;
            }).join("");

            if (pagination) pagination.classList.toggle("hidden", pageCount <= 1);
            if (pageLabel) pageLabel.textContent = `Trang ${attemptsPage + 1} / ${pageCount}`;
            if (prevBtn) prevBtn.disabled = attemptsPage === 0;
            if (nextBtn) nextBtn.disabled = attemptsPage >= pageCount - 1;
        }

        async function loadAttemptsList(uid, options = {}) {
            const { reset = false } = options;
            const listEl = document.getElementById("attempts-list");
            if (!listEl || !uid || attemptsLoading) return;
            const showInitialSkeleton = reset && !attemptsHasLoaded;
            if (showInitialSkeleton) {
                attemptsPage = 0;
                listEl.innerHTML = `<div class="attempt-group p-3"><div class="skeleton rounded" style="width:60%;height:12px;margin-bottom:8px"></div><div class="skeleton rounded" style="width:85%;height:10px"></div></div>`;
            }
            attemptsLoading = true;
            try {
                const rows = await loadTestAttempts(uid);
                attemptGroups = groupTestAttempts(rows);
                attemptsHasLoaded = true;
                if (reset) attemptsPage = 0;
                renderAttemptGroups();
            } catch (e) {
                console.error("Tải lịch sử làm bài lỗi:", e);
                attemptsHasLoaded = true;
                if (showInitialSkeleton) listEl.innerHTML = `<p class="text-xs font-medium text-center py-4" style="color:#ef4444">Không tải được lịch sử làm bài. Hãy bấm nút tải lại để thử lại.</p>`;
            } finally {
                attemptsLoading = false;
            }
        }

        function openAttempt(id) {
            if (!id) return;
            window.history.pushState({ attempt: id }, "", "profile.html?attempt=" + encodeURIComponent(id));
            showAttemptDetail(id);
        }

        function showProfileGrid() {
            const box = document.getElementById("attempt-detail");
            if (box) { box.style.display = "none"; box.innerHTML = ""; }
            const grid = document.getElementById("profile-grid");
            if (grid) grid.style.display = "";
        }

        async function showAttemptDetail(id) {
            const box = document.getElementById("attempt-detail");
            const grid = document.getElementById("profile-grid");
            if (!box) return;
            if (grid) grid.style.display = "none";
            box.style.display = "block";
            box.innerHTML = `<div class="lh-card p-6 flex items-center justify-center gap-3" style="color:var(--text-sub)"><i class="fas fa-spinner fa-spin"></i> Đang tải bài làm...</div>`;

            let attempt;
            try {
                attempt = await loadTestAttempt(id);
            } catch (e) {
                console.error("Tải chi tiết bài làm lỗi:", e);
                box.innerHTML = `<div class="lh-card p-6 text-center space-y-3">
                    <p class="text-sm font-semibold" style="color:#ef4444">Không tải được chi tiết bài làm. Hãy quay lại và thử lại.</p>
                    <button id="attempt-back" type="button" class="px-4 py-2 rounded-xl text-xs font-bold" style="background:#f1f5f9;color:#475569">Quay lại</button>
                </div>`;
                bindAttemptBack();
                return;
            }
            if (!attempt) {
                box.innerHTML = `<div class="lh-card p-6 text-center space-y-3">
                    <p class="text-sm font-semibold" style="color:var(--text-sub)">Không tìm thấy bài làm này.</p>
                    <button id="attempt-back" type="button" class="px-4 py-2 rounded-xl text-xs font-bold" style="background:#f1f5f9;color:#475569">Quay lại</button>
                </div>`;
                bindAttemptBack();
                return;
            }
            box.innerHTML = renderAttemptDetail(attempt);
            bindAttemptBack();
        }

        function bindAttemptBack() {
            const btn = document.getElementById("attempt-back");
            if (btn) btn.addEventListener("click", () => window.history.back());
        }

        // Sanitize rich-text cho sectionDesc (giữ <b>/<i>/<u>... như trang quiz, gỡ thẻ lạ + mọi attribute)
        const SAFE_TEXT_TAGS = ["b", "i", "u", "em", "strong", "br", "span", "code"];
        function sanitizeHtml(html) {
            const body = new DOMParser().parseFromString(String(html || ""), "text/html").body;
            (function clean(parent) {
                Array.from(parent.children).forEach(function (el) {
                    const tag = el.tagName.toLowerCase();
                    if (SAFE_TEXT_TAGS.indexOf(tag) === -1) {
                        clean(el);
                        el.replaceWith(...el.childNodes);
                    } else {
                        Array.from(el.attributes).forEach(function (a) { el.removeAttribute(a.name); });
                        clean(el);
                    }
                });
            })(body);
            return body.innerHTML;
        }

        function renderOptionsHtml(answers, chosenIdx, correctIdx, canReveal) {
            const list = Array.isArray(answers) ? answers : [];
            if (!list.length) return "";
            return `<div class="answers-grid">` + list.map((ans, idx) => {
                const isCorrect = idx === Number(correctIdx);
                const isChosen = chosenIdx !== null && chosenIdx !== undefined && idx === Number(chosenIdx);
                let cls = "ans-label";
                if (canReveal) {
                    if (isCorrect) cls += " true-answer-highlight";
                    else if (isChosen) cls += " review-wrong";
                } else if (isChosen) {
                    cls += " selected";
                }
                const imgUrl = imgUrlOf(ans);
                const innerHtml = imgUrl
                    ? `<img class="ans-img" src="${imgUrl}" alt="Đáp án ${String.fromCharCode(65 + idx)}" loading="lazy" onerror="this.style.display='none'">`
                    : `<span>${sanitizeHtml(answerTextOf(ans))}</span>`;
                return `<div class="${cls}"><input type="radio" disabled ${isChosen ? "checked" : ""}>${innerHtml}</div>`;
            }).join("") + `</div>`;
        }

        function renderQuestionHtml(q, qNo, canReveal) {
            const type = q.type || "multiple";
            const idx = qNo - 1;
            let title = q.title || "";
            if (!title) {
                if (type === "passage") title = "Đọc đoạn văn và trả lời các câu hỏi bên dưới";
                else if (type === "cloze") title = "Điền từ thích hợp vào chỗ trống";
                else if (type === "short_answer") title = "Tự luận";
                else if (type === "true_false") title = q.question || "Đúng hay Sai";
                else title = q.question || "";
            }

            let inner = "";
            const imgUrl = imgUrlOf(q.image);
            if (imgUrl) inner += `<div class="q-image" style="text-align:center;margin:10px 0;"><img src="${imgUrl}" alt="" onerror="this.parentElement.style.display='none'" style="max-width:100%;max-height:250px;border-radius:10px;"></div>`;
            // Đề bài riêng (khi câu vừa có title vừa có question) hiển thị ở thân card — giống trang quiz
            if (q.title && q.question && q.question !== q.title) {
                inner += `<div style="margin-bottom:12px;font-size:0.95rem;line-height:1.6;font-weight:600;color:var(--text);">${sanitizeHtml(q.question)}</div>`;
            }

            let ok = null; // true/false khi xác định được, null khi ẩn đáp án

            if (type === "multiple") {
                const chosen = q.chosen === null || q.chosen === undefined ? null : Number(q.chosen);
                if (chosen !== null) ok = chosen === Number(q.correct);
                inner += renderOptionsHtml(q.answers, q.chosen, q.correct, canReveal);
            } else if (type === "true_false") {
                const subs = Array.isArray(q.subQuestions) ? q.subQuestions : [];
                const chosenArr = Array.isArray(q.chosen) ? q.chosen : [];
                let allOk = true;
                const optStyle = "cursor:pointer;display:flex;align-items:center;gap:3px;background:transparent;padding:4px 10px;border-radius:6px;border:1.2px solid var(--tf-border);font-size:0.85rem;";
                inner += `<div class="tf-wrapper" style="background:var(--card);border:1px solid var(--tf-border);border-radius:10px;overflow:hidden;">` + subs.map((sub, i) => {
                    const has = chosenArr[i] !== null && chosenArr[i] !== undefined;
                    const userVal = has ? Number(chosenArr[i]) : null;
                    const correctVal = Number(sub.correct);
                    const subOk = has && userVal === correctVal;
                    if (!subOk) allOk = false;
                    const bg = canReveal ? `background:${subOk ? "var(--success-light)" : "var(--danger-light)"};` : "";
                    const tip = canReveal ? `<span class="tf-answer-tip ${subOk ? "true-text" : "false-text"}"> (Đáp án: ${correctVal === 1 ? "Đúng" : "Sai"})</span>` : "";
                    return `<div class="tf-row" style="display:flex;align-items:center;justify-content:space-between;padding:10px;border-bottom:1px solid var(--tf-border);gap:10px;${bg}">
                        <div class="tf-question-text" style="flex:1;font-size:0.9rem;"><strong style="color:var(--primary)">${String.fromCharCode(97 + i)}.</strong> <span>${sanitizeHtml(sub.text || "")}</span>${tip}</div>
                        <div class="tf-options" style="display:flex;gap:5px;flex-shrink:0;">
                            <label style="${optStyle}"><input type="radio" disabled ${userVal === 1 ? "checked" : ""}> <b>Đ</b></label>
                            <label style="${optStyle}"><input type="radio" disabled ${userVal === 0 ? "checked" : ""}> <b>S</b></label>
                        </div>
                    </div>`;
                }).join("") + `</div>`;
                if (canReveal) ok = allOk;
            } else if (type === "short_answer") {
                const chosen = q.chosen == null ? "" : String(q.chosen);
                const correct = q.correctAnswer == null ? "" : String(q.correctAnswer);
                const subOk = chosen.trim().toLowerCase() === correct.trim().toLowerCase();
                const border = canReveal ? (subOk ? "var(--success)" : "var(--danger)") : "#e2e8f0";
                inner += `<textarea class="short-input writing-input" disabled rows="${q.rows || 3}" style="width:100%;box-sizing:border-box;padding:12px;border:2px solid ${border};border-radius:10px;outline:none;font-size:0.95rem;resize:vertical;font-family:inherit;line-height:1.6;color:var(--text);background:var(--card);">${escapeHtml(chosen)}</textarea>`;
                if (canReveal) {
                    ok = subOk;
                    inner += `<div class="true-text" style="margin-top:10px;">✓ Đáp án chuẩn: ${sanitizeHtml(correct)}</div>`;
                }
            } else if (type === "passage") {
                const subs = Array.isArray(q.subQuestions) ? q.subQuestions : [];
                const chosenArr = Array.isArray(q.chosen) ? q.chosen : [];
                let allOk = true;
                const subsHtml = subs.map((sub, i) => {
                    const chosen = chosenArr[i] === null || chosenArr[i] === undefined ? null : Number(chosenArr[i]);
                    const subOk = chosen !== null && chosen === Number(sub.correct);
                    if (!subOk) allOk = false;
                    const border = canReveal ? ` style="border-color:${subOk ? "var(--success)" : "var(--danger)"};"` : "";
                    return `<div class="sub-q-block"${border}>
                        <div class="sub-q-text" style="font-weight:600;font-size:0.92rem;margin-bottom:10px;"><strong style="color:var(--primary)">${String.fromCharCode(97 + i)}.</strong> ${sanitizeHtml(sub.question || "")}</div>
                        ${renderOptionsHtml(sub.answers, chosenArr[i], sub.correct, canReveal)}
                    </div>`;
                }).join("");
                const passageContent = q.passage ? `<div class="passage-left"><div class="passage-left-inner">${sanitizeHtml(q.passage)}</div></div>` : "";
                inner += `<div class="passage-layout">${passageContent}<div class="passage-right sub-questions">${subsHtml}</div></div>`;
                if (canReveal) ok = allOk;
            } else if (type === "cloze") {
                const chosenArr = Array.isArray(q.chosen) ? q.chosen : [];
                const blanks = Array.isArray(q.blanks) ? q.blanks : [];
                let allOk = true;
                let text = sanitizeHtml(String(q.question || ""));
                text = text.replace(/\{\{(\d+)\}\}/g, (m, n) => {
                    const i = parseInt(n, 10) - 1;
                    const val = chosenArr[i];
                    const correctVal = blanks[i] === undefined ? "" : String(blanks[i]);
                    const has = val !== undefined && val !== null && String(val).trim() !== "";
                    const subOk = has && String(val).trim().toLowerCase() === correctVal.trim().toLowerCase();
                    if (!subOk) allOk = false;
                    const w = Math.max(80, ((correctVal.length || (has ? String(val).length : 0) || 8)) * 10);
                    const style = canReveal
                        ? `border-color:${subOk ? "var(--success)" : "var(--danger)"};background:${subOk ? "var(--success-light)" : "var(--danger-light)"};`
                        : "";
                    let out = `<input type="text" class="cloze-input short-input" disabled value="${has ? escapeHtml(String(val)) : ""}" style="width:${w}px;min-width:80px;box-sizing:border-box;padding:6px 8px;border:2px solid #e2e8f0;border-radius:8px;font-size:0.9rem;text-align:center;${style}">`;
                    if (canReveal && !subOk) out += `<span class="cloze-answer-tip true-text" style="margin-left:6px;font-size:0.8rem;">(${sanitizeHtml(correctVal)})</span>`;
                    return out;
                });
                if (canReveal) ok = allOk;
                inner += `<div style="background:var(--card);padding:14px;border-radius:10px;border:1px solid var(--tf-border);line-height:2.1;font-size:1rem;color:var(--text);">${text}</div>`;
            }

            let cardCls = "question-card";
            if (canReveal && ok !== null) cardCls += ok ? " review-true" : " review-false";
            const html = `<div class="${cardCls}" id="card-${idx}" style="margin-bottom:20px;padding:15px;">
                <div class="q-header" style="margin-bottom:12px;font-size:0.95rem;">
                    <span class="q-badge" style="background:var(--primary);color:white;padding:2px 8px;border-radius:15px;font-size:0.75rem;font-weight:bold;margin-right:5px;">Câu ${qNo}</span> 
                    <span>${sanitizeHtml(title)}</span>
                </div>
                ${inner}
            </div>`;
            return { html, ok: canReveal ? ok : null };
        }

        function renderAttemptDetail(a) {
            const paper = (a && a.paper) || {};
            const meta = paper.meta || {};
            const result = paper.result || {};
            const sections = Array.isArray(paper.sections) ? paper.sections : [];

            const showAnswers = meta.showAnswers || "always";
            const showScore = meta.showScore || "always";
            const scoreHidden = String(showScore).toLowerCase() === "none";
            const score = Number(result.score != null ? result.score : (a.score || 0));
            const canReveal = showAnswers === "always" || (showAnswers === "perfect" && score >= 10);

            const st = scoreHidden ? { bg: "rgba(148,163,184,.14)", fg: "#64748b" } : attemptScoreStyle(score);
            const dur = formatDurationMs(result.durationMs != null ? result.durationMs : a.duration_ms);
            const correct = result.correctCount != null ? result.correctCount : (a.correct_count ?? 0);
            const total = result.totalQuestions != null ? result.totalQuestions : (a.total_questions ?? 0);
            const autoSub = result.autoSubmitted != null ? result.autoSubmitted : a.auto_submitted;
            const title = meta.name || a.test_name || "Bài kiểm tra";
            const subject = meta.subject || a.subject || "";
            const maxScore = meta.maxScore != null ? meta.maxScore : (a.max_score ?? 10);

            let qNo = 0;
            let body = "";
            let nav = "";
            if (sections.length) {
                sections.forEach((sec) => {
                    // Tiêu đề phần — inline giống hệt trang quiz
                    if (sec.sectionTitle) {
                        nav += `<div class="nav-section-label" style="grid-column:1/-1;font-weight:bold;margin:10px 0 5px;font-size:0.7rem;color:#64748b;text-transform:uppercase;">${escapeHtml(sec.sectionTitle)}</div>`;
                        const descHtml = (sec.sectionDesc && String(sec.sectionDesc).trim() !== "")
                            ? `<div style="margin-top:4px;font-size:0.78rem;color:var(--text-sub);font-weight:normal;font-style:italic;line-height:1.4;">${sanitizeHtml(sec.sectionDesc)}</div>`
                            : "";
                        body += `<div style="margin:25px 0 15px;padding:12px 15px;background:#eff6ff;color:#1a73e8;border-radius:8px;border-left:5px solid #1a73e8;">
                            <div style="font-weight:bold;text-transform:uppercase;font-size:0.95rem;display:block !important;">${escapeHtml(sec.sectionTitle)}</div>
                            ${descHtml}
                        </div>`;
                    }
                    if (sec.passage && sec.type !== "passage") {
                        body += `<div style="background:var(--card);padding:14px 18px;border-radius:12px;border:1px solid var(--tf-border);line-height:1.75;margin-bottom:14px;color:var(--text);">${sanitizeHtml(sec.passage)}</div>`;
                    }
                    const aHtml = audioListHtml(sec.audio);
                    if (aHtml) {
                        body += `<div style="background:var(--primary-light);border:1px solid var(--primary);border-radius:12px;padding:12px;margin-bottom:14px;">
                            <div style="font-weight:700;color:var(--primary);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="fas fa-headphones"></i> Phần Nghe${sec.listenTitle ? " · " + escapeHtml(sec.listenTitle) : ""}</div>
                            ${aHtml}
                        </div>`;
                    }
                    (sec.questions || []).forEach((q) => {
                        const r = renderQuestionHtml(q, qNo + 1, canReveal);
                        body += r.html;
                        const navStyle = (r.ok === null) ? "" : ` style="background:${r.ok ? "var(--success)" : "var(--danger)"};color:white;"`;
                        nav += `<div class="nav-item" id="nav-${qNo}" onclick="scrollToQuestion(${qNo})"${navStyle}>${qNo + 1}</div>`;
                        qNo++;
                    });
                });
            } else {
                body = `<p class="at-empty-note">Không có dữ liệu bài làm chi tiết cho lần nộp này.</p>`;
            }

            const progressHtml = scoreHidden
                ? `<span id="progressText" style="color:var(--primary);font-size:0.9rem;">Đã nộp bài</span>`
                : `<span id="progressText" style="color:var(--success);font-size:0.9rem;">${score.toFixed(2)} / ${maxScore}</span>`;

            return `<div class="space-y-3">
                <div class="lh-card p-4 sm:p-5 space-y-3">
                    <div class="flex items-center gap-3">
                        <button id="attempt-back" type="button" class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors" style="background:#f1f5f9;color:#475569" title="Quay lại"><i class="fas fa-arrow-left"></i></button>
                        <div style="flex:1;min-width:0">
                            <h3 class="text-base sm:text-lg font-extrabold truncate" style="color:var(--text-main)">${escapeHtml(title)}</h3>
                            <p class="text-xs font-semibold truncate" style="color:var(--text-sub)">${subject ? escapeHtml(subject) + " · " : ""}${formatDateTime(a.created_at)}</p>
                        </div>
                        ${scoreHidden ? "" : `<div class="attempt-score" style="background:${st.bg};color:${st.fg};min-width:56px;font-size:20px">${score}</div>`}
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        ${miniStat("Đúng", scoreHidden ? "Ẩn" : `${correct}/${total}`, "#2563eb", "rgba(37,99,235,.08)")}
                        ${miniStat("Thời gian", dur || "—", "#8b5cf6", "rgba(139,92,246,.08)")}
                        ${miniStat("Thang điểm", String(maxScore), "#f59e0b", "rgba(245,158,11,.1)")}
                        ${miniStat("Trạng thái", autoSub ? "Tự động nộp" : "Đã nộp", autoSub ? "#ef4444" : "#10b981", autoSub ? "rgba(239,68,68,.08)" : "rgba(16,185,129,.08)")}
                    </div>
