<script>
/* ===== POSTMESSAGE: nhận user từ parent (index.html) ===== */
window.learnHubUser = null;
window.addEventListener('message', async function(event) {
  if (event.data && event.data.type === 'LEARNHUB_USER') {
    const receivedUser = event.data.user;
    window.learnHubUser = receivedUser;
    if (typeof window.__forumApplyHeaderUser === 'function') window.__forumApplyHeaderUser(receivedUser);
    if (typeof window.__forumSetUser === 'function') await window.__forumSetUser(receivedUser);
  }
  // [FIX BUG #26] Xử lý luôn USER_INFO tại đây (đã gộp listener) để chỉ còn 1 chỗ apply user
  if (event.data && event.data.type === 'USER_INFO' && event.data.user) {
    window.learnHubUser = event.data.user;
    if (typeof window.__forumApplyHeaderUser === 'function') window.__forumApplyHeaderUser(event.data.user);
    if (typeof window.__forumSetUser === 'function') await window.__forumSetUser(event.data.user);
  }
  if (event.data && event.data.type === 'DARK_MODE') {
    if (event.data.value) document.body.classList.add('dark-mode');
    else document.body.classList.remove('dark-mode');
  }
  if (event.data && event.data.type === 'REDUCED_MOTION') {
    document.body.classList.toggle('cc-reduced', !!event.data.value);
  }
});

// Fallback: đọc dark mode + reduced motion từ localStorage khi mở standalone
if (localStorage.getItem("darkMode") === "on") {
  document.body.classList.add("dark-mode");
}
if (localStorage.getItem("cc_reduce") === "on") {
  document.body.classList.add("cc-reduced");
}
</script>

