                    </div>`;
            }
            // 🔥 [Tiếng Anh] Điền lỗ: câu văn có nhiều ô trống {{1}}, {{2}}...
            else if (item.type === 'cloze') {
                window.totalMaxScore += 1;
                let clozeHtml = esc(String(item.question || ""));
                const blanks = item.blanks || [];
                clozeHtml = clozeHtml.replace(/\{\{(\d+)\}\}/g, (m, n) => {
                    const idx = parseInt(n, 10) - 1;
                    const placeholder = (blanks[idx] !== undefined) ? "" : "Trống";
                    return `<input type="text" class="cloze-input short-input" placeholder="${placeholder}..." oninput="markDone(${globalIdx})" data-qidx="${globalIdx}" data-blank="${idx}" style="width: ${Math.max(80, (blanks[idx] ? blanks[idx].length : 8) * 10)}px; min-width: 80px; box-sizing: border-box; padding: 6px 8px; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 0.9rem; text-align: center;">`;
