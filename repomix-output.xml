<!-- POPUP -->
<div id="popup" class="popup">
  <div class="popup-box">
   <div class="celebrate-icon">🎉</div>
   <h2>Hoàn thành!</h2>
   <p>Bạn đã bùng nổ, chinh phục tất cả từ của chủ đề này! 🎯</p>
   <button onclick="restartGame()">Học lại nha!</button>
</div>
  <div class="confetti-container" id="confettiContainer"></div>
</div>
<!-- SCRIPT -->
<script>
function formatTopicNameFromDataFile(dataFile) {
    const clean = (dataFile || "data.js")
        .split("/")
        .pop()
        .replace(".js", "")
        .replace(/[_-]+/g, " ")
        .trim();

    if (!clean || clean.toLowerCase() === "data") return "Bộ từ vựng mặc định";
    return clean.replace(/\b\w/g, c => c.toUpperCase());
}

function resolveTopicName(dataFile) {
    // Ưu tiên tên được khai báo trong file data (global).
    const globalTopicName = window.TOPIC_NAME || window.topicName || window.topic_title;
    if (typeof globalTopicName === "string" && globalTopicName.trim()) {
        return globalTopicName.trim();
    }
    // Fallback theo tên file data.
    return formatTopicNameFromDataFile(dataFile);
}

function setTopicNameLabel(topicName) {
    const topicEl = document.getElementById("topicName");
    if (topicEl) topicEl.textContent = topicName || "Bộ từ vựng mặc định";
}

function enterApp() {
    const intro = document.getElementById("intro-screen");
    if (!intro || intro.style.display === "none") return;

    intro.style.opacity = "0";
    intro.style.pointerEvents = "none";

    setTimeout(() => {
        intro.style.display = "none";
    }, 500);
}

// Auto-skip intro screen if opened from hub (has data param)
(function() {
    const params = new URLSearchParams(window.location.search);
    if (params.get("data") || params.get("set")) {
        const intro = document.getElementById("intro-screen");
        if (intro) {
            intro.style.display = "none";
        }
    }
})();

function hideLoadPopup() {
    const p = document.getElementById("loadPopup");
    if (!p) return;
    p.style.opacity = "0";
    setTimeout(() => p.remove(), 400);
}

function loadDataScript() {
    const params = new URLSearchParams(window.location.search);
    const dataFile = params.get("data") || "data.js"; 
    // Hiển thị tạm theo tên file trước khi data script load xong.
    setTopicNameLabel(formatTopicNameFromDataFile(dataFile));

    const script = document.createElement("script");
    script.src = dataFile;

    script.onload = () => {
        // Sau khi data script load, ưu tiên tên khai báo trong chính file data.
        setTopicNameLabel(resolveTopicName(dataFile));

        const gameScript = document.createElement("script");
        gameScript.src = "../../scripts/features/game.js?v=11";

        gameScript.onload = () => {
            if (typeof setTotal === 'function') {
                setTotal();
            }
            hideLoadPopup();
        };

        gameScript.onerror = () => {
            hideLoadPopup();
            lhToast("Không tải được game.js", 'error');
        };

        document.body.appendChild(gameScript);
    };

    script.onerror = () => {
        hideLoadPopup();
        lhToast("Không tải được dữ liệu: " + dataFile, 'error');
    };

    document.body.appendChild(script);
}

// Nếu mở theo ?set=<id> (bộ từ lưu trên DB), chờ module supabase sẵn sàng rồi lấy dữ liệu.
// Ngược lại thì load file JS tĩnh như cũ.
function startLoad() {
    const params = new URLSearchParams(window.location.search);
    const setId = params.get("set");
    if (setId) {
        setTopicNameLabel(formatTopicNameFromDataFile("set_" + setId));
        if (window.__fcLoadSet) { window.__fcLoadSet(setId); return; }
        // [FIX BUG #16] Giới hạn số lần chờ để tránh setInterval chạy vô hạn nếu
        // __fcLoadSet không bao giờ xuất hiện (script lỗi/không tải được).
        let tries = 0;
        const MAX_TRIES = 150; // ~15s
        const wait = setInterval(() => {
            tries++;
            if (window.__fcLoadSet) {
                clearInterval(wait);
                window.__fcLoadSet(setId);
            } else if (tries >= MAX_TRIES) {
                clearInterval(wait);
                hideLoadPopup();
                if (typeof lhToast === 'function') lhToast("Không tải được bộ flashcard. Vui lòng thử lại.", 'error');
            }
        }, 100);
        return;
    }
    loadDataScript();
}

startLoad();

// Settings management
const settingsModal = document.createElement("div");
settingsModal.id = "settingsModal";
settingsModal.className = "settings-modal";
settingsModal.innerHTML = `
  <div class="settings-box">
    <div class="settings-header">
      <h3>Cài đặt</h3>
      <button id="settingsClose" class="settings-close" type="button">✕</button>
    </div>
    <div class="settings-content">
      <div class="setting-item">
        <div>
          <div class="setting-label">Nhạc nền</div>
          <div class="setting-desc">Điều chỉnh âm lượng nhạc nền</div>
        </div>
        <input type="range" id="bgmVolume" min="0" max="1" step="0.1" value="1" style="width: 120px; accent-color: #2563eb;">
      </div>
      <div class="setting-item">
        <div>
          <div class="setting-label">Hiệu ứng âm thanh</div>
          <div class="setting-desc">Điều chỉnh âm lượng hiệu ứng</div>
        </div>
        <input type="range" id="sfxVolume" min="0" max="1" step="0.1" value="0.5" style="width: 120px; accent-color: #2563eb;">
      </div>
      <div class="setting-item">
        <div>
          <div class="setting-label">Giọng đọc</div>
          <div class="setting-desc">Điều chỉnh âm lượng giọng đọc từ</div>
        </div>
        <input type="range" id="speechVolume" min="0" max="1" step="0.1" value="1" style="width: 120px; accent-color: #2563eb;">
      </div>
    </div>
  </div>
`;
document.body.appendChild(settingsModal);

// Load settings from localStorage
function loadSettings() {
  const saved = localStorage.getItem("learnhubSettings");
  if (saved) {
    try {
      const settings = JSON.parse(saved);
      document.getElementById("bgmVolume").value = settings.bgmVolume ?? 1;
      document.getElementById("sfxVolume").value = settings.sfxVolume ?? 0.5;
      document.getElementById("speechVolume").value = settings.speechVolume ?? 1;
    } catch (e) {
      // [FIX BUG #14] Bỏ qua settings hỏng
    }
  }
}

// Save settings to localStorage
function saveSettings() {
  const settings = {
    bgmEnabled: parseFloat(document.getElementById("bgmVolume").value) > 0,
    bgmVolume: parseFloat(document.getElementById("bgmVolume").value),
    sfxEnabled: parseFloat(document.getElementById("sfxVolume").value) > 0,
    sfxVolume: parseFloat(document.getElementById("sfxVolume").value),
    speechEnabled: parseFloat(document.getElementById("speechVolume").value) > 0,
    speechVolume: parseFloat(document.getElementById("speechVolume").value)
  };
  localStorage.setItem("learnhubSettings", JSON.stringify(settings));
}

// Open settings modal
function openSettings() {
  settingsModal.classList.add("show");
}

// Settings modal controls
document.getElementById("settingsClose").addEventListener("click", () => {
  settingsModal.classList.remove("show");
});

settingsModal.addEventListener("click", (e) => {
  if (e.target === settingsModal) {
    settingsModal.classList.remove("show");
  }
});

// Save settings when sliders change
document.getElementById("bgmVolume").addEventListener("input", () => {
  saveSettings();
  if (typeof reloadGameSettings === 'function') reloadGameSettings();
  if (typeof applyBGMSetting === 'function') applyBGMSetting();
  // Demo BGM
  if (typeof bgmDemo !== 'undefined') bgmDemo();
});
document.getElementById("sfxVolume").addEventListener("input", () => {
  saveSettings();
  if (typeof reloadGameSettings === 'function') reloadGameSettings();
  // Demo SFX
  if (typeof soundclick !== 'undefined' && typeof playSound === 'function' && settings.sfxVolume > 0) {
    playSound(soundclick);
  }
});
document.getElementById("speechVolume").addEventListener("input", () => {
  saveSettings();
  if (typeof reloadGameSettings === 'function') reloadGameSettings();
  // Demo Speech
  if (typeof speak === 'function' && settings.speechVolume > 0) {
    speak('Hello');
  }
});

// Load settings on page load
loadSettings();

function openDictionary(word) {
  const cleanWord = word.trim().split(/\s+/)[0].toLowerCase();
  if (!cleanWord) return;
  const url = `https://dictionary.cambridge.org/vi/dictionary/english/${encodeURIComponent(cleanWord)}`;
  document.getElementById('dictWordDisplay').textContent = cleanWord;
  document.getElementById('dictDirectLink').href = url;
  document.getElementById('dictContent').innerHTML = '<div style="text-align:center;padding:30px 0;color:#94a3b8;">🔍 Đang tra từ...</div>';
  document.getElementById('dictPopup').classList.add('show');
  fetchDictInfo(cleanWord);
}

function closeDictPopup(e) {
  if (e && e.target !== document.getElementById('dictPopup')) return;
  document.getElementById('dictPopup').classList.remove('show');
}

async function fetchDictInfo(word) {
  const el = document.getElementById('dictContent');
  try {
    const res = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(word)}`);
    if (!res.ok) throw new Error('Not found');
    const data = await res.json();
    const entry = data[0];
    let html = '';
    // [FIX BUG #34] Escape dữ liệu trả về từ API từ điển trước khi gán innerHTML
    const esc = (s)=>(s||"").replace(/[<>&"']/g,c=>({"<": "&lt;",">": "&gt;","&": "&amp;","\"": "&quot;","'": "&#039;"})[c]);
    if (entry.phonetic) {
      html += `<div style="margin-bottom:12px;"><span style="font-weight:700;color:#475569;font-size:13px;">🔤 Phiên âm:</span> <span style="color:#6366f1;font-size:16px;">/${esc(entry.phonetic)}/</span></div>`;
    }
    entry.meanings.slice(0, 3).forEach(m => {
      html += `<div style="margin-bottom:14px;"><span style="display:inline-block;background:#eef2ff;color:#4f46e5;padding:2px 10px;border-radius:6px;font-size:12px;font-weight:700;text-transform:uppercase;">${esc(m.partOfSpeech||"")}</span>`;
      m.definitions.slice(0, 2).forEach(d => {
        html += `<div style="margin-top:8px;padding-left:10px;border-left:3px solid #6366f1;">
          <div><span style="font-weight:700;color:#475569;font-size:13px;">📖 Định nghĩa:</span> <span style="color:#1e293b;">${esc(d.definition||"")}</span></div>`;
        if (d.example) html += `<div style="color:#64748b;font-size:13px;margin-top:4px;"><span style="font-weight:700;color:#475569;">✏️ Ví dụ:</span> <span style="font-style:italic;">${esc(d.example||"")}</span></div>`;
        html += `</div>`;
      });
      html += `</div>`;
    });
    el.innerHTML = html;
  } catch {
    const esc2 = (s)=>(s||"").replace(/[<>&"']/g,c=>({"<": "&lt;",">": "&gt;","&": "&amp;","\"": "&quot;","'": "&#039;"})[c]);
    el.innerHTML = `<div style="text-align:center;padding:20px 0;">
      <div style="font-size:40px;margin-bottom:10px;">🤷</div>
      <div style="font-weight:700;color:#64748b;">Không tìm thấy từ "${esc2(word)}"</div>
      <div style="font-size:13px;color:#94a3b8;margin-top:4px;">Bấm nút bên dưới để tra trên Cambridge</div>
    </div>`;
  }
}
</script>
<script>
window.learnHubUser = null;
window.addEventListener('message', function(event) {
  if (event.data && event.data.type === 'LEARNHUB_USER') {
    window.learnHubUser = event.data.user;
  }
  if (event.data && event.data.type === 'DARK_MODE') {
    if (event.data.value) document.body.classList.add('dark-mode');
    else document.body.classList.remove('dark-mode');
  }
});
if (localStorage.getItem("darkMode") === "on") {
  document.body.classList.add("dark-mode");
}
</script>

<script type="module">
  import { supabase } from "../../scripts/core/supabase-config.js";

  // Load bộ từ từ Supabase theo ?set=<id>, gán dữ liệu cho engine cũ rồi nạp game.js.
  // Ai cũng đọc được (RPC cấp quyền anon, authenticated); sửa/thêm chỉ Giáo viên qua RPC.
  window.__fcLoadSet = async function(setId) {
    try {
      const { data, error } = await supabase.rpc("get_flashcard_set", { p_set_id: setId });
      if (error) throw error;
      if (!data || !data.length) throw new Error("Bộ từ không tồn tại");
      const s = data[0];
      window.TOPIC_NAME = s.name || "Bộ từ vựng";
      const raw = Array.isArray(s.cards) ? s.cards : [];
      window.cards = raw.map((c, i) => ({
        id: i + 1,
        front: c.front,
        back: c.back,
        ...(c.example ? { example: c.example } : {}),
        ...(c.description ? { description: c.description } : {}),
        ...(c.level ? { level: c.level } : {})
      }));
      setTopicNameLabel(window.TOPIC_NAME);

      const gameScript = document.createElement("script");
      gameScript.src = "../../scripts/features/game.js?v=11";
      gameScript.onload = () => {
        if (typeof setTotal === 'function') setTotal();
        hideLoadPopup();
      };
      gameScript.onerror = () => {
        hideLoadPopup();
        lhToast("Không tải được game.js", 'error');
      };
      setTimeout(() => document.body.appendChild(gameScript), 0);
    } catch (e) {
      console.error("get_flashcard_set lỗi:", e);
      hideLoadPopup();
      lhToast("Không tải được bộ từ: " + (e.message || e), 'error');
    }
  };
</script>
</body>
</html>
