/* ===== COMPLETION POPUP REFRESH ===== */
.popup {
  background:
    radial-gradient(circle at 22% 18%, rgba(236, 72, 153, 0.22), transparent 34%),
    radial-gradient(circle at 82% 20%, rgba(37, 99, 235, 0.22), transparent 36%),
    rgba(15, 23, 42, 0.42);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.popup-box {
  width: min(430px, calc(100% - 34px));
  padding: 30px 24px 24px;
  border-radius: 28px;
  border: 1px solid rgba(255, 255, 255, 0.82);
  background:
    radial-gradient(circle at top right, rgba(236, 72, 153, 0.16), transparent 38%),
