<script>
// 🔒 API Key được ẩn trên Cloudflare Worker - không bao giờ lộ ra trên frontend
    const WORKER_URL = "https://hubie-proxy.quanhao678.workers.dev";
    // DEEPL_PROXY_URL: proxy dịch máy DeepL chạy trên Cloudflare Worker
    const DEEPL_PROXY_URL = "https://deepl-proxy.quanhao678.workers.dev";

    let chatHistory = [];
    // [FIX BUG #14] Bọc try/catch quanh JSON.parse: localStorage hỏng → mảng rỗng thay vì sập script
    try {
      const raw = localStorage.getItem("hubie_chat_history");
