    <!-- Main Content -->
    <main class="max-w-lg w-full text-center space-y-6 sm:space-y-8 my-auto z-10 px-2 sm:px-4">

      <!-- Spinning icon with pulse -->
      <div class="flex justify-center maintenance-fade-up">
        <div class="p-5 sm:p-6 bg-gradient-to-br from-blue-100 to-cyan-100 rounded-full text-[#0066cc] shadow-lg shadow-blue-500/20 maintenance-pulse">
          <svg class="maintenance-spin-slow maintenance-glow w-16 h-16 sm:w-20 sm:h-20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93s.844.083 1.168-.142l.748-.56a1.125 1.125 0 011.543.169l.773.773a1.125 1.125 0 01.17 1.543l-.561.748c-.225.324-.258.78-.142 1.168s.506.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.424.07-.764.384-.93.78s-.083.844.142 1.168l.56.748a1.125 1.125 0 01-.169 1.543l-.773.773a1.125 1.125 0 01-1.543.17l-.748-.561c-.324-.225-.78-.258-1.168-.142s-.71.506-.78.93l-.15.893c-.09.543-.56.94-1.109.94h-1.094c-.55 0-1.02-.397-1.11-.94l-.148-.893c-.071-.424-.384-.764-.781-.93s-.844-.083-1.168.142l-.748.56a1.125 1.125 0 01-1.543-.169l-.773-.773a1.125 1.125 0 01-.17-1.543l.561-.748c.225-.324.258-.78.142-1.168s-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.764-.384.93-.78s.083-.844-.142-1.168l-.56-.748a1.125 1.125 0 01.17-1.543l.772-.773a1.125 1.125 0 011.543-.17l.748.561c.324.225.78.258 1.168.142s.71-.506.78-.93l.15-.894z"/>
