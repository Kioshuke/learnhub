<script>
// ==================== HIỆU ỨNG REVEAL KHI CUỘN (tối ưu hiệu năng mobile) ====================
(function () {
  var items = document.querySelectorAll('.reveal-item');
  if (!items.length) return;

  var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var observerSupported = 'IntersectionObserver' in window;

  if (prefersReduced || !observerSupported) {
    items.forEach(function (el) { el.classList.add('in-view'); });
    return;
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('in-view');
      observer.unobserve(entry.target);
    });
  }, { rootMargin: '0px 0px -40px 0px', threshold: 0.12 });

  items.forEach(function (el) { observer.observe(el); });
})();
</script>

<script>
// ==================== CAROUSEL TÍNH NĂNG NỔI BẬT (tự động phóng to từng card, màu nổi quanh card active) ====================
(function () {
  var section = document.getElementById('featuredFeatures');
  var grid = section ? section.querySelector('.feature-grid') : null;
  if (!grid) return;
  var cards = grid.querySelectorAll('.feature-card');
  if (cards.length < 2) return;

  var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tạo dấu chấm điều hướng (dot indicator)
  var dotsWrap = document.createElement('div');
  dotsWrap.className = 'feature-dots';
  for (var d = 0; d < cards.length; d++) {
    (function (idx) {
      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.setAttribute('role', 'button');
      dot.setAttribute('tabindex', '0');
      dot.addEventListener('click', function () { setActive(idx); start(); });
      dotsWrap.appendChild(dot);
    })(d);
  }
  section.appendChild(dotsWrap);
  var dots = dotsWrap.querySelectorAll('.dot');

  if (prefersReduced) return;

  var current = -1;
  var timer = null;
  var paused = false;

  function getColor(card) {
    var c = card.style.getPropertyValue('--feat-color');
    return (c || '#2563eb').trim();
  }

  function setActive(index) {
    index = (index + cards.length) % cards.length;
    current = index;
    for (var i = 0; i < cards.length; i++) {
      cards[i].classList.toggle('active', i === index);
      dots[i].classList.toggle('active', i === index);
    }
    dotsWrap.style.setProperty('--feat-dot', getColor(cards[index]));
    if (!prefersReduced) {
      var target = cards[index].offsetLeft - (grid.clientWidth - cards[index].offsetWidth) / 2;
      grid.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
    }
  }

  function start() {
    stop();
    timer = setInterval(function () {
      if (paused || document.hidden) return;
      setActive(current + 1);
    }, 2000);
  }

  function stop() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  setActive(0);
  start();

  grid.addEventListener('mouseenter', function () { paused = true; });
  grid.addEventListener('mouseleave', function () { paused = false; });
  grid.addEventListener('touchstart', function () { paused = true; }, { passive: true });
  grid.addEventListener('touchend', function () { paused = false; }, { passive: true });
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { stop(); } else { start(); }
  });

  cards.forEach(function (card) {
    card.addEventListener('click', function () {
      setActive(Array.prototype.indexOf.call(cards, card));
      start();
    });
  });
})();
</script>
