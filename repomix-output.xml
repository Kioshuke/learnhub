          </span>
        </h1>
        <p class="text-sm sm:text-base lg:text-lg text-slate-600 max-w-md mx-auto leading-relaxed">
          Hệ sinh thái học tập trực tuyến <b class="text-[#0066cc]">LearnHub</b> đang được nâng cấp để tối ưu hóa tính năng và trải nghiệm người dùng. Chúng mình sẽ quay lại sớm nhất có thể!
        </p>
      </div>

      <!-- Animated progress bar -->
      <div class="maintenance-fade-up-3">
        <div class="w-full h-2.5 rounded-full overflow-hidden bg-slate-200 max-w-xs sm:max-w-sm mx-auto shadow-inner relative">
          <div class="h-full rounded-full bg-gradient-to-r from-[#0066cc] via-cyan-400 to-[#0066cc] bg-[length:200%_100%] maintenance-bar shadow-lg"></div>
        </div>
        <p class="text-[10px] text-slate-400 mt-2 tracking-wider uppercase">Đang tải bản cập nhật...</p>
      </div>

      <!-- Status card -->
      <div class="inline-block px-4 sm:px-6 py-3 sm:py-4 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200 shadow-lg max-w-xs sm:max-w-sm w-full maintenance-fade-up-4 hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center justify-center gap-2 mb-1">
          <span class="inline-block w-2 h-2 rounded-full bg-amber-400 status-blink"></span>
          <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-slate-400">Trạng thái hiện tại</p>
        </div>
        <p id="maintenanceStatusText" class="text-sm sm:text-base font-bold text-slate-700">Đang cập nhật...</p>
      </div>

      <!-- CTA button -->
      <div class="maintenance-fade-up-5">
        <a href="https://zalo.me/0335925257" target="_blank" class="group inline-flex items-center gap-2 bg-[#ff7b29] hover:bg-[#e0631b] text-white font-semibold px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl shadow-lg shadow-orange-500/30 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-orange-500/40 hover:scale-105 text-sm sm:text-base">
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          <span>Liên hệ ban quản trị</span>
        </a>
      </div>

    </main>

    <!-- Footer -->
    <footer class="w-full text-center py-3 sm:py-4 text-[10px] sm:text-xs text-slate-500/70 z-10 maintenance-fade-up-5">
      &copy; 2026 LearnHub Platform - Hệ sinh thái học tập thông minh cho học sinh sinh viên.
    </footer>
  </div>

  <script type="module">
  import { subscribeMaintenance, logAppError } from "./scripts/core/supabase-config.js";
  window.logAppError = logAppError;

  try{
    console.log("[MAINTENANCE PAGE] Starting maintenance listener...");
    subscribeMaintenance((data) => {
      const enabled = data.enabled;
      const message = data.message;
      const statusEl = document.getElementById('maintenanceStatusText');
      console.log("[MAINTENANCE PAGE] Realtime update - enabled:", enabled, "message:", message);
      if(statusEl) statusEl.textContent = message ? message : 'Đang cập nhật...';
      if(!enabled){
        console.log("[MAINTENANCE PAGE] Maintenance disabled, redirecting to login.html");
        try { window.location.replace('/pages/auth/login.html'); } catch(e){ window.location.href = '/pages/auth/login.html'; }
      } else {
        console.log("[MAINTENANCE PAGE] Maintenance still enabled, staying on maintenance page");
      }
    });
  } catch(e){
    console.warn('Không thể lắng nghe trạng thái bảo trì:', e);
  }
  </script>
</body>
</html>
