/* ===== Feedback Animation ===== */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.feedback-show {
  animation: fadeSlideUp 0.5s ease forwards;
}

/* Score animations */
@keyframes shake {
  0%,100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  75% { transform: translateX(4px); }
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

@keyframes pop {
  0% { transform: scale(0.9); }
  100% { transform: scale(1); }
}

@keyframes bounceGlow {
  0% { transform: scale(0.9); box-shadow: 0 0 0 rgba(0,0,0,0); }
  50% { transform: scale(1.1); box-shadow: 0 0 20px rgba(34,197,94,0.5); }
  100% { transform: scale(1); box-shadow: 0 0 0 rgba(0,0,0,0); }
}
#confetti-container {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3000;
    overflow: hidden;
}

/* hạt pháo */
.confetti {
    position: absolute;
    width: 10px;
    height: 14px;
    opacity: 0.95;
    border-radius: 2px;
    will-change: transform;
}

@keyframes explode {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 1;
    }
    100% {
        transform: translate(var(--x), var(--y)) scale(0.9);
        opacity: 1;
    }
}

@keyframes fallReal {
    0% {
        transform: translate(var(--x), var(--y)) rotate(0deg);
        opacity: 1;
    }
    100% {
        transform: translate(calc(var(--x) + var(--fallX)), calc(var(--y) + 700px)) rotate(360deg);
        opacity: 0;
    }
}
/* rơi xuống sau khi nổ */
@keyframes fallDown {
    0% {
        transform: translate(0, -200px) rotate(0deg);
        opacity: 1;
    }
    100% {
        transform: translate(var(--fallX), 300px) rotate(720deg);
        opacity: 0;
    }
}
