/* ============================================================================
   5.11 BANG MAU DARK CHUAN — 1 NOI DUY NHAT (quan tri muc 4/5.1-5.10)
   ----------------------------------------------------------------------------
   🔴 TẤT CẢ biến màu dark dùng chung đều khai báo TẠI ĐÂY, đứng CUỐI file để
   cascade thắng mọi block cũ. Giá trị light kéo theo bên :root đầu file.
   Muốn đổi màu nền/khung/chữ/tô sáng khi dark mode → chỉ sửa khối này.
   ⚠️ KHÔNG khai lại biến màu ở block dưới; nếu cần màu riêng cho 1 trang thì
   dùng tên biến khác, không trùng tên để không đè lên bảng chuẩn.
   ============================================================================ */
body.dark-mode {
  /* Nền */
  --bg: #0f172a;
  --bg-main: #0f172a;
  --bg-deep: #0f172a;
  --bg-pattern: #1e293b;

  /* Chữ */
  --text: #f1f5f9;
  --text-main: #f1f5f9;
  --text-sub: #94a3b8;
  --text-faint: #64748b;
  --text-mute: #cbd5e1;
  --text-soft: #93c5fd;
  --sub: #94a3b8;
  --muted: #64748b;

  /* Card & Surface (nền đặc theo bảng chuẩn) */
  --card: #1e293b;
  --card-bg: #1e293b;
  --card-border: #334155;
  --card-text: #f1f5f9;
  --card-sub: #cbd5f5;
  --card-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  --surface: #1e293b;
  --surface-2: #334155;
  --surface-soft: #1a2332;

  /* Khung & đường kẻ */
  --border: #1e293b;
  --border-strong: #334155;
  --border-weak: #475569;

  /* Component dùng chung */
  --input-bg: #1e293b;
  --notice-bg: #1e293b;
  --notice-border: #334155;
  --quiz-bg: #1e293b;
  --quiz-border: #334155;

  /* Menu & Popup */
  --menu-bg: rgba(30, 41, 59, 0.7);
  --popup-bg: rgba(30, 41, 59, 0.9);

  /* Accent */
  --accent: #3b82f6;
  --blue-accent: #3b82f6;
  --accent-soft: #60a5fa;
  --accent-deep: #1d4ed8;

  /* Footer */
  --footer-bg: #1e293b;
  --footer-border: #334155;
  --footer-shadow: rgba(0, 0, 0, 0.2);
  --footer-brand-color: #93c5fd;
  --footer-heading-color: #93c5fd;
  --footer-text: #cbd5f5;
  --footer-text-strong: #f1f5f9;
  --footer-link-hover: #60a5fa;
  --footer-social-bg: #0f172a;
  --footer-social-text: #cbd5f5;
  --footer-divider: #334155;
  --footer-bottom-text: #94a3b8;

  /* Slideshow & AI Hubie */
  --hubie-bg: linear-gradient(135deg, #1e293b, #0f172a);
  --hubie-text: #60a5fa;
  --warn-text: #fbbf24;
  --warn-border: #1f2937;

  /* Tint background (profile...) */
  --tint-blue: rgba(59, 130, 246, 0.16);
  --tint-green: rgba(52, 211, 153, 0.14);
  --tint-violet: rgba(167, 139, 250, 0.16);
  --tint-amber: rgba(251, 191, 36, 0.14);
}

/* ===== Ghim header khi cuộn (chỉ tab: home, forum, blog, tài liệu) =====
   #lh-header-placeholder là div bọc header (nạp từ header.html). Đặt display:contents
   để .menu lấy <body> làm containing block -> position:sticky dính suốt trang.
   <body> chỉ có overflow-x:clip (không tạo scroll container) nên sticky vẫn chạy. */
#lh-header-placeholder{ display: contents; }

body.sticky-header .menu{
  position: sticky;
  top: 0;
  z-index: 1000;
}

/* Chừa đúng chiều cao header khi cuộn tới đầu tab (tránh header ghim che mất nội dung).
   --lh-menu-h được JS đo và gán; mặc định 80px nếu chưa đo được. */
body.sticky-header #forum,
body.sticky-header #blog,
body.sticky-header #tai-lieu{
  scroll-margin-top: var(--lh-menu-h, 80px);
}

/* Dòng chữ chạy: thu gọn khi đã cuộn, hiện lại khi về đầu trang (chỉ tab ghim header).
   Header là nền mờ (rgba .7 + backdrop-filter) nên phải ẩn hẳn ticker, không để lộ mờ. */
body.sticky-header .ticker-container{
  transition: max-height .22s ease, opacity .18s ease, padding .22s ease;
  max-height: 120px;
}
body.sticky-header.header-scrolled .ticker-container{
  max-height: 0;
  padding-top: 0;
  padding-bottom: 0;
  opacity: 0;
  overflow: hidden;
}
</file>

<file path="styles/quiz-review.css">
/* ============================================================================
   quiz-review.css — CSS DÙNG CHUNG cho card câu hỏi + chế độ xem lại (review)
   ----------------------------------------------------------------------------
   Nguồn duy nhất cho: card câu hỏi, ô đáp án, đúng/sai, đọc hiểu, điền lỗ và
   toàn bộ màu "review mode". Được link bởi:
     - pages/cauhoi/questionenglish.html
     - pages/cauhoi/filetest.html
     - pages/user/profile.html   (khung "Lịch sử làm bài")

   Các biến màu (--primary, --card, --text, --success...) KHÔNG khai báo ở đây.
   Trang nào dùng thì tự cung cấp: 2 trang quiz khai báo ở :root trong <style>;
   profile.html khai báo ở :root (light) và nhận dark mode từ global.css.
   ============================================================================ */

/* ============================ CARD CÂU HỎI ============================ */
.question-card {
  background: var(--card-gradient);
  border-radius: 20px;
  padding: 25px;
  margin-bottom: 25px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  border: 2px solid rgba(0, 0, 0, 0.05);
  color: var(--text);
}
.q-header { display: block; gap: 12px; margin-bottom: 20px; font-weight: 600; font-size: 1.05rem; align-items: flex-start; line-height: 1.6; }
.q-badge {
  display: inline-block;
  background: var(--primary-light);
  color: var(--primary);
  padding: 2px 10px;
  border-radius: 8px;
  font-size: 0.8rem;
  margin-right: 8px;
  vertical-align: middle;
}

/* ============================ Ô ĐÁP ÁN ============================ */
.answers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.ans-label {
  border: 2px solid #e2e8f0; padding: 14px; border-radius: 12px;
  cursor: pointer; display: flex; align-items: center; transition: all 0.2s;
  position: relative; overflow: hidden; align-items: center;
}
.ans-img { display: block; max-width: 100%; max-height: 150px; margin: 0 auto; border-radius: 9px; object-fit: contain; background: #fff; }
.ans-label:hover:not(.disabled) { background: var(--anshover); border-color: #cbd5e1; }
.ans-label.selected { border-color: var(--primary); background: var(--primary-light); }

/* ============================ TỰ LUẬN / ĐIỀN LỖ ============================ */
.short-input:focus {
  outline: none;
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 3px var(--primary-light);
}
/* Không dùng !important để màu đúng/sai ở review mode (đặt inline) ghi đè được */
.cloze-input {
  border: 2px solid #e2e8f0;
  color: var(--text);
  background: var(--card);
}
.cloze-answer-tip { font-weight: 700; }

/* ============================ ĐÚNG / SAI ============================ */
.tf-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-top: 15px;
}
.tf-wrapper {
  background: var(--card);
  border: 1px solid var(--tf-border);
  border-radius: 10px;
  overflow: hidden;
}
.tf-row {
  display: flex;
  align-items: center;
  padding: 12px;
  border-bottom: 1px solid var(--tf-border);
  gap: 15px;
  transition: background 0.2s;
  background: var(--tf-bg);
}
.tf-row:hover { background: var(--tf-hover); }
.tf-question-text { flex: 1; font-size: 0.95rem; line-height: 1.5; }
.tf-options { display: flex; gap: 10px; }
.tf-options input { accent-color: var(--primary); }
.tf-options label { transition: all 0.2s; }
.tf-options input:checked + b { color: var(--primary); }

/* ============================ ĐỌC HIỂU (PASSAGE) ============================ */
.passage-layout { display: flex; gap: 20px; align-items: flex-start; }
.passage-left {
  flex: 1;
  min-width: 0;
  position: sticky;
  top: 100px;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  padding-right: 12px;
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}
.passage-left::-webkit-scrollbar { width: 5px; }
.passage-left::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
.passage-left-inner {
  background: var(--card);
  padding: 18px 20px;
  border-radius: 14px;
  border: 2px solid var(--primary);
  border-left: 5px solid var(--primary);
  line-height: 1.75;
  font-size: 0.95rem;
  box-shadow: 0 2px 8px rgba(26, 115, 232, 0.08);
  position: relative;
}
.passage-left-inner::before {
  content: "📖";
  position: absolute;
  top: -10px;
  left: 14px;
  background: var(--bg);
  padding: 0 6px;
  font-size: 1rem;
}
.passage-right {
  flex: 1.1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.sub-q-block {
  background: var(--card);
  border: 1.5px solid var(--tf-border);
  border-radius: 12px;
  padding: 14px 16px;
  transition: border-color 0.2s;
}
.sub-q-block:hover { border-color: var(--primary); }
.passage-right .answers-grid { grid-template-columns: 1fr; gap: 8px; }

/* ============================ REVIEW MODE ============================ */
.review-correct { border: 2px solid var(--success) !important; background: transparent !important; }
.review-wrong { border: 2px solid var(--danger) !important; background: transparent !important; }
.ans-label.review-wrong { background: var(--answrong) !important; }
.true-answer-highlight { border: 2px solid var(--info) !important; background: var(--primary-light) !important; }
.true-answer-highlight::after { content: "✓ Đáp án đúng"; position: absolute; right: 8px; top: 2px; font-size: 0.65rem; color: var(--info); font-weight: bold; }

.review-true {
  background: var(--success-light) !important;
  border-color: var(--success) !important;
}
.review-false {
  background: var(--danger-light) !important;
  border-color: var(--danger) !important;
}

.true-text { color: var(--true-asw); font-weight: bold; }
.false-text { color: var(--false-asw); font-weight: bold; }

/* Khóa bài ở chế độ xem lại */
.quiz-locked { user-select: text; }
.quiz-locked .ans-label,
.quiz-locked .tf-options label { pointer-events: none; }
.quiz-locked .tf-row:hover { background: var(--tf-hover); }
.quiz-locked .ans-label:hover {
  background: var(--tf-hover) !important;
  border-color: var(--tf-border) !important;
  cursor: not-allowed;
}

/* ============================ RESPONSIVE ============================ */
@media (max-width: 1024px) {
  .question-card { padding: 15px; margin-bottom: 12px; border-radius: 12px; }
  .answers-grid { grid-template-columns: 1fr; gap: 8px; }
}
@media (max-width: 900px) {
  .passage-layout { flex-direction: column; }
  .passage-left { position: static; max-height: none; overflow-y: visible; padding-right: 0; }
  .passage-left-inner { max-height: 260px; overflow-y: auto; scrollbar-width: thin; }
}
@media (max-width: 600px) {
  .answers-grid { grid-template-columns: 1fr; }
}

/* ============================ MỤC LỤC (SIDEBAR) ============================ */
/* Bố cục 2 cột: phần bài làm + thanh mục lục bên phải (giống các trang quiz) */
.main-layout { display: flex; gap: 25px; align-items: flex-start; width: 100%; }
.quiz-section { flex: 2; min-width: 0; }

.sidebar {
  width: 280px;
  min-width: 300px;
  max-width: 400px;
  background: var(--card);
  padding: 20px;
  border-radius: 20px;
  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  position: sticky;
  top: 85px;
  border: 1px solid #e2e8f0;
}
.sidebar-header { font-weight: 800; margin-bottom: 15px; display: flex; justify-content: space-between; }
.nav-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
  gap: 6px;
}
.nav-item {
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  border-radius: 8px; border: 1px solid #e2e8f0; font-size: 0.8rem;
  font-weight: 600; cursor: pointer; transition: 0.2s; background: transparent;
}
.nav-item.done { background: var(--primary-light); border-color: var(--primary); color: var(--primary); }
.nav-item:hover { border-color: var(--primary); }
.nav-item.nav-correct { background: #ecfdf5 !important; border-color: var(--success) !important; color: var(--success) !important; }
.nav-item.nav-wrong { background: #fef2f2 !important; border-color: var(--danger) !important; color: var(--danger) !important; }

.mobile-nav-btn { display: none; position: fixed; bottom: 20px; right: 20px; }

@media (max-width: 1024px) {
  .mobile-nav-btn {
    display: flex !important;
    position: fixed !important;
    bottom: 30px; right: 20px;
    width: 50px; height: 50px;
    background: var(--primary); color: white;
    border-radius: 50%; border: none;
    align-items: center; justify-content: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    z-index: 9999; font-size: 20px; cursor: pointer;
  }
  /* Mục lục khi mở trên điện thoại: hiện dạng popup giữa màn hình */
  .sidebar {
    display: none;
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2100;
    max-height: 75vh;
    overflow-y: auto;
    width: 92%;
    max-width: 420px;
    padding: 15px;
    border-radius: 16px;
  }
  .main-layout { display: block; }
}
</file>

<file path="supabase/blog.sql">
-- ============================================================================
-- LearnHub Blog (blog.sql)
-- ----------------------------------------------------------------------------
-- Cách dùng: dán toàn bộ file này vào Supabase Dashboard -> SQL Editor -> Run
-- Idempotent: chạy lại nhiều lần vẫn an toàn.
--
-- Mô hình:
--   • blog_posts  — bài viết do ADMIN soạn từ Dashboard (tab "Blog").
--   • Nội dung lưu dạng HTML (rich text editor), ảnh chỉ dán URL.
--   • Đọc công khai: ai cũng xem được bài đã publish (kể cả khách chưa đăng nhập).
--   • Ghi: chỉ admin (theo public.is_admin() trong schema.sql).
-- ============================================================================

create extension if not exists "pgcrypto";

-- ============================== TABLE ==============================
create table if not exists public.blog_posts (
  id          uuid primary key default gen_random_uuid(),
  title       text not null default '',
  excerpt     text not null default '',
  content     text not null default '',
  cover_url   text,
  category    text not null default 'Tin tức',
  tags        text[] not null default '{}',
  author      text not null default 'Ban Quản Trị LearnHub',
  author_id   text,
  published   boolean not null default true,
  pinned      boolean not null default false,
  views       int not null default 0,
  created_at  timestamptz not null default now(),
  updated_at  timestamptz not null default now()
);

create index if not exists blog_posts_created_idx     on public.blog_posts (created_at desc);
create index if not exists blog_posts_published_idx   on public.blog_posts (published, pinned desc, created_at desc);
create index if not exists blog_posts_category_idx    on public.blog_posts (category);

-- ============================== RLS ==============================
alter table public.blog_posts enable row level security;

-- Đọc công khai: mọi người (kể cả anon) xem bài đã publish.
drop policy if exists blog_posts_select_public on public.blog_posts;
create policy blog_posts_select_public on public.blog_posts
  for select to anon, authenticated using (published = true);

-- Admin xem được cả bản nháp.
drop policy if exists blog_posts_select_admin on public.blog_posts;
create policy blog_posts_select_admin on public.blog_posts
  for select to authenticated using (public.is_admin());

-- Chỉ admin được thêm / sửa / xoá.
drop policy if exists blog_posts_write_admin on public.blog_posts;
create policy blog_posts_write_admin on public.blog_posts
  for all to authenticated using (public.is_admin()) with check (public.is_admin());

-- ============================== TRIGGER: updated_at ==============================
-- Chỉ coi là "cập nhật" khi các cột NỘI DUNG đổi. Riêng lượt xem (views) tăng lên
-- KHÔNG làm đổi updated_at (nếu không, mỗi lượt xem lại đụng updated_at + phát realtime).
create or replace function public.blog_touch_updated_at()
returns trigger
language plpgsql
as $$
begin
  if (new.title, new.excerpt, new.content, new.cover_url, new.category, new.tags,
      new.author, new.author_id, new.published, new.pinned)
     is distinct from
     (old.title, old.excerpt, old.content, old.cover_url, old.category, old.tags,
      old.author, old.author_id, old.published, old.pinned)
  then
    new.updated_at := now();
  else
    new.updated_at := old.updated_at;
  end if;
  return new;
end;
$$;

drop trigger if exists blog_posts_touch on public.blog_posts;
create trigger blog_posts_touch
  before update on public.blog_posts
  for each row execute function public.blog_touch_updated_at();

-- ============================== RPC: tăng lượt xem ==============================
-- Công khai (anon + authenticated), chỉ tăng cho bài đã publish.
create or replace function public.blog_increment_views(p_id uuid)
returns void
language plpgsql security definer
set search_path = public
as $$
begin
  if p_id is null then
    return;
  end if;
  update public.blog_posts
     set views = views + 1
   where id = p_id
     and published = true;
end;
$$;

revoke execute on function public.blog_increment_views(uuid) from public;
grant execute on function public.blog_increment_views(uuid) to anon, authenticated;

-- Tăng lượt xem cho NHIỀU bài trong 1 request (gộp nhiều lượt mở bài lại).
-- Trùng id trong mảng = cộng bấy nhiêu lần (giữ đúng nghĩa "mỗi lần mở +1").
-- Dùng cho khách (không có heartbeat) hoặc khi rời trang, để đỡ số request.
create or replace function public.blog_increment_views_many(p_ids uuid[])
returns void
language plpgsql security definer
set search_path = public
as $$
begin
  if p_ids is null or array_length(p_ids, 1) is null then
    return;
  end if;
  update public.blog_posts b
     set views = b.views + c.cnt
    from (
      select t.id, count(*)::int as cnt
        from unnest(p_ids) as t(id)
       group by t.id
    ) c
   where b.id = c.id
     and b.published = true;
end;
$$;

revoke execute on function public.blog_increment_views_many(uuid[]) from public;
grant execute on function public.blog_increment_views_many(uuid[]) to anon, authenticated;

-- ==================== RPC: heartbeat "online" + lượt xem (gộp 1 request) ====================
-- Y HỆT public.users_heartbeat trong schema.sql, chỉ thêm phần cộng lượt xem cho
-- các bài trong p_view_ids. Nhờ vậy mỗi nhịp online 5 giây vừa cập nhật "đang online"
-- vừa đếm lượt xem trong CÙNG 1 request (không tạo thêm lượt gửi riêng).
-- Gọi với p_view_ids rỗng/null thì chỉ cập nhật online như cũ.
create or replace function public.users_heartbeat_views(p_uid text, p_view_ids uuid[] default '{}'::uuid[])
returns void
language plpgsql security definer
set search_path = public
as $$
declare
  now_ms bigint := (extract(epoch from clock_timestamp()) * 1000)::bigint;
begin
  if auth.uid()::text <> p_uid and not public.is_admin() then
    raise exception 'Forbidden';
  end if;

  update public.users
    set last_active = now_ms,
        online = true
    where id = p_uid
      and not coalesce(disabled, false)
      and online = true;

  if p_view_ids is not null and array_length(p_view_ids, 1) is not null then
    update public.blog_posts b
       set views = b.views + c.cnt
      from (
        select t.id, count(*)::int as cnt
          from unnest(p_view_ids) as t(id)
         group by t.id
      ) c
     where b.id = c.id
       and b.published = true;
  end if;
end;
$$;

revoke execute on function public.users_heartbeat_views(text, uuid[]) from public;
grant execute on function public.users_heartbeat_views(text, uuid[]) to authenticated;

-- ==================== RPC: hồ sơ tác giả (đồng bộ avatar) ====================
-- Ảnh đại diện tác giả lấy TRỰC TIẾP từ public.users.photo (đồng bộ "sống" theo
-- user trong DB: user đổi avatar -> bài viết cũ cũng tự hiển thị avatar mới).
-- Vì anon KHÔNG đọc được public.users (RLS users_select chỉ cho authenticated),
-- ta mở một đường công khai bằng function security definer — chỉ trả về những
-- user CÓ bài blog đã publish (không lộ toàn bộ bảng users).
create or replace function public.blog_authors()
returns table (id text, name text, photo text)
language sql
security definer
stable
set search_path = public
as $$
  select u.id::text, u.name, u.photo
  from public.users u
  where exists (
    select 1 from public.blog_posts b
    where b.author_id = u.id
      and b.published = true
  );
$$;

revoke execute on function public.blog_authors() from public;
grant execute on function public.blog_authors() to anon, authenticated;

-- ============================== GRANTS ==============================
-- Bảng tạo sau schema.sql nên phải cấp quyền lại (RLS vẫn là lớp chặn chính).
grant select on public.blog_posts to anon, authenticated;
grant insert, update, delete on public.blog_posts to authenticated;

-- ============================== REALTIME ==============================
do $$
begin
  if not exists (
    select 1 from pg_publication_tables
    where pubname = 'supabase_realtime'
      and schemaname = 'public'
      and tablename = 'blog_posts'
  ) then
    alter publication supabase_realtime add table public.blog_posts;
  end if;
end $$;
</file>

