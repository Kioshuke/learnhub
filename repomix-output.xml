    /* ===== STICKY SIDEBAR TOC (CARD) ===== */
    .toc-sidebar{position:sticky;top:100px;grid-column:1;grid-row:2;width:auto;height:fit-content;background:#ffffff;border:1px solid #e2e8f0;border-radius:16px;padding:20px 16px;box-shadow:0 6px 20px rgba(15,23,42,0.07);z-index:100;align-self:start}
