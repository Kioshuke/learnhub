// Kiểm tra trạng thái lúc mới load (đề phòng mở riêng trang này)
// 1. Kiểm tra Dark Mode (Giữ nguyên logic của bạn)
if (localStorage.getItem("darkMode") === "on") {
    document.body.classList.add("dark-mode");
}

// Mã bài kiểm tra từ URL — bắt buộc dạng t:<uuid> (đề 100% lưu trong database)
const urlParams = new URLSearchParams(window.location.search);
const TEST_DE = (urlParams.get('de') || "").trim();

let questionsData = [];
window.totalMaxScore = 0; 
let totalQuestions = 0;

// --- Biến cho đồng hồ đếm ngược / tính giờ làm bài ---
let examTimeLimitSeconds = 0; // Tổng số giây được làm bài (lấy từ timeLimit trong JSON, đơn vị phút)
let remainingSeconds = 0;     // Số giây còn lại
let timerInterval = null;
let examStartTime = null;     // Mốc thời gian bắt đầu làm bài (Date.now())
let examEndTime = null;       // Mốc thời gian khi nộp bài
let isSubmitted = false;      // Tránh nộp bài 2 lần (vd: vừa hết giờ vừa bấm nộp)
const DEFAULT_EXAM_TIME_LIMIT_MINUTES = 15;

// ── ĐỀ ĐỌC 100% TỪ DATABASE: de=t:<uuid> → lấy bản ghi test_sets qua RPC get_test_content,
// áp dụng trực tiếp các cột: score (điểm tối đa), shuffle_q (trộn câu hỏi),
// shuffle_a (trộn đáp án), minutes (thời gian). Không còn đọc file JSON tĩnh.
let examConfig = { maxScore: 10, shuffleQ: true, shuffleA: true, showScore: 'always', showAnswers: 'always', reviewLocked: true, subtestEnabled: false, subtestCount: null };

// [Lịch sử làm bài] Thông tin đề (môn/tên) chép lại vào mỗi lần nộp, đọc từ get_test_content
let examMeta = { subject: "", name: "" };

function getExamTimeLimitSeconds(data) {
    const sections = Array.isArray(data) ? data : (Array.isArray(data.sections) ? data.sections : []);
    const rawLimit =
        Number(data && data.timeLimit) ||
        Number(data && data.duration) ||
        Number(data && data.durationMinutes) ||
        Number(sections.find(section => Number(section.timeLimit) > 0)?.timeLimit) ||
        DEFAULT_EXAM_TIME_LIMIT_MINUTES;

    return Math.max(0, Math.round(rawLimit * 60));
}

// 3. Hàm xáo trộn mảng (Giữ nguyên)
function shuffle(array) {
    for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
}

// Đề con: bốc ngẫu nhiên N card câu hỏi trên TOÀN BỘ đề (mỗi card = 1 câu).
// Chọn trước rồi mới xáo thứ tự câu/đáp án theo cấu hình. Passage/đọc hiểu
// là 1 card nên được giữ nguyên cả cụm.
function pickSubtestSections(sections, count) {
    const list = Array.isArray(sections) ? sections : [];
    const flat = [];
    list.forEach((section, si) => {
        if (!section || !Array.isArray(section.questions)) return;
        section.questions.forEach(q => flat.push({ si, q }));
    });
    const n = Math.floor(Number(count));
    if (!Number.isFinite(n) || n <= 0 || n >= flat.length) return list;

    const bySection = new Map();
    shuffle(flat.slice()).slice(0, n).forEach(({ si, q }) => {
        if (!bySection.has(si)) bySection.set(si, new Set());
        bySection.get(si).add(q);
    });

    return list.reduce((out, section, si) => {
        const keep = bySection.get(si);
        if (!keep || !section || !Array.isArray(section.questions)) return out;
        const questions = section.questions.filter(q => keep.has(q));
        if (questions.length) out.push({ ...section, questions });
        return out;
    }, []);
}

// 4. Hàm tải câu hỏi linh hoạt
async function loadQuestions() {
    try {
        if (!/^t:[0-9a-f-]{8,}$/i.test(TEST_DE)) {
            throw new Error('Mã bài kiểm tra không hợp lệ. Vui lòng mở từ Phòng Học.');
        }
        const supabase = await import('../../scripts/core/supabase-config.js').then(m => m.supabase);
        const { data: rpcData, error } = await supabase.rpc('get_test_content', { p_de: TEST_DE });
        if (error) throw error;
        if (!rpcData || rpcData.ok !== true || !Array.isArray(rpcData.content)) {
            throw new Error((rpcData && rpcData.error === 'not_found')
                ? 'Không tìm thấy bài kiểm tra trong database'
                : 'Không tải được bài kiểm tra từ database');
        }
        const data = rpcData.content;

        // [Lịch sử làm bài] chép môn/tên đề để lưu kèm mỗi lần nộp
        examMeta.subject = rpcData.subject || "";
        examMeta.name = rpcData.name || "";
        examMeta.description = rpcData.description || "";

        // Đọc cấu hình từ các CỘT trong test_sets
        const rawScore = Number(rpcData.score);
        examConfig.maxScore = (!isNaN(rawScore) && rawScore > 0) ? rawScore : 10;
        examConfig.shuffleQ = !(rpcData.shuffle_q === false || rpcData.shuffle_q === 0);
        examConfig.shuffleA = !(rpcData.shuffle_a === false || rpcData.shuffle_a === 0);
        examConfig.showScore = (rpcData.show_score === 'none') ? 'none' : 'always';
        examConfig.showAnswers = (rpcData.show_answers === 'none' || rpcData.show_answers === 'perfect')
            ? rpcData.show_answers : 'always';
        const rawMinutes = Number(rpcData.minutes);
        examTimeLimitSeconds = (!isNaN(rawMinutes) && rawMinutes > 0) ? Math.round(rawMinutes * 60) : 0;
        const rawSubtestEnabled = rpcData.subtest_enabled === true || rpcData.subtest_enabled === 1 || rpcData.subtest_enabled === 'true';
        const rawSubtestCount = Number(rpcData.subtest_count);
        examConfig.subtestEnabled = rawSubtestEnabled && Number.isFinite(rawSubtestCount) && rawSubtestCount > 0;
        examConfig.subtestCount = examConfig.subtestEnabled ? Math.floor(rawSubtestCount) : null;
        
        totalQuestions = 0; 

        // Đề con: chọn N card ngẫu nhiên trước, sau đó mới xáo câu/đáp án.
        const sourceData = examConfig.subtestEnabled
            ? pickSubtestSections(data, examConfig.subtestCount)
            : data;

        // Xáo trộn theo cấu hình: trộn câu hỏi (shuffleQ) + trộn đáp án (shuffleA)
        questionsData = sourceData.map(section => {
            const sourceQuestions = examConfig.shuffleQ ? shuffle(section.questions) : section.questions;
            const sectionQuestions = sourceQuestions.map(q => {
                totalQuestions++; 
                
                if (q.type === 'multiple' && q.answers) {
                    const mixed = q.answers.map((ans, i) => ({ text: ans, isCorrect: i === q.correct }));
                    if (examConfig.shuffleA) shuffle(mixed);
                    return {
                        ...q,
                        answers: mixed.map(a => a.text),
                        correct: mixed.findIndex(a => a.isCorrect)
                    };
                }
                if (q.type === 'true_false' && q.subQuestions) {
                    const mixedSub = examConfig.shuffleQ ? shuffle([...q.subQuestions]) : q.subQuestions;
                    return { ...q, subQuestions: mixedSub };
                }
                return q;
            });

            return {
                sectionTitle: section.sectionTitle,
                sectionDesc: section.sectionDesc,
                questions: sectionQuestions
            };
        });

        renderQuiz();
        startExamTimer();

    } catch (e) {
        console.error(e);
        const msg = e.name === 'AbortError' ? 'Mạng quá chậm hoặc bị treo, vui lòng thử lại.' : e.message;
        if (window.logAppError) {
            window.logAppError({
                source: "filetest",
                category: "feature",
                level: "error",
                code: e.name === 'AbortError' ? 'TIMEOUT' : 'LOAD_TEST_FAIL',
                message: msg,
                detail: { de: TEST_DE }
            });
        }
        document.getElementById('quiz-container').innerHTML = `
            <div style="padding: 20px; background: #fee2e2; color: #ef4444; border-radius: 10px; border: 1px solid #fca5a5;">
                <strong>Lỗi tải đề thi:</strong> ${msg} <br>
                <small>Vui lòng mở từ Phòng Học với liên kết dạng ?de=t:&lt;id&gt;.</small>
            </div>`;
        const errNav = document.getElementById('navGrid');
        if (errNav) errNav.innerHTML = '<div style="grid-column:1/-1; color: var(--text-sub); font-size:0.8rem; text-align:center; padding:12px 0;">Đề không tải được</div>';
        const errProgress = document.getElementById('progressText');
        if (errProgress) errProgress.textContent = '';
    }
}

    // [FIX BUG #22] Helper escape + lọc URL: nội dung đề (từ DB) được chèn thẳng qua
    // innerHTML — nếu chứa HTML/JS sẽ chạy trên trình duyệt của học sinh.
    function esc(v) { return String(v == null ? "" : v).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function safeUrl(u) { return /^https?:\/\//i.test(String(u || "").trim()) ? String(u).trim() : ""; }

    // Ảnh câu hỏi / đáp án: nhận link trực tiếp, link Drive share, hoặc "Ảnh: <link>"
    const IMG_MARKER_SRC = "(?:ảnh(?:\\s*minh\\s*họa)?|hình(?:\\s*ảnh)?|link\\s*ảnh|image|img)";
    function normalizeImageUrl(u) {
        u = String(u == null ? "" : u).trim().replace(/[.,;]+$/, "");
        const m = u.match(/^https?:\/\/(?:drive|docs)\.google\.com\/(?:file\/d\/|open\?id=|uc\?(?:[^#]*&)?id=)([^/?#&]+)/i);
        if (m) return "https://drive.google.com/thumbnail?id=" + m[1] + "&sz=w1200";
        return u;
    }
    function isImageUrl(u) {
        u = normalizeImageUrl(u);
        if (!/^https?:\/\//i.test(u)) return false;
        if (/\.(?:jpe?g|png|webp|gif|avif|svg)(?:[?#][^\s]*)?$/i.test(u)) return true;
        if (/^https?:\/\/(?:placehold\.co|picsum\.photos|images\.unsplash\.com)\//i.test(u)) return true;
        if (/^https?:\/\/lh3\.googleusercontent\.com\/d\/[^/?#]+/i.test(u)) return true;
        if (/^https?:\/\/drive\.google\.com\/thumbnail\?[^#]*\bid=/i.test(u)) return true;
        if (/^https?:\/\/[^/]*googleusercontent\.com\//i.test(u)) return true;
        return false;
    }
    function answerImageUrl(ans) {
        let s = String(ans == null ? "" : ans).trim();
        if (!s) return "";
        s = s.replace(/<[^>]*>/g, " ").replace(/&nbsp;/gi, " ").replace(/\s+/g, " ").trim();
        s = s.replace(/^([A-Za-z])\s*[.、)]\s+/, "");
        const m = s.match(new RegExp("^" + IMG_MARKER_SRC + "\\s*[:：]\\s*(https?:\\/\\/\\S+)\\s*$", "i"));
        if (m) return safeUrl(normalizeImageUrl(m[1]));
        const u = s.replace(/[.,;]+$/, "");
        if (/^https?:\/\//i.test(u) && isImageUrl(u)) return safeUrl(normalizeImageUrl(u));
        return "";
    }
    function extractImageMarker(text) {
        const s = String(text == null ? "" : text);
        const re = new RegExp("(?:^|[\\s;,(?!])(" + IMG_MARKER_SRC + "\\s*[:：]\\s*(https?:\\/\\/[^\\s<>\"']+))", "i");
        const m = re.exec(s);
        if (!m) return null;
        const url = safeUrl(normalizeImageUrl(m[2]));
        if (!url) return null;
        const out = (s.slice(0, m.index) + " " + s.slice(m.index + m[0].length)).replace(/\s+/g, " ").trim();
        return { text: out, url: url };
    }
    function imageFieldUrl(v) {
        const s = String(v == null ? "" : v).trim();
        if (!s) return "";
        const m = extractImageMarker(s);
        return (m && !m.text) ? m.url : safeUrl(normalizeImageUrl(s));
    }
    // [FIX BUG #22] Sanitize rich-text cho sectionDesc: nội dung do người tạo đề nhập và CHƯA
    // escape (vì code cố ý giữ <b>/<i>/<u>). Dùng whitelist thẻ + gỡ TOÀN BỘ attribute để
    // không còn <script>, <img onerror>, onclick... — chữ in đậm/nghiêng/gạch chân vẫn giữ.
    const SAFE_TEXT_TAGS = ["b", "i", "u", "em", "strong", "br", "span", "code"];
    function sanitizeHtml(html) {
        const body = new DOMParser().parseFromString(String(html || ""), "text/html").body;
        (function clean(parent) {
            Array.from(parent.children).forEach(function (el) {
                const tag = el.tagName.toLowerCase();
                if (SAFE_TEXT_TAGS.indexOf(tag) === -1) {
                    clean(el);
                    el.replaceWith(...el.childNodes); // gỡ thẻ lạ, giữ lại chữ bên trong
                } else {
                    Array.from(el.attributes).forEach(function (a) { el.removeAttribute(a.name); });
                    clean(el);
                }
            });
        })(body);
        return body.innerHTML;
    }

    // 3. Hàm Render chính - Chia phần bài làm và mục lục
function renderQuiz() {
    const quizContainer = document.getElementById('quiz-container');
    const navContainer = document.getElementById('navGrid');
    
    let quizHtml = '';
    let navHtml = '';
    let globalIdx = 0;
    window.totalMaxScore = 0;

    questionsData.forEach((section) => {
        // 1. Tạo HTML cho tiêu đề phụ (dùng span để nhận diện <b>, <i>, <u>)
        const descHtml = (section.sectionDesc && section.sectionDesc.trim() !== "") ? 
            `<div style="margin-top: 4px; font-size: 0.78rem; color: var(--text-sub); font-weight: normal; font-style: italic; line-height: 1.4;">
                <span>${sanitizeHtml(section.sectionDesc)}</span>
            </div>` : '';

        // 2. Render tiêu đề phần (Dùng div thay cho h2 để tránh lỗi khoảng cách)
        quizHtml += `
            <div style="margin: 25px 0 15px; padding: 12px 15px; background: #eff6ff; color: #1a73e8; border-radius: 8px; border-left: 5px solid #1a73e8;">
                <div style="font-weight: bold; text-transform: uppercase; font-size: 0.95rem; display: block !important;">
                    ${esc(section.sectionTitle)}
                </div>
                ${descHtml}
            </div>`;
        
        navHtml += `<div class="nav-section-label" style="grid-column: 1/-1; font-weight: bold; margin: 10px 0 5px; font-size: 0.7rem; color: #64748b; text-transform: uppercase;">${esc(section.sectionTitle)}</div>`;

        section.questions.forEach((item) => {
            const qMarker = extractImageMarker(item.question);
            const questionText = qMarker ? qMarker.text : item.question;
            const qImage = imageFieldUrl(item.image) || (qMarker ? qMarker.url : "");
            const imageHtml = qImage ? `
                <div class="q-image" style="text-align: center; margin: 10px 0;">
                    <img src="${esc(qImage)}" onerror="this.parentElement.style.display='none'" style="max-width: 100%; max-height: 250px; border-radius: 10px;">
                </div>` : '';

            let answersContent = '';
            if (item.type === 'multiple') {
                window.totalMaxScore += 1;
                answersContent = `<div class="answers-grid">
                    ${item.answers.map((ans, idx) => {
                        const imgUrl = answerImageUrl(ans);
                        const answerInner = imgUrl
                            ? `<img class="ans-img" src="${esc(imgUrl)}" alt="Đáp án ${String.fromCharCode(65 + idx)}" loading="lazy" onerror="this.style.display='none'">`
                            : `<span>${sanitizeHtml(ans)}</span>`;
                        return `
                        <label class="ans-label" id="label-${globalIdx}-${idx}" onclick="selectAnswer(this, ${globalIdx})">
                            <input type="radio" name="question-${globalIdx}" value="${idx}">
                            ${answerInner}
                        </label>`;
                    }).join('')}
                </div>`;
            } 
            else if (item.type === 'true_false') {
                window.totalMaxScore += 1; 
                answersContent = `
                    <div class="tf-wrapper" style="background: var(--card); border: 1px solid var(--tf-border); border-radius: 10px; overflow: hidden;">
                        ${item.subQuestions.map((sub, subIdx) => `
                            <div class="tf-row" style="display: flex; align-items: center; justify-content: space-between; padding: 10px; border-bottom: 1px solid var(--tf-border); gap: 10px;">
                                <div class="tf-question-text" style="flex: 1; font-size: 0.9rem;">
                                    <strong style="color:var(--primary)">${String.fromCharCode(97 + subIdx)}.</strong> <span>${sanitizeHtml(sub.text)}</span>
                                </div>
                                <div class="tf-options" style="display: flex; gap: 5px; flex-shrink: 0;">
                                    <label style="cursor:pointer; display:flex; align-items:center; gap:3px; background: transparent; padding:4px 10px; border-radius:6px; border: 1.2px solid var(--tf-border); font-size: 0.85rem;">
                                        <input type="radio" name="tf-${globalIdx}-${subIdx}" value="1" onclick="tfSelect(${globalIdx}, ${subIdx}, 1)"> <b>Đ</b>
                                    </label>
                                    <label style="cursor:pointer; display:flex; align-items:center; gap:3px; background: transparent; padding:4px 10px; border-radius:6px; border: 1.2px solid var(--tf-border); font-size: 0.85rem;">
                                        <input type="radio" name="tf-${globalIdx}-${subIdx}" value="0" onclick="tfSelect(${globalIdx}, ${subIdx}, 0)"> <b>S</b>
                                    </label>
                                </div>
                            </div>
                        `).join('')}
                    </div>`;
            } 
            else if (item.type === 'short_answer') {
                window.totalMaxScore += 1;
                answersContent = `<textarea class="short-input writing-input" placeholder="Nhập câu trả lời của bạn..." oninput="markDone(${globalIdx})" onblur="shortToast(${globalIdx})" data-qidx="${globalIdx}" rows="${item.rows || 3}" style="width: 100%; box-sizing: border-box; padding: 12px; border: 2px solid #e2e8f0; border-radius: 10px; outline: none; font-size: 0.95rem; resize: vertical; font-family: inherit; line-height: 1.6;"></textarea>`;
            }

            quizHtml += `
                <div class="question-card" id="card-${globalIdx}" style="margin-bottom: 20px; padding: 15px;">
                    <div class="q-header" style="margin-bottom: 12px; font-size: 0.95rem;">
                        <span class="q-badge" style="background: var(--primary); color: white; padding: 2px 8px; border-radius: 15px; font-size: 0.75rem; font-weight: bold; margin-right: 5px;">Câu ${globalIdx + 1}</span> 
                        <span>${sanitizeHtml(questionText)}</span>
                    </div>
                    ${imageHtml}
                    ${answersContent}
                </div>`;
            
            navHtml += `<div class="nav-item" id="nav-${globalIdx}" onclick="scrollToQuestion(${globalIdx})">${globalIdx + 1}</div>`;
            globalIdx++;
        });
    });

    quizContainer.innerHTML = quizHtml + '<div class="quiz-end-marker" style="display:flex; align-items:center; justify-content:center; gap:14px; margin:38px 0 8px; padding:0 8px; user-select:none;"><div style="flex:1; height:1px; background:linear-gradient(to right, transparent, var(--primary), var(--primary));"></div><span style="font-family:inherit; font-weight:800; font-size:1rem; letter-spacing:4px; color:var(--primary); white-space:nowrap;">Hết</span><div style="flex:1; height:1px; background:linear-gradient(to left, transparent, var(--primary), var(--primary));"></div></div>';
    navContainer.innerHTML = navHtml;
    updateProgress();
}
    // 4. Các hàm bổ trợ xử lý trạng thái làm bài
    // 🔥 [LearnHub Test] Mini toast xác nhận đã lưu đáp án (tái sử dụng lhToast từ ../toast.js)
    let activeAnswerToast = null;
    let lastToastKey = "";
    let lastToastTime = 0;
    function showAnswerToast(qIdx, answerText) {
        if (typeof window.lhToast !== "function") return;
        // Chặn kích hoạt kép: <label> chứa <input radio> bắn onclick 2 lần
        const key = `${qIdx}:${answerText}`;
        const now = Date.now();
        if (key === lastToastKey && now - lastToastTime < 100) return;
        lastToastKey = key;
        lastToastTime = now;

        // Chỉ giữ 1 mini toast duy nhất: xóa toast cũ ngay để không xếp chồng/nhảy lên
        if (activeAnswerToast) {
            try { if (activeAnswerToast.el) activeAnswerToast.el.remove(); } catch (e) {}
            activeAnswerToast = null;
        }
        try {
            const handle = window.lhToast(`Đã lưu đáp án ${answerText}`, {
                type: "success",
                title: `Câu ${qIdx + 1}`,
                durationMs: 1500,
                sound: false
            });
            activeAnswerToast = handle;
            if (handle && handle.el) {
                handle.el.classList.add("lh-toast-mini");
                const msgEl = handle.el.querySelector(".lh-toast-message");
                if (msgEl) msgEl.innerHTML = `Đã lưu đáp án <b>${String(answerText ?? "").replace(/[<>&"]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c])}</b>`;
            }
        } catch (e) {}
    }

    function selectAnswer(el, qIdx) {
        // 🔥 Nếu đang khóa thì không làm gì
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;

        if(el.classList.contains('disabled')) return;
        document.querySelectorAll(`input[name="question-${qIdx}"]`).forEach(input => input.parentElement.classList.remove('selected'));
        el.classList.add('selected');

        // 🔥 Mini toast xác nhận đã lưu đáp án
        const selInput = el.querySelector('input');
        if (selInput) showAnswerToast(qIdx, String.fromCharCode(65 + parseInt(selInput.value, 10)));

        markDone(qIdx);
    }

    function checkTFDone(globalIdx) {
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;

        const checked = document.querySelectorAll(`input[name^="tf-${globalIdx}-"]:checked`);
        
        const card = document.getElementById(`card-${globalIdx}`);
        const totalSub = card.querySelectorAll('.tf-row').length;

        if (checked.length === totalSub) markDone(globalIdx);
    }

    // hỗ trợ toast cho công việc tương tác (dùng chung activeAnswerToast để chỉ giữ 1 toast)
    function pushToast(title, messageHtml, isSuccess) {
        if (typeof window.lhToast !== "function") return;
        if (activeAnswerToast) {
            try { if (activeAnswerToast.el) activeAnswerToast.el.remove(); } catch (e) {}
            activeAnswerToast = null;
        }
        try {
            const handle = window.lhToast(isSuccess ? "Đã lưu đáp án" : "Thông báo", {
                type: isSuccess ? "success" : "info",
                title: title,
                durationMs: 1500,
                sound: false
            });
            activeAnswerToast = handle;
            if (handle && handle.el) {
                handle.el.classList.add("lh-toast-mini");
                const msgEl = handle.el.querySelector(".lh-toast-message");
                if (msgEl) msgEl.innerHTML = messageHtml;
            }
        } catch (e) {}
    }

    // 🔥 [Đúng/Sai] chọn 1 ý -> toast thông báo ý nào đã chọn Đúng/Sai
    function tfSelect(globalIdx, subIdx, val) {
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;
        const label = val === 1 ? "Đúng" : "Sai";
        const letter = String.fromCharCode(97 + subIdx);
        pushToast(`Câu ${globalIdx + 1}`, `Ý <b>${letter}</b> đã chọn <b>${label}</b>`, true);
        checkTFDone(globalIdx);
    }

    // 🔥 [Tự luận] khi gõ xong (rời ô) -> toast đã lưu đáp án
    function shortToast(qIdx) {
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;
        const input = document.querySelector(`[data-qidx="${qIdx}"]`);
        if (input && input.value && input.value.trim() !== "") {
            pushToast(`Câu ${qIdx + 1}`, `Đã lưu <b>đáp án tự luận</b>`, true);
        }
    }

    function markDone(qIdx) {
        document.getElementById(`nav-${qIdx}`).classList.add('done');
        updateProgress();
    }

function updateProgress(isFinished, score = 0) {
        const textEl = document.getElementById('progressText');
        const totalQs = document.querySelectorAll('.nav-item').length;
        if (isFinished) {
            if (examConfig.showScore === 'none') {
                textEl.innerText = 'Đã nộp bài';
                textEl.style.color = "";
            } else {
                textEl.innerText = `${score.toFixed(2)} / 10`;
                textEl.style.color = "var(--success)";
            }
        } else {
            const doneCount = document.querySelectorAll('.nav-item.done').length;
            textEl.innerText = `${doneCount}/${totalQs} câu`;
        }
    }
function submitQuiz() {
