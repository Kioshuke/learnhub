let usersChannel = null;
let onlineUsersMap = new Map(); // userId -> DOM element
let refreshOnlineListTimer = null;

function buildOnlineUserRow(u) {
  const safePhoto = escapeUrl(u.photo) || "https://i.imgur.com/6VBx3io.png";
