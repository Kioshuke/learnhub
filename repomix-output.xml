        <!-- LIST MY SETS -->
        <div id="tcFcListCard" class="tc-card" style="padding:22px;margin-top:18px">
          <div class="fc-panel-head" style="margin-bottom:16px">
            <div class="fc-panel-ico ico-green"><i class="fa-solid fa-circle-plus"></i></div>
            <div>
              <h3 style="font-size:15px">Bộ từ của tôi</h3>
              <span class="muted">Đã có <b id="fcMemberCount">0</b> bộ từ</span>
