    async function tcEnsureMembers(classId) {
      if (tcMembersCache[classId] !== undefined) return;
      const { data, error } = await supabase.rpc("class_members_of", { p_class_id: classId });
      if (error) { console.error("class_members_of lỗi:", error); return; }
      tcMembersCache[classId] = data || [];
    }

    window.tcOpenDetail = async function(classId) {
      tcCurrentClassId = classId;
      setMainView("detail");
      document.getElementById("tcDetailName").textContent = "";
      document.getElementById("tcDetailBlock").textContent = "";
      document.getElementById("tcDetailCode").innerHTML = "";
      document.getElementById("tcBtnDeleteClass").style.display = "";
      document.getElementById("tcMemberList").innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-chalkboard-user"></i></div>Đang tải...</div>';
      tcRenderDetailHead(classId);
      try { await tcEnsureMembers(classId); } catch (e) { console.error("class_members_of lỗi:", e); }
      tcRenderMembers(classId);
    };

    window.tcSetMember = async function(memberId, action, classId) {
      const { data, error } = await supabase.rpc("set_class_member", { p_member_id: memberId, p_action: action });
      if (error) { console.error("set_class_member lỗi:", error); return toast("Lỗi thao tác", "error"); }
      if (data && data.ok !== true) return toast("Không thực hiện được", "error");
      toast(action === "approve" ? "Đã duyệt học sinh vào lớp" : "Đã xử lý", action === "approve" ? "success" : "info");

      const members = tcMembersCache[classId] || [];
      if (action === "approve") {
        const m = members.find(x => x.member_id === memberId);
        if (m) m.status = "approved";
      } else {
        tcMembersCache[classId] = members.filter(x => x.member_id !== memberId);
      }

      const cls = (tcClassesCache || []).find(c => c.class_id === classId);
      if (cls) {
        const alist = tcMembersCache[classId] || [];
        cls.member_count = alist.filter(x => x.status === "approved").length;
        cls.pending_count = alist.filter(x => x.status === "pending").length;
        tcRenderClasses(tcClassesCache);
      }
      tcRenderMembers(classId);
    };

    window.tcBackToList = function() {
      setMainView("manage");
      tcCurrentClassId = null;
      tcLoadClasses();
    };

    window.tcDeleteClass = async function() {
      if (!tcCurrentClassId) return;
      if (window.lhConfirm) {
        const ok = await lhConfirm("Chắc chắn xoá lớp này? Toàn bộ thành viên trong lớp cũng sẽ bị gỡ. Hành động này không thể hoàn tác!");
        if (!ok) return;
      } else {
        if (!confirm("Chắc chắn xoá lớp này? Toàn bộ thành viên trong lớp cũng sẽ bị gỡ. Hành động này không thể hoàn tác!")) return;
      }
      const id = tcCurrentClassId;
      const { data, error } = await supabase.rpc("delete_class", { p_class_id: id });
      if (error) { console.error("delete_class lỗi:", error); return toast("Lỗi xoá lớp", "error"); }
      if (data && data.ok !== true) return toast("Không xoá được lớp", "error");
      toast("Đã xoá lớp", "success");
      if (tcClassesCache) tcClassesCache = tcClassesCache.filter(c => c.class_id !== id);
      delete tcMembersCache[id];
      setMainView("manage");
      tcCurrentClassId = null;
      tcRenderClasses(tcClassesCache || []);
    };

    window.tcOpenFc = function() {
      window.location.href = "./newflashcard.html";
    };

    // ================= LỊCH HỌC & LỊCH THI (THỜI KHÓA BIỂU) =================
    const SCHEDULE_SUBJECTS = (window.LH_SUBJECTS || []).map(s => ({ value: s.id, label: s.name }));
    const SCHEDULE_COLORS = (window.LH_SUBJECTS || []).reduce((m, s) => { m[s.id] = [s.short, s.color]; return m; }, {});
    let scheduleEvents = [];
    let scheduleWeekStart = getMonday(new Date());
    let scheduleEditingEventId = null;

    function pad2(n) { return String(n).padStart(2, "0"); }
    function toIsoDate(d) { return d.getFullYear() + "-" + pad2(d.getMonth() + 1) + "-" + pad2(d.getDate()); }
    function addDays(d, days) { const next = new Date(d); next.setDate(next.getDate() + days); return next; }
    function getMonday(d) { const date = new Date(d.getFullYear(), d.getMonth(), d.getDate()); date.setDate(date.getDate() - ((date.getDay() + 6) % 7)); return date; }
    function scheduleEventId() { return crypto.randomUUID ? crypto.randomUUID() : "e" + Date.now() + Math.random().toString(16).slice(2); }
    function scFormatDate(iso) {
      try { return new Date(iso).toLocaleString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }); }
      catch (e) { return String(iso || ""); }
    }
    function scheduleSubjectOptions(sel) {
      return SCHEDULE_SUBJECTS.map(s => `<option value="${s.value}"${s.value === sel ? " selected" : ""}>${s.label}</option>`).join("");
    }

    function scheduleEditorCard(e) {
      const id = e.id || scheduleEventId();
      const session = e.session || guessScheduleSession(e.time);
      const sessionInfo = { morning: ['<i class="fa-solid fa-sun"></i>', "Sáng"], noon: ['<i class="fa-solid fa-temperature-high"></i>', "Trưa"], afternoon: ['<i class="fa-solid fa-cloud-sun"></i>', "Chiều"], evening: ['<i class="fa-solid fa-moon"></i>', "Tối"] }[session] || ['<i class="fa-solid fa-clock"></i>', "Buổi học"];
      const time = [e.time, e.endTime].filter(Boolean).join(" – ") || "Chưa chọn giờ";
      const subjInfo = SCHEDULE_COLORS[e.subject] || [String(e.subject || "Môn"), "#2563eb"];
      return `<div class="schedule-event-row ${e.type === "thi" ? "type-thi" : ""}" style="border-left-color:${subjInfo[1]}" data-id="${escapeHtml(id)}" data-date="${escapeHtml(e.date)}">
        <button class="se-delete" type="button" title="Xóa lịch" onclick="removeScheduleEvent('${escapeHtml(id)}')">×</button>
        <div onclick="editScheduleEvent('${escapeHtml(id)}')"><div class="admin-schedule-top"><span class="admin-schedule-tag ${e.type === "thi" ? "thi" : ""}">${e.type === "thi" ? "Thi" : "Học"}</span><span class="admin-schedule-session ${session}">${sessionInfo[0]} ${sessionInfo[1]}</span><span class="admin-schedule-subj" style="background:${subjInfo[1]}">${escapeHtml(subjInfo[0])}</span></div><div class="admin-schedule-title">${escapeHtml(e.title || "")}</div><div class="admin-schedule-time"><i class="fa-solid fa-clock"></i> ${escapeHtml(time)}</div>${e.note ? `<div class="admin-schedule-note">${escapeHtml(e.note)}</div>` : ""}</div>
      </div>`;
    }

    function renderScheduleEvents() {
      const listEl = document.getElementById("scheduleEventsList");
      if (!listEl) return;
      const weekdays = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];
      const today = toIsoDate(new Date());
      const weekDates = Array.from({ length: 7 }, (_, i) => toIsoDate(addDays(scheduleWeekStart, i)));
      const label = document.getElementById("scheduleWeekLabel");
      if (label) label.innerHTML = `Tuần đang chỉnh<small>${weekDates[0].split("-").reverse().join("/")} – ${weekDates[6].split("-").reverse().join("/")}</small>`;
      listEl.innerHTML = '<div class="schedule-week-grid">' + weekDates.map((date, i) => {
        const dayEvents = scheduleEvents.filter(e => e && e.date === date);
        const classes = "schedule-day-column" + (date === today ? " is-today" : "") + (i === 6 ? " is-sunday" : "");
        return `<div class="${classes}"><div class="schedule-day-head"><div><div class="schedule-day-name">${weekdays[i]}</div><div class="schedule-day-date">${date.split("-").reverse().slice(0, 2).join("/")}</div></div><button class="schedule-day-add" type="button" title="Thêm lịch ngày này" onclick="addScheduleEvent('${date}')">+</button></div>${dayEvents.length ? dayEvents.map(scheduleEditorCard).join("") : '<div class="schedule-day-empty">Chưa có lịch</div>'}</div>`;
      }).join("") + "</div>";
    }

    window.removeScheduleEvent = (id) => { scheduleEvents = scheduleEvents.filter(e => e.id !== id); renderScheduleEvents(); };
    function guessScheduleSession(time) {
      const hour = Number(String(time || "08:00").split(":")[0]);
      if (hour < 11) return "morning";
      if (hour < 14) return "noon";
      if (hour < 18) return "afternoon";
      return "evening";
    }
    function openScheduleModal(date, eventId) {
      const event = eventId ? scheduleEvents.find(e => e.id === eventId) : null;
      scheduleEditingEventId = event ? event.id : null;
      document.getElementById("scheduleModalTitle").innerHTML = event ? '<i class="fa-solid fa-pen"></i> Chỉnh sửa lịch' : '<i class="fa-solid fa-calendar-days"></i> Thêm lịch học / lịch thi';
      document.getElementById("scheduleModalDate").value = event ? event.date : (date || toIsoDate(scheduleWeekStart));
      document.getElementById("scheduleModalSubject").innerHTML = scheduleSubjectOptions(event ? event.subject : "ly");
      document.getElementById("scheduleModalType").value = event ? event.type : "hoc";
      document.getElementById("scheduleModalSession").value = event ? (event.session || guessScheduleSession(event.time)) : "morning";
      document.getElementById("scheduleModalStart").value = event ? (event.time || "") : "08:00";
      document.getElementById("scheduleModalEnd").value = event ? (event.endTime || "") : "10:00";
      document.getElementById("scheduleModalTitleInput").value = event ? event.title : "";
      document.getElementById("scheduleModalNote").value = event ? (event.note || "") : "";
      document.getElementById("scheduleEventModal").classList.add("show");
      document.getElementById("scheduleModalTitleInput").focus();
    }
    function closeScheduleModal() { document.getElementById("scheduleEventModal").classList.remove("show"); }
    window.addScheduleEvent = openScheduleModal;
    window.editScheduleEvent = (id) => { const event = scheduleEvents.find(e => e.id === id); if (event) openScheduleModal(event.date, id); };
    window.closeScheduleModal = closeScheduleModal;

    document.getElementById("saveScheduleModalBtn").addEventListener("click", () => {
      const date = document.getElementById("scheduleModalDate").value;
      const title = document.getElementById("scheduleModalTitleInput").value.trim();
      if (!date || !title) { toast("Vui lòng chọn ngày và nhập nội dung lịch.", "warning"); return; }
      const time = document.getElementById("scheduleModalStart").value;
      const nextEvent = { id: scheduleEditingEventId || scheduleEventId(), date, subject: document.getElementById("scheduleModalSubject").value, type: document.getElementById("scheduleModalType").value, session: document.getElementById("scheduleModalSession").value || guessScheduleSession(time), time, endTime: document.getElementById("scheduleModalEnd").value, title, note: document.getElementById("scheduleModalNote").value.trim() };
      if (scheduleEditingEventId) scheduleEvents = scheduleEvents.map(e => e.id === scheduleEditingEventId ? nextEvent : e); else scheduleEvents.push(nextEvent);
      closeScheduleModal();
      scheduleWeekStart = getMonday(new Date(date + "T00:00:00"));
      renderScheduleEvents();
    });

    document.getElementById("addScheduleEventBtn").addEventListener("click", () => window.addScheduleEvent(toIsoDate(scheduleWeekStart)));
    document.getElementById("schedulePrevWeekBtn").addEventListener("click", () => { scheduleWeekStart = addDays(scheduleWeekStart, -7); renderScheduleEvents(); });
    document.getElementById("scheduleNextWeekBtn").addEventListener("click", () => { scheduleWeekStart = addDays(scheduleWeekStart, 7); renderScheduleEvents(); });
    document.getElementById("scheduleTodayBtn").addEventListener("click", () => { scheduleWeekStart = getMonday(new Date()); renderScheduleEvents(); });

    async function tcLoadSchedule() {
      const listEl = document.getElementById("scheduleEventsList");
      if (listEl) listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-spinner fa-spin"></i></div>Đang tải lịch học & lịch thi...</div>';
      try {
        const { data: d } = await supabase.from("schedule_settings").select("*").eq("id", true).maybeSingle();
        // [FIX BUG #37] Spread trước rồi mới gán id để id tạo mới không bị ghi đè bởi e.id rỗng
        scheduleEvents = (d && Array.isArray(d.events)) ? d.events.map(e => ({ ...e, id: e.id || scheduleEventId() })) : [];
        renderScheduleEvents();
        const meta = document.getElementById("scheduleMeta");
        if (meta) meta.textContent = d && d.updated_at ? `Cập nhật: ${scFormatDate(d.updated_at)}${d.updated_by ? ` · bởi ${d.updated_by}` : ""}` : "Chưa có bản lưu. Lưu lần đầu để áp dụng.";
      } catch (e) {
        console.error(e);
        toast("Không tải được lịch học & lịch thi.", "error");
      }
    }

    document.getElementById("saveScheduleBtn").addEventListener("click", async () => {
      const dropped = scheduleEvents.filter(Boolean).filter(e => !e.date || !String(e.title || "").trim()).length;
      const events = scheduleEvents.filter(e => e && e.date && String(e.title || "").trim());
      if (dropped > 0) toast(`Có ${dropped} lịch thiếu ngày/tiêu đề sẽ bị bỏ qua khi lưu.`, "warning");
      try {
        const now = new Date().toISOString();
        const { error } = await supabase.from("schedule_settings").upsert({
          id: true,
          active: true,
          events,
          updated_at: now,
          updated_by: tcEmail
        }, { onConflict: "id" });
        if (error) throw error;
        scheduleEvents = events;
        renderScheduleEvents();
        const meta = document.getElementById("scheduleMeta");
        if (meta) meta.textContent = `Cập nhật: ${scFormatDate(now)} · bởi ${tcEmail}`;
        toast("Đã lưu lịch học & lịch thi.", "success");
      } catch (e) {
        console.error(e);
        toast("Lưu lịch thất bại. Kiểm tra lại bảng schedule_settings đã tạo chưa.", "error");
      }
    });

    document.getElementById("refreshScheduleBtn").addEventListener("click", tcLoadSchedule);

    /* ===== THÔNG BÁO MÔN HỌC ===== */
const NOTICE_SUBJECTS = (window.LH_SUBJECTS || []).map(s => ({
      id: s.id,
      name: s.name,
      icon: s.icon,
      color: s.color
    }));
    const NOTICE_ICON_CHOICES = [
      { v: "fa-bell", n: "Chuông" },
      { v: "fa-fire", n: "Lửa" },
      { v: "fa-bullhorn", n: "Loaphone" },
      { v: "fa-triangle-exclamation", n: "Cảnh báo" },
      { v: "fa-info-circle", n: "Thông tin" },
      { v: "fa-calendar-check", n: "Lịch" },
      { v: "fa-star", n: "Sao" },
      { v: "fa-circle-exclamation", n: "Chú ý" }
    ];
    let tcWatchedNoticesMap = null;

    window.tcOpenNotices = function() {
      setMainView("notice");
      if (window.TeacherShell && window.TeacherShell.setActive) window.TeacherShell.setActive("notice");
      tcLoadNotices();
    };

    window.tcOpenQuizzes = function() {
      setMainView("quiz");
      if (window.TeacherShell && window.TeacherShell.setActive) window.TeacherShell.setActive("quiz");
      tcLoadQuizzes();
    };

    /* Liệt kê các đề lưu trong DB (teacher_list_test_sets) — thay nguồn mẫu tĩnh */
    async function tcLoadQuizzes() {
      const listEl = document.getElementById("tcQuizList");
      if (!listEl) return;
      try {
        const { data, error } = await supabase.rpc("teacher_list_test_sets");
        if (error) throw error;
        const rows = Array.isArray(data) ? data : [];
        const done = rows.filter(r => r.is_complete).length;
        const pending = rows.length - done;
        tcRenderQuizStats(rows.length, done, pending);
        if (!rows.length) {
          listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-file-circle-check"></i></div>' +
            'Chưa có bài kiểm tra nào trong Phòng Học.<br>' +
            '<span style="font-size:12.5px">Bấm <b>Tạo đề mới</b> để soạn đề đầu tiên (trắc nghiệm / đúng-sai / tự luận / nghe).</span></div>';
          return;
        }
        listEl.innerHTML = '<table class="tc-quiz-table"><thead><tr>' +
          '<th style="width:42%">Tên đề</th><th class="tc-qz-nowrap">Môn</th><th class="tc-qz-nowrap" style="width:58px">Số câu</th><th class="tc-qz-nowrap" style="width:112px">Thời gian</th><th class="tc-qz-nowrap" style="width:52px">Điểm</th><th style="width:96px">Trạng thái</th><th class="tc-qz-nowrap" style="width:116px">Tạo lúc</th><th style="width:42px"></th>' +
          '</tr></thead><tbody>' + rows.map(function (r) {
          const de = "t:" + r.set_id;
          const badges =
            (r.show_score === 'none' ? '<span class="tc-qz-badge danger"><i class="fa-solid fa-lock"></i> Ẩn điểm</span>' : '') +
            (r.show_answers === 'none' ? '<span class="tc-qz-badge danger"><i class="fa-solid fa-eye-slash"></i> Chặn xem đáp án</span>' : (r.show_answers === 'perfect' ? '<span class="tc-qz-badge info"><i class="fa-solid fa-eye"></i> Xem đáp án khi điểm tối đa</span>' : '')) +
            (r.subtest_enabled ? '<span class="tc-qz-badge info"><i class="fa-solid fa-dice"></i> Đề con ' + (r.subtest_count || 0) + '/' + (r.question_count || 0) + '</span>' : '');
          return '<tr>' +
            '<td><div class="tc-t">' + escapeHtml(r.name) + '</div>' +
              (r.description ? '<div class="tc-sub">' + escapeHtml(r.description) + '</div>' : '') +
              (badges ? '<div class="tc-qz-badges">' + badges + '</div>' : '') + '</td>' +
            '<td class="tc-qz-nowrap">' + escapeHtml(r.subject) + '</td>' +
            '<td class="tc-qz-nowrap">' + (r.subtest_enabled && r.subtest_count ? (r.subtest_count + '/' + (r.question_count || 0)) : (r.question_count || 0)) + '</td>' +
            '<td class="tc-qz-nowrap">' + (r.minutes > 0 ? '<i class="fa-solid fa-stopwatch"></i> ' + r.minutes + ' phút' : "Không giới hạn") + '</td>' +
            '<td class="tc-qz-nowrap">' + (r.score || 10) + '</td>' +
            '<td>' +
              '<button type="button" role="switch" aria-checked="' + (r.is_complete ? 'true' : 'false') + '" class="tc-qz-switch' + (r.is_complete ? ' on' : '') + '" data-action="toggle" data-id="' + r.set_id + '" data-complete="' + (r.is_complete ? 1 : 0) + '" title="Đổi trạng thái hoàn thành / chưa hoàn thành"><span class="tc-qz-switch-knob"></span></button>' +
            '</td>' +
            '<td class="tc-qz-created">' + scFormatDate(r.created_at) + '</td>' +
            '<td><div class="tc-qz-menu-wrap">' +
              '<button type="button" class="tc-qz-menu-btn" data-action="menu" data-de="' + de + '" data-id="' + r.set_id + '" title="Thao tác" aria-label="Thao tác"><i class="fa-solid fa-ellipsis-vertical"></i></button>' +
            '</div></td>' +
          '</tr>';
        }).join('') + '</tbody></table>';
        if (!listEl.__tcBound) {
          listEl.__tcBound = true;
          listEl.addEventListener("click", tcQuizListClick);
        }
      } catch (e) {
        console.error("tcLoadQuizzes lỗi:", e);
        tcRenderQuizStats(0, 0, 0);
        listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-triangle-exclamation"></i></div>' +
          'Không tải được danh sách bài kiểm tra.<br>' +
          '<span style="font-size:12.5px">' + escapeHtml(String((e && e.message) || e)) + '</span></div>';
      }
    }

    function tcRenderQuizStats(total, done, pending) {
      const t = document.getElementById("tcStatTotal");
      const d = document.getElementById("tcStatDone");
      // [FIX BUG #32] Dùng id riêng cho thống kê quiz để tránh trùng với tcStatPending của lớp
      const p = document.getElementById("tcStatQuizPending");
      if (t) t.textContent = total;
      if (d) d.textContent = done;
      if (p) p.textContent = pending;
    }

    function tcQuizListClick(e) {
      const el = e.target && e.target.closest ? e.target.closest("[data-action]") : null;
      if (!el) return;
      const id = el.getAttribute("data-id");
      const action = el.getAttribute("data-action");
      if (action === "menu") {
        tcQuizToggleMenu(el);
      } else if (action === "toggle") {
        tcQuizSetComplete(id, el.getAttribute("data-complete") !== "1");
      }
    }

    let tcQuizMenuEl = null;
    function tcQuizEnsureMenu() {
      if (tcQuizMenuEl) return tcQuizMenuEl;
      tcQuizMenuEl = document.createElement("div");
      tcQuizMenuEl.className = "tc-qz-menu";
      tcQuizMenuEl.style.position = "fixed";
      tcQuizMenuEl.hidden = true;
      tcQuizMenuEl.innerHTML =
        '<button type="button" class="tc-qz-menu-item" data-action="edit"><i class="fa-solid fa-pen"></i> Sửa đề</button>' +
        '<button type="button" class="tc-qz-menu-item" data-action="copy"><i class="fa-solid fa-copy"></i> Sao chép liên kết đề</button>' +
        '<button type="button" class="tc-qz-menu-item danger" data-action="delete"><i class="fa-solid fa-trash"></i> Xoá đề</button>';
      tcQuizMenuEl.addEventListener("click", function (e) {
        const el = e.target && e.target.closest ? e.target.closest(".tc-qz-menu-item") : null;
        if (!el) return;
        const btn = tcQuizMenuEl.__btn;
        tcQuizCloseMenus();
        if (!btn) return;
        const act = el.getAttribute("data-action");
        if (act === "edit") {
          tcQuizEdit(btn.getAttribute("data-id"));
        } else if (act === "copy") {
          tcQuizCopyLink(btn.getAttribute("data-de"));
        } else if (act === "delete") {
          tcQuizDeleteWithConfirm(btn.getAttribute("data-id"));
        }
      });
      document.body.appendChild(tcQuizMenuEl);
      return tcQuizMenuEl;
    }

    async function tcQuizDeleteWithConfirm(id) {
      const ok = window.lhConfirm
        ? await lhConfirm("Xoá bài kiểm tra này? Card trong Phòng Học sẽ bị gỡ bỏ vĩnh viễn.")
        : confirm("Xoá bài kiểm tra này? Card trong Phòng Học sẽ bị gỡ bỏ vĩnh viễn.");
      if (!ok) return;
      tcQuizDelete(id);
    }

    /* Sửa đề: mở trình soạn, nạp sẵn content của đề vào màn 2 (JSON + Xem trước) */
    function tcQuizEdit(id) {
      window.location.href = "./newtest/index.html?edit=t:" + id;
    }

    function tcQuizToggleMenu(btn) {
      const menu = tcQuizEnsureMenu();
      if (!menu.hidden && menu.__btn === btn) { menu.hidden = true; return; }
      menu.__btn = btn;
      menu.style.minWidth = "";
      const r = btn.getBoundingClientRect();
      let left = r.right - 210;
      if (left < 8) left = 8;
      let top = r.bottom + 4;
      menu.style.left = left + "px";
      menu.style.top = top + "px";
      menu.hidden = false;
      const rect = menu.getBoundingClientRect();
      if (rect.bottom > window.innerHeight - 8) {
        top = Math.max(8, Math.round(r.top - rect.height - 4));
        menu.style.top = top + "px";
      }
      const rect2 = menu.getBoundingClientRect();
      if (rect2.right > window.innerWidth - 8) {
        menu.style.left = Math.max(8, Math.round(window.innerWidth - rect2.width - 8)) + "px";
      }
      menu.__btn = btn;
    }

    function tcQuizCloseMenus() {
      if (tcQuizMenuEl) tcQuizMenuEl.hidden = true;
    }

    document.addEventListener("click", function (e) {
      if (!e.target || !e.target.closest || !e.target.closest("#tcQuizList .tc-qz-menu-wrap")) {
        tcQuizCloseMenus();
      }
    });

    function tcQuizCopyLink(de) {
      // Link mở từ web chính giống cơ chế copy link card trong Phòng Học:
      // ?open=phong-hoc&de=t:<uuid> → mở thẳng bài test trong Phòng Học.
      const link = location.origin + "/?open=phong-hoc&de=" + de;
      const done = function () { toast("Đã sao chép liên kết bài test", "success"); };
      const fail = function () { toast("Không sao chép được liên kết", "error"); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(link).then(done, fail);
      } else {
        try {
          const ta = document.createElement("textarea");
          ta.value = link;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
          done();
        } catch (e) {
          fail();
        }
      }
    }

    async function tcQuizSetComplete(id, complete) {
      try {
        const { error } = await supabase.rpc("teacher_set_test_complete", { p_id: id, p_is_complete: complete });
        if (error) throw error;
        toast(complete ? "Đã đánh dấu hoàn thành — hiện card cho học sinh" : "Chuyển sang chưa hoàn thành — học sinh không thể Làm bài", "success");
        tcLoadQuizzes();
      } catch (e) {
        console.error("tcQuizSetComplete lỗi:", e);
        toast("Không đổi được trạng thái: " + ((e && e.message) || e), "error");
      }
    }

    async function tcQuizDelete(id) {
      try {
        const { error } = await supabase.rpc("teacher_delete_test_set", { p_id: id });
        if (error) throw error;
        toast("Đã xoá bài kiểm tra", "success");
        tcLoadQuizzes();
      } catch (e) {
        console.error("tcQuizDelete lỗi:", e);
        toast("Không xoá được bài kiểm tra: " + ((e && e.message) || e), "error");
      }
    }

    async function tcLoadNotices() {
      const listEl = document.getElementById("subjectNoticeList");
      const metaEl = document.getElementById("subjectNoticeMeta");
      if (listEl) listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-circle-notch fa-spin"></i></div>Đang tải thông báo...</div>';
      try {
        const { data, error } = await supabase.rpc("load_subject_notices");
        if (error) throw error;
        const row = (data && data[0]) || null;
        tcWatchedNoticesMap = (row && row.notices) || {};
        renderSubjectNoticeCards();
        if (metaEl) metaEl.textContent = row && row.updated_at
          ? `Cập nhật: ${scFormatDate(row.updated_at)}${row.updated_by ? ` · bởi ${row.updated_by}` : ""}`
          : "Chưa có bản lưu từ web giáo viên. Các môn đang dùng nội dung mặc định.";
      } catch (e) {
        console.error("load_subject_notices lỗi:", e);
        if (listEl) listEl.innerHTML = '<div class="empty"><div class="big"><i class="fa-solid fa-triangle-exclamation"></i></div>Không tải được thông báo. Kiểm tra đã chạy SQL subject-notices.sql chưa.</div>';
      }
    }

    function renderSubjectNoticeCards() {
      const listEl = document.getElementById("subjectNoticeList");
      if (!listEl) return;
      const iconDisplayName = v => {
        const rec = NOTICE_ICON_CHOICES.find(x => x.v === v);
        return rec ? rec.n : v;
      };
      listEl.innerHTML = NOTICE_SUBJECTS.map(s => {
        const rec = tcWatchedNoticesMap && tcWatchedNoticesMap[s.id];
        const hasRec = !!(rec && typeof rec === "object");
        const htmlVal = hasRec ? (rec.html || "") : "";
        const enabled = hasRec ? (rec.enabled !== false) : true;
        const icon = hasRec ? (rec.icon || "fa-bell") : "fa-bell";
        const statusLabel = hasRec ? "Đã đặt trong database" : "Chưa có — không hiển thị ở Phòng Học";
        const iconOptions = NOTICE_ICON_CHOICES.map(ic =>
          `<button type="button" data-icon-opt="${ic.v}" class="notice-icon-opt${ic.v === icon ? " active" : ""}" title="${ic.n}"><i class="fa-solid ${ic.v}"></i><span>${ic.n}</span></button>`
        ).join("");

        return `
          <div data-subject="${s.id}" style="border:1px solid #e5e7eb;border-radius:16px;padding:16px;background:#fff">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
              <div style="width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:15px;color:#fff;background:${s.color};flex-shrink:0"><i class="fa-solid ${s.icon}"></i></div>
              <div style="min-width:0">
                <div style="font-weight:700;font-size:15px;color:#111827">${escapeHtml(s.name)}</div>
                <div style="font-size:11.5px;color:#94a3b8">${statusLabel}</div>
              </div>
              <label style="margin-left:auto;display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:#475569;white-space:nowrap;cursor:pointer">
                <input type="checkbox" data-enabled="1"${enabled ? " checked" : ""}> Hiện
              </label>
            </div>
            <label style="font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px">Nội dung (hỗ trợ HTML)</label>
            <textarea data-html="1" rows="3" placeholder="Nhập nội dung thông báo (bỏ trống nếu không muốn hiện)" style="width:100%;padding:12px 14px;border:1px solid #d1d5db;border-radius:12px;font-family:inherit;font-size:13px;resize:vertical;outline:none;transition:border-color .15s,box-shadow .15s">${escapeHtml(htmlVal)}</textarea>
            <div style="margin-top:10px">
              <label style="font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px">Icon</label>
              <div class="notice-icon-pick" data-icon-pick="1">${iconOptions}</div>
              <div class="notice-icon-prev"><span class="icp-box"><i class="fa-solid ${icon}"></i></span><span data-icon-label="1">${iconDisplayName(icon)}</span></div>
            </div>
            <div style="display:flex;gap:8px;margin-top:12px">
              <button class="btn-sm" data-save style="background:#d97706;color:#fff"><i class="fa-solid fa-floppy-disk"></i> Lưu</button>
              <button class="btn-sm" data-remove style="background:#f1f5f9;color:#334155"><i class="fa-solid fa-rotate-left"></i> Trở về mặc định</button>
            </div>
          </div>`;
      }).join("");

      listEl.querySelectorAll("[data-save]").forEach(btn => {
        btn.addEventListener("click", () => tcSaveNotice(btn.closest("[data-subject]").dataset.subject));
      });
      listEl.querySelectorAll("[data-remove]").forEach(btn => {
        btn.addEventListener("click", () => tcRemoveNotice(btn.closest("[data-subject]").dataset.subject));
      });
      listEl.querySelectorAll("[data-icon-pick]").forEach(pick => {
        pick.addEventListener("click", e => {
          const btn = e.target.closest("[data-icon-opt]");
          if (!btn) return;
          const card = btn.closest("[data-subject]");
          pick.querySelectorAll("[data-icon-opt]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          const labelEl = card.querySelector("[data-icon-label]");
          const boxEl = card.querySelector(".icp-box i");
          const nameSpan = btn.querySelector("span");
          if (labelEl && nameSpan) labelEl.textContent = nameSpan.textContent;
          if (boxEl) boxEl.className = "fa-solid " + btn.dataset.iconOpt;
        });
      });
    }

    window.tcSaveNotice = async function(subjectId) {
      const card = document.querySelector(`#subjectNoticeList [data-subject="${subjectId}"]`);
      const subj = NOTICE_SUBJECTS.find(s => s.id === subjectId);
      if (!card || !subj) return;
      const html = (card.querySelector("[data-html]").value || "").trim();
      const activeIcon = card.querySelector("[data-icon-opt].active");
      const icon = activeIcon ? activeIcon.dataset.iconOpt : "fa-bell";
      const enabled = card.querySelector("[data-enabled]").checked;
      const btn = card.querySelector("[data-save]");
      btn.disabled = true;
      try {
        const { data, error } = await supabase.rpc("teacher_save_subject_notice", {
          p_subject: subjectId, p_icon: icon, p_html: html, p_enabled: enabled
        });
        if (error) throw error;
        if (!data || data.ok !== true) { toast(data?.error === "forbidden" ? "Bạn không có quyền chỉnh thông báo." : "Không lưu được thông báo.", "error"); return; }
        toast(`Đã lưu thông báo môn ${subj.name}.`, "success");
        await tcLoadNotices();
      } catch (e) {
        console.error("teacher_save_subject_notice lỗi:", e);
        toast("Lỗi lưu thông báo: " + (e.message || e), "error");
      } finally {
        btn.disabled = false;
      }
    };

    window.tcRemoveNotice = async function(subjectId) {
      const subj = NOTICE_SUBJECTS.find(s => s.id === subjectId);
      if (!subj) return;
      const btn = document.querySelector(`#subjectNoticeList [data-subject="${subjectId}"] [data-remove]`);
      if (btn) btn.disabled = true;
      try {
        const { data, error } = await supabase.rpc("teacher_remove_subject_notice", { p_subject: subjectId });
        if (error) throw error;
        if (!data || data.ok !== true) { toast(data?.error === "forbidden" ? "Bạn không có quyền chỉnh thông báo." : "Không xoá được thông báo.", "error"); return; }
        toast(`Đã xoá thông báo môn ${subj.name} — dùng lại mặc định.`, "success");
        await tcLoadNotices();
      } catch (e) {
        console.error("teacher_remove_subject_notice lỗi:", e);
        toast("Lỗi xoá thông báo: " + (e.message || e), "error");
      } finally {
        if (btn) btn.disabled = false;
      }
    };

    const tcStudentModal = document.getElementById("tcStudentModal");
    if (tcStudentModal) tcStudentModal.addEventListener("click", tcModalOverlayHandler);

    guard();
  </script>
</body>
</html>
</file>

<file path="pages/teacher/newflashcard.html">
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LearnHub - Soạn Flashcard</title>
  <link rel="icon" href="../../assets/images/favicon.png" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="../../assets/images/favicon.png">
  <link rel="apple-touch-icon" href="../../assets/images/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../../styles/global.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root{
      --bg:#f6f8ff; --card:#ffffff; --border:#e6e9f2; --text:#0f172a; --sub:#64748b;
      --blue:#2563eb; --cyan:#0891b2; --green:#10b981; --green-d:#059669; --amber:#f59e0b;
      --violet:#8b5cf6;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0}
    body{
      font-family:'Inter','Segoe UI',system-ui,-apple-system,sans-serif;
      background:var(--bg);
      color:var(--text);
      min-height:100vh;
    }

    .tc-wrap{max-width:1600px;margin:28px 32px;padding:0 0 64px;width:auto}
    .tc-card{background:var(--card);border:1px solid var(--border);border-radius:20px;box-shadow:0 10px 30px rgba(15,23,42,.05)}

    .tc-view-head{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px}
    .tc-view-head h2{margin:0;font-size:22px;font-weight:800;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}
    .tc-view-head h2 i{color:var(--green)}
    .tc-view-head .back{background:#fff;border:1px solid var(--border);border-radius:12px;padding:9px 16px;cursor:pointer;font-weight:700;font-size:13px;color:var(--sub);text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:all .15s;box-shadow:0 1px 2px rgba(15,23,42,.04)}
    .tc-view-head .back:hover{background:#f1f5f9;color:var(--text)}
    .tc-view-head .muted{color:var(--sub);font-size:13px;font-weight:600;margin-left:auto}

    .fc-layout{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:18px;align-items:start}
    .fc-panel-head{display:flex;align-items:center;gap:12px;margin-bottom:18px}
    .fc-panel-head h3{margin:0;font-size:16px;font-weight:800;letter-spacing:-.01em}
    .fc-panel-head .muted{color:var(--sub);font-size:12.5px;font-weight:600;display:block;margin-top:2px}
    .fc-panel-ico{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-size:16px;flex-shrink:0}
    .fc-panel-ico.ico-green{background:linear-gradient(135deg,#ecfdf5,#d1fae5);color:var(--green-d)}
    .fc-panel-ico.ico-violet{background:linear-gradient(135deg,#f5f3ff,#ede9fe);color:#7c3aed}

    .fc-info,.fc-write{padding:22px}
    .fc-info{position:relative}
    .fc-info::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--green),var(--violet));border-radius:20px 20px 0 0}
    .fc-write{position:relative}
    .fc-write::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--violet),var(--cyan));border-radius:20px 20px 0 0}

    .fc-field{margin-bottom:14px}
    .fc-field label{display:block;font-size:12.5px;font-weight:600;color:#475569;margin-bottom:6px}
    .fc-field label b{color:#dc2626;font-weight:700}
    input,select,textarea{width:100%;border:1px solid #e2e8f0;border-radius:12px;padding:11px 14px;font-size:14px;outline:none;background:#f8fafc;transition:all .15s ease;font-family:inherit}
    input:focus,textarea:focus{border-color:var(--green);background:#fff;box-shadow:0 0 0 4px rgba(16,185,129,.12)}
    textarea{resize:vertical;line-height:1.55}
    .hint{font-size:12.5px;color:var(--sub);line-height:1.5}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

    /* Dropdown custom: nhóm + độ khó */
    .fc-dd{position:relative;flex:1;min-width:0}
    .fc-dd-trigger{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;border:1px solid #e2e8f0;border-radius:12px;padding:11px 14px;font-size:13.5px;font-weight:600;background:#fff;color:var(--text);cursor:pointer;transition:all .15s ease;font-family:inherit;text-align:left}
    .fc-dd-trigger:hover{border-color:#cbd5e1}
    .fc-dd-trigger i.arr{font-size:11px;color:#94a3b8;flex-shrink:0;transition:transform .2s ease;margin-left:auto}
    .fc-dd.open .fc-dd-trigger{border-color:var(--green);box-shadow:0 0 0 4px rgba(16,185,129,.12)}
    .fc-dd.open .fc-dd-trigger i.arr{color:var(--green);transform:rotate(180deg)}
    .fc-dd-trigger .ph{color:#94a3b8;font-weight:500}
    .fc-dd-menu{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:50;background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 18px 44px rgba(15,23,42,.16);padding:6px;display:none;max-height:260px;overflow:auto;margin:0;list-style:none}
    .fc-dd.open .fc-dd-menu{display:block}
    .fc-dd-opt{display:flex;align-items:center;gap:8px;width:100%;text-align:left;background:none;border:0;border-radius:10px;padding:9px 11px;font-size:13.5px;font-weight:600;color:#334155;cursor:pointer;transition:background .12s;font-family:inherit}
    .fc-dd-opt:hover{background:#ecfdf5;color:#047857}
    .fc-dd-opt.sel{background:#ecfdf5;color:#059669}
    .fc-dd-opt.sel:after{content:"\f00c";font-family:"Font Awesome 6 Free";font-weight:900;font-size:11px;margin-left:auto;color:#059669}
    #fcFcLvDD .fc-dd-trigger{background:#ecfdf5;font-weight:700}
    #fcFcLvDD .fc-dd-trigger .ph{color:#10b981}
    #fcFcLvDD .fc-dd-opt.sel{background:#ecfdf5;color:#059669;font-weight:700}
    #fcFcLvDD .fc-dd-opt[data-v="Dễ"]:not(:hover){color:#059669}
    #fcFcLvDD .fc-dd-opt[data-v="Trung bình"]:not(:hover){color:#b45309}
    #fcFcLvDD .fc-dd-opt[data-v="Khó"]:not(:hover){color:#dc2626}
    #fcFcLvDD .fc-dd-opt[data-v="Nâng cao"]:not(:hover){color:#7c3aed}
    .fc-dd-sel{position:absolute;opacity:0;pointer-events:none;height:1px;width:1px;border:0;padding:0;margin:0;overflow:hidden}

    .fc-cat-row{display:flex;gap:8px;align-items:center}
    .fc-cat-row .fc-dd{flex:1}
    .btn-sm{border:0;border-radius:10px;padding:8px 13px;font-weight:700;font-size:12.5px;cursor:pointer;transition:all .15s;font-family:inherit}
    .btn-sm:hover{transform:translateY(-1px)}
    .btn-approve{background:#d1fae5;color:#047857}
    .btn-approve:hover{background:#a7f3d0}
    .btn-remove{background:#fee2e2;color:#dc2626}
    .btn-remove:hover{background:#fecaca}
    button.btn-green{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--green),var(--green-d));color:#fff;border:0;border-radius:12px;padding:12px 24px;font-weight:700;font-size:14px;cursor:pointer;transition:all .2s ease;box-shadow:0 6px 16px rgba(16,185,129,.3);font-family:inherit}
    button.btn-green:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(16,185,129,.38)}
    button.btn-green:disabled{opacity:.55;cursor:not-allowed;transform:none}
    button.btn-ghost{display:inline-flex;align-items:center;gap:8px;background:#f1f5f9;color:#334155;border:0;border-radius:12px;padding:12px 20px;font-weight:700;font-size:14px;cursor:pointer;transition:all .2s ease;font-family:inherit}
    button.btn-ghost:hover{background:#e2e8f0}
    .fc-save-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px dashed #e6e9f2}
    .fc-count-pill{display:inline-flex;align-items:center;gap:7px;background:#f0fdf4;border:1px solid #bbf7d0;color:#15803d;border-radius:999px;padding:7px 14px;font-size:13px;font-weight:700}

    .fc-live{margin-top:14px}
    .fc-live-title{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:700;color:#7c3aed;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
    .fc-live-title i{font-size:11px}
    .fc-live-empty{background:#f8fafc;border:1px dashed #dbe3f0;border-radius:14px;padding:22px 16px;text-align:center;color:#94a3b8;font-size:13px;line-height:1.6}
    .fc-live-empty i{display:block;font-size:22px;margin-bottom:6px;color:#c7d2e8}
    .fc-live-card{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;background:linear-gradient(135deg,#f8fafc,#fdf4ff);border:1px solid #ede9fe;border-radius:14px;padding:12px 14px;margin-bottom:8px}
    .fc-live-front{font-weight:800;font-size:14px;color:#0f172a}
    .fc-live-arrow{color:#a78bfa;font-size:12px}
    .fc-live-back{color:#475569;font-size:13.5px;font-weight:600} 
    .fc-live-back .fc-live-ex{display:block;font-weight:500;color:#94a3b8;font-size:12px;margin-top:2px}
    .fc-live-more{text-align:center;font-size:12px;color:#94a3b8;font-weight:600;margin-top:6px}
    .fc-live-card{cursor:pointer;transition:transform .12s ease,box-shadow .12s ease}
    .fc-live-card:hover{transform:translateY(-1px);box-shadow:0 10px 20px rgba(124,58,237,.12)}
    .fc-live-row{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-top:10px;position:relative;z-index:5}
    .fc-live-row .btn-sm{position:relative;z-index:6}
    .fc-textarea-min{background:#f8fafc;border:1px solid #e2e8f0;color:#475569;border-radius:10px;padding:7px 12px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .15s}
    .fc-textarea-min:hover{background:#eef2ff;border-color:#c7d2fe;color:#4f46e5}

    .fc-modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:2100;padding:18px}
    .fc-modal.open{display:flex}
    .fc-modal-panel{background:#fff;border-radius:18px;box-shadow:0 24px 60px rgba(15,23,42,.3);width:min(680px,100%);max-height:82vh;display:flex;flex-direction:column;overflow:hidden}
    .fc-modal-head{display:flex;align-items:center;gap:10px;padding:16px 18px 12px;border-bottom:1px solid #eef1f6}
    .fc-modal-head h3{margin:0;font-size:16px;font-weight:800;color:#0f172a}
    .fc-modal-head .muted{font-size:12px;color:#94a3b8}
    .fc-modal-close{margin-left:auto;background:#f1f5f9;border:0;border-radius:9px;width:32px;height:32px;cursor:pointer;color:#475569;font-size:14px;font-family:inherit}
    .fc-modal-close:hover{background:#e2e8f0}
    .fc-modal-body{padding:14px 18px;overflow-y:auto;flex:1}
    .fc-card-list{display:flex;flex-direction:column;gap:8px}
    .fc-modal-form{background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:14px;margin-top:12px}
    .fc-m-form-row{display:flex;align-items:center;gap:12px}
    .fc-m-num{width:30px;height:30px;flex:none;border-radius:9px;background:#eef2ff;color:#4f46e5;display:grid;place-items:center;font-weight:800;font-size:13px}
    .fc-m-field{flex:1}
    .fc-m-field label{display:block;font-size:11px;font-weight:700;color:#64748b;margin-bottom:3px}
    .fc-m-field input{width:100%;border:1px solid #e2e8f0;border-radius:10px;padding:8px 11px;font-size:13.5px;font-family:inherit;color:#0f172a;box-sizing:border-box;outline:none}
    .fc-m-field input:focus{border-color:#818cf8;box-shadow:0 0 0 3px rgba(99,102,241,.15)}
    .fc-m-field select{width:100%;border:1px solid #e2e8f0;border-radius:10px;padding:8px 11px;font-size:13.5px;font-family:inherit;color:#0f172a;box-sizing:border-box;outline:none;background:#fff;cursor:pointer}
    .fc-m-field select:focus{border-color:#818cf8;box-shadow:0 0 0 3px rgba(99,102,241,.15)}
    .fc-m-actions{display:flex;gap:8px;margin-top:12px;justify-content:flex-end}
    .fc-card-item{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#f8fafc,#fdf4ff);border:1px solid #ede9fe;border-radius:12px;padding:9px 12px}
    .fc-card-item-front{font-weight:800;font-size:13.5px;color:#0f172a;min-width:120px}
    .fc-card-item-back{color:#475569;font-size:13px;font-weight:600;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fc-card-item-ex{color:#94a3b8;font-size:11.5px;font-weight:600;flex:none;max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fc-card-item-desc{color:#64748b;font-size:11.5px;line-height:1.45;flex:none;max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .fc-lv-chip{display:inline-flex;align-items:center;font-size:10.5px;font-weight:800;border-radius:999px;padding:2px 9px;flex:none;white-space:nowrap}
    .fc-lv-chip.lv-de{background:#dcfce7;color:#15803d}
    .fc-lv-chip.lv-tb{background:#fef9c3;color:#a16207}
    .fc-lv-chip.lv-kho{background:#fee2e2;color:#b91c1c}
    .fc-lv-chip.lv-cao{background:#ede9fe;color:#6d28d9}
    .fc-lv-chip.lv-none{background:#f1f5f9;color:#475569}
    .fc-preview-lvl{display:inline-flex;align-items:center;font-size:10px;font-weight:800;border-radius:999px;padding:1px 8px;background:#f1f5f9;color:#475569;margin-top:4px}
    .fc-card-item-acts{display:flex;gap:4px;flex:none}
    .fc-card-item-acts button{background:none;border:0;border-radius:8px;width:28px;height:28px;cursor:pointer;color:#6b7280;font-size:12px;font-family:inherit;transition:all .12s}
    .fc-card-item-acts .fc-ed:hover{background:#eef2ff;color:#4f46e5}
    .fc-card-item-acts .fc-del:hover{background:#fee2e2;color:#dc2626}
    .fc-card-item{cursor:grab}
    .fc-card-item:active{cursor:grabbing}
    .fc-drag-handle{color:#c4b5fd;font-size:13px;cursor:grab;flex:none;padding:2px}
    .fc-card-item.dragging{opacity:.45;border-style:dashed}
    .fc-card-item.d-over{border-color:#7c3aed;background:#f5f3ff;box-shadow:0 0 0 2px rgba(124,58,237,.15)}
    .fc-m-add{display:inline-flex;align-items:center;justify-content:center;gap:7px;width:100%;margin-top:8px;background:#ecfdf5;border:1px dashed #6ee7b7;color:#047857;border-radius:12px;padding:10px;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;transition:all .15s}
    .fc-m-add:hover{background:#d1fae5}

    .fc-chip{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;border-radius:999px;padding:3px 9px}
    .fc-chip.members{background:#e0f2fe;color:#0369a1}
    .fc-chip.green{background:#d1fae5;color:#047857}
    .fc-chip.pending{background:#fef3c7;color:#b45309}

    .tc-class-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
    #tcFcList{display:block}
    .fc-group{margin-bottom:22px}
    .fc-group:last-child{margin-bottom:0}
    .fc-group-head{display:flex;align-items:center;gap:10px;margin-bottom:12px;cursor:pointer;user-select:none}
    .fc-group-head .fc-group-caret{color:var(--green);transition:transform .18s ease;font-size:12px}
    .fc-group-head.open .fc-group-caret{transform:rotate(90deg)}
    .fc-group-title{font-weight:800;font-size:16px;color:var(--ink)}
    .fc-group-count{font-size:12px;font-weight:700;color:var(--green-d);background:#d1fae5;padding:3px 10px;border-radius:999px}
    .fc-chip.complete-chip{background:#d1fae5;color:#047857}
    .fc-chip.wip-chip{background:#fef3c7;color:#b45309}
    .fc-toggle-row{display:inline-flex;align-items:center;gap:10px;cursor:pointer;user-select:none;font-weight:600;font-size:14px;color:var(--ink)}
    .fc-toggle-row input{display:none}
    .fc-toggle-track{display:inline-block;width:44px;height:24px;border-radius:999px;background:#cbd5e1;position:relative;transition:background .2s;flex:none}
    .fc-toggle-track::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
    .fc-toggle-row input:checked + .fc-toggle-track{background:#10b981}
    .fc-toggle-row input:checked + .fc-toggle-track::after{left:23px}
    .fc-group-toggle{font-size:12px;margin-left:auto}
    .fc-group-toggle .fc-toggle-track{width:34px;height:20px}
    .fc-group-toggle .fc-toggle-track::after{width:14px;height:14px;top:3px;left:3px}
    .fc-group-toggle input:checked + .fc-toggle-track::after{left:17px}
    .fc-group-rename{background:none;border:none;color:#6b7280;font-size:13px;cursor:pointer;padding:4px 8px;border-radius:6px}
    .fc-group-rename:hover{background:#eef2ff;color:#4f46e5}
    .tc-class{border:1px solid var(--border);border-radius:16px;padding:16px;background:var(--card);position:relative;overflow:hidden;transition:all .18s ease}
    .tc-class:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(15,23,42,.08)}
    .tc-class::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--green),var(--violet))}
    .tc-class .tc-class-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .tc-class .tc-drag-handle{color:#94a3b8;font-size:14px;cursor:grab;padding:2px 1px;flex-shrink:0;opacity:.7}
    .tc-class .tc-drag-handle:hover{opacity:1;color:var(--green-d)}
    .tc-class.dragging{opacity:.4;border-style:dashed}
    .tc-class.d-over{border-color:var(--green-d);box-shadow:0 0 0 2px var(--green);transform:translateY(-2px)}
    .tc-class .tc-class-ico{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;font-size:17px;background:#ecfdf5;color:var(--green-d);flex-shrink:0}
    .tc-class .name{font-weight:800;font-size:15px;line-height:1.2}
    .tc-class .meta{display:flex;gap:8px;align-items:center}

    .empty{text-align:center;color:#94a3b8;padding:44px 20px;background:linear-gradient(180deg,#fbfdff,#f6f8ff);border:1px dashed #dbe3f0;border-radius:16px;grid-column:1 / -1}
    .empty .big{font-size:42px;margin-bottom:10px;line-height:1}
    .empty-title{font-size:15px;font-weight:700;color:#475569;margin:10px 0 4px}
    .empty-sub{font-size:13px;color:#94a3b8;margin:0 0 18px;line-height:1.5}
    .empty-cta{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--green),var(--green-d));color:#fff;border-radius:12px;padding:11px 22px;font-weight:700;font-size:14px;cursor:pointer;border:0;font-family:inherit;box-shadow:0 6px 16px rgba(16,185,129,.28);transition:all .2s ease}
    .empty-cta:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(16,185,129,.36)}

    .fc-login{max-width:420px;margin:70px auto;padding:38px 30px;text-align:center}
    .fc-login .icon{font-size:48px;color:var(--green);margin-bottom:14px}
    .fc-login h2{margin:0 0 8px;font-size:20px}
    .fc-login p{color:var(--sub);font-size:14px;margin-bottom:22px}
    a.btn{display:inline-block;background:linear-gradient(135deg,var(--green),var(--green-d));color:#fff;padding:12px 24px;border-radius:12px;text-decoration:none;font-weight:700;box-shadow:0 6px 16px rgba(16,185,129,.25)}
    a.btn:hover{transform:translateY(-1px)}

    @media(max-width:900px){
      .fc-layout{grid-template-columns:1fr}
      .grid-2{grid-template-columns:1fr}
      .tc-wrap{margin:28px 20px}
    }
    @media(max-width:720px){
      .tc-wrap{margin:22px 14px 52px}
      .tc-view-head h2{font-size:18px}
      .fc-live-card{grid-template-columns:1fr}
      .fc-live-arrow{display:none}
    }
  </style>
</head>
<body>
  <div id="tcApp" class="teacher-app" style="display:none">
    <!-- Sidebar + Topbar được chèn tự động bởi shell.js -->

    <!-- ===== MAIN AREA ===== -->
    <div class="teacher-canvas">
      <div class="tc-wrap">
        <div class="tc-view-head">
          <h2><i class="fa-solid fa-layer-group" style="color:var(--green)"></i> Soạn flashcard</h2>
          <span class="muted" id="fcCount"></span>
          <a class="back" href="../flashcard/hub.html" style="margin-left:auto"><i class="fa-solid fa-arrow-up-right-from-square"></i> Xem hub</a>
        </div>

        <!-- EDITOR -->
        <div id="tcFcEditor" style="display:none">
          <div class="fc-layout">
            <!-- LEFT: THÔNG TIN BỘ TỪ -->
            <div class="tc-card fc-info">
              <div class="fc-panel-head">
                <div class="fc-panel-ico ico-green"><i class="fa-solid fa-file-lines"></i></div>
                <div>
                  <h3 id="tcFcEditorTitle">Bộ từ mới</h3>
                  <span class="muted" id="tcFcEditorMode"></span>
                </div>
                <div style="margin-left:auto">
                  <button class="btn-sm" type="button" style="background:#f1f5f9;color:#334155" onclick="tcFcCancel()"><i class="fa-solid fa-xmark"></i> Huỷ</button>
                </div>
              </div>
              <div class="fc-field">
                <label>Tên bộ từ <b>*</b></label>
                <input id="tcFcName" type="text" placeholder="vd: Từ vựng công nghệ">
              </div>
              <div class="fc-field">
                <label>Nhóm hiển thị trong hub flashcard <b>*</b></label>
                <div class="fc-cat-row">
                  <div class="fc-dd" id="fcFcCatDD">
                    <button type="button" class="fc-dd-trigger" aria-haspopup="listbox"><span id="tcFcCatLabel">— Chọn nhóm —</span> <i class="fa-solid fa-chevron-down arr"></i></button>
                    <ul class="fc-dd-menu" role="listbox"></ul>
                    <select id="tcFcCategory" class="fc-dd-sel" tabindex="-1" aria-hidden="true">
                      <option value="">— Chọn nhóm —</option>
                    </select>
                  </div>
                  <button type="button" onclick="tcFcAddCategory()" style="flex-shrink:0;background:linear-gradient(135deg,var(--green),var(--green-d));color:#fff;border:0;border-radius:12px;padding:11px 14px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap;font-family:inherit"><i class="fa-solid fa-plus"></i> Nhóm mới</button>
                </div>
                <div id="tcFcNewCatRow" style="display:none;margin-top:8px;gap:8px;align-items:center">
                  <input id="tcFcNewCategory" type="text" placeholder="Nhập tên nhóm mới, vd: Từ vựng công nghệ" style="flex:1">
                  <button type="button" onclick="tcFcCancelNewCategory()" style="flex-shrink:0;background:#f1f5f9;color:#334155;border:0;border-radius:12px;padding:10px 12px;font-weight:700;font-size:12.5px;cursor:pointer;font-family:inherit">Huỷ</button>
                </div>
              </div>
              <div class="grid-2">
                <div class="fc-field">
                  <label>Level / độ khó</label>
