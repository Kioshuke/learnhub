    // 5. Hàm Nộp bài và Chấm điểm (Logic 0.25đ mỗi ý đúng-sai)
function startExamTimer() {
    // Ghi mốc bắt đầu làm bài
    examStartTime = Date.now();

    // ✅ Nút "Nộp bài" luôn phải hiện ra khi vào bài, bất kể đề có giới hạn
    // giờ làm hay không — không gắn chung điều kiện với đồng hồ đếm giờ.
    const submitBtn = document.getElementById('submitBtn');
    if (submitBtn) submitBtn.style.display = 'inline-flex';

    // Nếu đề không khai báo thời gian làm bài thì vẫn hiện khung đồng hồ
    // nhưng ghi "Vô hạn" thay vì chạy đếm ngược.
    const timerBox = document.getElementById('timerBox');
    timerBox.style.display = 'flex';

    if (!examTimeLimitSeconds || examTimeLimitSeconds <= 0) {
        const timerText = document.getElementById('timerText');
        if (timerText) timerText.innerText = 'Vô hạn';
        const innerTimerVisual = timerBox.querySelector('.timer-box');
        if (innerTimerVisual) {
            innerTimerVisual.classList.remove('timer-warning', 'timer-danger');
            innerTimerVisual.style.background = 'var(--primary-light)';
            innerTimerVisual.style.color = 'var(--primary)';
        }
        return;
    }

    remainingSeconds = examTimeLimitSeconds;
    updateTimerDisplay();

    timerInterval = setInterval(() => {
        remainingSeconds--;
        updateTimerDisplay();

        if (remainingSeconds <= 0) {
            clearInterval(timerInterval);
            // Hết giờ -> tự động nộp bài
            handleFinalSubmit(true);
        }
    }, 1000);
}

function formatHMS(totalSeconds) {
    const s = Math.max(0, Math.floor(totalSeconds));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    const pad = (n) => String(n).padStart(2, '0');
    return `${pad(h)}:${pad(m)}:${pad(sec)}`;
}

function updateTimerDisplay() {
    const timerText = document.getElementById('timerText');
    const timerBox = document.getElementById('timerBox');
    
    // Tìm đến khung giao diện thật để đổi màu
    const innerTimerVisual = timerBox.querySelector('.timer-box');
    
    timerText.innerText = formatHMS(remainingSeconds);

    if (innerTimerVisual) {
        innerTimerVisual.classList.remove('timer-warning', 'timer-danger');
        
        if (remainingSeconds <= 60) {
            innerTimerVisual.classList.add('timer-danger');
            innerTimerVisual.style.background = '#fee2e2'; // Nền đỏ nhạt
            innerTimerVisual.style.color = '#dc2626';      // Chữ đỏ đậm
        } else if (remainingSeconds <= 300) {
            innerTimerVisual.classList.add('timer-warning');
            innerTimerVisual.style.background = '#fff7ed'; // Nền cam nhạt
            innerTimerVisual.style.color = '#ea580c';      // Chữ cam đậm
        } else {
            innerTimerVisual.style.background = 'var(--primary-light)';
            innerTimerVisual.style.color = 'var(--primary)';
        }
    }
}

function stopExamTimer() {
    if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
    }
}

function handleFinalSubmit(autoSubmitted = false) {
    if (isSubmitted) return; // Chặn nộp 2 lần
    isSubmitted = true;
    stopExamTimer();
    examEndTime = Date.now();
let correctCount = 0;
    let globalIdx = 0;
    let userScore = 0;
    const resultFlags = [];
    
// Tính điểm cơ bản dựa trên tổng số câu thực tế (totalQuestions)
    // theo ĐIỂM TỐI ĐA đã cấu hình (mặc định 10; đề từ DB đọc từ cột test_sets.score)
    const maxScore = (examConfig && examConfig.maxScore > 0) ? examConfig.maxScore : 10;
    const basePerQuestion = totalQuestions > 0 ? (maxScore / totalQuestions) : 0;

    // [Lịch sử làm bài] snapshot đề (bản đã xáo trộn như HS thấy) + bài làm để lưu lịch sử
    const attemptSections = questionsData.map((section) => ({
        sectionTitle: section.sectionTitle || "",
        sectionDesc: section.sectionDesc || "",
        passage: section.passage || "",
        type: section.type || "",
        audio: section.audio || null,
        listenTitle: section.listenTitle || "",
        questions: []
    }));

questionsData.forEach((section, secIdx) => {
        section.questions.forEach((item) => {
            let isPerfect = true;
            const qSnap = JSON.parse(JSON.stringify(item)); // chép nguyên câu gốc (text/answers/correct...)

            if (item.type === 'multiple') {
                const sel = document.querySelector(`input[name="question-${globalIdx}"]:checked`);
                qSnap.chosen = sel ? parseInt(sel.value) : null;
                if (sel && qSnap.chosen === item.correct) {
                    userScore += basePerQuestion;
                    correctCount++;
                } else isPerfect = false;
            } 
            else if (item.type === 'true_false') {
                let subCorrect = 0;
                qSnap.chosen = [];
                item.subQuestions.forEach((sub, subIdx) => {
                    const sel = document.querySelector(`input[name="tf-${globalIdx}-${subIdx}"]:checked`);
                    qSnap.chosen.push(sel ? parseInt(sel.value) : null);
                    if (sel && parseInt(sel.value) === sub.correct) {
                        userScore += (basePerQuestion / (item.subQuestions.length || 1));
                        subCorrect++;
                    }
                });
                // Chỉ tính là đúng 1 câu nếu đúng hết cả 4 ý nhỏ
                if (subCorrect === item.subQuestions.length) {
                    correctCount++;
                } else {
                    isPerfect = false;
                }
            }
            else if (item.type === 'short_answer') {
                const inputEl = document.querySelector(`[data-qidx="${globalIdx}"]`);
                const val = inputEl ? inputEl.value.trim().toLowerCase() : "";
                qSnap.chosen = inputEl ? inputEl.value.trim() : "";
                // [FIX BUG #20] Guard correctAnswer undefined để tránh crash khi chấm điểm
                if (val === String(item.correctAnswer || "").toLowerCase()) {
                    userScore += basePerQuestion;
                    correctCount++;
                } else isPerfect = false;
            }

            qSnap.isCorrect = isPerfect;
            attemptSections[secIdx].questions.push(qSnap);
resultFlags.push(isPerfect);
            globalIdx++;
        });
    });

// Hiển thị lên Popup (điểm theo đúng thang tối đa đã cấu hình).
    // Mặc định mở khoá ôn tập ("Xem bài làm") mới cho phép:
    //  - show_answers='always'  → luôn cho phép
    //  - show_answers='perfect' → chỉ khi đạt ĐIỂM TỐI ĐA (full mark, chuẩn hoá 10/10)
    //  - show_answers='none'    → không cho phép
    const score = Number(((userScore / maxScore) * 10).toFixed(1));
    const fullMark = score >= 10;
    // [FIX BUG #10] Bỏ điều kiện `showAnswers !== 'none'` — nó luôn đúng nên phá vỡ
    // ràng buộc 'perfect' (chỉ cho xem khi đạt điểm tối đa).
    const canReview = examConfig.showAnswers === 'always' ||
        (examConfig.showAnswers === 'perfect' && fullMark);
    examConfig.reviewLocked = !canReview;

    const scoreCircle = document.getElementById('scoreValue');
    const feedbackEl = document.getElementById("feedbackText");
    const statsEl = document.getElementById('statsText');
    // Ẩn điểm thật hoàn toàn: không ghi số vào DOM → devtool/console không tìm thấy điểm
    if (examConfig.showScore === 'none') {
        scoreCircle.innerText = '--';
        scoreCircle.style.color = "var(--sec-text)";
        scoreCircle.style.borderColor = "var(--sec-border)";
        scoreCircle.style.background = "transparent";
        statsEl.innerText = 'Điểm bài kiểm tra đã được ẩn';
        feedbackEl.innerText = '';
        feedbackEl.style.color = "var(--sec-text)";
        feedbackEl.classList.remove("feedback-show");
    } else {
        scoreCircle.innerText = userScore.toFixed(1);
        statsEl.innerText = `🎯 Đúng ${correctCount}/${totalQuestions} câu · Điểm tối đa: ${maxScore}đ`;

        const feedback = getFeedback(score);
        if (score >= 10) {
            setTimeout(() => launchConfetti(), 300);
        }
        feedbackEl.innerText = "💬 " + feedback.text;
        feedbackEl.style.color = feedback.color;

        // animation text
        feedbackEl.classList.remove("feedback-show");
        void feedbackEl.offsetWidth;
        feedbackEl.classList.add("feedback-show");

        // set màu + animation vòng điểm
        scoreCircle.style.color = feedback.color;
        scoreCircle.style.borderColor = feedback.color;
        scoreCircle.style.background = feedback.bg;

        // reset animation
        scoreCircle.style.animation = "none";
        void scoreCircle.offsetWidth;
        scoreCircle.style.animation = feedback.animation + " 0.6s ease";
    }

    // Tô màu mục lục (đỏ/xanh) CHỈ khi được phép xem đáp án, tránh lộ kết quả gián tiếp
    const navItemsRef = document.querySelectorAll('.nav-item');
    if (canReview) {
        resultFlags.forEach((ok, i) => {
            const flagEl = document.getElementById(`nav-${i}`);
            if (!flagEl) return;
            flagEl.classList.remove('done');
            flagEl.style.background = ok ? "var(--success)" : "var(--danger)";
            flagEl.style.color = "white";
        });
    }
    navItemsRef.forEach((el) => el.classList.remove('done'));

    // Ẩn/hiện nút "Xem bài làm" theo quyền review
    const reviewBtnEl = document.getElementById('reviewBtn');
    if (reviewBtnEl) reviewBtnEl.style.display = canReview ? '' : 'none';

    closeModal('confirmModal');

    // Hiển thị thời gian đã làm bài (và lý do nộp nếu tự động nộp do hết giờ)
    const elapsedSeconds = examStartTime ? Math.round((examEndTime - examStartTime) / 1000) : 0;
    const timeSpentEl = document.getElementById('timeSpentText');
    const timeSpentBox = document.getElementById('timeSpentBox');
    let timeSpentMsg = `Thời gian làm bài: ${formatHMS(elapsedSeconds)}`;
    if (autoSubmitted) {
        timeSpentMsg += ` — Hết giờ, tự động nộp`;
        timeSpentBox.classList.add('time-danger');
    } else {
        timeSpentBox.classList.remove('time-danger');
    }
timeSpentEl.innerText = timeSpentMsg;

    closeModal('confirmModal');
    openModal('resultModal');
    updateProgress(true, score);
    const timerBoxEl = document.getElementById('timerBox');
    if (timerBoxEl) timerBoxEl.style.display = 'none';
    const submitBtnEl = document.getElementById('submitBtn');
    if (submitBtnEl) submitBtnEl.style.display = 'none';

    // 🆕 [LearnHub Test - Giai đoạn 2] Lưu kết quả vào testStats/{uid} sau khi đã chấm điểm xong (score đã tính ở trên)
    if (typeof window.saveTestResult === "function") {
        const durationMs = (examStartTime && examEndTime) ? Math.max(0, examEndTime - examStartTime) : null;
        const rawScoreVal = Number(userScore.toFixed(2));
        window.saveTestResult(score, {
            testId: TEST_DE,
            subject: examMeta.subject,
            name: examMeta.name,
            rawScore: rawScoreVal,
            maxScore: maxScore,
            correctCount: correctCount,
            totalQuestions: totalQuestions,
            durationMs: durationMs,
            autoSubmitted: !!autoSubmitted,
            paper: {
                meta: { testId: TEST_DE, subject: examMeta.subject, name: examMeta.name, description: examMeta.description, maxScore: maxScore, showAnswers: examConfig.showAnswers, showScore: examConfig.showScore },
                result: { score: score, rawScore: rawScoreVal, correctCount: correctCount, totalQuestions: totalQuestions, durationMs: durationMs, autoSubmitted: !!autoSubmitted },
                sections: attemptSections
            }
        });
    }
}
function reviewMode() {
        if (examConfig.reviewLocked) return; // khoá xem đáp án khi config không cho phép (cả khi gọi qua console/devtool)

        closeModal('resultModal');

        // 🔥 bật khóa
        document.getElementById("quiz-container").classList.add("quiz-locked");

        document.querySelectorAll('input').forEach(input => input.disabled = true);

    let globalIdx = 0;
    questionsData.forEach((section) => {
        section.questions.forEach((item) => {
            const card = document.getElementById(`card-${globalIdx}`);

            // --- 1. XỬ LÝ CÂU TRẮC NGHIỆM ---
            if (item.type === 'multiple') {
                const selected = document.querySelector(`input[name="question-${globalIdx}"]:checked`);
                const isCorrect = selected && parseInt(selected.value) === item.correct;
                
                // Tô màu cả khung câu hỏi
                card.classList.add(isCorrect ? 'review-true' : 'review-false');

                const labels = card.querySelectorAll('.ans-label');
                labels.forEach((label, idx) => {
                    if (idx === item.correct) label.classList.add('true-answer-highlight');
                    const radio = label.querySelector('input');
                    if (radio.checked && idx !== item.correct) label.classList.add('review-wrong');
                });
            }

            // --- 2. XỬ LÝ CÂU ĐÚNG SAI (Từng dòng nhỏ) ---
            else if (item.type === 'true_false') {
                let allSubCorrect = true;
                const rows = card.querySelectorAll('.tf-row');

                item.subQuestions.forEach((_, subIdx) => {
                    const selected = document.querySelector(`input[name="tf-${globalIdx}-${subIdx}"]:checked`);
                    const userVal = selected ? parseInt(selected.value) : null;
                    const correctVal = item.subQuestions[subIdx].correct;
                    const row = rows[subIdx];

                    // tô màu từng dòng
                    if (userVal === correctVal) {
                        if (userVal === correctVal) {
                        }
                        row.style.background = "var(--success-light)";
                    } else {
                        row.style.background = "var(--danger-light)";
                        allSubCorrect = false;
                    }

                    const textEl = row.querySelector('.tf-question-text');

                    // tránh append nhiều lần
                    if (!textEl.querySelector('.tf-answer-tip')) {
                        const tip = document.createElement('span');
                        tip.className = `tf-answer-tip ${userVal === correctVal ? 'true-text' : 'false-text'}`;
                        tip.innerHTML = ` (Đáp án: ${correctVal === 1 ? 'Đúng' : 'Sai'})`;
                        textEl.appendChild(tip);
                    }
                });

                card.classList.add(allSubCorrect ? 'review-true' : 'review-false');
            }
            // --- 3. XỬ LÝ CÂU TRẢ LỜI NGẮN ---
            else if (item.type === 'short_answer') {
                const input = card.querySelector('.short-input');
                const userAns = input.value.trim().toLowerCase();
                // [FIX BUG #20] Guard correctAnswer undefined
                const isCorrect = userAns === String(item.correctAnswer || "").toLowerCase();

                card.classList.add(isCorrect ? 'review-true' : 'review-false');
                input.style.borderColor = isCorrect ? "var(--success)" : "var(--danger)";

                const resultDiv = document.createElement('div');
                resultDiv.className = 'true-text';
                resultDiv.style.marginTop = "10px";
                // [FIX BUG #22] Escape nội dung để tránh XSS
                resultDiv.textContent = `✓ Đáp án chuẩn: ${item.correctAnswer || ""}`;
                input.parentNode.appendChild(resultDiv);
            }

            globalIdx++;
        });
    });

    document.getElementById('action-button-container').innerHTML = `
        <button class="btn btn-reload" onclick="location.reload()" style="white-space:nowrap;"><i class="fa-solid fa-rotate"></i> Làm bài mới</button>
    `;
}
