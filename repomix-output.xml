    .toc-list li:nth-child(4) .toc-link.active{color:#ea580c;border-left-color:#ea580c;background:linear-gradient(90deg,rgba(234,88,12,0.08) 0%,rgba(234,88,12,0) 100%)}
    .toc-list li:nth-child(5) .toc-link.active{color:#db2777;border-left-color:#db2777;background:linear-gradient(90deg,rgba(219,39,119,0.08) 0%,rgba(219,39,119,0) 100%)}
    .toc-list li:nth-child(6) .toc-link.active{color:#0d9488;border-left-color:#0d9488;background:linear-gradient(90deg,rgba(13,148,136,0.08) 0%,rgba(13,148,136,0) 100%)}
    .toc-list li:nth-child(7) .toc-link.active{color:#4f46e5;border-left-color:#4f46e5;background:linear-gradient(90deg,rgba(79,70,229,0.08) 0%,rgba(79,70,229,0) 100%)}
    .toc-list li:nth-child(8) .toc-link.active{color:#e11d48;border-left-color:#e11d48;background:linear-gradient(90deg,rgba(225,29,72,0.08) 0%,rgba(225,29,72,0) 100%)}
    .toc-list li:nth-child(9) .toc-link.active{color:#d97706;border-left-color:#d97706;background:linear-gradient(90deg,rgba(217,119,6,0.08) 0%,rgba(217,119,6,0) 100%)}
    .toc-list li:nth-child(10) .toc-link.active{color:#0891b2;border-left-color:#0891b2;background:linear-gradient(90deg,rgba(8,145,178,0.08) 0%,rgba(8,145,178,0) 100%)}

    /* ===== CONTENT CARD ===== */
    .doc-content{min-width:0}
