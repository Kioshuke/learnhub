}

/* Đổ card video giáo viên vào GRID MÔN HỌC sẵn có (không tạo tab riêng).
   Mỗi card = 1 (subject, card_title) do giáo viên đặt tên (vd: "Tổng ôn tiếng anh"). */
function seedGvVideoTab(data, order) {
  if (!data) return;
  var staticOrder = (window.PHONGHOC_SUBJECTS || []).map(function(s) { return s.name; });
  var indexOf = function(n) { return staticOrder.indexOf(n); };
  var names = (order && order.length ? order : Object.keys(data))
    .filter(function(n) { return data[n] && data[n].length; })
    .sort(function(a, b) {
      var ia = indexOf(a), ib = indexOf(b);
      if (ia === -1 && ib === -1) return a.localeCompare(b, "vi");
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    });

  names.forEach(function(n) {
    var s = null;
    (window.PHONGHOC_SUBJECTS || []).forEach(function(x) { if (x.name === n) s = x; });
    var panel = s ? document.getElementById(s.id) : null;
    var grid = panel ? panel.querySelector(".grid") : null;
    if (!grid) return;

    var icon = (s && s.icon) || "fa-chalkboard-teacher";
    var color = (s && s.cardColor) || (s && s.tabColor) || "#0d9488";

    var byCard = {};
    var cardOrder = [];
    (data[n] || []).forEach(function(c) {
      var ct = String(c.card_title || "").trim() || "Video";
      if (!byCard[ct]) { byCard[ct] = []; cardOrder.push(ct); }
      byCard[ct].push(c);
    });
    cardOrder.sort(function(a, b) { return a.localeCompare(b, "vi"); });

    cardOrder.forEach(function(ct) {
      var key = n + "§" + ct;
      // [FIX BUG #17] Không nhét card_title vào CSS selector (tiêu đề chứa "/\ hoặc "
      // làm querySelector throw -> dừng render thẻ Video GV). So khớp qua dataset thay thế.
      var existed = false;
      for (var ci = 0; ci < grid.children.length; ci++) {
        if (grid.children[ci].dataset && grid.children[ci].dataset.gvCard === key) { existed = true; break; }
      }
      if (existed) return;
      var cards = byCard[ct];
      var groupNames = [];
      cards.forEach(function(c) {
        var g = String(c.group_name || "").trim() || "Chung";
        if (groupNames.indexOf(g) === -1) groupNames.push(g);
      });
      var cardDesc = "";
      for (var di = 0; di < cards.length; di++) {
        if (String(cards[di].card_description || "").trim()) { cardDesc = cards[di].card_description; break; }
      }
      if (!cardDesc) cardDesc = "Khóa video tổng hợp của giáo viên — bấm Xem video để bắt đầu.";
      grid.insertAdjacentHTML("beforeend",
        '<div class="card" data-gv-card="' + escHtml(key) + '">' +
          '<div class="card-color-bar"></div>' +
          '<div class="card-body">' +
            '<div class="card-top">' +
              '<div class="card-icon" style="background:' + escHtml(color) + '"><i class="fas ' + escHtml(icon) + '"></i></div>' +
              '<h3>' + escHtml(ct) + '</h3>' +
'<span class="status done"></span>' +
            '</div>' +
            '<p class="card-desc">' + escHtml(cardDesc) + '</p>' +
            '<div class="gv-card-foot">' +
              '<a class="btn" href="#" onclick="openGvSubject(this,\'' + escJs(n) + '\',\'' + escJs(ct) + '\'); return false;">Xem video</a>' +
              '<span class="gv-card-stats"><i class="fa-solid fa-video"></i> ' + gvCountText(cards) + '<i class="fa-solid fa-folder" style="margin-left:8px"></i> ' + groupNames.length + ' chủ đề</span>' +
            '</div>' +
          '</div>' +
        '</div>');
    });
  });

  if (typeof applyCardDominoEffect === "function") applyCardDominoEffect();
}

/* Đổ card BÀI TEST từ database (test_sets) vào GRID MÔN HỌC — mỗi bài = 1 card.
   Dùng `.status.done` / `.status.up` có sẵn trong CSS. */
function mergeDbTestCards(list) {
  if (!list || !list.length) return;
  window.__testCardMap = window.__testCardMap || {};
  var subjects = window.PHONGHOC_SUBJECTS || [];
  list.forEach(function (t) {
    var s = null;
    subjects.forEach(function (x) { if (x.name === String(t.subject || "").trim()) s = x; });
    if (!s) return;
    var grid = document.getElementById(s.id) ? document.getElementById(s.id).querySelector(".grid") : null;
    if (!grid) return;
    var key = String(t.set_id || t.id || "");
    if (!key || grid.querySelector('.card[data-test-card="' + key + '"]')) return;
    var color = s.cardColor || s.tabColor || "#0d9488";
    var icon = s.icon || "fa-book";
    var de = "t:" + key;
    var url = "../cauhoi/" + ((s.id === "anh") ? "questionenglish.html" : "filetest.html") + "?de=" + de;
    var copyLink = location.origin + "/?open=phong-hoc&de=" + de;
    var done = !!t.is_complete;
    var startAt = t.start_at || null;
    var endAt = t.end_at || null;
    // Quyền cao nhất: giáo viên bật "Hoàn thành" VÀ thời điểm hiện tại nằm trong khoảng mở đề.
    var canOpen = done && isTestInTimeWindow(startAt, endAt);
    window.__testCardMap[de] = { url: url, subjectId: s.id, done: done, start_at: startAt, end_at: endAt, canOpen: canOpen };
    var stats = [];
    if (t.minutes > 0) stats.push(t.minutes + " phút");
    grid.insertAdjacentHTML("beforeend",
      '<div class="card" data-test-card="' + escHtml(key) + '">' +
        '<div class="card-color-bar"></div>' +
        '<div class="card-body">' +
          '<div class="card-top">' +
            '<div class="card-icon" style="background:' + escHtml(color) + '"><i class="fas ' + escHtml(icon) + '"></i></div>' +
            '<h3>' + escHtml(t.name || "Bài kiểm tra") + '</h3>' +
            '<span class="status ' + (canOpen ? 'done' : 'pending') + '"></span>' +
          '</div>' +
          '<p class="card-desc">' + escHtml(t.description || "Bài kiểm tra từ giáo viên — bấm Làm bài để bắt đầu.") + '</p>' +
          '<div class="btn-row">' +
            (canOpen
              ? '<a class="btn" href="#" onclick="loadQuiz(this,\'' + escJs(url) + '\'); return false;">Làm bài</a>' +
                '<a class="btn-copy-icon" href="#" title="Copy link bài test" onclick="copyQuizLink(this,\'' + escJs(copyLink) + '\'); return false;"><i class="fas fa-link"></i></a>'
              : '<a class="btn disabled" href="#" style="pointer-events:auto" onclick="blockQuizByDe(\'' + escJs(de) + '\'); return false;">' + (done ? 'Chưa mở' : 'Sắp ra mắt') + '</a>') +
          '</div>' +
          (stats.length
            ? '<div style="margin-top:8px;font-size:12px;color:#94a3b8;display:flex;align-items:center;gap:6px"><i class="fa-regular fa-clock"></i> ' + escHtml(stats.join(" · ")) + '</div>'
            : '') +
        '</div>' +
      '</div>');
  });
  if (typeof applyCardDominoEffect === "function") applyCardDominoEffect();
}

function openGvSubject(el, subjectName, cardTitle) {
  document.querySelectorAll(".card").forEach(function(c) { c.classList.remove("active-card"); });
  var card = el && el.closest ? el.closest(".card") : null;
  if (card) card.classList.add("active-card");

