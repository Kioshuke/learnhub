<!-- 🆕 [Refactor] filetest.html không còn tự thao tác Supabase nữa.
     Toàn bộ logic (tạo hồ sơ, reset tuần, lưu điểm) đã được chuyển sang
     learnhub-stats.js. Ở đây chỉ import và gọi API, giữ nguyên tên các hàm
     window.* cũ (ensureTestStatsProfile, saveTestResult)
     để không phải sửa các nơi đang gọi chúng (listener message, handleFinalSubmit). -->
<script>
window.ensureTestStatsProfile = async function(user){
    window.learnHubTestStats = user || null;
};

window.saveTestResult = async function(score, attempt){
    const user = window.learnHubUser;
    if (!user || !user.uid || window.parent === window) {
        showSaveStatus(false);
        return;
    }

    const requestId = `test-result-${Date.now()}-${Math.random().toString(36).slice(2)}`;

    const onAck = (event) => {
        if (!event.data || event.data.type !== "LEARNHUB_TEST_RESULT_ACK" || event.data.requestId !== requestId) return;
        window.removeEventListener("message", onAck);
        clearTimeout(ackTimer);
        showSaveStatus(true);
    };
    window.addEventListener("message", onAck);
    const ackTimer = setTimeout(() => {
        window.removeEventListener("message", onAck);
        showSaveStatus(false);
    }, 8000);

    window.parent.postMessage({
        type: "LEARNHUB_TEST_RESULT",
        requestId,
        score,
        // [Lịch sử làm bài] kèm snapshot đề + bài làm để web chính lưu vào test_attempts
        attempt: attempt || null
    }, "*");
};

function showSaveStatus(success){
    const el = document.getElementById("saveStatsStatus");
    if (!el) return;
    el.style.display = "block";
    el.innerText = success ? "Đã gửi kết quả về LearnHub." : "Không thể lưu kết quả. Vui lòng kiểm tra kết nối hoặc mở lại trang.";
    el.style.color = success ? "var(--success, #16a34a)" : "var(--danger, #c81515)";
}


</script>

<script>
// Lắng nghe tín hiệu từ trang chính gửi tới
window.addEventListener('message', (event) => {
    // Kiểm tra nếu tin nhắn gửi tới là lệnh đổi Dark Mode
    if (event.data && event.data.type === 'DARK_MODE') {
        const isDark = event.data.value;
        if (isDark) {
            document.body.classList.add('dark-mode');
        } else {
            document.body.classList.remove('dark-mode');
        }
    }

    // 🆕 [LearnHub Test - Giai đoạn 1] Nhận thông tin user từ web chính (LearnHub)
    if (event.data && event.data.type === 'LEARNHUB_USER') {
