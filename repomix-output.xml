<file path="supabase/dump-drift.sql">
-- ============================================================================
-- [FIX BUG #12]  DUMP object "schema drift"  —  CHỈ ĐỌC, KHÔNG thay đổi gì.
-- ----------------------------------------------------------------------------
-- Mục đích: lấy ĐÚNG định nghĩa thật của các object có trên DB live nhưng
-- không có CREATE trong repo, để chốt (idempotent) vào supabase/schema.sql.
--
-- CÁCH DÙNG: Supabase Dashboard -> SQL Editor -> dán TOÀN BỘ file này -> Run.
--            Copy kết quả của TẤT CẢ các tab trả về và gửi lại.
-- KHÔNG có câu lệnh nào ghi/xóa — chạy an toàn.
-- ============================================================================

-- 1) Cột của 3 bảng bị thiếu --------------------------------------------------
select '1_columns' as phan, table_name, ordinal_position, column_name,
       data_type, udt_name, is_nullable, column_default
from information_schema.columns
where table_schema = 'public'
  and table_name in ('whitelist_settings','video_cards','tailieu_docs')
order by table_name, ordinal_position;

-- 2) Ràng buộc PK / FK / UNIQUE / CHECK -------------------------------------
select '2_constraints' as phan, conrelid::regclass::text as table_name,
       conname, contype, pg_get_constraintdef(oid) as definition
from pg_constraint
where connamespace = 'public'::regnamespace
  and conrelid::regclass::text in ('whitelist_settings','video_cards','tailieu_docs')
order by 2, 3;

-- 3) Index -------------------------------------------------------------------
select '3_indexes' as phan, tablename, indexname, indexdef
from pg_indexes
where schemaname = 'public'
  and tablename in ('whitelist_settings','video_cards','tailieu_docs')
order by 2, 3;

-- 4) RLS: bảng nào bật + policy ---------------------------------------------
select '4_rls_enabled' as phan, c.relname as table_name,
       c.relrowsecurity as rls_enabled, c.relforcerowsecurity as rls_forced
from pg_class c
where c.relnamespace = 'public'::regnamespace
  and c.relname in ('whitelist_settings','video_cards','tailieu_docs');

select '4_rls_policies' as phan, tablename, policyname, cmd, roles, qual, with_check
from pg_policies
where schemaname = 'public'
  and tablename in ('whitelist_settings','video_cards','tailieu_docs')
order by 2, 3;

-- 5) Định nghĩa ĐẦY ĐỦ các function bị thiếu (copy nguyên văn) ----------------
select '5_functions' as phan, p.proname,
       pg_get_function_identity_arguments(p.oid) as args,
       pg_get_functiondef(p.oid) as definition
from pg_proc p
where p.pronamespace = 'public'::regnamespace
  and p.proname in ('store_otp','verify_otp',
                    'list_tailieu_docs','teacher_upsert_tailieu_doc','teacher_delete_tailieu_doc')
order by p.proname;

-- 6) Bảng / view nào liên quan OTP (nếu hàm lưu vào bảng riêng) ---------------
select '6_otp_objects' as phan, table_name, table_type
from information_schema.tables
where table_schema = 'public'
  and (table_name ilike '%otp%' or table_name ilike '%code%')
order by 1, 2;
</file>

<file path="supabase/fix-blog-covers-drive.sql">
-- ============================================================================
-- Chuyển ảnh bìa blog đã đăng từ pictures/loading*.jpg sang Google Drive
-- ----------------------------------------------------------------------------
-- Ảnh dùng link trực tiếp (lh3) để thẻ <img>/CSS hiển thị được.
-- Cách dùng: dán vào Supabase Dashboard -> SQL Editor -> Run (chạy 1 lần).
-- An toàn khi chạy lại: chỉ thay đúng các link cũ, không đụng ảnh khác.
-- ============================================================================

update public.blog_posts
   set cover_url = replace(
                     replace(
                       replace(
                         replace(cover_url,
                           'pictures/loading1.jpg',
                           'https://lh3.googleusercontent.com/d/1f3rEeg-z1nOk7uo8q4L_iT58Lj7u_LgK'),
                         'pictures/loading2.jpg',
                         'https://lh3.googleusercontent.com/d/1XZPTLHhFprawMWYCqRKeMbX_8uRcnffd'),
                       'pictures/loading3.jpg',
                       'https://lh3.googleusercontent.com/d/1MHymxXGWpJDsZZo_RSED_7v7pA3kvEJ8'),
                     'pictures/loading4.jpg',
                     'https://lh3.googleusercontent.com/d/17FJKkeKnybZs4oqB51ub5hY4nRXG59Li')
 where cover_url like '%pictures/loading1.jpg%'
    or cover_url like '%pictures/loading2.jpg%'
    or cover_url like '%pictures/loading3.jpg%'
    or cover_url like '%pictures/loading4.jpg%';

-- Xem lại: con_link_cu = false là đã chuyển xong
select id,
       title,
       cover_url,
       (cover_url like '%pictures/loading%.jpg%') as con_link_cu
from public.blog_posts
order by pinned desc, created_at desc;
</file>

<file path="supabase/fix-blog-links.sql">
-- ============================================================================
-- Sửa link trong các bài blog ĐÃ ĐĂNG
-- ----------------------------------------------------------------------------
-- Đổi link mở thẳng file riêng (bị lỗi đăng nhập) sang deep link của web chính:
--   https://learnhubpf.pages.dev/?open=...
-- Cách dùng: dán vào Supabase Dashboard -> SQL Editor -> Run (chạy 1 lần).
-- An toàn khi chạy lại: sau lần đầu sẽ không còn link cũ để thay.
-- ============================================================================

update public.blog_posts
   set content = replace(
                   replace(
                     replace(
                       replace(content,
                         'https://learnhubpf.pages.dev/element/forum.html',
                         'https://learnhubpf.pages.dev/?open=forum'),
                       'https://learnhubpf.pages.dev/element/hubfile.html',
                       'https://learnhubpf.pages.dev/?open=tai-lieu'),
                     'https://learnhubpf.pages.dev/element/phong-hoc.html',
                     'https://learnhubpf.pages.dev/?open=phong-hoc'),
                   'https://learnhubpf.pages.dev/flashcard/hub.html',
                   'https://learnhubpf.pages.dev/?open=flash')
 where content like '%learnhubpf.pages.dev/element/%'
    or content like '%learnhubpf.pages.dev/flashcard/hub.html%';

-- Xem lại: con_link_cu = false là đã sửa xong
select id,
       title,
       (content like '%learnhubpf.pages.dev/element/%'
        or content like '%learnhubpf.pages.dev/flashcard/hub.html%') as con_link_cu,
       (content ~ '\?open=(flash|forum|tai-lieu|phong-hoc)') as co_deep_link
from public.blog_posts
order by pinned desc, created_at desc;
</file>

<file path="supabase/rename-video-card.sql">
-- Đổi tên card / khóa (card_title) trong 1 môn.
-- Cập nhật toàn bộ video có đúng subject + card_title cũ.

create or replace function public.teacher_rename_video_card(
  p_subject text,
  p_old_title text,
  p_new_title text
) returns jsonb
language plpgsql security definer
set search_path = public
as $$
declare
  v_old text;
  v_new text;
  v_cnt int;
begin
  if not public.is_teacher() then
    return jsonb_build_object('ok', false, 'error', 'forbidden');
  end if;

  v_old := btrim(coalesce(p_old_title, ''));
  v_new := btrim(coalesce(p_new_title, ''));
  if v_old = '' then
    return jsonb_build_object('ok', false, 'error', 'empty_old_title');
  end if;
  if v_new = '' then
    return jsonb_build_object('ok', false, 'error', 'empty_new_title');
  end if;

  update public.video_cards
     set card_title = v_new,
         updated_at = now()
   where subject = p_subject
     and card_title = v_old;

  get diagnostics v_cnt = row_count;
  return jsonb_build_object('ok', true, 'affected', v_cnt);
end;
$$;

revoke all on function public.teacher_rename_video_card(text, text, text) from public;
grant execute on function public.teacher_rename_video_card(text, text, text) to authenticated;
</file>

<file path="supabase/rename-video-group.sql">
-- Đổi tên nhóm / chủ đề (group_name) trong 1 card (theo môn + tên card).
-- Cập nhật toàn bộ video có đúng subject + card_title + group_name cũ.

create or replace function public.teacher_rename_video_group(
  p_subject text,
  p_card_title text,
  p_old_group text,
  p_new_group text
) returns jsonb
language plpgsql security definer
set search_path = public
as $$
declare
  v_old text;
  v_new text;
  v_cnt int;
begin
  if not public.is_teacher() then
    return jsonb_build_object('ok', false, 'error', 'forbidden');
  end if;

  v_old := btrim(coalesce(p_old_group, ''));
  v_new := btrim(coalesce(p_new_group, ''));
  if v_old = '' then
    return jsonb_build_object('ok', false, 'error', 'empty_old_group');
  end if;
  if v_new = '' then
    return jsonb_build_object('ok', false, 'error', 'empty_new_group');
  end if;

  update public.video_cards
     set group_name = v_new,
         updated_at = now()
   where subject = p_subject
     and card_title = p_card_title
     and group_name = v_old;

  get diagnostics v_cnt = row_count;
  return jsonb_build_object('ok', true, 'affected', v_cnt);
end;
$$;

revoke all on function public.teacher_rename_video_group(text, text, text, text) from public;
