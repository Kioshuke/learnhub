      --section-glow: rgba(124, 58, 237, 0.42);
      margin-top: 28px;
      animation: sectionFadeIn 0.45s ease both;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .section-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 40px;
    }

    .section-title {
      margin: 0;
      font-size: clamp(20px, 2.8vw, 28px);
      color: var(--section-accent);
    }

    .section-note {
      min-width: 44px;
      color: #475569;
      font-size: 15px;
      font-weight: 800;
      line-height: 1;
      text-align: center;
      white-space: nowrap;
    }

    .section-nav {
      width: 40px;
      height: 40px;
      border: 1px solid var(--section-border);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.96);
      color: var(--section-accent);
      cursor: pointer;
      font-size: 28px;
      font-weight: 800;
      line-height: 0;
      display: inline-grid;
      place-items: center;
      padding: 0 0 3px;
      box-shadow: 0 8px 16px var(--section-soft);
      transition: transform 0.15s ease, opacity 0.15s ease, border-color 0.15s ease;
    }

    .section-nav:hover:not(:disabled) {
      transform: translateY(-2px);
      border-color: var(--section-accent);
    }

    .section-nav:disabled {
      opacity: 0.35;
      cursor: not-allowed;
      box-shadow: none;
    }

    .topic-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: 16px;
      margin-top: 28px;
      align-items: stretch;
    }

    .topic-slider {
      --slide-index: 0;
      --slide-step: calc((100% + 16px) / 3);
      margin: 28px -15px -22px;
      overflow-x: hidden;
      overflow-y: visible;
      padding: 0 15px 22px;
    }

    .topic-slider .topic-grid {
      display: flex;
      grid-template-columns: none;
      gap: 16px;
      margin-top: 0;
      transform: translateX(calc(var(--slide-index) * -1 * var(--slide-step)));
      transition: transform 0.36s ease;
      align-items: stretch;
    }

    .topic-slider .topic-card {
      flex: 0 0 calc((100% - 32px) / 3);
    }

    .topic-card {
      position: relative;
      overflow: hidden;
      border-radius: 22px;
      background: var(--glass);
      border: 1px solid var(--line);
      outline: 0 solid transparent;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, outline-color 0.2s ease, outline-width 0.2s ease;
      min-height: 210px;
      height: 100%;
      animation: cardFloatIn 0.35s ease both;
    }

    .topic-card::before {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      right: -60px;
      top: -80px;
      background: radial-gradient(circle, var(--section-soft), transparent 70%);
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .topic-card:hover {
      transform: translateY(-7px) scale(1.018);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), var(--section-soft));
      border-color: var(--section-accent);
      outline: 3px solid var(--section-soft);
    }

    .topic-card:hover::before {
      opacity: 1;
      transform: scale(1.16);
      background: radial-gradient(circle, var(--section-glow), transparent 70%);
    }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .chip {
      font-size: 12px;
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--section-soft);
      border: 1px solid var(--section-border);
      color: var(--section-accent-dark);
      white-space: nowrap;
    }

    .fc-hub-grip {
      color: var(--section-accent);
      font-size: 13px;
      cursor: grab;
      padding: 2px 4px;
      opacity: .75;
      flex: none;
    }
    .fc-hub-grip:hover { opacity: 1; }
    .topic-card.dragging { opacity: .4; border-style: dashed; }
    .topic-card.d-over { border-color: var(--section-accent); background: var(--section-soft); box-shadow: 0 0 0 2px var(--section-border); }

    .status-badge {
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 999px;
      font-weight: 700;
      white-space: nowrap;
    }

    .status-done {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
    }

    .status-update {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
    }

    .card-updating-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      padding: 4px 10px;
      border-radius: 999px;
      font-weight: 700;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
      animation: badgePulse 2s ease-in-out infinite;
    }

    @keyframes badgePulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    .open-btn.updating {
      background: linear-gradient(135deg, #94a3b8, #64748b) !important;
      box-shadow: 0 8px 16px rgba(100, 116, 139, 0.3) !important;
      cursor: not-allowed;
    }

    .open-btn.updating:hover {
      transform: none;
    }

    .topic-title {
      margin: 0;
      font-size: 22px;
      font-weight: 800;
    }

    .topic-desc {
      margin: 0;
