    <style>
        .no-scrollbar::-webkit-scrollbar{width:0;height:0}
        .no-scrollbar{scrollbar-width:none}

        /* ---- Lịch sử làm bài ---- */
        .attempt-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:1px solid var(--card-border);background:var(--card,#fff);cursor:pointer;transition:background .15s,border-color .15s,transform .15s}
        .attempt-item:hover{background:rgba(16,185,129,.06);border-color:rgba(16,185,129,.35);transform:translateY(-1px)}
        .attempt-group{overflow:hidden;border:1px solid var(--card-border);border-radius:12px;background:var(--card,#fff)}
        .attempt-group-head{width:100%;text-align:left;display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,1.25fr);align-items:center;gap:14px;padding:12px;background:transparent;cursor:pointer}
        .attempt-group-head:hover{background:rgba(16,185,129,.06)}
        .attempt-group-copy{min-width:0}
        .attempt-group-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
        .attempt-group-stat{min-width:0;padding:7px 8px;border-radius:9px;background:rgba(148,163,184,.1)}
        .attempt-group-stat-label{font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:var(--text-sub)}
        .attempt-group-stat-value{font-size:11px;font-weight:800;margin-top:3px;color:var(--text-main);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .attempts-modal{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:16px}
        .attempts-modal[hidden]{display:none}
        .attempts-modal-backdrop{position:absolute;inset:0;background:rgba(2,12,27,.55);backdrop-filter:blur(4px)}
        .attempts-modal-panel{position:relative;display:flex;flex-direction:column;width:min(560px,100%);max-height:80vh;padding:18px}
        @media(max-width:640px){.attempt-group-head{grid-template-columns:minmax(0,1fr);gap:10px}.attempt-group-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.attempt-group-stat{padding:6px}.attempt-group-stat-value{font-size:10px}.attempts-modal{padding:10px}.attempts-modal-panel{max-height:88vh;padding:14px}}
        .attempt-score{font-weight:800;font-size:15px;min-width:48px;text-align:center;border-radius:10px;padding:6px 4px;flex-shrink:0}
        .attempt-tag{display:inline-flex;align-items:center;gap:3px;padding:1px 6px;border-radius:999px;font-size:9px;font-weight:800;background:rgba(239,68,68,.12);color:#ef4444}

        /* ---- Chi tiết bài làm: dùng lại class chung của trang quiz (quiz-review.css) ---- */
        /* Khung chi tiết dùng chung: card câu hỏi, ô đáp án, đúng/sai, đọc hiểu, điền lỗ,
           màu review (.review-true/.review-false), mục lục (.main-layout/.sidebar/.nav-*)
           đều được định nghĩa trong styles/quiz-review.css để đồng bộ 100% với trang thi. */
        .at-notice{display:flex;align-items:center;gap:6px;padding:8px 10px;border-radius:10px;font-size:12px;font-weight:700;background:rgba(245,158,11,.1);color:#b45309}
        .at-empty-note{font-size:12.5px;color:var(--text-sub);text-align:center;padding:14px 0}
    </style>
    <!-- LEADERBOARD FULL MODAL -->
    <div id="lb-modal" class="lh-modal-overlay fixed inset-0 z-50 flex justify-center items-center opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="lh-modal-box rounded-2xl w-full max-w-6xl mx-4 shadow-2xl transform scale-95 transition-transform duration-300 relative flex flex-col" style="height:80vh">
            <div class="flex items-center justify-between px-5 py-3 border-b" style="border-color:var(--card-border)">
                <h3 class="text-sm font-bold flex items-center gap-1.5" style="color:var(--text-main)">
                    <i class="fas fa-trophy text-amber-500"></i> Bảng Xếp Hạng Tuần
                </h3>
                <button onclick="closeLeaderboardModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-base"></i>
                </button>
            </div>
            <div class="flex-1 overflow-hidden">
                <iframe id="lb-full-frame" src="" class="w-full h-full border-0 no-scrollbar"></iframe>
            </div>
        </div>
    </div>
    <script>
        function openLeaderboardModal() {
            const m = document.getElementById('lb-modal');
            document.getElementById('lb-full-frame').src = '../features/leaderboard.html?t=' + Date.now();
            m.classList.remove('opacity-0','pointer-events-none');
            m.classList.add('opacity-100');
            m.querySelector('div').classList.remove('scale-95');
            m.querySelector('div').classList.add('scale-100');
        }
        function closeLeaderboardModal() {
            const m = document.getElementById('lb-modal');
            m.classList.add('opacity-0','pointer-events-none');
            m.classList.remove('opacity-100');
            m.querySelector('div').classList.add('scale-95');
            m.querySelector('div').classList.remove('scale-100');
            setTimeout(() => { document.getElementById('lb-full-frame').src = ''; }, 300);
        }
        document.getElementById('lb-modal').addEventListener('click', e => { if (e.target === e.currentTarget) closeLeaderboardModal(); });
    </script>

