.nav-arrow-right,
.nav-arrow-right:hover {
  background: linear-gradient(135deg, #22c55e, #16a34a) !important;
  color: #fff !important;
  border-color: transparent !important;
  box-shadow: 0 10px 18px rgba(34, 197, 94, 0.35) !important;
}

.game-start-card,
.blast-box,
.game-shell,
.popup-box {
  background:
    radial-gradient(circle at top right, rgba(236, 72, 153, 0.1), transparent 34%),
    radial-gradient(circle at bottom left, rgba(37, 99, 235, 0.1), transparent 34%),
    rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 20px 42px rgba(15, 23, 42, 0.14);
}

.game-start-card h2 {
  color: #1d4ed8;
}

.match-card,
.options button {
  border: 1px solid rgba(37, 99, 235, 0.12);
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.1);
}

.match-card:hover,
.options button:hover {
  box-shadow: 0 14px 26px rgba(37, 99, 235, 0.16);
}

#intro-screen {
  background:
    radial-gradient(circle at 18% 18%, rgba(236, 72, 153, 0.2), transparent 30%),
    radial-gradient(circle at 82% 20%, rgba(37, 99, 235, 0.22), transparent 34%),
    radial-gradient(circle at 50% 92%, rgba(245, 158, 11, 0.18), transparent 36%),
