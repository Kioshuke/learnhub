    .highlight-box{background:#eff6ff;border:1px solid #bfdbfe;border-radius:16px;padding:16px 20px;margin:20px 0;font-size:14px;color:#1e40af;line-height:1.7;display:flex;gap:14px;align-items:flex-start}
