/* ============================================================ */
/* ✨ ANIMATIONS (Rung, Bắn, Bay) */
/* ============================================================ */
/* Đạn bay lên */
.bullet-trace {
    position: absolute;
    width: 6px; /* Cho đạn mập hơn xíu nhìn cho rõ */
    height: 40px;
    background: linear-gradient(to top, #00f2ff, transparent); /* Hiệu ứng vệt mờ */
    border-radius: 100px;
    box-shadow: 0 0 20px #00f2ff, 0 0 40px #00f2ff;
    z-index: 15;
    pointer-events: none;
    animation: bulletFly 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards; /* Bay mượt hơn */
}
.emergency-flash {
    animation: emergencyRed 0.5s ease-in-out;
}
@keyframes bulletFly {
    from { transform: translate(-50%, 0); bottom: 180px; opacity: 1; }
    to { transform: translate(-50%, -500px); bottom: 180px; opacity: 0; }
}
/* Lớp phủ báo động đỏ toàn màn hình */
.emergency-flash::after {
    content: "";
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(255, 0, 0, 0.6);
    z-index: 999;
    pointer-events: none;
    animation: alertPulse 0.5s ease-out forwards;
}

@keyframes alertPulse {
    0% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
}
@keyframes emergencyRed {
    0% { box-shadow: 0 0 0px red inset; background: #000; }
    20% { box-shadow: 0 0 100px red inset; background: rgba(255, 0, 0, 0.4); }
    40% { box-shadow: 0 0 20px red inset; background: #000; }
    60% { box-shadow: 0 0 80px red inset; background: rgba(255, 0, 0, 0.3); }
    100% { box-shadow: 0 0 0px red inset; background: #000; }
}
@keyframes monsterWobble {
    from { transform: rotate(-3deg); }
    to { transform: rotate(3deg); }
}

@keyframes playerFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}

@keyframes engineBurn {
    from { opacity: 0.6; transform: translateX(-50%) scaleY(1); }
    to { opacity: 0.9; transform: translateX(-50%) scaleY(1.3); }
}
/* Trang trí hành tinh */
.planet {
    position: absolute;
    opacity: 0.65;
    filter: blur(1px);
    z-index: 2;
    animation: floatSlow 10s linear infinite;
}
.p1 { top: 10%; right: 10%; font-size: 50px; }
.p2 { top: 40%; left: 5%; font-size: 30px; animation-duration: 15s; }
.p3 { bottom: 20%; right: 5%; font-size: 40px; animation-delay: -5s; }

.defender-nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(14px);
    pointer-events: none;
    z-index: 2;
}

.defender-nebula.n1 {
    width: 190px;
    height: 190px;
    top: 18%;
    left: 8%;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.45), transparent 70%);
}

.defender-nebula.n2 {
    width: 220px;
    height: 220px;
    top: 10%;
    right: 6%;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.4), transparent 70%);
}

.defender-nebula.n3 {
    width: 260px;
    height: 260px;
    bottom: 20%;
    left: 35%;
    background: radial-gradient(circle, rgba(244, 63, 94, 0.3), transparent 70%);
}

.starfield-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
}

.starfield-layer .star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
    opacity: 0.75;
    animation: starPulse 2.8s ease-in-out infinite;
}

.star.s1 { top: 12%; left: 10%; animation-delay: 0s; }
.star.s2 { top: 22%; left: 26%; animation-delay: 0.8s; }
.star.s3 { top: 14%; left: 52%; animation-delay: 1.4s; }
.star.s4 { top: 30%; left: 70%; animation-delay: 0.4s; }
.star.s5 { top: 18%; left: 88%; animation-delay: 1.1s; }
.star.s6 { top: 50%; left: 14%; animation-delay: 1.7s; }
.star.s7 { top: 42%; left: 40%; animation-delay: 0.3s; }
.star.s8 { top: 58%; left: 68%; animation-delay: 1.9s; }
.star.s9 { top: 48%; left: 82%; animation-delay: 0.6s; }
.star.s10 { top: 66%; left: 26%; animation-delay: 1.2s; }
.star.s11 { top: 72%; left: 52%; animation-delay: 0.2s; }
.star.s12 { top: 62%; left: 92%; animation-delay: 1.5s; }
/* Hiệu ứng Trái tim vỡ bay lên */
.floating-broken-heart {
    position: absolute;
    bottom: 180px; /* Xuất phát gần họng súng */
    left: 50%;
    transform: translateX(-50%);
    font-size: 80px; /* To mờ mờ */
    opacity: 0.6; /* Mờ mờ ban đầu */
    filter: drop-shadow(0 0 10px #ff0055); /* Hào quang đỏ máu */
    z-index: 50; /* Đè lên phi thuyền và quái vật */
    pointer-events: none;
    will-change: transform, opacity;
    animation: heartbreakFloat 1s ease-out forwards;
}

/* Nếu mă dùng ảnh cho tim vỡ thì thêm CSS này: */
/* .floating-broken-heart img {
    width: 100%;
    height: 100%;
    object-fit: contain;
} */

@keyframes heartbreakFloat {
    0% { transform: translateX(-50%) translateY(0) scale(1); opacity: 0.6; }
    50% { transform: translateX(-50%) translateY(-50px) scale(1.2); opacity: 0.4; }
    100% { transform: translateX(-50%) translateY(-100px) scale(1); opacity: 0; }
}
@keyframes floatSlow {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(-20px) rotate(360deg); }
}
@keyframes float {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(5deg); }
    100% { transform: translateY(0px) rotate(0deg); }
}

@keyframes starPulse {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.35); }
}

@keyframes starTwinkle {
    0% { opacity: 0.45; }
    50% { opacity: 0.8; }
    100% { opacity: 0.6; }
}

/* Popup Game Over */
.game-over-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: none; /* Hiện khi thua */
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.game-over-box {
    text-align: center;
    border: 3px solid #ff0055;
    padding: 30px;
    background: #000;
    border-radius: 20px;
    box-shadow: 0 0 30px #ff0055;
}

.broken-ship {
    font-size: 80px;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 10px #ff0055);
}

.game-over-box h2 {
    color: #ff0055;
    font-size: 35px;
    margin: 10px 0;
    text-shadow: 0 0 10px #ff0055;
}

.game-over-box p { color: #fff; margin-bottom: 20px; }

.game-overlay {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 120;
    padding: 18px;
    background: rgba(2, 6, 23, 0.56);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: auto;
}

.pause-box {
    width: min(360px, 92%);
    text-align: center;
    padding: 28px 24px 24px;
    border-radius: 24px;
    border: 1px solid rgba(34, 211, 238, 0.36);
    background:
      radial-gradient(circle at top, rgba(34, 211, 238, 0.18), transparent 38%),
      rgba(15, 23, 42, 0.92);
    box-shadow: 0 24px 46px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    color: #fff;
    pointer-events: auto;
}

.pause-box h2 {
    margin: 0 0 16px;
    color: #e0f2fe;
    font-size: 30px;
    letter-spacing: 0.02em;
    text-shadow: 0 0 14px rgba(34, 211, 238, 0.45);
}

.pause-box button {
    margin: 0;
    width: 100%;
    border-radius: 16px;
    background: linear-gradient(135deg, #06b6d4, #6366f1);
    box-shadow: 0 14px 28px rgba(6, 182, 212, 0.24);
}

.pause-box button:hover {
    transform: translateY(-2px);
}
@keyframes shakeError {
  0% { transform: translateX(0); }
  20% { transform: translateX(-8px); }
  40% { transform: translateX(8px); }
  60% { transform: translateX(-6px); }
  80% { transform: translateX(6px); }
  100% { transform: translateX(0); }
}

.shake {
  animation: shakeError 0.25s ease !important;
}
#intro-screen {
    position: fixed;
    inset: 0;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: 0.5s;
}

#intro-screen h1 {
    color: #1d4ed8;
    font-size: clamp(34px, 6vw, 64px);
    margin-bottom: 18px;
    letter-spacing: 1px;
    text-shadow: 0 10px 30px rgba(37, 99, 235, 0.2);
}

#intro-screen button {
    padding: 14px 30px;
    font-size: 18px;
    font-weight: 700;
    border-radius: 14px;
    border: none;
    background: linear-gradient(135deg, #6366f1, #a855f7);
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.35);
}

/* ===== VISUAL REFRESH - sinh động hơn, không đổi logic ===== */
html,
body {
  background:
    radial-gradient(circle at 12% 10%, rgba(236, 72, 153, 0.18), transparent 26%),
    radial-gradient(circle at 84% 14%, rgba(37, 99, 235, 0.18), transparent 30%),
    radial-gradient(circle at 68% 86%, rgba(245, 158, 11, 0.15), transparent 34%),
    linear-gradient(135deg, #f8fbff 0%, #fff7fb 44%, #f5fffb 100%);
  background-attachment: fixed;
}

/* ===== FLASHCARD CATEGORY UI ===== */
.fc-review-indicator {
    font-size: 13px;
    font-weight: 700;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 6px 14px;
    border-radius: 999px;
    margin-top: 10px;
    text-align: center;
    animation: reviewPulse 2s ease-in-out infinite;
}

@keyframes reviewPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

body {
  isolation: isolate;
  font-family: 'Segoe UI', Roboto, Arial, system-ui, -apple-system, sans-serif;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  font-synthesis: none;
}

button,
.question,
.options button,
#topicBanner,
#progressText,
#score,
.streak-badge {
  font-family: 'Segoe UI', Roboto, Arial, system-ui, -apple-system, sans-serif !important;
  font-variant-ligatures: none;
}

body > * {
  position: relative;
  z-index: 1;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.58), transparent 78%);
}

body::after {
  content: "";
  position: fixed;
  inset: auto -12% -26% -12%;
  height: 42vh;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.12), transparent 68%);
}

#menu,
#topicBanner,
#progressContainer,
.mode {
  position: relative;
  z-index: 1;
}

#menu {
  background: transparent;
  border: none;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

#menu button {
  position: relative;
  overflow: hidden;
}

#menu button::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0;
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.18), rgba(37, 99, 235, 0.16));
  transition: opacity 0.2s ease;
}

#menu button:hover::before {
  opacity: 1;
}

#menu button.active-nav {
  background: linear-gradient(135deg, #2563eb, #7c3aed) !important;
  box-shadow: 0 12px 26px rgba(37, 99, 235, 0.28);
}

/* Mỗi tab 1 màu riêng */
#menu button.active-nav[data-mode="flashcard"] {
  background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.28);
}
#menu button.active-nav[data-mode="match"] {
  background: linear-gradient(135deg, #a78bfa, #7c3aed) !important;
  box-shadow: 0 12px 24px rgba(124, 58, 237, 0.3);
}
#menu button.active-nav[data-mode="blast"] {
  background: linear-gradient(135deg, #fbbf24, #f59e0b) !important;
  box-shadow: 0 12px 24px rgba(245, 158, 11, 0.32);
}
#menu button.active-nav[data-mode="fillblank"] {
  background: linear-gradient(135deg, #22d3ee, #0891b2) !important;
  box-shadow: 0 12px 24px rgba(8, 145, 178, 0.3);
}
#menu button.active-nav[data-mode="defender"] {
  background: linear-gradient(135deg, #f472b6, #db2777) !important;
  box-shadow: 0 12px 24px rgba(219, 39, 119, 0.3);
}
#menu button.active-nav[data-mode="wordsearch"] {
  background: linear-gradient(135deg, #34d399, #059669) !important;
  box-shadow: 0 12px 24px rgba(5, 150, 105, 0.3);
}

/* Hover theo màu từng tab */
#menu button[data-mode="flashcard"]:hover:not(.active-nav) { color: #2563eb; background: rgba(37, 99, 235, 0.08); }
#menu button[data-mode="match"]:hover:not(.active-nav) { color: #7c3aed; background: rgba(124, 58, 237, 0.08); }
#menu button[data-mode="blast"]:hover:not(.active-nav) { color: #d97706; background: rgba(245, 158, 11, 0.1); }
#menu button[data-mode="fillblank"]:hover:not(.active-nav) { color: #0891b2; background: rgba(8, 145, 178, 0.08); }
#menu button[data-mode="defender"]:hover:not(.active-nav) { color: #db2777; background: rgba(219, 39, 119, 0.08); }
#menu button[data-mode="wordsearch"]:hover:not(.active-nav) { color: #059669; background: rgba(5, 150, 105, 0.08); }

#topicBanner,
#progressContainer {
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-color: rgba(255, 255, 255, 0.78);
  box-shadow: 0 16px 34px rgba(37, 99, 235, 0.13);
}

#topicBanner {
  text-align: center;
}

#progressInner {
  background: linear-gradient(90deg, #ec4899, #2563eb, #22c55e);
  box-shadow: 0 0 18px rgba(37, 99, 235, 0.35);
}

.flash-front,
.flash-back {
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 12%, rgba(236, 72, 153, 0.13), transparent 28%),
    radial-gradient(circle at 88% 18%, rgba(37, 99, 235, 0.12), transparent 30%),
    rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 22px 48px rgba(15, 23, 42, 0.16);
}

.flash-front::before,
.flash-back::before {
  content: "";
  position: absolute;
  inset: 12px;
  border-radius: 24px;
  border: 1px solid rgba(37, 99, 235, 0.1);
  pointer-events: none;
}

.flash-front span,
.flash-back {
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.75);
}

.flash-back {
  background:
    radial-gradient(circle at 16% 16%, rgba(34, 211, 238, 0.16), transparent 28%),
    radial-gradient(circle at 86% 18%, rgba(168, 85, 247, 0.16), transparent 30%),
    linear-gradient(140deg, rgba(255, 255, 255, 0.96), rgba(239, 246, 255, 0.94));
  color: #3730a3;
}

.nav-arrow,
.speaker-icon {
  background: rgba(255, 255, 255, 0.92);
