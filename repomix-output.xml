                            <div class="tf-row" style="display: flex; align-items: center; justify-content: space-between; padding: 10px; border-bottom: 1px solid var(--tf-border); gap: 10px;">
                                <div class="tf-question-text" style="flex: 1; font-size: 0.9rem;">
