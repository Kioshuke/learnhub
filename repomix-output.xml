}

// 🔥 [Tiếng Anh] Tải full audio thành Blob URL để tua/bấm tới vị trí bất kỳ hoạt động
// trên mọi hosting (kể cả GitHub Pages không hỗ trợ Range request tốt)
function loadListeningAudios() {
    document.querySelectorAll('.listening-player audio[data-src]').forEach(audio => {
        const rawUrl = audio.getAttribute('data-src');
        if (!rawUrl) return;
        const url = encodeURI(decodeURI(rawUrl));
        fetch(url)
            .then(res => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.blob();
            })
            .then(blob => {
                const blobUrl = URL.createObjectURL(blob);
                audio.src = blobUrl;
            })
            .catch(err => {
                console.warn('Không tải được audio (giữ nguồn gốc):', url, err);
            });
    });
}
    // 4. Các hàm bổ trợ xử lý trạng thái làm bài
    // 🔥 [LearnHub Test] Mini toast xác nhận đã lưu đáp án (tái sử dụng lhToast từ ../toast.js)
    let activeAnswerToast = null;
    let lastToastKey = "";
    let lastToastTime = 0;
    function showAnswerToast(qIdx, answerText) {
        if (typeof window.lhToast !== "function") return;
        // Chặn kích hoạt kép: <label> chứa <input radio> bắn onclick 2 lần
        const key = `${qIdx}:${answerText}`;
        const now = Date.now();
        if (key === lastToastKey && now - lastToastTime < 100) return;
        lastToastKey = key;
        lastToastTime = now;

        // Chỉ giữ 1 mini toast duy nhất: xóa toast cũ ngay để không xếp chồng/nhảy lên
        if (activeAnswerToast) {
            try { if (activeAnswerToast.el) activeAnswerToast.el.remove(); } catch (e) {}
            activeAnswerToast = null;
        }
        try {
            const handle = window.lhToast(`Đã lưu đáp án ${answerText}`, {
                type: "success",
                title: `Câu ${qIdx + 1}`,
                durationMs: 1500,
                sound: false
            });
            activeAnswerToast = handle;
            if (handle && handle.el) {
                handle.el.classList.add("lh-toast-mini");
                const msgEl = handle.el.querySelector(".lh-toast-message");
                if (msgEl) msgEl.innerHTML = `Đã lưu đáp án <b>${String(answerText ?? "").replace(/[<>&"]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c])}</b>`;
            }
        } catch (e) {}
    }

    function selectAnswer(el, qIdx, subIdx) {
        // 🔥 Nếu đang khóa thì không làm gì
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;

        if(el.classList.contains('disabled')) return;

        // Câu passage: radio name dạng q-{qIdx}-{subIdx}
        if (subIdx !== undefined && subIdx !== null) {
            const group = `q-${qIdx}-${subIdx}`;
            document.querySelectorAll(`input[name="${group}"]`).forEach(input => input.parentElement.classList.remove('selected'));
            el.classList.add('selected');

            // 🔥 Mini toast xác nhận đã lưu đáp án (câu con của passage)
            const subSel = el.querySelector('input');
            if (subSel) showAnswerToast(qIdx, String.fromCharCode(65 + parseInt(subSel.value, 10)));

            // Đánh dấu xong khi đã trả lời đủ tất cả câu con
            const card = document.getElementById(`card-${qIdx}`);
            const subCount = card.querySelectorAll('.sub-q-block').length;
            let answered = 0;
            for (let s = 0; s < subCount; s++) {
                if (document.querySelector(`input[name="q-${qIdx}-${s}"]:checked`)) answered++;
            }
            if (answered === subCount) markDone(qIdx);
            return;
        }

        document.querySelectorAll(`input[name="question-${qIdx}"]`).forEach(input => input.parentElement.classList.remove('selected'));
        el.classList.add('selected');

        // 🔥 Mini toast xác nhận đã lưu đáp án (câu trắc nghiệm thường)
        const selInput = el.querySelector('input');
        if (selInput) showAnswerToast(qIdx, String.fromCharCode(65 + parseInt(selInput.value, 10)));

        markDone(qIdx);
    }

    function checkTFDone(globalIdx) {
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;

        const checked = document.querySelectorAll(`input[name^="tf-${globalIdx}-"]:checked`);
        
        const card = document.getElementById(`card-${globalIdx}`);
        const totalSub = card.querySelectorAll('.tf-row').length;

        if (checked.length === totalSub) markDone(globalIdx);
    }

    function markDone(qIdx) {
        document.getElementById(`nav-${qIdx}`).classList.add('done');
        updateProgress();
    }

    // 🔥 [Tự luận] khi gõ xong (rời ô) -> toast đã lưu đáp án
    function shortToast(qIdx) {
        if (document.getElementById("quiz-container").classList.contains("quiz-locked")) return;
        const input = document.querySelector(`[data-qidx="${qIdx}"]`);
        if (input && input.value && input.value.trim() !== "") {
            showAnswerToast(qIdx, "câu trả lời");
        }
    }


function updateProgress(isFinished, score = 0) {
        const textEl = document.getElementById('progressText');
        const totalQs = document.querySelectorAll('.nav-item').length;
        if (isFinished) {
            if (examConfig.showScore === 'none') {
                textEl.innerText = 'Đã nộp bài';
                textEl.style.color = "";
            } else {
                textEl.innerText = `${score.toFixed(2)} / 10`;
                textEl.style.color = "var(--success)";
            }
        } else {
            const doneCount = document.querySelectorAll('.nav-item.done').length;
            textEl.innerText = `${doneCount}/${totalQs} câu`;
        }
    }
function submitQuiz() {
    openModal('confirmModal');
