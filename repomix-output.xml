                answersContent = `
                    ${promptHtml}
                    <textarea class="short-input writing-input" placeholder="Nhập câu trả lời của bạn..." oninput="markDone(${globalIdx})" onblur="shortToast(${globalIdx})" data-qidx="${globalIdx}" rows="${item.rows || 3}" style="width: 100%; box-sizing: border-box; padding: 12px; border: 2px solid #e2e8f0; border-radius: 10px; outline: none; font-size: 0.95rem; resize: vertical; font-family: inherit; line-height: 1.6;"></textarea>`;
            }
            // 🔥 [Tiếng Anh] Đọc hiểu: 1 đoạn văn (passage) + nhiều câu hỏi trắc nghiệm con
            else if (item.type === 'passage') {
                window.totalMaxScore += 1;
                const passageContent = (item.passage && item.passage.trim() !== "") ? esc(item.passage) : '';
                answersContent = `
                    <div class="passage-layout">
                        <div class="passage-left">
                            <div class="passage-left-inner">
                                ${passageContent}
                            </div>
                        </div>
                        <div class="passage-right sub-questions">
                            ${(item.subQuestions || []).map((sub, subIdx) => `
                                <div class="sub-q-block">
                                    <div class="sub-q-text" style="font-weight: 600; font-size: 0.92rem; margin-bottom: 10px;">
                                        <strong style="color: var(--primary);">${String.fromCharCode(97 + subIdx)}.</strong> ${esc(sub.question || "")}
                                    </div>
                                    <div class="answers-grid">
                                        ${sub.answers.map((ans, aIdx) => `
                                            <label class="ans-label" id="label-${globalIdx}-${subIdx}-${aIdx}" onclick="selectAnswer(this, ${globalIdx}, ${subIdx})">
                                                <input type="radio" name="q-${globalIdx}-${subIdx}" value="${aIdx}">
                                                <span><b>${String.fromCharCode(65 + aIdx)}.</b> ${answerInnerHtml(ans, aIdx)}</span>
