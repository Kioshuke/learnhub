      padding: 10px 10px;
      font-size: 14px;
      font-weight: 600;
      color: #334155;
      cursor: pointer;
    }

    .filter-item:hover,
    .filter-item.active {
      background: rgba(37, 99, 235, 0.1);
      color: #1d4ed8;
    }

    .section-block {
      --section-accent: #2563eb;
