      flex-shrink: 0;
    }
    .meta-list .m-label { color: var(--text-sub); font-weight: 600; min-width: 74px; }
    .meta-list .m-value { font-weight: 600; word-break: break-word; }
    .detail-actions {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 14.5px;
      font-weight: 700;
font-family: inherit;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.15s ease;
      margin: 0;
    }
    .btn-primary {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 8px 18px var(--primary-soft);
    }
    .btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); }
    .btn-ghost {
      background: var(--panel);
      border-color: var(--line);
      color: var(--text-main);
    }
    .btn-ghost:hover { border-color: var(--primary); color: var(--primary); }
    .btn[disabled] { opacity: 0.5; cursor: not-allowed; }

    .mobile-note {
      display: none;
      align-items: flex-start;
      gap: 10px;
      position: relative;
      z-index: 2;
      margin: 12px;
      padding: 13px 14px;
      border-radius: 12px;
      background: var(--panel);
      border: 1px solid var(--line);
      color: var(--text-main);
      font-size: 13.5px;
      line-height: 1.55;
      box-shadow: var(--shadow);
    }
    .mobile-note i { color: var(--primary); font-size: 17px; margin-top: 2px; flex-shrink: 0; }
    .mobile-note .mn-inner { display: flex; flex-direction: column; gap: 4px; }
    .mobile-note .mn-title { font-size: 14.5px; font-weight: 800; }
    .mobile-note .mn-sub { color: var(--text-sub); }

/* ===== RESPONSIVE ===== */
    @media (min-width: 901px) {
      .detail-modal { height: min(760px, calc(var(--lh-view-h, 100vh) - 48px)); }
    }
    @media (min-width: 901px) and (max-width: 1180px) {
      .detail-body { grid-template-columns: 1fr 300px; }
    }
    @media (max-width: 900px) {
      .detail-body {
        grid-template-columns: 1fr;
        overflow-y: auto;
      }
      .detail-preview {
        border-right: none;
        border-bottom: 1px solid var(--line);
        min-height: calc(var(--lh-view-h, 100vh) * 0.46);
      }
      .detail-preview iframe { position: static; display: block; height: calc(var(--lh-view-h, 100vh) * 0.46); }
    }
    @media (max-width: 480px) {
      .cards-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .mobile-note { display: flex; }
      .detail-preview { min-height: 0; }
      .detail-preview iframe,
      .detail-spinner,
      .detail-fallback { display: none !important; }
    }
    @media (max-width: 560px) {
      .hero { flex-direction: column; align-items: flex-start; gap: 14px; padding: 18px; }
      .hero-stat { align-self: stretch; justify-content: center; }
    }

    /* ===== GIẢM CHUYỂN ĐỘNG ===== */
    body.cc-reduced *,
    body.cc-reduced *::before,
    body.cc-reduced *::after {
      animation-duration: 0.01s !important;
      transition-duration: 0.08s !important;
    }

    /* ===== PHÂN TRANG (chỉ khi giảm chuyển động) ===== */
    .pagination-bar {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      margin-top: 18px;
    }
    .pagination-bar button {
      min-width: 34px;
      height: 34px;
      border: 1px solid var(--line-strong);
      background: var(--surface);
      color: var(--text);
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.12s, color 0.12s;
    }
    .pagination-bar button:hover:not(:disabled) {
      background: var(--primary);
      color: #fff;
    }
    .pagination-bar button:disabled {
      opacity: 0.4;
      cursor: default;
    }
    .pagination-bar button.pg-active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }
    .pagination-bar .pg-info {
      font-size: 12px;
      color: var(--muted);
      margin: 0 6px;
    }
  </style>
<script src="../../version/version-check.js" defer></script>
</head>
<body>

<div class="wrap">
  <header class="hero">
    <div class="hero-main">
      <h1 class="hero-title"><i class="fa-solid fa-book-open"></i> Thư viện Tài liệu</h1>
      <p class="hero-sub">Tìm kiếm và xem nhanh tài liệu học tập</p>
    </div>
    <div class="hero-stat">
      <span class="stat-num" id="statCount">0</span>
      <span class="stat-label">tài liệu</span>
    </div>
  </header>

  <div class="toolbar">
    <div class="search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="search" id="searchInput" placeholder="Tìm kiếm tên file..." autocomplete="off">
    </div>
    <div class="chips" id="categoryChips"></div>
  </div>

  <div id="cardsGrid" class="cards-grid"></div>
  <div id="paginationBar" class="pagination-bar" style="display:none;"></div>

  <div id="emptyState" class="empty-state" style="display:none;">
    <div class="fa-solid fa-folder-open"></div>
    <h3>Không tìm thấy tài liệu</h3>
    <p>Thử thay đổi từ khóa tìm kiếm hoặc chọn nhóm khác.<br>Nếu bạn cần tài liệu cụ thể, vui lòng liên hệ Admin để được hỗ trợ.</p>
    <a href="mailto:learnhubplatform@gmail.com" style="display:inline-flex;align-items:center;gap:6px;margin-top:14px;padding:10px 20px;border-radius:12px;background:rgba(8,145,178,0.08);border:1px solid rgba(8,145,178,0.25);color:#0891b2;font-size:13px;font-weight:600;text-decoration:none;transition:all 0.2s ease;">
      <i class="fa-solid fa-envelope"></i> Liên hệ Admin
    </a>
  </div>

  <section class="detail-view" id="detailView">
    <div class="detail-modal">
      <div class="detail-head">
        <div class="doc-card-top" style="margin:0;">
          <span class="file-ico" id="detailIco"><i class="fa-solid fa-file"></i></span>
          <h2 id="detailName"></h2>
        </div>
        <button class="detail-close" type="button" title="Đóng chi tiết" onclick="closeDetail()">✕</button>
      </div>
      <div class="detail-body">
      <div class="detail-preview">
        <div class="mobile-note">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span class="mn-inner">
            <b class="mn-title">Chế độ xem trước chỉ có thể được sử dụng trên desktop</b>
            <span class="mn-sub">Để xem file trên điện thoại, vui lòng bấm nút <b>Mở file gốc</b> hoặc <b>Tải xuống</b> bên dưới.</span>
          </span>
        </div>
        <div class="detail-spinner" id="detailSpinner">
          <div class="spinner"></div>
          <span>Đang tải file...</span>
        </div>
        <iframe id="detailFrame" title="Xem trước tài liệu" allowfullscreen></iframe>
        <div class="detail-fallback" id="detailFallback">
          <div>
            <div class="fa-solid fa-file"></div>
            <h3 style="margin:0 0 8px;">Không thể xem trước trong trình duyệt</h3>
            <p>Loại file này không hỗ trợ nhúng xem trước. Vui lòng nhấn <b>Mở file gốc</b> ở khung bên phải.</p>
          </div>
        </div>
      </div>
      <aside class="detail-info">
        <p class="d-desc" id="detailDesc"></p>
        <ul class="meta-list">
          <li><span class="m-icon" id="detailCatIco"><i class="fa-solid fa-tag"></i></span><span class="m-label">Nhóm</span><span class="m-value" id="detailCategory"></span></li>
          <li><span class="m-icon"><i class="fa-solid fa-link"></i></span><span class="m-label">Nguồn</span><span class="m-value" id="detailSource"></span></li>
          <li><span class="m-icon"><i class="fa-solid fa-file-arrow-down"></i></span><span class="m-label">Kích thước</span><span class="m-value" id="detailSize"></span></li>
          <li><span class="m-icon"><i class="fa-solid fa-calendar-days"></i></span><span class="m-label">Ngày đăng</span><span class="m-value" id="detailDate"></span></li>
          <li><span class="m-icon"><i class="fa-solid fa-user"></i></span><span class="m-label">Người đăng</span><span class="m-value" id="detailAuthor"></span></li>
        </ul>
        <div class="detail-actions">
          <a class="btn btn-primary" id="openBtn" target="_blank" rel="noopener"><i class="fa-solid fa-up-right-from-square"></i> Mở file gốc</a>
          <a class="btn btn-ghost" id="downloadBtn" target="_blank" rel="noopener"><i class="fa-solid fa-download"></i> Tải xuống</a>
        </div>
      </aside>
      </div>
    </div>
  </section>
</div>

<script src="../../scripts/features/subjects-data.js"></script>
<script type="module">
import { supabase, logAppError } from "../../scripts/core/supabase-config.js";

(async function () {
  "use strict";

  var data = [];
  var loadError = null;

  var searchInput = document.getElementById("searchInput");
  var chipsEl = document.getElementById("categoryChips");
  var gridEl = document.getElementById("cardsGrid");
  var emptyEl = document.getElementById("emptyState");
  var paginationBar = document.getElementById("paginationBar");
  var detailView = document.getElementById("detailView");
  var frame = document.getElementById("detailFrame");
  var spinner = document.getElementById("detailSpinner");
  var fallback = document.getElementById("detailFallback");

  var state = { q: "", cat: "all", activeId: null, activeDoc: null, page: 1 };

  var SOURCE_LABEL = { drive: "Google Drive", direct: "File trực tiếp", storage: "Kho lưu trữ" };

function categoryColor(cat) {
    if (!cat) return "";
    var list = window.LH_SUBJECTS || [];
    cat = String(cat).trim();
    for (var i = 0; i < list.length; i++) {
      var s = list[i];
      if (s.name === cat || s.short === cat) return s.color;
      if (s.alias && s.alias.indexOf(cat) !== -1) return s.color;
    }
    return "";
  }

  function formatDate(v) {
    if (!v) return "—";
    var m = String(v).match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (m) return m[3] + "/" + m[2] + "/" + m[1];
    var d = new Date(v);
    if (isNaN(d.getTime())) return v;
    return ("0" + d.getDate()).slice(-2) + "/" + ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
  }

  var EXT_ICON = {
    pdf:  { icon: "fa-solid fa-file-pdf",   bg: "#ef4444" },
    doc:  { icon: "fa-solid fa-file-word",  bg: "#2563eb" },
    docx: { icon: "fa-solid fa-file-word",  bg: "#2563eb" },
    xls:  { icon: "fa-solid fa-file-excel", bg: "#16a34a" },
    xlsx: { icon: "fa-solid fa-file-excel", bg: "#16a34a" },
    ppt:  { icon: "fa-solid fa-file-powerpoint", bg: "#ea580c" },
    pptx: { icon: "fa-solid fa-file-powerpoint", bg: "#ea580c" },
    mp4:  { icon: "fa-solid fa-file-video", bg: "#7c3aed" },
    webm: { icon: "fa-solid fa-file-video", bg: "#7c3aed" },
    mov:  { icon: "fa-solid fa-file-video", bg: "#7c3aed" },
    mp3:  { icon: "fa-solid fa-file-audio", bg: "#0891b2" },
    wav:  { icon: "fa-solid fa-file-audio", bg: "#0891b2" },
    png:  { icon: "fa-solid fa-file-image", bg: "#d97706" },
    jpg:  { icon: "fa-solid fa-file-image", bg: "#d97706" },
    jpeg: { icon: "fa-solid fa-file-image", bg: "#d97706" },
    gif:  { icon: "fa-solid fa-file-image", bg: "#d97706" },
    webp: { icon: "fa-solid fa-file-image", bg: "#d97706" },
    svg:  { icon: "fa-solid fa-file-image", bg: "#d97706" },
    zip:  { icon: "fa-solid fa-file-zipper", bg: "#475569" },
    rar:  { icon: "fa-solid fa-file-zipper", bg: "#475569" }
  };

  var EMBEDDABLE = ["pdf", "png", "jpg", "jpeg", "gif", "webp", "svg", "mp4", "webm", "mov", "mp3", "wav", "ogg", "txt", "csv", "html", "htm"];

  function extOf(url) {
    var u = String(url || "");
    var name = "";
    try { name = decodeURIComponent(u.split("?")[0].split("#")[0]); } catch (e) { name = u.split("?")[0]; }
    var m = name.match(/\.([a-zA-Z0-9]+)$/);
    return m ? m[1].toLowerCase() : "";
  }

  function fileStyle(doc) {
    var key = (doc.icon || extOf(doc.url)).toLowerCase();
    var style = EXT_ICON[key];
    if (!style) style = { icon: "fa-solid fa-file", bg: "#64748b" };
    return style;
  }

  function toDrivePreview(u) {
    // [FIX BUG #30] Trả về "" nếu không trích được fileId (vd link folder) để cannot-embed
    // hiển thị fallback thay vì nhúng URL Google Drive chắc chắn bị chặn (trang trắng).
    var m = u.match(/\/(?:file\/d|document\/d|spreadsheets\/d|presentation\/d)\/([a-zA-Z0-9_-]+)/);
    if (m) return "https://drive.google.com/file/d/" + m[1] + "/preview";
    m = u.match(/[?&]id=([a-zA-Z0-9_-]+)/);
    if (m) return "https://drive.google.com/file/d/" + m[1] + "/preview";
    return "";
  }

  function buildEmbedUrl(doc) {
    var u = String(doc.url || "").trim();
    if (!u) return "";
    if (doc.type === "drive") return toDrivePreview(u);
    return u;
  }

  function buildDownloadUrl(doc) {
    var u = String(doc.url || "").trim();
    if (doc.type === "drive") {
      var m = u.match(/\/(?:file\/d|document\/d|spreadsheets\/d|presentation\/d)\/([a-zA-Z0-9_-]+)/);
      if (m) return "https://drive.google.com/uc?export=download&id=" + m[1];
      m = u.match(/[?&]id=([a-zA-Z0-9_-]+)/);
      if (m) return "https://drive.google.com/uc?export=download&id=" + m[1];
    }
    return u;
  }

  function isHttp(u) { return /^https?:\/\//i.test(u); }

  function canEmbed(doc) {
    var u = String(doc.url || "");
    // [FIX BUG #30] Chỉ nhúng được Drive khi trích ra được fileId
    if (doc.type === "drive") return !!toDrivePreview(u);
    var ext = extOf(u);
    if (EMBEDDABLE.indexOf(ext) !== -1) return true;
    return false;
  }

  function sourceTag(doc) {
    return '<span class="tag tag-src ' + escapeAttr(doc.type || "storage") + '">' + escapeHtml(SOURCE_LABEL[doc.type] || "Khác") + '</span>';
  }

  function escapeHtml(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }
  function escapeAttr(s) {
    return String(s == null ? "" : s).replace(/"/g, "&quot;");
  }

  function renderChips() {
    var cats = ["all"];
    data.forEach(function (d) {
      if (d.category && cats.indexOf(d.category) === -1) cats.push(d.category);
    });
    chipsEl.innerHTML = "";
    cats.forEach(function (c) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "chip" + (state.cat === c ? " active" : "");
      b.textContent = c === "all" ? "Tất cả" : c;
      b.dataset.cat = c;
      b.addEventListener("click", function () {
        state.cat = c;
        state.page = 1;
        renderChips();
        renderGrid();
      });
      chipsEl.appendChild(b);
    });
  }

  function filteredDocs() {
    var q = state.q.trim().toLowerCase();
    return data.filter(function (d) {
      if (state.cat !== "all" && d.category !== state.cat) return false;
      if (!q) return true;
      return String(d.name || "").toLowerCase().indexOf(q) !== -1 ||
             String(d.description || "").toLowerCase().indexOf(q) !== -1;
    });
  }

  function renderGrid() {
    var list = filteredDocs();
    var reduced = document.body.classList.contains("cc-reduced");
    var perPage = 12;
    var totalPages = Math.ceil(list.length / perPage) || 1;
    if (state.page > totalPages) state.page = totalPages;
    if (state.page < 1) state.page = 1;
    var start = (state.page - 1) * perPage;
    var pageList = list.slice(start, start + perPage);

    gridEl.innerHTML = "";
    emptyEl.style.display = list.length ? "none" : "block";

    pageList.forEach(function (doc, i) {
      var st = fileStyle(doc);
      var card = document.createElement("div");
      card.className = "doc-card" + (state.activeId === doc.id ? " active" : "");
      // [FIX BUG #29] Gắn id để openDetail khớp chính xác (tránh khớp theo tên)
      card.dataset.id = doc.id;
      var catColor = categoryColor(doc.category);
      if (catColor) card.style.setProperty("--cat", catColor);
      if (!reduced) card.style.animationDelay = (i * 40) + "ms";
      card.innerHTML =
        '<div class="doc-card-top">' +
          '<span class="file-ico" style="background:' + st.bg + ';"><i class="' + st.icon + '"></i></span>' +
          '<h3>' + escapeHtml(doc.name) + '</h3>' +
        '</div>' +
        '<p class="desc' + (doc.description ? "" : " no-desc") + '">' + escapeHtml(doc.description || "Không có mô tả.") + '</p>' +
        '<div class="doc-card-bottom">' +
          '<span class="tag tag-cat">' + escapeHtml(doc.category || "Chung") + '</span>' +
          sourceTag(doc) +
        '</div>';
      card.addEventListener("click", function () { openDetail(doc); });
      gridEl.appendChild(card);
    });

    renderPagination(totalPages, list.length);
  }

  function renderPagination(total, totalItems) {
    if (total <= 1) {
      paginationBar.style.display = "none";
      return;
    }
    paginationBar.style.display = "flex";
    paginationBar.innerHTML = "";

    var prev = document.createElement("button");
    prev.type = "button";
    prev.textContent = "‹";
    prev.disabled = state.page <= 1;
    prev.addEventListener("click", function () { state.page--; renderGrid(); });
    paginationBar.appendChild(prev);

    for (var p = 1; p <= total; p++) {
      (function (pg) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = pg;
        if (pg === state.page) btn.className = "pg-active";
        btn.addEventListener("click", function () { state.page = pg; renderGrid(); });
        paginationBar.appendChild(btn);
      })(p);
    }

    var next = document.createElement("button");
    next.type = "button";
    next.textContent = "›";
    next.disabled = state.page >= total;
    next.addEventListener("click", function () { state.page++; renderGrid(); });
    paginationBar.appendChild(next);

    var info = document.createElement("span");
    info.className = "pg-info";
    info.textContent = state.page + "/" + total + " (" + totalItems + ")";
    paginationBar.appendChild(info);
  }

  function inParentFrame() {
    try { return window.self !== window.top; } catch (e) { return true; }
  }

  /* ===== [FIX] Popup review hiển thị Ở TRANG CHÍNH thay vì trong iframe =====
     Iframe tab "Tài liệu" được nới cao = toàn bộ nội dung, nên `position:fixed`
     bên trong iframe neo theo KHUNG IFRAME (không phải màn hình thật) -> popup bị
     trôi theo khi người dùng cuộn trang và dễ bị header/đối tượng khác đè lên.
     Cách sửa: nhờ TRANG CHÍNH (top-level document) render popup -> fixed neo đúng
     viewport thật, không bao giờ trôi, và z-index cao nên nằm trên mọi thứ. */
  function requestParentReview(doc) {
    var st = fileStyle(doc);
    var catColor = categoryColor(doc.category);
    var embed = buildEmbedUrl(doc);
    var payload = {
      id: doc.id,
      name: doc.name || "",
      description: doc.description || "",
      category: doc.category || "Chung",
      catColor: catColor || "",
      iconClass: st.icon,
      iconBg: st.bg,
      sourceLabel: SOURCE_LABEL[doc.type] || "Khác",
      size: doc.size || "",
      date: doc.date || "",
      author: doc.author || "",
      url: doc.url || "",
      downloadUrl: buildDownloadUrl(doc),
      embedUrl: embed,
      embeddable: !!(canEmbed(doc) && embed)
    };
    try { window.parent.postMessage({ type: "OPEN_DOC_REVIEW", doc: payload }, "*"); } catch (e) {}
  }

  function openDetail(doc) {
    state.activeId = doc.id;
    state.activeDoc = doc;
    document.querySelectorAll(".doc-card").forEach(function (c) { c.classList.remove("active"); });
    // [FIX BUG #29] Khớp card theo id (dataset) thay vì theo tên (tránh khớp nhầm khi
    // tên rỗng/trùng và tránh quét textContent).
    var match = null;
    gridEl.querySelectorAll(".doc-card").forEach(function (c) {
      if (c.dataset && c.dataset.id === String(doc.id)) { match = c; }
    });
    if (match) match.classList.add("active");

    // Đang nằm trong iframe -> nhờ trang chính hiển thị popup (fix lỗi trôi theo cuộn).
    // Mở trực tiếp element/hubfile.html (không iframe) thì vẫn dùng modal cục bộ.
    if (inParentFrame()) {
      requestParentReview(doc);
      return;
    }

    var st = fileStyle(doc);
    document.getElementById("detailIco").style.background = st.bg;
    document.getElementById("detailIco").innerHTML = '<i class="' + st.icon + '"></i>';
    document.getElementById("detailName").textContent = doc.name;
    document.getElementById("detailDesc").textContent = doc.description || "Chưa có mô tả.";
    document.getElementById("detailCategory").textContent = doc.category || "Chung";
    var catColor = categoryColor(doc.category);
    var catIco = document.getElementById("detailCatIco");
    if (catIco) {
      catIco.style.background = catColor ? "color-mix(in srgb, " + catColor + " 15%, transparent)" : "";
      catIco.style.color = catColor || "";
    }
    document.getElementById("detailCategory").style.color = catColor || "";
    document.getElementById("detailSource").textContent = SOURCE_LABEL[doc.type] || "Khác";
    document.getElementById("detailSize").textContent = doc.size || "—";
    document.getElementById("detailDate").textContent = formatDate(doc.date);
    document.getElementById("detailAuthor").textContent = doc.author || "—";

    var openBtn = document.getElementById("openBtn");
    openBtn.href = doc.url || "#";
    openBtn.dataset.url = doc.url || "";

    var dlBtn = document.getElementById("downloadBtn");
    dlBtn.href = buildDownloadUrl(doc);
    if (/^\.\.?\//.test(doc.url) || String(doc.url || "").indexOf(location.origin) === 0) {
      dlBtn.setAttribute("download", "");
    } else {
      dlBtn.removeAttribute("download");
    }

    var embed = buildEmbedUrl(doc);
    var embeddable = canEmbed(doc) && embed;

    frame.removeAttribute("src");
    spinner.style.display = "grid";
    fallback.style.display = "none";

    if (embeddable) {
      frame.style.display = "block";
      frame.setAttribute("src", embed);
      frame.onload = function () { spinner.style.display = "none"; };
      setTimeout(function () { if (spinner.style.display !== "none") spinner.style.display = "none"; }, 12000);
    } else {
      frame.style.display = "none";
      spinner.style.display = "none";
      fallback.style.display = "grid";
    }

    detailView.classList.add("show");
    // Không khoá cuộn trang: iframe cao bằng nội dung nên thanh cuộn nằm ở trang chính,
    // khoá lại gây khó chịu. Chỉ xin vùng nhìn thấy (kèm chiều cao header ghim) để đặt modal.
    if (window.parent && window.parent !== window) {
      try { window.parent.postMessage({ type: "REQUEST_FRAME_VIEW" }, "*"); } catch (e) {}
    }
  }

  window.closeDetail = function () {
    state.activeId = null;
    state.activeDoc = null;
    frame.removeAttribute("src");
    document.querySelectorAll(".doc-card").forEach(function (c) { c.classList.remove("active"); });
    detailView.classList.remove("show");
    // Popup đang nằm ở trang chính -> báo trang chính đóng luôn.
    if (inParentFrame()) {
      try { window.parent.postMessage({ type: "CLOSE_DOC_REVIEW" }, "*"); } catch (e) {}
    }
  };

  detailView.addEventListener("click", function (e) {
    if (e.target === detailView) closeDetail();
  });
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    // Phím Esc khi focus còn trong iframe KHÔNG nổi lên trang chính -> phải báo trang chính.
    if (inParentFrame()) {
      try { window.parent.postMessage({ type: "CLOSE_DOC_REVIEW" }, "*"); } catch (e) {}
      return;
    }
    closeDetail();
  });

  searchInput.addEventListener("input", function () {
    state.q = searchInput.value;
    state.page = 1;
    renderGrid();
  });

  try {
    var res = await supabase.rpc("list_tailieu_docs");
    if (res.error) throw res.error;
    data = (res.data || []).slice();
  } catch (err) {
    loadError = err;
    console.error("[tailieu-hub] tải tài liệu lỗi:", err);
    logAppError({
      source: "tailieu_hub",
      category: "feature",
      code: "list_tailieu_docs",
      message: String((err && err.message) || err)
    });
  }

  renderChips();
  renderGrid();

  document.getElementById("statCount").textContent = data.length;

  if (loadError) {
    emptyEl.style.display = "block";
    emptyEl.querySelector("h3").textContent = "Không tải được thư viện tài liệu";
    emptyEl.querySelector("p").innerHTML = "Kết nối dữ liệu đang có sự cố.<br>Vui lòng tải lại trang sau ít phút hoặc liên hệ Admin.";
  }

  window.addEventListener("message", function (event) {
    if (!event.data) return;
    if (event.data.type === "DARK_MODE") {
      document.body.classList.toggle("dark-mode", !!event.data.value);
    }
    if (event.data.type === "REDUCED_MOTION") {
      document.body.classList.toggle("cc-reduced", !!event.data.value);
      state.page = 1;
      renderGrid();
    }
    if (event.data.type === "LEARNHUB_USER") {
      window.learnHubUser = event.data.user;
    }
    // Trang chính đóng popup review -> bỏ trạng thái active của thẻ tài liệu.
    if (event.data.type === "CLOSE_DOC_REVIEW") {
      state.activeId = null;
      state.activeDoc = null;
      document.querySelectorAll(".doc-card").forEach(function (c) { c.classList.remove("active"); });
    }
  });

  if (localStorage.getItem("darkMode") === "on") {
    document.body.classList.add("dark-mode");
  }
  if (localStorage.getItem("cc_reduce") === "on") {
    document.body.classList.add("cc-reduced");
    state.page = 1;
  }
})();
</script>
<script>
/* ====== Auto-size khi nằm trong iframe: báo chiều cao + giữ modal khớp vùng nhìn thấy ======
   Trang chính (index.html) set lại height cho iframe theo chiều cao nội dung -> cuộn bằng
   trang chính. Vì iframe cao bằng cả nội dung nên 100vh/position:fixed bên trong bị "cao theo
   cả trang"; trang chính gửi {type:"FRAME_VIEW", top, vh} để đặt modal (.modal-overlay /
   .detail-view) đúng vùng đang nhìn thấy. Khi KHÔNG nằm trong iframe thì mọi thứ giữ nguyên. */
(function () {
  var inIframe = false;
  try { inIframe = window.self !== window.top; } catch (e) { inIframe = true; }
  if (!inIframe) return;

  var root = document.documentElement;
  root.classList.add("lh-in-iframe");

  var timer = null, lastH = -1, lastVh = -1, lastTop = null, lastMenu = -1;

  function measure() {
    var b = document.body;
    if (!b) return 0;
    var r = b.getBoundingClientRect();
    var cs = getComputedStyle(b);
    var extra = (parseFloat(cs.marginTop) || 0) + (parseFloat(cs.marginBottom) || 0);
    return Math.ceil(r.height + extra);
  }
  function reportHeight() {
    var px = measure();
    if (px < 1 || Math.abs(px - lastH) < 2) return;
    lastH = px;
    try { parent.postMessage({ type: "IFRAME_HEIGHT", height: px }, "*"); } catch (e) {}
  }
  function queueHeight() {
    if (timer) return;
    timer = setTimeout(function () { timer = null; reportHeight(); }, 120);
  }
  function requestView() {
    try { parent.postMessage({ type: "REQUEST_FRAME_VIEW" }, "*"); } catch (e) {}
  }

  window.addEventListener("message", function (ev) {
    var d = ev.data;
    if (!d || !d.type) return;
    if (d.type === "REQUEST_HEIGHT") { reportHeight(); }
    else if (d.type === "FRAME_VIEW") {
      var vh = Number(d.vh) || 0;
      var top = Number(d.top) || 0;
      var menu = Number(d.menuH) || 0;
      if (vh > 0 && vh !== lastVh) { lastVh = vh; root.style.setProperty("--lh-view-h", vh + "px"); }
      if (top !== lastTop) { lastTop = top; root.style.setProperty("--lh-frame-top", top + "px"); }
      if (menu !== lastMenu) { lastMenu = menu; root.style.setProperty("--lh-frame-menu", menu + "px"); }
    }
  });

  window.addEventListener("resize", queueHeight);
  if ("ResizeObserver" in window && document.body) {
    new ResizeObserver(queueHeight).observe(document.body);
  }
  document.addEventListener("load", function (e) {
    if (e.target && e.target.tagName === "IMG") queueHeight();
  }, true);

  requestView();
  reportHeight();
  window.addEventListener("load", function () { reportHeight(); requestView(); });
  setTimeout(reportHeight, 80);
  setTimeout(reportHeight, 400);
  setTimeout(reportHeight, 1200);
})();
</script>
</body>
