              <div class="fc-live">
<div class="fc-live-title"><i class="fa-solid fa-bolt"></i> Xem trước <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:600;color:#94a3b8">(bấm vào thẻ để sửa thẻ đó)</span></div>
              <div id="tcFcLive"></div>
              <div class="fc-live-row">
