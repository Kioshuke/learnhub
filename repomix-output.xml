        }
        wrap.innerHTML = classes.map(c => `
          <div class="tc-modal-class-row">
            <div class="tc-modal-class-icon"><i class="fa-solid fa-chalkboard"></i></div>
            <div style="min-width:0">
              <div class="tc-modal-class-name">${escapeHtml(c.class_name || "Lớp")}</div>
              <div class="tc-modal-class-block">${escapeHtml(c.block || "—")} · Tham gia ${fmtDate(c.joined_at)}</div>
            </div>
            <span class="tc-modal-class-status ${c.status === "approved" ? "approved" : "pending"}">${c.status === "approved" ? "Đã duyệt" : "Chờ duyệt"}</span>
          </div>
        `).join("");
      } catch (e) {
        console.error("user_classes lỗi:", e);
        document.getElementById("tcModalClasses").innerHTML = '<div class="tc-modal-empty">Không tải được danh sách lớp.</div>';
      }
