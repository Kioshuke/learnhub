}

/* Giữ màu đỏ/xanh cho nút phân loại flashcard (vượt qua rule chung) */
.nav-arrow-left,
.nav-arrow-left:hover {
  background: linear-gradient(135deg, #f43f5e, #dc2626) !important;
  color: #fff !important;
