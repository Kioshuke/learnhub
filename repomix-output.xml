.blm-x:hover{background:#fee2e2;border-color:#f87171;color:#b91c1c}
.blm-modal-body{padding:22px;flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
