<style>
  /* --- LAYOUT OVERLAY SLIDING CỐ ĐỊNH 2 FORM --- */
  .auth-shell {
    position: relative;
    display: flex;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* 2 Form nằm cố định 2 bên (Trái: Login 50% | Phải: Register 50%) */
  .auth-left, .auth-right-form {
    flex-shrink: 0 !important;
    box-sizing: border-box;
    transition: opacity 0.5s ease, filter 0.5s ease;
  }

  /* Khi bị che -> Tự làm mờ và chặn tương tác chuột */
  .form-disabled {
    pointer-events: none !important;
    user-select: none !important;
    opacity: 0.3 !important;
    filter: blur(2px);
  }

  /* Màn che Slideshow (Overlay Panel) nằm tuyệt đối đè lên các form */
  .auth-overlay-panel {
    position: absolute;
    top: 0;
    left: 50%; /* Trạng thái mặc định: Che bên phải (Form Đăng ký - 50%) */
    width: 50%;
    height: 100%;
    z-index: 20;
    transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
    overflow: hidden;
  }

  /* Khi chuyển sang TAB ĐĂNG KÝ: Màn che Slider trượt sang TRÁI che Form Đăng nhập */
  .auth-shell.active-register .auth-overlay-panel {
    transform: translateX(-100%);
  }

  .auth-right {
    width: 100% !important;
    height: 100% !important;
    clip-path: none !important;
  }

  @media (min-width: 901px) {
    .auth-anim-item {
      opacity: 0;
      animation: authFadeUp 0.45s ease forwards;
    }
    .auth-anim-item:nth-child(1) { animation-delay: 0.05s; }
    .auth-anim-item:nth-child(2) { animation-delay: 0.12s; }
    .auth-anim-item:nth-child(3) { animation-delay: 0.19s; }
    .auth-anim-item:nth-child(4) { animation-delay: 0.26s; }
    .auth-anim-item:nth-child(5) { animation-delay: 0.33s; }
    .auth-anim-item:nth-child(6) { animation-delay: 0.40s; }
  }

  /* ===== MOBILE (≤900px) ===== */
  @media (max-width: 900px) {
    .auth-shell {
      flex-direction: column !important;
      overflow-y: auto !important;
    }
    .auth-left, .auth-right-form {
      width: 100% !important;
      min-height: auto !important;
      padding: 24px 20px !important;
    }
    .auth-overlay-panel {
      display: none !important;
    }
    .form-disabled {
      display: none !important;
    }
    .auth-right-form.form-disabled {
      display: none !important;
    }
    #loginBox .auth-brand {
      margin-bottom: 12px !important;
    }
    #loginBox .auth-brand img {
      width: 40px !important;
      height: 40px !important;
    }
    #loginBox .auth-brand span {
      font-size: 17px !important;
    }
  }

  .auth-otp-btn{
    width:auto;
    padding:11px 18px;
    margin-top:0;
    border:2px solid #2563eb;
    border-radius:12px;
    background:#eff6ff;
    color:#2563eb;
    font-weight:700;
    font-size:13px;
    cursor:pointer;
    transition:all .2s ease;
    white-space:nowrap;
    align-self:stretch;
  }
  .auth-otp-btn:hover{background:#dbeafe;border-color:#1d4ed8}
  .auth-otp-btn:disabled{opacity:.5;cursor:not-allowed;border-style:solid;color:#94a3b8;background:#f1f5f9}

  /* ===== CẢI THIỆN UX/UI LOGIN ===== */
  .auth-login-btn--soon{opacity:.55;filter:grayscale(.35);cursor:not-allowed}
  .auth-login-btn--soon:hover{transform:none;box-shadow:0 10px 24px rgba(15,23,42,0.08)}
  .auth-soon-tag{
    font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
    background:#e2e8f0;color:#64748b;border-radius:999px;padding:2px 8px;margin-left:4px;
  }
  .auth-eye-btn{
    position:absolute;right:6px;top:50%;transform:translateY(-50%);
    background:none;border:none;cursor:pointer;color:#94a3b8;
    font-size:15px;padding:10px;border-radius:10px;transition:color .2s;
    z-index:2;
  }
  .auth-eye-btn:hover{color:#2563eb}
  #loginBox .auth-input-group input[type="password"]{padding-right:52px}
  .auth-field-error{display:none;font-size:12px;color:#ef4444;margin:-6px 0 10px 4px;font-weight:600}
  .auth-caps-hint{display:none;align-items:center;gap:6px;font-size:11.5px;font-weight:600;color:#d97706;margin:-6px 0 10px 4px}
  .auth-caps-hint.show{display:inline-flex}
  .auth-terms{display:flex;align-items:flex-start;gap:8px;margin:14px 0 16px;font-size:12.5px;color:#64748b;line-height:1.5;text-align:left}
  .auth-terms input{margin-top:2px;accent-color:#2563eb;width:15px;height:15px;flex-shrink:0;cursor:pointer}
  .auth-terms a{color:#2563eb;font-weight:600;text-decoration:underline}
  .auth-terms a:hover{color:#1d4ed8}
  .auth-btn-spinner{
    display:inline-block;vertical-align:-2px;margin-right:8px;
    width:15px;height:15px;border-radius:50%;
    border:2px solid rgba(255,255,255,.45);border-top-color:#fff;
    animation:authSpin .7s linear infinite;
  }
  @keyframes authSpin{to{transform:rotate(360deg)}}
  @keyframes authShake{
    0%,100%{transform:translateX(0)}
    20%{transform:translateX(-8px)}
    40%{transform:translateX(8px)}
    60%{transform:translateX(-5px)}
    80%{transform:translateX(5px)}
  }
  .auth-shake{animation:authShake .45s ease}
  @media (prefers-reduced-motion: reduce){.auth-shake{animation:none}}

  .auth-email-row{
    display:flex;
    gap:8px;
    align-items:stretch;
    margin-bottom:12px;
  }
  .auth-email-row .auth-input-group{
    flex:1;
    min-width:0;
    margin-bottom:0!important;
  }

  .auth-otp-row{
    display:flex;
    gap:8px;
    align-items:center;
    margin-bottom:12px;
  }
  .auth-otp-row input{
    flex:0 1 160px;
    min-width:0;
    padding:11px 14px;
    border-radius:12px;
    border:1.5px solid #e2e8f0;
    font-size:13px;
    font-family:inherit;
    letter-spacing:2px;
    text-align:center;
    outline:none;
    transition:border-color .25s,box-shadow .25s;
  }
  .auth-otp-row input:focus{
    border-color:#2563eb;
    box-shadow:0 0 0 3px rgba(37,99,235,0.1);
  }
  .otp-timer-label{
    font-size:12px;
    font-family:inherit;
    color:#94a3b8;
    white-space:nowrap;
  }
  .otp-timer-label b{
    font-weight:700;
    color:#64748b;
  }

  .auth-otp-resend{
    background:none;
    border:none;
    color:#2563eb;
    font-weight:600;
    font-size:13px;
    cursor:pointer;
    padding:4px 8px;
    border-radius:8px;
    transition:background .2s;
  }
  .auth-otp-resend:hover:not(:disabled){background:#eff6ff}
  .auth-otp-resend:disabled{color:#cbd5e1;cursor:not-allowed}

  .req-star{color:#ef4444;margin-left:2px;font-weight:700}

  /* Label tĩnh — không float */
  .auth-static-group label{
    position:relative!important;
    top:auto!important;
    transform:none!important;
    font-size:13px!important;
    color:#64748b!important;
    background:none!important;
    padding:0!important;
    margin-bottom:6px;
    display:block;
    pointer-events:auto;
  }

  /* Register form: spacing chặt hơn */
  #authRegisterPanel .auth-input-group{
    margin-bottom:12px;
  }

  /* Ảnh đại diện: optional nhưng hiệu ứng float y hệt required */
  #loginBox .auth-input-group #registerPhoto:valid + label{
    top:50%!important;font-size:14px!important;color:#94a3b8!important;
    background:transparent!important;padding:0 6px!important;border-radius:0!important;
    transform:translateY(-50%)!important;
  }
  #loginBox .auth-input-group #registerPhoto:not(:placeholder-shown) + label,
  #loginBox .auth-input-group #registerPhoto:focus + label{
    top:-8px!important;font-size:12px!important;color:#2563eb!important;
    background:#fff!important;padding:0 4px!important;border-radius:4px!important;
    transform:none!important;
  }

  /* ===== FORGOT / RESET PASSWORD MODAL ===== */
  .auth-modal-overlay{
    position:fixed; inset:0; z-index:2000001;
    display:none; align-items:center; justify-content:center;
    background:rgba(15,23,42,0.55);
    backdrop-filter:blur(4px);
    -webkit-backdrop-filter:blur(4px);
  }
  .auth-modal-overlay.show{ display:flex; }
  .auth-modal{
    width:min(92vw,420px);
    background:#fff; border-radius:16px;
    box-shadow:0 24px 60px rgba(0,0,0,0.25);
    padding:28px 26px;
    box-sizing:border-box;
    animation:authFadeUp .3s ease;
    max-height:92vh; overflow-y:auto;
  }
  .auth-modal h3{
    margin:0 0 6px; font-size:20px; color:#0f172a;
    display:flex; align-items:center; justify-content:space-between; gap:12px;
  }
  .auth-modal .auth-modal-sub{ margin:0 0 18px; font-size:13px; color:#64748b; }
  .auth-modal-close{
    border:none; background:none; font-size:20px; line-height:1;
    color:#94a3b8; cursor:pointer; padding:4px; flex-shrink:0;
  }
  .auth-modal-close:hover{ color:#0f172a; }
  #forgotModal .auth-input-group{ margin-bottom:14px; }
  .auth-modal .auth-submit{ width:100%; }
  .auth-forgot-link{
    display:inline-block; margin:2px 0 14px;
    color:#2563eb; font-size:13px; font-weight:600;
    cursor:pointer; text-decoration:none; background:none; border:none; padding:0;
  }
  .auth-forgot-link:hover{ text-decoration:underline; }
  .auth-modal .auth-static-group label{
    position:relative!important;
    top:auto!important; transform:none!important;
    font-size:13px!important; color:#64748b!important;
    background:none!important; padding:0!important;
    margin-bottom:6px; display:block; pointer-events:auto;
  }
  .auth-modal .auth-static-group input{
    width:100%;
    padding:13px 16px;
    border-radius:12px;
    border:1.5px solid #e2e8f0;
    outline:none;
    font-size:14px;
    background:rgba(255,255,255,0.9);
    transition:border-color .25s ease, box-shadow .25s ease;
  }
  .auth-modal .auth-static-group input:focus{
    border-color:#2563eb;
    box-shadow:0 0 0 4px rgba(37,99,235,0.12);
  }

  /* ===== AUTH BELOW: TỔNG QUAN + TÍNH NĂNG NỔI BẬT (CUỘN XUỐNG) ===== */
  .auth-below{
    position:relative;
    width:100%;
    background:linear-gradient(180deg,#f0f4ff 0%,#ffffff 40%,#f8fafc 100%);
    padding:80px 20px 88px;
    box-sizing:border-box;
    overflow:hidden;
  }
  .auth-below::before{
    content:'';position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent 0%,#c7d2fe 50%,transparent 100%);
  }
  /* Animated grid bg */
  .auth-below-gridbg{
    position:absolute;inset:0;z-index:0;pointer-events:none;
    background-image:
      linear-gradient(to right,rgba(99,102,241,.04) 1px,transparent 1px),
      linear-gradient(to bottom,rgba(99,102,241,.04) 1px,transparent 1px);
    background-size:64px 64px;
    -webkit-mask-image:radial-gradient(ellipse 90% 80% at 50% 18%,#000 20%,transparent 70%);
    mask-image:radial-gradient(ellipse 90% 80% at 50% 18%,#000 20%,transparent 70%);
    animation:authGridDrift 20s linear infinite;
  }
  @keyframes authGridDrift{0%{background-position:0 0}100%{background-position:64px 64px}}

  /* Blobs */
  .auth-below-blob{position:absolute;border-radius:50%;pointer-events:none;z-index:0;filter:blur(80px);opacity:.45}
  .auth-below-blob--tl{width:500px;height:500px;top:-200px;left:-180px;background:radial-gradient(circle at 32% 30%,#c7d2fe 0%,rgba(199,210,254,0) 65%);animation:authBlobFloat1 8s ease-in-out infinite}
  .auth-below-blob--br{width:520px;height:520px;bottom:-200px;right:-180px;background:radial-gradient(circle at 68% 70%,#bfdbfe 0%,rgba(191,219,254,0) 65%);animation:authBlobFloat2 10s ease-in-out infinite}
  @keyframes authBlobFloat1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(20px,15px) scale(1.05)}}
  @keyframes authBlobFloat2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-15px,-20px) scale(1.08)}}

  /* Floating particles */
  .auth-below-particles{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
  .auth-below-particle{
    position:absolute;border-radius:50%;
    background:linear-gradient(135deg,rgba(37,99,235,.15),rgba(124,58,237,.12));
    animation:authParticleFloat linear infinite;
  }
  .auth-below-particle:nth-child(1){width:6px;height:6px;top:12%;left:8%;animation-duration:7s;animation-delay:0s}
  .auth-below-particle:nth-child(2){width:4px;height:4px;top:25%;left:85%;animation-duration:9s;animation-delay:1s}
  .auth-below-particle:nth-child(3){width:8px;height:8px;top:55%;left:15%;animation-duration:11s;animation-delay:2s}
  .auth-below-particle:nth-child(4){width:5px;height:5px;top:70%;left:75%;animation-duration:8s;animation-delay:0.5s}
  .auth-below-particle:nth-child(5){width:7px;height:7px;top:40%;left:50%;animation-duration:12s;animation-delay:3s}
  .auth-below-particle:nth-child(6){width:4px;height:4px;top:85%;left:30%;animation-duration:10s;animation-delay:1.5s}
  .auth-below-particle:nth-child(7){width:6px;height:6px;top:18%;left:65%;animation-duration:8.5s;animation-delay:2.5s}
  .auth-below-particle:nth-child(8){width:5px;height:5px;top:65%;left:42%;animation-duration:9.5s;animation-delay:0.8s}
  @keyframes authParticleFloat{
    0%{transform:translateY(0) rotate(0deg);opacity:0}
    10%{opacity:.7}
    90%{opacity:.7}
    100%{transform:translateY(-120vh) rotate(720deg);opacity:0}
  }

  .auth-below-inner{position:relative;z-index:1;max-width:1100px;margin:0 auto}

  /* === HEADER === */
  .auth-below-head{text-align:center;margin-bottom:28px}
  .auth-below-head-badge{
    display:inline-flex;align-items:center;gap:6px;
    padding:6px 16px;border-radius:999px;
    background:linear-gradient(135deg,rgba(37,99,235,.08),rgba(99,102,241,.08));
    border:1px solid rgba(37,99,235,.12);
    font-size:12px;font-weight:700;color:#2563eb;
    margin-bottom:16px;letter-spacing:.02em;
    animation:authBadgeShimmer 3s ease-in-out infinite;
  }
  @keyframes authBadgeShimmer{
    0%,100%{box-shadow:0 0 0 0 rgba(37,99,235,0)}
    50%{box-shadow:0 0 0 6px rgba(37,99,235,.08)}
  }
  .auth-below-head-badge i{font-size:11px;animation:authBadgeIconPulse 2s ease-in-out infinite}
  @keyframes authBadgeIconPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.2)}}
  .auth-below-head h2{
    margin:0 0 16px;font-size:34px;font-weight:800;
    color:#0f172a;letter-spacing:-.8px;line-height:1.2;
  }
  .auth-below-head h2 span{
    background:linear-gradient(135deg,#2563eb 0%,#7c3aed 30%,#ec4899 60%,#2563eb 100%);
    background-size:300% 300%;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:authGradShift 5s ease infinite;
  }
  @keyframes authGradShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  .auth-below-head p{margin:0 auto;max-width:600px;font-size:15px;line-height:1.8;color:#64748b}

  /* === STATS ROW === */
  .auth-below-stats{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:32px}
  .auth-below-stat{
    display:flex;align-items:center;gap:10px;
    padding:14px 22px;border-radius:16px;
    background:#fff;border:1px solid #e8edf5;
    box-shadow:0 2px 8px rgba(16,24,40,.04);
    min-width:150px;
    transition:all .3s cubic-bezier(.2,.7,.3,1);
    position:relative;overflow:hidden;
  }
  .auth-below-stat::after{
    content:'';position:absolute;inset:0;
    background:linear-gradient(135deg,transparent 40%,rgba(37,99,235,.03) 50%,transparent 60%);
    background-size:250% 250%;
    animation:authStatShine 4s ease-in-out infinite;
  }
  @keyframes authStatShine{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .auth-below-stat:hover{transform:translateY(-4px) scale(1.02);box-shadow:0 12px 32px rgba(37,99,235,.12)}
  .auth-below-stat-icon{
    width:40px;height:40px;border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    font-size:17px;flex-shrink:0;color:#fff;
    animation:authStatIconPulse 3s ease-in-out infinite;
  }
  @keyframes authStatIconPulse{
    0%,100%{box-shadow:0 0 0 0 rgba(255,255,255,.3)}
    50%{box-shadow:0 0 0 8px rgba(255,255,255,0)}
  }
  .auth-below-stat-num{font-size:20px;font-weight:800;color:#0f172a;line-height:1;position:relative;z-index:1}
  .auth-below-stat-label{font-size:11.5px;color:#94a3b8;font-weight:600;margin-top:2px;position:relative;z-index:1}

  /* === POINTS (BADGES) === */
  .auth-below-points{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-bottom:40px}
  .auth-below-point{
    display:inline-flex;align-items:center;gap:8px;
    padding:10px 18px;border-radius:12px;
    background:#fff;border:1px solid #e2e8f0;
    font-size:13px;font-weight:600;color:#334155;
    box-shadow:0 1px 3px rgba(16,24,40,.04);
    transition:all .3s cubic-bezier(.2,.7,.3,1);
    position:relative;overflow:hidden;
  }
  .auth-below-point::before{
    content:'';position:absolute;top:50%;left:50%;
    width:0;height:0;border-radius:50%;
    background:rgba(37,99,235,.06);
    transition:all .5s ease;transform:translate(-50%,-50%);
  }
  .auth-below-point:hover::before{width:200px;height:200px}
  .auth-below-point i{
    font-size:13px;display:inline-flex;align-items:center;justify-content:center;
    width:26px;height:26px;border-radius:8px;
    color:#2563eb;background:rgba(37,99,235,.08);
    transition:all .3s ease;position:relative;z-index:1;
  }
  .auth-below-point span{position:relative;z-index:1}
  .auth-below-point:hover{
    transform:translateY(-3px) scale(1.03);border-color:#2563eb;
    box-shadow:0 8px 24px rgba(37,99,235,.18);
  }
  .auth-below-point:hover i{background:rgba(37,99,235,.15);transform:scale(1.15) rotate(-5deg)}

  /* === FEATURE CARDS === */
  .auth-below-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .auth-below-card{
    position:relative;display:flex;flex-direction:column;align-items:flex-start;
    gap:14px;padding:28px 22px 26px;
    background:#fff;border:1px solid #eef2f7;border-radius:18px;
    box-shadow:0 1px 3px rgba(16,24,40,.04),0 6px 16px -6px rgba(16,24,40,.06);
    box-sizing:border-box;overflow:hidden;
    transition:all .4s cubic-bezier(.2,.7,.3,1);
    transform-style:preserve-3d;
    perspective:800px;
  }
  .auth-below-card::before{
    content:'';position:absolute;top:0;left:0;right:0;height:3px;
    background:linear-gradient(90deg,var(--fc,#2563eb),color-mix(in srgb,var(--fc,#2563eb) 50%,#a78bfa),var(--fc,#2563eb));
    background-size:200% 100%;
    opacity:0;transition:opacity .3s ease;
    animation:authCardBorderFlow 3s linear infinite paused;
  }
  .auth-below-card:hover::before{opacity:1;animation-play-state:running}
  @keyframes authCardBorderFlow{0%{background-position:0% 0}100%{background-position:200% 0}}
  .auth-below-card::after{
    content:'';position:absolute;inset:0;border-radius:18px;
    background:radial-gradient(circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--fc,#2563eb) 6%,transparent) 0%,transparent 60%);
    opacity:0;transition:opacity .3s ease;pointer-events:none;
  }
  .auth-below-card:hover::after{opacity:1}
  .auth-below-card:hover{
    transform:translateY(-8px) scale(1.02);
    box-shadow:0 4px 8px rgba(16,24,40,.04),0 32px 64px -16px color-mix(in srgb,var(--fc,#2563eb) 25%,rgba(16,24,40,.14));
    border-color:color-mix(in srgb,var(--fc,#2563eb) 35%,#e2e8f0);
  }

  /* === STAGGER HOVER: hover 1 card -> card kề hưởng ứng nhẹ === */
  .auth-below-grid:has(.auth-below-card:hover) .auth-below-card:not(:hover){
    transform:translateY(-3px) scale(1.008);
    box-shadow:0 2px 6px rgba(16,24,40,.03),0 12px 24px -8px rgba(16,24,40,.06);
    border-color:#e8edf5;
  }
  .auth-below-grid:has(.auth-below-card:hover) .auth-below-card:not(:hover) .auth-below-icon{
    transform:translateY(-1px) scale(1.03);
  }
  /* Card liền kề (trước/sau) hover mạnh hơn chút */
  .auth-below-grid:has(.auth-below-card:hover) .auth-below-card:not(:hover):has(~ .auth-below-card:hover),
  .auth-below-grid:has(.auth-below-card:hover) .auth-below-card:not(:hover):has(+ .auth-below-card:hover){
    transform:translateY(-5px) scale(1.012);
    box-shadow:0 3px 8px rgba(16,24,40,.04),0 18px 36px -10px rgba(16,24,40,.08);
  }
  .auth-below-grid:has(.auth-below-card:hover) .auth-below-card:not(:hover):has(~ .auth-below-card:hover) .auth-below-icon,
  .auth-below-grid:has(.auth-below-card:hover) .auth-below-card:not(:hover):has(+ .auth-below-card:hover) .auth-below-icon{
    transform:translateY(-2px) scale(1.05);
  }

  /* === AUTO HOVER: tự động highlight card theo thứ tự === */
  .auth-below-card--auto-active{
    transform:translateY(-8px) scale(1.02)!important;
    box-shadow:0 4px 8px rgba(16,24,40,.04),0 32px 64px -16px color-mix(in srgb,var(--fc,#2563eb) 25%,rgba(16,24,40,.14))!important;
    border-color:color-mix(in srgb,var(--fc,#2563eb) 35%,#e2e8f0)!important;
    z-index:2;
  }
  .auth-below-card--auto-active::before{opacity:1;animation-play-state:running}
  .auth-below-card--auto-active::after{opacity:1}
  .auth-below-card--auto-active .auth-below-icon{
    transform:translateY(-4px) scale(1.12) rotate(-3deg)!important;
    box-shadow:0 8px 20px color-mix(in srgb,var(--fc,#2563eb) 25%,transparent)!important;
  }
  /* Card liền kề auto-active cũng rise nhẹ */
  .auth-below-card--auto-active ~ .auth-below-card:not(.auth-below-card--auto-active):not(:hover){
    transform:translateY(-4px) scale(1.01)!important;
    box-shadow:0 3px 8px rgba(16,24,40,.04),0 16px 32px -10px rgba(16,24,40,.08)!important;
  }
  .auth-below-card--auto-active ~ .auth-below-card:not(.auth-below-card--auto-active):not(:hover) .auth-below-icon{
    transform:translateY(-2px) scale(1.05)!important;
  }
  .auth-below-card:has(+ .auth-below-card--auto-active):not(.auth-below-card--auto-active):not(:hover){
    transform:translateY(-4px) scale(1.01)!important;
    box-shadow:0 3px 8px rgba(16,24,40,.04),0 16px 32px -10px rgba(16,24,40,.08)!important;
  }
  .auth-below-card:has(+ .auth-below-card--auto-active):not(.auth-below-card--auto-active):not(:hover) .auth-below-icon{
    transform:translateY(-2px) scale(1.05)!important;
  }

  .auth-below-icon{
    width:48px;height:48px;
    display:flex;align-items:center;justify-content:center;
    font-size:20px;border-radius:14px;
    background:linear-gradient(135deg,color-mix(in srgb,var(--fc,#2563eb) 10%,#fff),color-mix(in srgb,var(--fc,#2563eb) 5%,#f8fafc));
    border:1px solid color-mix(in srgb,var(--fc,#2563eb) 18%,transparent);
    color:var(--fc,#2563eb);
    transition:all .4s cubic-bezier(.2,.7,.3,1);
  }
  .auth-below-card:hover .auth-below-icon{
    transform:translateY(-4px) scale(1.12) rotate(-3deg);
    box-shadow:0 8px 20px color-mix(in srgb,var(--fc,#2563eb) 25%,transparent);
  }
  .auth-below-name{font-size:14.5px;font-weight:700;color:#0f172a;letter-spacing:-.1px;line-height:1.3;transition:color .3s ease}
  .auth-below-desc{font-size:12.5px;line-height:1.65;color:#64748b}
  .auth-below-card:hover .auth-below-name{color:var(--fc,#2563eb)}

  /* === SHINE SWEEP: vệt sáng quét ngang card khi hover === */
  .auth-below-shine{
    position:absolute;top:-20%;bottom:-20%;left:0;width:70px;
    transform:translateX(-140px) skewX(-22deg);
    background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--fc,#2563eb) 16%,rgba(255,255,255,.85)),transparent);
    opacity:0;pointer-events:none;z-index:3;
  }
  .auth-below-card:hover .auth-below-shine,
  .auth-below-card--auto-active .auth-below-shine{
    opacity:1;animation:authCardShine 1s cubic-bezier(.4,0,.2,1);
  }
  @keyframes authCardShine{
    0%{transform:translateX(-140px) skewX(-22deg);opacity:0}
    15%{opacity:1}
    85%{opacity:1}
    100%{transform:translateX(560px) skewX(-22deg);opacity:0}
  }

  /* === CLICK RIPPLE: sóng lan khi bấm vào card === */
  .auth-below-ripple{
    position:absolute;border-radius:50%;transform:scale(0);
    background:radial-gradient(circle,color-mix(in srgb,var(--fc,#2563eb) 22%,transparent) 0%,transparent 65%);
    animation:authCardRipple .65s ease-out forwards;
    pointer-events:none;z-index:2;
  }
  @keyframes authCardRipple{to{transform:scale(1);opacity:0}}

  /* === SCROLL UP BUTTON === */
  .auth-below-up{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;
    margin:40px auto 0;padding:14px 28px;
    border-radius:14px;border:1.5px solid #e2e8f0;
    background:linear-gradient(135deg,#fff,#f8fafc);
    color:#334155;font-family:inherit;font-size:14px;font-weight:700;
    cursor:pointer;box-shadow:0 4px 16px rgba(15,23,42,.06);
    transition:all .3s ease;position:relative;overflow:hidden;
  }
  .auth-below-up::before{
    content:'';position:absolute;inset:0;
    background:linear-gradient(90deg,transparent,rgba(37,99,235,.05),transparent);
    transform:translateX(-100%);transition:transform .5s ease;
  }
  .auth-below-up:hover::before{transform:translateX(100%)}
  .auth-below-up:hover{border-color:#2563eb;box-shadow:0 8px 28px rgba(37,99,235,.15);transform:translateY(-2px)}
  .auth-below-up-icon{
    display:inline-flex;align-items:center;justify-content:center;
    width:28px;height:28px;border-radius:8px;
    background:#e2e8f0;color:#334155;font-size:14px;
    transition:all .3s ease;
  }
  .auth-below-up.active{
    border-color:#2563eb;
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    color:#fff;box-shadow:0 10px 32px rgba(37,99,235,.35);
    animation:authUpPulse 2s ease-in-out infinite;
  }
  @keyframes authUpPulse{0%,100%{box-shadow:0 10px 32px rgba(37,99,235,.35)}50%{box-shadow:0 10px 40px rgba(37,99,235,.5)}}
  .auth-below-up.active .auth-below-up-icon{
    background:#fff;color:#2563eb;
    animation:authUpBob 1s ease-in-out infinite;
  }
  @keyframes authUpBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}

  /* === SCROLL DOWN FAB === */
  .auth-scroll-down{
    position:fixed;left:50%;bottom:22px;
    transform:translateX(-50%);
    display:flex;align-items:center;gap:8px;
    padding:10px 20px;border-radius:999px;
    border:1.5px solid #2563eb;background:#fff;color:#2563eb;
    font-family:inherit;font-size:13px;font-weight:700;
    cursor:pointer;z-index:60;
    box-shadow:0 8px 24px rgba(37,99,235,.2);
    transition:all .3s ease;
    animation:authFabEntry .6s cubic-bezier(.2,.7,.3,1) backwards;animation-delay:1s;
  }
  @keyframes authFabEntry{from{opacity:0;transform:translateX(-50%) translateY(20px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
  .auth-scroll-down::before{
    content:'';position:absolute;inset:-3px;border-radius:999px;
    background:radial-gradient(circle,rgba(37,99,235,.25),transparent 70%);
    opacity:0;transition:opacity .3s ease;z-index:-1;
  }
  .auth-scroll-down:hover::before{opacity:1}
  .auth-scroll-down:hover{box-shadow:0 12px 32px rgba(37,99,235,.35);transform:translateX(-50%) translateY(-3px)}
  .auth-scroll-down-arrow{
    display:inline-flex;align-items:center;justify-content:center;
    width:22px;height:22px;border-radius:50%;
    background:#2563eb;color:#fff;font-size:13px;
    animation:authDownBob 1.2s ease-in-out infinite;
  }
  @keyframes authDownBob{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}
  .auth-scroll-down.hidden{opacity:0;pointer-events:none;transform:translateX(-50%) translateY(10px)}

  /* === REVEAL ANIMATION === */
  .auth-below:not(.auth-below--show) .auth-below-head,
  .auth-below:not(.auth-below--show) .auth-below-stat,
  .auth-below:not(.auth-below--show) .auth-below-point,
  .auth-below:not(.auth-below--show) .auth-below-card{
    opacity:0;transform:translateY(32px) scale(.96);
  }
  @keyframes authFadeUp{from{opacity:0;transform:translateY(32px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
  @keyframes authFadeUpBounce{
    0%{opacity:0;transform:translateY(40px) scale(.9)}
    60%{opacity:1;transform:translateY(-6px) scale(1.02)}
    100%{opacity:1;transform:translateY(0) scale(1)}
  }
  @keyframes authIconPopIn{
    0%{transform:scale(0) rotate(-15deg)}
    70%{transform:scale(1.15) rotate(5deg)}
    100%{transform:scale(1) rotate(0)}
  }
  .auth-below--show .auth-below-head{animation:authFadeUpBounce .65s cubic-bezier(.2,.7,.3,1) backwards;animation-delay:.05s}
  .auth-below--show .auth-below-stat{animation:authFadeUpBounce .55s cubic-bezier(.2,.7,.3,1) backwards}
