          '<ul class="grammar-sidebar-list" id="' + listId + '">' + groupsHtml + '</ul>' +
        '</div>' +
      '</div>' +
    '</div>';

  var listEl = document.getElementById(listId);
  if (listEl) {
    listEl.querySelectorAll(".gv-group-head").forEach(function(hd) {
      hd.addEventListener("click", function() {
        var group = hd.parentNode;
