  var tick=false;
  function upd(){
    tick=false;
    var h=document.documentElement;
    var max=h.scrollHeight-h.clientHeight;
    var y=h.scrollTop||document.body.scrollTop||0;
    bar.style.width=(max>0?(y/max)*100:0)+'%';
